<%- include('partials/crm-head', { title: 'Companies', active: 'companies' }) %>
<section class="crm-hero"><div><p class="crm-eyebrow">Connected CRM</p><h1>Companies</h1><p>Organisations with their people, meetings, and accumulated context.</p></div></section>
<section class="section-card">
  <h2>Add company</h2>
  <form class="crm-form-grid" method="post" action="/crm/companies">
    <label>Name<input name="name" required></label>
    <label>Type<select name="type"><option value="">Not set</option><option>employer</option><option>client</option><option>vendor</option><option>partner</option></select></label>
    <label>Website<input name="website" type="url" placeholder="https://"></label>
    <label class="wide">Notes<textarea name="notes" rows="2"></textarea></label>
    <button class="btn" type="submit">Create company</button>
  </form>
</section>
<section class="crm-card-grid">
  <% for (const company of companies) { %>
    <a class="mgmt-card crm-link-card" href="/crm/company/<%= company.id %>">
      <div class="crm-card-title"><span><%= company.name %></span><span class="crm-badge"><%= company.type || 'company' %></span></div>
      <p><%= company.contact_count %> people · <%= company.meeting_count %> meetings</p>
      <% if (company.notes) { %><p class="crm-muted"><%= company.notes %></p><% } %>
    </a>
  <% } %>
</section>
<%- include('partials/crm-foot') %>
