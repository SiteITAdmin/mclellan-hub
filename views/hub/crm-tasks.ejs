<%- include('partials/crm-head', { title: 'Tasks', active: 'tasks' }) %>
<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Google Tasks</p>
    <h1>Tasks</h1>
    <p>All tasks synced from Google Tasks, with links to people, companies, and projects.</p>
  </div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <a href="/crm/tasks?show_history=<%= showHistory ? '0' : '1' %>" class="btn btn-sm" style="opacity:.7;">
      <%= showHistory ? 'Hide history' : 'Show history' %>
    </a>
  </div>
</section>

<% if (syncError) { %>
  <p class="crm-notice" style="border-color:var(--crm-danger,#c0392b);color:var(--crm-danger,#c0392b);">
    Google Tasks sync failed just now (<%= syncError %>) — this list may be stale. Changes still save locally and sync when Google is reachable.
  </p>
<% } %>

<!-- Add task form -->
<section class="section-card" style="margin-bottom:24px;">
  <h2>Add task</h2>
  <form class="crm-form-grid" id="task-add-form">
    <label class="wide">Title<input name="title" required placeholder="What needs doing?"></label>
    <label class="wide">Notes<input name="notes" placeholder="Optional details or context"></label>
    <label>Start date<input name="start" type="date" title="Not before — a date over 2 weeks out is held off your Google list until it's near"></label>
    <label>Due date<input name="due" type="date"></label>
    <label>Priority
      <select name="priority">
        <option value="">— none —</option>
        <option value="low">Low</option>
        <option value="medium">Medium</option>
        <option value="high">High</option>
      </select>
    </label>
    <label>Effort
      <select name="effort_minutes">
        <option value="5">5 min</option>
        <option value="15">15 min</option>
        <option value="30" selected>30 min (default)</option>
        <option value="60">1 hour</option>
        <option value="120">2 hours</option>
      </select>
    </label>
    <label>Add to planner
      <span class="task-add-planner">
        <input name="planner_selected" type="checkbox" value="1">
        <select name="planner_lane" aria-label="Planner time">
          <option value="work">Work hours</option>
          <option value="personal">Evening / weekend</option>
        </select>
      </span>
    </label>
    <label>Person
      <select name="contact_id">
        <option value="">— no person —</option>
        <% for (const c of contacts) { %><option value="<%= c.id %>"><%= c.name %></option><% } %>
      </select>
    </label>
    <label>Company
      <select name="company_id">
        <option value="">— no company —</option>
        <% for (const co of companies) { %><option value="<%= co.id %>"><%= co.name %></option><% } %>
      </select>
    </label>
    <label>Project
      <select name="project_slug">
        <option value="">— no project —</option>
        <% for (const p of projects) { %><option value="<%= p.slug %>"><%= p.name %></option><% } %>
      </select>
    </label>
    <label>Assign to (someone else)
      <input name="assignee" list="assignee-options" placeholder="Leave blank if it's yours" autocomplete="off">
      <datalist id="assignee-options">
        <% for (const c of contacts) { %><option value="<%= c.name %>"></option><% } %>
      </datalist>
    </label>
    <button class="btn" type="submit">Add to Google Tasks</button>
    <p class="crm-muted task-form-msg" id="task-form-msg"></p>
  </form>
</section>

<!-- Task list -->
<% const openAll = tasks.filter(t => t.status === 'needsAction' && !t.deleted_at); %>
<% const startsLater = openAll.filter(t => !t.assignee && isStartDeferred(t.start)); %>
<% const open = openAll.filter(t => !t.assignee && !isStartDeferred(t.start)); %>
<% const assignedOut = openAll.filter(t => t.assignee); %>
<% const done = tasks.filter(t => t.status === 'completed' && !t.deleted_at); %>
<% const deleted = tasks.filter(t => t.deleted_at); %>

<section class="section-card">
  <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;margin-bottom:8px;">
    <h2 style="margin:0;">Open (<%= open.length %>)</h2>
    <div style="display:flex;gap:4px;align-items:center;flex-wrap:wrap;">
      <% for (const [key, label] of [['all','All'],['overdue','Overdue'],['due-soon','Due soon'],['high','High priority'],['unsized','No due/size']]) { %>
        <button class="btn btn-sm btn-ghost task-filter" data-filter="<%= key %>" <%= key === 'all' ? 'style="font-weight:600;"' : '' %>><%= label %></button>
      <% } %>
      <select id="task-filter-project" style="font-size:12px;padding:3px 6px;" title="Filter by project">
        <option value="">Project: all</option>
        <option value="__none__">No project</option>
        <% for (const p of projects) { %><option value="<%= p.slug %>"><%= p.name %></option><% } %>
      </select>
      <select id="task-sort" style="font-size:12px;padding:3px 6px;">
        <option value="due">Sort: due date</option>
        <option value="priority">Sort: priority</option>
        <option value="effort">Sort: effort</option>
        <option value="project">Sort: project</option>
      </select>
    </div>
  </div>
  <% if (!open.length) { %><p class="crm-muted">No open tasks. Nice.</p><% } %>
  <% for (const t of open) { %>
    <%- include('partials/task-row', { t, showHistory }) %>
  <% } %>
</section>

<% if (startsLater.length) { %>
<section class="section-card" style="margin-top:16px;">
  <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;margin-bottom:8px;">
    <h2 style="margin:0;">Starts later (<%= startsLater.length %>)</h2>
    <p class="crm-muted" style="margin:0;">Held off your Google Tasks list until ~2 weeks before their start date. Not scheduled until then.</p>
  </div>
  <% for (const t of startsLater.slice().sort((a, b) => String(a.start).localeCompare(String(b.start)))) { %>
    <%- include('partials/task-row', { t, showHistory }) %>
  <% } %>
</section>
<% } %>

<% if (assignedOut.length) { %>
<section class="section-card" style="margin-top:16px;">
  <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;margin-bottom:8px;">
    <h2 style="margin:0;">Tasks assigned to others (<%= assignedOut.length %>)</h2>
    <p class="crm-muted" style="margin:0;">Tracked but not on your calendar. Clear the assignee on a task to take it back.</p>
  </div>
  <%
    const byAssignee = new Map();
    for (const t of assignedOut) {
      const key = t.assignee;
      if (!byAssignee.has(key)) byAssignee.set(key, []);
      byAssignee.get(key).push(t);
    }
    const assigneeNames = [...byAssignee.keys()].sort((a, b) => a.toLowerCase() < b.toLowerCase() ? -1 : 1);
  %>
  <% for (const name of assigneeNames) { %>
    <h3 style="margin:14px 0 6px;font-size:15px;opacity:.8;">→ <%= name %> (<%= byAssignee.get(name).length %>)</h3>
    <% for (const t of byAssignee.get(name)) { %>
      <%- include('partials/task-row', { t, showHistory }) %>
    <% } %>
  <% } %>
</section>
<% } %>

<% if (showHistory && done.length) { %>
<section class="section-card" style="margin-top:16px;">
  <h2>Completed (<%= done.length %>)</h2>
  <% for (const t of done) { %>
    <%- include('partials/task-row', { t, showHistory }) %>
  <% } %>
</section>
<% } %>

<% if (showHistory && deleted.length) { %>
<section class="section-card" style="margin-top:16px;">
  <h2>Deleted (<%= deleted.length %>)</h2>
  <% for (const t of deleted) { %>
    <%- include('partials/task-row', { t, showHistory }) %>
  <% } %>
</section>
<% } %>

<script>
document.getElementById('task-add-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('task-form-msg');
  const btn = e.target.querySelector('button[type=submit]');
  const data = Object.fromEntries(new FormData(e.target));
  btn.disabled = true;
  msg.textContent = 'Adding…';
  try {
    const r = await fetch('/api/tasks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const j = await r.json();
    if (j.ok) { msg.textContent = 'Added! Refreshing…'; setTimeout(() => location.reload(), 800); }
    else msg.textContent = j.error || 'Error adding task.';
  } catch (err) {
    msg.textContent = 'Error: ' + err.message;
  } finally {
    btn.disabled = false;
  }
});

async function taskAction(id, action) {
  const r = await fetch(`/api/tasks/${id}/${action}`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + (j.error || action + ' failed'));
}

// Client-side filter + sort over the open list, driven by task-row data attrs
const openSection = document.querySelector('.task-filter')?.closest('.section-card');
const PRIORITY_RANK = { high: 0, medium: 1, low: 2, '': 3 };
let activeFilter = 'all';
const projectFilterEl = document.getElementById('task-filter-project');
const openCountEl = openSection?.querySelector('h2');

function applyTaskFilters() {
  if (!openSection) return;
  const project = projectFilterEl?.value || '';
  const soonCutoff = new Date(Date.now() + 7 * 86400000).toLocaleDateString('sv-SE');
  let visible = 0;
  openSection.querySelectorAll('.crm-task-row[data-task-status=open]').forEach(row => {
    const due = row.dataset.taskDue;
    const overdue = row.dataset.taskOverdue === '1';
    let show = true;
    if (activeFilter === 'overdue') show = overdue;
    else if (activeFilter === 'due-soon') show = Boolean(due) && !overdue && due <= soonCutoff;
    else if (activeFilter === 'high') show = row.dataset.taskPriority === 'high';
    else if (activeFilter === 'unsized') show = !due || !row.dataset.taskEffort;
    if (show && project === '__none__') show = !row.dataset.taskProject;
    else if (show && project) show = row.dataset.taskProject === project;
    row.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  if (openCountEl) {
    const total = openSection.querySelectorAll('.crm-task-row[data-task-status=open]').length;
    openCountEl.textContent = visible === total ? `Open (${total})` : `Open (${visible} of ${total})`;
  }
}

document.querySelectorAll('.task-filter').forEach(btn => {
  btn.addEventListener('click', () => {
    activeFilter = btn.dataset.filter;
    document.querySelectorAll('.task-filter').forEach(b => b.style.fontWeight = b === btn ? '600' : '');
    applyTaskFilters();
  });
});
projectFilterEl?.addEventListener('change', applyTaskFilters);

document.getElementById('task-sort')?.addEventListener('change', e => {
  const mode = e.target.value;
  const rows = [...openSection.querySelectorAll('.crm-task-row[data-task-status=open]')];
  rows.sort((a, b) => {
    if (mode === 'priority') return (PRIORITY_RANK[a.dataset.taskPriority] ?? 3) - (PRIORITY_RANK[b.dataset.taskPriority] ?? 3);
    if (mode === 'effort') return (parseInt(a.dataset.taskEffort, 10) || 9999) - (parseInt(b.dataset.taskEffort, 10) || 9999);
    if (mode === 'project') {
      const an = a.dataset.taskProjectName || 'zzz';
      const bn = b.dataset.taskProjectName || 'zzz';
      if (an !== bn) return an < bn ? -1 : 1;
      return (a.dataset.taskDue || '9999') < (b.dataset.taskDue || '9999') ? -1 : 1;
    }
    return (a.dataset.taskDue || '9999') < (b.dataset.taskDue || '9999') ? -1 : 1;
  });
  for (const row of rows) openSection.appendChild(row);
});
</script>
<%- include('partials/crm-foot') %>
