<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= activeProject ? '/' + activeProject.slug : (conv?.title || 'Chat') %> — McLellan Hub</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/atom-one-dark.min.css">
<link rel="stylesheet" href="/hub.modern.css?v=20260505">
</head>
<body>

<script>
  window.HUB_DATA = {
    user: '<%- locals.user || "" %>',
    activeProject: <%- JSON.stringify(locals.activeProject || null) %>,
    conv: <%- JSON.stringify(locals.conv || null) %>,
    messages: <%- JSON.stringify(locals.messages || []) %>,
    projects: <%- JSON.stringify(locals.projects || []) %>,
    recentConvs: <%- JSON.stringify(locals.recentConvs || []) %>,
    availableModels: <%- JSON.stringify(locals.availableModels || []) %>,
    projectDocs: <%- JSON.stringify(locals.projectDocs || []) %>,
    projectHistoryCount: <%- locals.projectHistoryCount || 0 %>,
    projectHistoryLoaded: <%- locals.projectHistoryLoaded || false %>,
  };
  window.CONV_ID = '<%- locals.convId || "" %>';
  window.PROJECT_SLUG = '<%- locals.activeProject?.slug || "" %>';
  window.TWEAK_DEFAULTS = {
    theme: 'light',
    accent: 'violet',
    density: 'comfortable',
    bubbles: 'mixed',
    font: 'manrope',
    displayFont: 'sans',
  };
</script>

<div id="root"></div>

<script src="https://cdn.jsdelivr.net/npm/marked@12.0.0/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/core.min.js"></script>
<script src="https://unpkg.com/react@18.3.1/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js"></script>
<script type="text/babel" src="/tweaks-panel.jsx?v=20260505"></script>
<script type="text/babel" src="/hub-modern.jsx?v=20260505"></script>

</body>
</html>
