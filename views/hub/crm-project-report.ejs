<%- include('partials/crm-head', { title: 'Project Report', active: 'project-report' }) %>

<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Projects</p>
    <h1>Project Report</h1>
    <p>Current synthesis across meetings, tasks, documents, emails, and derived knowledge.</p>
  </div>
</section>

<section class="section-card" style="margin-bottom:18px;">
  <form class="crm-form-grid" method="GET" action="/crm/project-report">
    <label>Project
      <select name="project" required>
        <option value="">Choose a project...</option>
        <% if ((crmProjects || []).length) { %>
          <optgroup label="CRM projects">
            <% for (const p of crmProjects) { %>
              <option value="<%= p.slug %>" <%= selectedSlug === p.slug ? 'selected' : '' %>><%= p.name %></option>
            <% } %>
          </optgroup>
        <% } %>
        <% if ((workspaceProjects || []).length) { %>
          <optgroup label="Chat workspaces">
            <% for (const p of workspaceProjects) { %>
              <option value="<%= p.slug %>" <%= selectedSlug === p.slug ? 'selected' : '' %>><%= p.name %> (workspace)</option>
            <% } %>
          </optgroup>
        <% } %>
      </select>
    </label>
    <label>Window
      <select name="days">
        <% [30, 60, 90, 180, 365].forEach(function(n){ %>
          <option value="<%= n %>" <%= days === n ? 'selected' : '' %>><%= n %> days</option>
        <% }); %>
      </select>
    </label>
    <button class="btn" type="submit">Generate report</button>
  </form>
  <% if (error && !report) { %>
    <p class="crm-muted" style="color:var(--crm-danger,#c0392b);margin-top:10px;"><%= error %></p>
  <% } %>
</section>

<% if (!project) { %>
  <section class="section-card">
    <p class="crm-muted" style="margin:0;"><%= projects.length ? 'Pick a CRM project or chat workspace to generate a report. Workspaces are labelled separately because they are not CRM projects yet.' : 'No projects or chat workspaces are available for reporting yet.' %></p>
  </section>
<% } %>

<% if (project) { %>
  <section class="section-card" style="margin-bottom:18px;">
    <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;">
      <h2 style="margin:0;font-size:15px;">Scheduled email</h2>
      <% if (reportSchedule && reportSchedule.enabled) { %>
        <span class="crm-badge">active: <%= reportSchedule.cadence.replace(':', ' ') %> · <%= reportSchedule.window_days %>d window<%= reportSchedule.last_run_at ? ` · last sent ${new Date(reportSchedule.last_run_at * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short' })}` : '' %></span>
      <% } %>
    </div>
    <form class="crm-inline-form" id="report-schedule-form" style="flex-wrap:wrap;margin-top:10px;">
      <input type="hidden" name="project" value="<%= project.slug %>">
      <select name="mode" id="sched-mode">
        <% const curMode = reportSchedule?.enabled ? reportSchedule.cadence.split(':')[0] : 'off'; %>
        <option value="off" <%= curMode === 'off' ? 'selected' : '' %>>No schedule</option>
        <option value="weekly" <%= curMode === 'weekly' ? 'selected' : '' %>>Weekly</option>
        <option value="monthly" <%= curMode === 'monthly' ? 'selected' : '' %>>Monthly</option>
      </select>
      <select name="day" id="sched-day-weekly" style="<%= curMode === 'weekly' ? '' : 'display:none;' %>">
        <% for (const [v, l] of [['mon','Monday'],['tue','Tuesday'],['wed','Wednesday'],['thu','Thursday'],['fri','Friday'],['sat','Saturday'],['sun','Sunday']]) { %>
          <option value="<%= v %>" <%= reportSchedule?.cadence === `weekly:${v}` ? 'selected' : '' %>><%= l %></option>
        <% } %>
      </select>
      <select id="sched-day-monthly" style="<%= curMode === 'monthly' ? '' : 'display:none;' %>">
        <% for (let d = 1; d <= 28; d++) { %>
          <option value="<%= d %>" <%= reportSchedule?.cadence === `monthly:${d}` ? 'selected' : '' %>>Day <%= d %></option>
        <% } %>
      </select>
      <select name="window_days">
        <% for (const n of [30, 60, 90]) { %>
          <option value="<%= n %>" <%= (reportSchedule?.window_days || 30) === n ? 'selected' : '' %>><%= n %>-day window</option>
        <% } %>
      </select>
      <button class="btn btn-sm" type="submit">Save schedule</button>
      <span class="crm-muted" id="report-schedule-msg" style="font-size:12px;"></span>
    </form>
  </section>
  <script>
  document.getElementById('sched-mode').addEventListener('change', e => {
    document.getElementById('sched-day-weekly').style.display = e.target.value === 'weekly' ? '' : 'none';
    document.getElementById('sched-day-monthly').style.display = e.target.value === 'monthly' ? '' : 'none';
  });
  document.getElementById('report-schedule-form').addEventListener('submit', async e => {
    e.preventDefault();
    const msg = document.getElementById('report-schedule-msg');
    const mode = document.getElementById('sched-mode').value;
    const day = mode === 'monthly' ? document.getElementById('sched-day-monthly').value : document.getElementById('sched-day-weekly').value;
    const data = Object.fromEntries(new FormData(e.target));
    data.day = day;
    msg.textContent = 'Saving…';
    try {
      const r = await fetch('/api/crm/project-report/schedule', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
      });
      const j = await r.json();
      msg.textContent = j.ok ? j.message : (j.error || 'Error');
      if (j.ok) setTimeout(() => location.reload(), 900);
    } catch (err) { msg.textContent = err.message; }
  });
  </script>
<% } %>

<% if (project && evidence) { %>
  <section class="section-card" style="margin-bottom:18px;">
    <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;">
      <div>
        <p class="crm-eyebrow" style="margin-bottom:4px;">/<%= project.slug %></p>
        <h2 style="margin:0;"><%= project.name %></h2>
        <% if (project.project_kind !== 'crm' && !(crmProjects || []).some(p => p.slug === project.slug)) { %>
          <p class="crm-muted" style="font-size:12px;margin:6px 0 0;">This is a chat workspace. The report may be thin until tasks, meetings, emails, or knowledge are linked to it.</p>
        <% } %>
        <% if (model) { %><p class="crm-muted" style="font-size:12px;margin:6px 0 0;">Generated with <%= model %><%= fallback ? ' — AI unavailable, showing evidence summary' : '' %></p><% } %>
        <% if (error && report) { %><p class="crm-muted" style="font-size:12px;color:var(--crm-danger,#c0392b);margin:6px 0 0;"><%= error %></p><% } %>
      </div>
      <div class="crm-badges">
        <span class="crm-badge subtle"><%= evidence.meetings.length %> meetings</span>
        <span class="crm-badge subtle"><%= evidence.tasks.filter(t => t.status === 'needsAction' && !t.deleted_at).length %> open tasks</span>
        <span class="crm-badge subtle"><%= evidence.tasks.filter(t => t.status === 'completed' && !t.deleted_at).length %> completed</span>
        <span class="crm-badge subtle"><%= evidence.atoms.length %> knowledge claims</span>
      </div>
    </div>
  </section>
<% } %>

<% if (report) { %>
  <%/* ── Narrative — the main story ──────────────────────────────────── */%>
  <section class="section-card" style="margin-bottom:18px;">
    <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:16px;">
      <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;">
        <h2 style="margin:0;"><%= report.headline || project.name %></h2>
        <span class="crm-badge"><%= report.status || 'unclear' %></span>
      </div>
      <button id="email-pdf-btn" class="btn" style="font-size:13px;padding:6px 14px;white-space:nowrap;" onclick="emailReport(this)">Email PDF</button>
    </div>
    <% if (report.narrative) { %>
      <div style="font-size:15px;line-height:1.75;color:var(--crm-text,inherit);">
        <% report.narrative.split(/\n\n+/).filter(p => p.trim()).forEach(function(para) { %>
          <p style="margin:0 0 1em;"><%= para.trim() %></p>
        <% }); %>
      </div>
    <% } else if (report.summary) { %>
      <p style="font-size:15px;line-height:1.75;margin:0;"><%= report.summary %></p>
    <% } %>
  </section>

  <%/* ── Next actions — surfaced prominently ─────────────────────────── */%>
  <% const actions = report.next_actions || []; %>
  <% if (actions.length) { %>
  <section class="section-card" style="margin-bottom:18px;">
    <h2 style="margin-bottom:12px;">Next actions</h2>
    <% for (const item of actions) { %>
      <div class="crm-action" style="display:flex;align-items:flex-start;gap:10px;padding:8px 0;border-bottom:1px solid var(--crm-border,#eee);">
        <span style="color:var(--crm-accent,#0070c9);font-size:14px;margin-top:2px;">→</span>
        <span style="font-size:14px;line-height:1.5;"><%= item %></span>
      </div>
    <% } %>
  </section>
  <% } %>

  <%/* ── Supporting detail grid ───────────────────────────────────────── */%>
  <div class="crm-two-col">
    <div class="crm-stack">
      <section class="section-card">
        <h2>Tasks</h2>
        <% const tasks = report.tasks || []; %>
        <% if (!tasks.length) { %><p class="crm-muted">No task signal in the report.</p><% } %>
        <% for (const item of tasks) { %><div class="crm-action" style="padding:6px 0;border-bottom:1px solid var(--crm-border,#eee);"><span style="font-size:13px;"><%= item %></span></div><% } %>
      </section>

      <section class="section-card">
        <h2>Meetings</h2>
        <% const meetings = report.meetings || []; %>
        <% if (!meetings.length) { %><p class="crm-muted">No meeting signal in the report.</p><% } %>
        <% for (const item of meetings) { %><div class="crm-action" style="padding:6px 0;border-bottom:1px solid var(--crm-border,#eee);"><span style="font-size:13px;"><%= item %></span></div><% } %>
      </section>
    </div>

    <div class="crm-stack">
      <section class="section-card">
        <h2>Timeline</h2>
        <% const timeline = report.timeline || []; %>
        <% if (!timeline.length) { %><p class="crm-muted">No timeline signal in the report.</p><% } %>
        <% for (const item of timeline) { %><div class="crm-action" style="padding:6px 0;border-bottom:1px solid var(--crm-border,#eee);"><span style="font-size:13px;"><%= item %></span></div><% } %>
      </section>

      <section class="section-card">
        <h2>Risks & gaps</h2>
        <% const risks = report.risks || []; %>
        <% if (!risks.length) { %><p class="crm-muted">No specific risks identified.</p><% } %>
        <% for (const item of risks) { %><div class="crm-action" style="padding:6px 0;border-bottom:1px solid var(--crm-border,#eee);"><span style="font-size:13px;"><%= item %></span></div><% } %>
      </section>
    </div>
  </div>
<% } %>

<% if (evidence) { %>
  <section class="section-card" style="margin-top:18px;">
    <h2 style="margin-bottom:4px;">Evidence read</h2>
    <p class="crm-muted" style="font-size:12px;margin:0 0 12px;">Everything the report generator was given. Expand a section to audit exactly what was included and why.</p>
    <details style="margin-bottom:10px;">
      <summary style="cursor:pointer;font-size:14px;font-weight:600;">Meetings (<%= evidence.meetings.length %>)</summary>
      <% for (const m of evidence.meetings) { %>
        <div class="crm-action" style="padding:6px 0;">
          <a href="/crm/meeting/<%= m.id %>" style="font-size:13px;"><%= m.meeting_date %> · <%= m.title %></a>
          <span class="crm-badge subtle" title="How this meeting was linked to the project"><%= m.link_kind === 'direct' ? 'direct link' : m.link_kind === 'company' ? 'via company' : 'via attendee' %></span>
        </div>
      <% } %>
      <% if (!evidence.meetings.length) { %><p class="crm-muted">None found.</p><% } %>
    </details>
    <details style="margin-bottom:10px;">
      <% const openEv = evidence.tasks.filter(t => t.status === 'needsAction' && !t.deleted_at); %>
      <% const doneEv = evidence.tasks.filter(t => t.status === 'completed' && !t.deleted_at); %>
      <summary style="cursor:pointer;font-size:14px;font-weight:600;">Tasks (<%= openEv.length %> open · <%= doneEv.length %> completed)</summary>
      <% for (const t of [...openEv, ...doneEv]) { %>
        <div class="crm-action" style="padding:6px 0;">
          <a href="/crm/tasks/<%= t.id %>" style="font-size:13px;<%= t.status === 'completed' ? 'text-decoration:line-through;opacity:.6;' : '' %>"><%= t.title %></a>
          <span class="crm-muted" style="font-size:12px;"><%= t.due ? 'due ' + String(t.due).slice(0,10) : '' %></span>
        </div>
      <% } %>
      <% if (!evidence.tasks.length) { %><p class="crm-muted">None found.</p><% } %>
    </details>
    <details style="margin-bottom:10px;">
      <summary style="cursor:pointer;font-size:14px;font-weight:600;">Emails (<%= evidence.emails.length %>)</summary>
      <% for (const e of evidence.emails) { %>
        <p class="crm-muted" style="margin:6px 0 0;font-size:12px;"><%= e.subject %> — <%= e.from_name || e.from_email || 'unknown' %></p>
      <% } %>
      <% if (!evidence.emails.length) { %><p class="crm-muted">None found.</p><% } %>
    </details>
    <details style="margin-bottom:10px;">
      <summary style="cursor:pointer;font-size:14px;font-weight:600;">Documents (<%= evidence.docs.length %>)</summary>
      <% for (const d of evidence.docs) { %>
        <p class="crm-muted" style="margin:6px 0 0;font-size:12px;"><%= d.filename %></p>
      <% } %>
      <% if (!evidence.docs.length) { %><p class="crm-muted">None found.</p><% } %>
    </details>
    <details>
      <summary style="cursor:pointer;font-size:14px;font-weight:600;">Knowledge claims (<%= evidence.atoms.length %>)</summary>
      <% for (const a of evidence.atoms) { %>
        <p class="crm-muted" style="margin:6px 0 0;font-size:12px;<%= a.status !== 'active' ? 'opacity:.55;' : '' %>"><%= a.predicate.replace(/_/g, ' ') %>: <%= a.value %> · <%= Math.round(a.confidence * 100) %>%<%= a.status !== 'active' ? ' · ' + a.status : '' %></p>
      <% } %>
      <% if (!evidence.atoms.length) { %><p class="crm-muted">None found — run a synthesis job to build knowledge for this project.</p><% } %>
    </details>
  </section>
<% } %>

<% if (project && report) { %>
<script>
async function emailReport(btn) {
  btn.disabled = true;
  btn.textContent = 'Generating PDF…';
  try {
    const resp = await fetch('/crm/project-report/email', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ project: '<%= selectedSlug %>', days: '<%= days %>' }),
    });
    const data = await resp.json();
    if (data.ok) {
      btn.textContent = '✓ Sent';
      btn.style.background = 'var(--crm-success, #22c55e)';
    } else {
      btn.textContent = 'Failed';
      btn.style.background = 'var(--crm-danger, #ef4444)';
      alert('Could not send: ' + data.error);
    }
  } catch (err) {
    btn.textContent = 'Error';
    alert(err.message);
  }
}
</script>
<% } %>

<%- include('partials/crm-foot') %>
