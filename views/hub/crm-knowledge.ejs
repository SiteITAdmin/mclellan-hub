<%- include('partials/crm-head', { title: 'Ask the Hub', active: 'ask-the-hub' }) %>

<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Knowledge</p>
    <h1>Ask the Hub</h1>
    <p>Free-form questions answered from atoms, patterns, and derived knowledge across every entity.</p>
  </div>
</section>

<section class="section-card" style="margin-bottom:18px;">
  <form method="GET" action="/crm/knowledge" style="display:flex;gap:10px;align-items:flex-start;">
    <input
      type="text"
      name="q"
      value="<%= query %>"
      placeholder="e.g. How many tasks came via meetings with H30? What patterns keep recurring across projects?"
      style="flex:1;padding:10px 14px;font-size:14px;border:1px solid var(--crm-border,#ddd);border-radius:6px;background:var(--crm-input-bg,#fff);color:var(--crm-text,inherit);"
      autofocus
    />
    <button class="btn" type="submit" style="white-space:nowrap;">Ask</button>
    <a class="btn btn-ghost" href="/crm/knowledge<%= browse ? '' : '?browse=1' %>" style="white-space:nowrap;"><%= browse ? 'Hide browser' : 'Browse atoms' %></a>
  </form>
  <% if (error) { %>
    <p class="crm-muted" style="color:var(--crm-danger,#c0392b);margin-top:10px;font-size:13px;"><%= error %></p>
  <% } %>
</section>

<section class="section-card" style="margin-bottom:18px;">
  <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;">
    <h2 style="margin:0;font-size:15px;">Knowledge engine</h2>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <% if (health.duplicateEmails) { %><span class="crm-badge" style="color:#b8860b;border-color:currentColor;" title="Contacts sharing an email address"><%= health.duplicateEmails %> duplicate email<%= health.duplicateEmails === 1 ? '' : 's' %></span><% } %>
      <% if (health.orphanFacts) { %><span class="crm-badge" style="color:var(--crm-danger,#c0392b);border-color:currentColor;" title="Facts whose contact no longer exists"><%= health.orphanFacts %> orphaned fact<%= health.orphanFacts === 1 ? '' : 's' %></span><% } %>
      <% if (health.staleAtoms) { %><span class="crm-badge subtle"><%= health.staleAtoms %> stale atom<%= health.staleAtoms === 1 ? '' : 's' %></span><% } %>
      <% if (health.disputedAtoms) { %><span class="crm-badge subtle"><%= health.disputedAtoms %> disputed</span><% } %>
      <button class="btn btn-sm" id="engine-run-btn">Process sources now</button>
      <% if (engineErrorSourceCount > 0) { %><button class="btn btn-sm btn-ghost" id="engine-retry-btn">Retry 8 errors</button><% } %>
      <span class="crm-muted" id="engine-run-msg" style="font-size:12px;"></span>
    </div>
  </div>
  <% if (engineStages.length) { %>
    <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:10px;">
      <% for (const s of engineStages) { %>
        <span style="font-size:12px;" class="crm-muted">
          <strong style="color:var(--crm-text,inherit);"><%= s.label %></strong>
          · last <%= new Date(s.last_at * 1000).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit', timeZone:'Europe/Dublin' }) %>
          · <%= s.total %> sources
          · <span style="color:var(--crm-success,#287a4b);"><%= s.processed %> processed</span>
          <% if (s.skipped > 0) { %> · <%= s.skipped %> skipped<% } %>
          <% if (s.warnings > 0) { %> · <span style="color:#b8860b;"><%= s.warnings %> warning<%= s.warnings === 1 ? '' : 's' %></span><% } %>
          <% if (s.errors > 0) { %> · <span style="color:var(--crm-danger,#c0392b);"><%= s.errors %> error<%= s.errors === 1 ? '' : 's' %></span><% } %>
        </span>
      <% } %>
    </div>
  <% } else { %>
    <p class="crm-muted" style="font-size:12px;margin:10px 0 0;">No receipts yet — the engine has not processed any sources for this account.</p>
  <% } %>
  <% if (engineCoverage) { %>
    <p class="crm-muted" style="font-size:12px;margin:10px 0 0;">
      Current-version coverage: <strong style="color:var(--crm-text,inherit);"><%= engineCoverage.completed %>/<%= engineCoverage.eligible %></strong> complete (<%= engineCoverage.coveragePercent %>%)
      <% if (engineCoverage.incomplete) { %> · <span style="color:#b8860b;"><%= engineCoverage.incomplete %> incomplete</span><% } %>
      <% if (engineCoverage.review) { %> · <span style="color:#b8860b;"><%= engineCoverage.review %> review</span><% } %>
      <% if (engineCoverage.errors) { %> · <span style="color:var(--crm-danger,#c0392b);"><%= engineCoverage.errors %> error</span><% } %>
    </p>
  <% } %>
  <% if (engineErrorSourceCount > 0) { %>
    <details style="margin-top:12px;">
      <summary style="cursor:pointer;font-size:12px;color:var(--crm-danger,#c0392b);"><%= engineErrorSourceCount %> source<%= engineErrorSourceCount === 1 ? '' : 's' %> currently have an errored stage</summary>
      <div style="margin-top:8px;display:grid;gap:7px;">
        <% for (const failure of engineErrors) { %>
          <div style="font-size:12px;padding:7px 9px;border-left:3px solid var(--crm-danger,#c0392b);background:var(--crm-subtle-bg,rgba(0,0,0,.025));">
            <strong><%= failure.stage.replace(/^crm_/,'').replace(/_/g,' ') %></strong>
            · <%= failure.source_kind.replace(/_/g,' ') %>
            · <%= new Date(failure.created_at * 1000).toLocaleString('en-GB', { day:'numeric', month:'short', year:'numeric', timeZone:'Europe/Dublin' }) %>
            <div class="crm-muted" style="margin-top:2px;"><%= failure.summary || 'No error detail recorded.' %></div>
          </div>
        <% } %>
        <% if (engineErrorSourceCount > engineErrors.length) { %><div class="crm-muted" style="font-size:11px;">Showing the 12 most recent errored stages.</div><% } %>
      </div>
    </details>
  <% } %>
</section>

<% if (actionOutcomeQueue && actionOutcomeQueue.length) { %>
<section class="section-card" style="margin-bottom:18px;">
  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;flex-wrap:wrap;">
    <h2 style="margin:0;font-size:15px;">Knowledge and action review queue</h2>
    <span class="crm-muted" style="font-size:12px;"><%= actionOutcomeQueue.length %> visible outcome<%= actionOutcomeQueue.length === 1 ? '' : 's' %></span>
  </div>
  <p class="crm-muted" style="font-size:12px;margin:8px 0 10px;">Each item is tied to an exact source span and current source revision. Review items can create one stable, replay-safe task; an unreconciled provider call is deliberately non-creatable until its task or calendar state is reconciled.</p>
  <div style="display:grid;gap:8px;">
    <% for (const outcome of actionOutcomeQueue) { %>
      <% const nonCreatable = Boolean(outcome.payload && outcome.payload.non_creatable); %>
      <% const requiresReconciliation = Boolean(outcome.payload && outcome.payload.side_effect_ambiguity?.requires_reconciliation); %>
      <% const sourceStage = String(outcome.payload?.source_stage || ''); %>
      <% const duplicateReviewGate = Boolean(outcome.payload?.source_level && (
        sourceStage.startsWith('duplicate_')
        || Boolean(outcome.payload?.synthesis_gate)
        || Boolean(outcome.payload?.duplicate_review_error)
        || /^duplicate_review_|^supersession_/.test(String(outcome.reason || ''))
      )); %>
      <article style="padding:10px;border-left:3px solid <%= outcome.disposition === 'error' ? 'var(--crm-danger,#c0392b)' : '#b8860b' %>;background:var(--crm-subtle-bg,rgba(0,0,0,.025));">
        <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap;">
          <div>
            <strong style="font-size:13px;"><%= outcome.candidate_title || 'Malformed action candidate' %></strong>
            <span class="crm-badge subtle" style="margin-left:5px;"><%= outcome.disposition.replace(/_/g, ' ') %></span>
            <div class="crm-muted" style="font-size:11px;margin-top:3px;">
              <a href="/crm/source/<%= outcome.source_kind %>/<%= outcome.source_id %>"><%= outcome.source_kind.replace(/_/g, ' ') %> evidence</a>
              · revision <%= String(outcome.source_revision || '').slice(0, 12) %>
              · <%= outcome.reason || 'No reason recorded' %>
            </div>
          </div>
          <div style="display:flex;gap:6px;">
            <% if (duplicateReviewGate && (outcome.disposition === 'review' || outcome.disposition === 'error')) { %>
              <button class="btn btn-sm duplicate-review-action" data-outcome="<%= outcome.id %>" data-action="skip">Skip atom synthesis</button>
              <button class="btn btn-sm btn-ghost duplicate-review-action" data-outcome="<%= outcome.id %>" data-action="retry">Re-run duplicate review</button>
            <% } else if (outcome.disposition === 'review' && !nonCreatable) { %>
              <button class="btn btn-sm outcome-action" data-outcome="<%= outcome.id %>" data-action="accept">Create task</button>
            <% } %>
            <% if (!duplicateReviewGate && (outcome.disposition === 'review' || outcome.disposition === 'error')) { %>
              <button class="btn btn-sm btn-ghost outcome-action" data-outcome="<%= outcome.id %>" data-action="dismiss">Dismiss</button>
            <% } %>
          </div>
        </div>
        <% if (requiresReconciliation) { %>
          <div class="crm-muted" style="font-size:12px;margin-top:7px;">Provider reconciliation required: the prior task or calendar call may have succeeded, so creating another one is blocked.</div>
        <% } else if (duplicateReviewGate) { %>
          <div class="crm-muted" style="font-size:12px;margin-top:7px;">This is a source-level duplicate/supersession decision. Skip records an audited terminal synthesis skip; re-run asks the duplicate reviewer about this source only.</div>
        <% } else if (nonCreatable) { %>
          <div class="crm-muted" style="font-size:12px;margin-top:7px;">This review is evidence-only and cannot create a task.</div>
        <% } %>
        <% if (outcome.evidence_text) { %>
          <blockquote style="margin:8px 0 0;padding-left:9px;border-left:2px solid var(--crm-border,#ddd);font-size:12px;line-height:1.45;white-space:pre-wrap;"><%= outcome.evidence_text %></blockquote>
        <% } %>
      </article>
    <% } %>
  </div>
</section>
<% } %>

<% if (browse) { %>
<section class="section-card" style="margin-bottom:18px;">
  <h2 style="margin-bottom:10px;">Browse the knowledge base</h2>
  <form method="GET" action="/crm/knowledge" class="crm-inline-form" style="flex-wrap:wrap;margin-bottom:14px;">
    <input type="hidden" name="browse" value="1">
    <select name="kind">
      <option value="">All subjects</option>
      <% for (const k of ['contact','company','project','document']) { %>
        <option value="<%= k %>" <%= browseFilters.kind === k ? 'selected' : '' %>><%= k %></option>
      <% } %>
    </select>
    <select name="status">
      <option value="">Any status (except retired)</option>
      <% for (const st of ['active','proposed','stale','disputed']) { %>
        <option value="<%= st %>" <%= browseFilters.status === st ? 'selected' : '' %>><%= st %></option>
      <% } %>
    </select>
    <select name="minconf">
      <option value="">Any confidence</option>
      <% for (const c of [0.5, 0.7, 0.9]) { %>
        <option value="<%= c %>" <%= browseFilters.minConf === c ? 'selected' : '' %>>≥ <%= Math.round(c * 100) %>%</option>
      <% } %>
    </select>
    <button class="btn btn-sm" type="submit">Filter</button>
  </form>
  <% const predicates = Object.keys(browseAtoms || {}); %>
  <% if (!predicates.length) { %><p class="crm-muted">No atoms match these filters.</p><% } %>
  <% for (const pred of predicates) { %>
    <div style="margin-bottom:12px;">
      <div style="font-size:11px;text-transform:uppercase;letter-spacing:.04em;opacity:.55;margin-bottom:3px;"><%= pred.replace(/_/g,' ') %> (<%= browseAtoms[pred].length %>)</div>
      <% for (const a of browseAtoms[pred]) { %>
        <div style="display:flex;justify-content:space-between;gap:8px;align-items:baseline;padding:4px 0;border-bottom:1px solid var(--border,#eee);" id="atom-row-<%= a.id %>">
          <span style="font-size:13px;<%= ['stale','disputed'].includes(a.status) ? 'opacity:.55;' : '' %>">
            <% if (a.subject_kind === 'contact' && a.subject_id) { %><a href="/crm/contact/<%= a.subject_id %>"><strong><%= a.subject_label %></strong></a><% } else if (a.subject_kind === 'company' && a.subject_id) { %><a href="/crm/company/<%= a.subject_id %>"><strong><%= a.subject_label %></strong></a><% } else { %><strong><%= a.subject_label %></strong><% } %>
            — <%= a.value %>
            <% if (a.status !== 'active') { %><span style="font-size:10px;opacity:.7;">· <%= a.status %></span><% } %>
          </span>
          <span style="font-size:11px;white-space:nowrap;display:inline-flex;gap:6px;align-items:baseline;">
            <span style="opacity:.5;"><%= Math.round(a.confidence * 100) %>%</span>
            <% if (a.status === 'active' || a.status === 'proposed') { %>
              <button class="crm-fact-archive atom-action" data-atom="<%= a.id %>" data-action="stale" title="No longer current — synthesis will re-check it">stale</button>
              <button class="crm-fact-archive atom-action" data-atom="<%= a.id %>" data-action="dispute" style="color:var(--crm-danger,#c0392b);" title="This is wrong — synthesis will re-weigh it">dispute</button>
            <% } else { %>
              <button class="crm-fact-archive atom-action" data-atom="<%= a.id %>" data-action="restore" title="Restore to active">restore</button>
            <% } %>
          </span>
        </div>
      <% } %>
    </div>
  <% } %>
</section>
<% } %>

<% if (result) { %>
  <section class="section-card" style="margin-bottom:18px;">
    <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;margin-bottom:14px;">
      <h2 style="margin:0;font-size:16px;color:var(--crm-muted-text,#666);">Answer</h2>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <% if (result.atomsUsed) { %><span class="crm-badge subtle"><%= result.atomsUsed %> atoms</span><% } %>
        <% if (result.semanticHits) { %><span class="crm-badge subtle"><%= result.semanticHits %> semantic hits</span><% } %>
        <% if (result.insightsUsed) { %><span class="crm-badge subtle"><%= result.insightsUsed %> insights</span><% } %>
        <% if (result.model) { %><span class="crm-badge subtle"><%= result.model %></span><% } %>
      </div>
    </div>
    <div style="font-size:15px;line-height:1.75;color:var(--crm-text,inherit);">
      <% (result.answer || '').split(/\n\n+/).filter(p => p.trim()).forEach(function(para) { %>
        <p style="margin:0 0 1em;"><%= para.trim() %></p>
      <% }); %>
    </div>
  </section>
<% } %>

<% if (!query) { %>
  <%/* ── Show insight atoms when no query is active ── */%>
  <% if (insights.length) { %>
    <section class="section-card" style="margin-bottom:18px;">
      <h2 style="margin-bottom:14px;">Cross-entity insights</h2>
      <p class="crm-muted" style="font-size:13px;margin-bottom:16px;">Patterns, workflow opportunities, and connections spotted across the full knowledge graph by the nightly synthesis job.</p>
      <div class="crm-stack">
        <% for (const ins of insights) { %>
          <div style="padding:12px 0;border-bottom:1px solid var(--crm-border,#eee);">
            <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:4px;">
              <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--crm-accent,#7c6af5);"><%= ins.predicate %></span>
              <span style="font-size:14px;font-weight:600;"><%= ins.subject_label %></span>
              <span class="crm-badge subtle" style="font-size:11px;"><%= Math.round(ins.confidence * 100) %>%</span>
            </div>
            <p style="font-size:13px;line-height:1.6;color:var(--crm-text,inherit);margin:0;"><%= ins.value %></p>
          </div>
        <% } %>
      </div>
    </section>
  <% } else { %>
    <section class="section-card">
      <h2 style="margin-bottom:10px;">Cross-entity insights</h2>
      <p class="crm-muted">No insights yet — the cross-entity synthesis job runs nightly and will populate patterns here once it has run. You can trigger it manually from the admin jobs queue.</p>
    </section>
  <% } %>

  <section class="section-card" style="margin-top:18px;">
    <h2 style="margin-bottom:10px;">What can you ask?</h2>
    <div class="crm-card-grid">
      <div class="mgmt-card">
        <div class="crm-card-title">Across entities</div>
        <p class="crm-muted" style="font-size:12px;margin-top:6px;">How many tasks came via meetings with H30?</p>
        <p class="crm-muted" style="font-size:12px;margin-top:4px;">Which contacts appear in both CRM projects and care context?</p>
        <p class="crm-muted" style="font-size:12px;margin-top:4px;">What topics keep recurring across different projects?</p>
      </div>
      <div class="mgmt-card">
        <div class="crm-card-title">Patterns & workflows</div>
        <p class="crm-muted" style="font-size:12px;margin-top:6px;">What repetitive tasks could be systemised?</p>
        <p class="crm-muted" style="font-size:12px;margin-top:4px;">What are the most common blockers across projects?</p>
        <p class="crm-muted" style="font-size:12px;margin-top:4px;">Where is knowledge thin and needs more ingest?</p>
      </div>
      <div class="mgmt-card">
        <div class="crm-card-title">Connections</div>
        <p class="crm-muted" style="font-size:12px;margin-top:6px;">What does the system know about [person or company]?</p>
        <p class="crm-muted" style="font-size:12px;margin-top:4px;">How is [contact] connected to [project]?</p>
        <p class="crm-muted" style="font-size:12px;margin-top:4px;">What happened with [topic] across all contexts?</p>
      </div>
    </div>
  </section>
<% } %>

<script>
document.getElementById('engine-run-btn').addEventListener('click', async e => {
  const msg = document.getElementById('engine-run-msg');
  e.target.disabled = true;
  msg.textContent = 'Starting…';
  try {
    const r = await fetch('/api/crm/knowledge/run', { method: 'POST' });
    const j = await r.json();
    msg.textContent = j.ok ? j.message : (j.error || 'Error');
  } catch (err) { msg.textContent = err.message; e.target.disabled = false; }
});

document.getElementById('engine-retry-btn')?.addEventListener('click', async e => {
  const msg = document.getElementById('engine-run-msg');
  e.target.disabled = true;
  msg.textContent = 'Starting retry batch…';
  try {
    const r = await fetch('/api/crm/knowledge/retry-errors', { method: 'POST' });
    const j = await r.json();
    msg.textContent = j.ok ? `${j.message} Refresh in a minute to see the new outcomes.` : (j.error || 'Error');
    if (!j.ok) e.target.disabled = false;
  } catch (err) { msg.textContent = err.message; e.target.disabled = false; }
});

document.querySelectorAll('.outcome-action').forEach(btn => {
  btn.addEventListener('click', async () => {
    const action = btn.dataset.action;
    if (action === 'dismiss' && !confirm('Dismiss this source-backed outcome?')) return;
    btn.disabled = true;
    try {
      const r = await fetch(`/api/crm/knowledge/actions/${btn.dataset.outcome}/${action}`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: action === 'dismiss' ? JSON.stringify({ reason: 'dismissed from knowledge queue' }) : '{}',
      });
      const j = await r.json();
      if (j.ok) location.reload();
      else { btn.disabled = false; alert(j.error || 'Error'); }
    } catch (err) { btn.disabled = false; alert(err.message); }
  });
});

document.querySelectorAll('.duplicate-review-action').forEach(btn => {
  btn.addEventListener('click', async () => {
    const action = btn.dataset.action;
    const prompt = action === 'skip'
      ? 'Skip atom synthesis for this source? The source evidence remains intact and this decision is recorded.'
      : 'Re-run duplicate/supersession review for this source only?';
    if (!confirm(prompt)) return;
    btn.disabled = true;
    try {
      const r = await fetch(`/api/crm/knowledge/duplicate-review/${btn.dataset.outcome}/${action}`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}',
      });
      const j = await r.json();
      if (j.ok) location.reload();
      else { btn.disabled = false; alert(j.error || 'Error'); }
    } catch (err) { btn.disabled = false; alert(err.message); }
  });
});

document.querySelectorAll('.atom-action').forEach(btn => {
  btn.addEventListener('click', async () => {
    const action = btn.dataset.action;
    let reason = '';
    if (action === 'dispute') {
      reason = prompt('Why is this wrong? (optional — helps the synthesis re-weigh it)') || '';
    }
    btn.disabled = true;
    const r = await fetch(`/api/crm/atoms/${btn.dataset.atom}/${action}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason }),
    });
    const j = await r.json();
    if (j.ok) location.reload();
    else { btn.disabled = false; alert(j.error || 'Error'); }
  });
});
</script>
<%- include('partials/crm-foot') %>
