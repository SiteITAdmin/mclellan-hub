<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>McLellan Hub — Sign in</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/hub.modern.css?v=20260505">
<style>
  html, body {
    height: 100%;
    margin: 0;
    background: var(--bg);
    font-family: var(--font-ui, 'Manrope', system-ui, sans-serif);
    color: var(--text);
  }
  .login-wrap {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .login-card {
    width: 100%;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .login-mark {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--accent, #7c6af5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--accent, #7c6af5) 35%, transparent);
  }
  .login-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.4px;
    color: var(--text);
    margin: 0 0 6px;
  }
  .login-sub {
    font-size: 14px;
    color: var(--text-3);
    margin: 0 0 28px;
    text-align: center;
  }
  .login-error {
    width: 100%;
    background: color-mix(in srgb, #e74c3c 12%, transparent);
    border: 1px solid color-mix(in srgb, #e74c3c 30%, transparent);
    color: #c0392b;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    margin-bottom: 16px;
    text-align: center;
    box-sizing: border-box;
  }
  .login-google-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 13px 20px;
    border-radius: 12px;
    background: var(--accent, #7c6af5);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    text-decoration: none;
    box-shadow: 0 2px 12px color-mix(in srgb, var(--accent, #7c6af5) 30%, transparent);
    transition: opacity 0.15s, transform 0.1s;
    box-sizing: border-box;
  }
  .login-google-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
  .login-google-btn:active {
    opacity: 1;
    transform: none;
  }
  .login-google-icon {
    flex-shrink: 0;
  }
  .login-footer {
    margin-top: 20px;
    font-size: 12px;
    color: var(--text-3);
    text-align: center;
  }
</style>
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <div class="login-mark">M</div>
    <h1 class="login-title">McLellan Hub</h1>
    <p class="login-sub"><%= locals.user || 'Your personal AI workspace' %></p>

    <% if (locals.error) { %>
    <div class="login-error"><%= error %></div>
    <% } %>

    <a class="login-google-btn" href="/auth/google">
      <svg class="login-google-icon" width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="rgba(255,255,255,0.9)"/>
        <path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.859-3.048.859-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="rgba(255,255,255,0.9)"/>
        <path d="M3.964 10.705A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.705V4.963H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.037l3.007-2.332z" fill="rgba(255,255,255,0.9)"/>
        <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.963L3.964 7.295C4.672 5.163 6.656 3.58 9 3.58z" fill="rgba(255,255,255,0.9)"/>
      </svg>
      Sign in with Google
    </a>

    <p class="login-footer">Access restricted to authorised accounts.</p>
  </div>
</div>
</body>
</html>
