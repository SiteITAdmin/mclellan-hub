<%- include('partials/crm-head', { title: 'Planner', active: 'planner' }) %>
<% const minuteOf = value => { const [h, m] = String(value || '00:00').split(':').map(Number); return h * 60 + m; }; %>
<% const preferences = snapshot.preferences; %>
<% const preferenceStarts = [preferences.workStart, preferences.eveningStart, preferences.weekendStart].map(minuteOf); %>
<% const preferenceEnds = [preferences.workEnd, preferences.eveningEnd, preferences.weekendEnd].map(minuteOf); %>
<% const viewStartMinutes = Math.max(0, Math.floor((Math.min(...preferenceStarts) - 60) / 60) * 60); %>
<% const viewEndMinutes = Math.min(24 * 60, Math.ceil((Math.max(...preferenceEnds) + 60) / 60) * 60); %>
<% const viewMinutes = viewEndMinutes - viewStartMinutes; %>
<% const minuteScale = 1.5; %>

<section class="crm-hero planner-hero">
  <div>
    <p class="crm-eyebrow">Tasks × Google Calendar</p>
    <h1>Plan the week</h1>
    <p>Check “Planner” on a CRM task, then drag it into free time. Work stays in working hours; personal tasks stay in evenings or weekends.</p>
  </div>
  <div class="planner-week-nav" aria-label="Change week">
    <a class="btn btn-sm btn-ghost" href="/api/planner/print-today" target="_blank" rel="noopener">Print today</a>
    <a class="btn btn-sm btn-ghost" href="/crm/planner?start=<%= previousStart %>" aria-label="Previous week">←</a>
    <a class="btn btn-sm btn-ghost" href="/crm/planner?start=<%= todayStart %>">Today</a>
    <a class="btn btn-sm btn-ghost" href="/crm/planner?start=<%= nextStart %>" aria-label="Next week">→</a>
  </div>
</section>

<% if (taskSyncError || calendarError) { %>
  <div class="crm-notice planner-warning" role="alert">
    <% if (taskSyncError) { %><div>Google Tasks could not refresh: <%= taskSyncError %>. Cached tasks are shown.</div><% } %>
    <% if (calendarError) { %><div>Google Calendar could not load: <%= calendarError %>. <a href="/auth/google">Reconnect Google</a> before scheduling.</div><% } %>
  </div>
<% } %>

<% if (snapshot.lastReflow && (snapshot.lastReflow.moved?.length || snapshot.lastReflow.unplaced?.length || snapshot.lastReflow.failed?.length)) { %>
  <div class="crm-notice planner-reflow-notice" role="status">
    <% if (snapshot.lastReflow.moved?.length) { %>
      <strong>Calendar changed:</strong> moved <%= snapshot.lastReflow.moved.length %> task<%= snapshot.lastReflow.moved.length === 1 ? '' : 's' %> to the next free time.
      <span><%= snapshot.lastReflow.moved.map(item => item.title).join(' · ') %></span>
    <% } %>
    <% if (snapshot.lastReflow.unplaced?.length || snapshot.lastReflow.failed?.length) { %>
      <strong><%= (snapshot.lastReflow.unplaced?.length || 0) + (snapshot.lastReflow.failed?.length || 0) %> task<%= ((snapshot.lastReflow.unplaced?.length || 0) + (snapshot.lastReflow.failed?.length || 0)) === 1 ? '' : 's' %> still need attention.</strong>
    <% } %>
  </div>
<% } %>

<section class="planner-toolbar section-card" aria-label="Automatic planning controls">
  <div class="planner-toolbar-copy">
    <strong><%= snapshot.unscheduledTasks.length %> to place</strong>
    <span><%= snapshot.scheduledCount %> already scheduled</span>
  </div>
  <fieldset class="planner-hours-group">
    <legend>Work · Mon–Fri</legend>
    <label>Start<input id="planner-work-start" type="time" value="<%= preferences.workStart %>" step="900"></label>
    <label>Finish<input id="planner-work-end" type="time" value="<%= preferences.workEnd %>" step="900"></label>
  </fieldset>
  <fieldset class="planner-hours-group">
    <legend>Personal · evenings</legend>
    <label>Start<input id="planner-evening-start" type="time" value="<%= preferences.eveningStart %>" step="900"></label>
    <label>Finish<input id="planner-evening-end" type="time" value="<%= preferences.eveningEnd %>" step="900"></label>
  </fieldset>
  <fieldset class="planner-hours-group">
    <legend>Personal · weekends</legend>
    <label>Start<input id="planner-weekend-start" type="time" value="<%= preferences.weekendStart %>" step="900"></label>
    <label>Finish<input id="planner-weekend-end" type="time" value="<%= preferences.weekendEnd %>" step="900"></label>
  </fieldset>
  <div class="planner-toolbar-actions">
    <button class="btn btn-sm btn-ghost" id="planner-save-hours" type="button">Save hours</button>
    <button class="btn btn-ghost" id="planner-reshuffle" type="button" <%= calendarError ? 'disabled' : '' %>>Reshuffle · fill free time</button>
    <button class="btn" id="planner-auto" type="button" <%= calendarError || !snapshot.unscheduledTasks.length ? 'disabled' : '' %>>Auto-plan selected tasks</button>
  </div>
</section>

<div class="planner-shell">
  <aside class="planner-inbox section-card" aria-label="Unscheduled tasks">
    <div class="planner-inbox-head">
      <div>
        <p class="crm-eyebrow">Task inbox</p>
        <h2>Unscheduled</h2>
      </div>
      <span class="planner-count"><%= snapshot.unscheduledTasks.length %></span>
    </div>
    <p class="planner-instruction">Only tasks checked for Planner appear here. Effort sets the block length; every new task defaults to 30 minutes.</p>
    <div class="planner-task-list">
      <% if (!snapshot.unscheduledTasks.length) { %>
        <div class="planner-empty">Everything has a place.</div>
      <% } %>
      <% for (const task of snapshot.unscheduledTasks) { %>
        <article class="planner-task-card priority-<%= task.priority || 'none' %>"
                 tabindex="0"
                 data-task-id="<%= task.id %>"
                 data-lane="<%= task.planner_lane %>"
                 data-duration="<%= task.planningDurationMinutes %>">
          <div class="planner-task-card-top">
            <a href="/crm/tasks/<%= task.id %>"><%= task.title %></a>
            <span><%= task.planningDurationMinutes >= 60 ? (task.planningDurationMinutes / 60) + 'h' : task.planningDurationMinutes + 'm' %></span>
          </div>
          <div class="planner-task-card-meta">
            <span class="planner-pill lane-<%= task.planner_lane %>"><%= task.planner_lane === 'personal' ? 'personal time' : 'work hours' %></span>
            <% if (task.priority) { %><span class="planner-pill"><%= task.priority %></span><% } %>
            <% if (task.due) { %><span>Due <%= new Date(String(task.due).slice(0, 10) + 'T12:00:00Z').toLocaleDateString('en-IE', { day: 'numeric', month: 'short', timeZone: 'UTC' }) %></span><% } %>
            <% if (task.project_name || task.project_slug) { %><span><%= task.project_name || task.project_slug %></span><% } %>
          </div>
        </article>
      <% } %>
    </div>
  </aside>

  <section class="planner-calendar-card section-card" aria-label="Weekly calendar">
    <div class="planner-calendar-title">
      <div>
        <p class="crm-eyebrow">Week of</p>
        <h2><%= new Date(snapshot.startDate + 'T12:00:00Z').toLocaleDateString('en-IE', { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' }) %></h2>
      </div>
      <div class="planner-legend"><span><i class="task"></i> Task block</span><span><i></i> Calendar</span></div>
    </div>
    <div class="planner-calendar-scroll">
      <div class="planner-calendar" style="--planner-view-height:<%= viewMinutes * minuteScale %>px;">
        <div class="planner-days-head">
          <div class="planner-corner"></div>
          <% for (const day of snapshot.days) { %>
            <div class="planner-day-head" data-date="<%= day.date %>">
              <span><%= day.label %></span>
              <strong><%= day.dayNumber %></strong>
              <small><%= day.monthLabel %></small>
            </div>
          <% } %>
        </div>
        <div class="planner-all-day-row">
          <div class="planner-all-day-label">all day</div>
          <% for (const day of snapshot.days) { %>
            <div class="planner-all-day-cell">
              <% for (const event of snapshot.events.filter(item => item.allDay && item.date <= day.date && item.endDate > day.date)) { %>
                <a class="planner-all-day-event" href="<%= event.htmlLink || '#' %>" <%= event.htmlLink ? 'target="_blank" rel="noopener"' : '' %> title="<%= event.title %>"><%= event.title %></a>
              <% } %>
            </div>
          <% } %>
        </div>
        <div class="planner-time-grid">
          <div class="planner-time-axis">
            <% for (let minute = viewStartMinutes; minute <= viewEndMinutes; minute += 60) { %>
              <span style="top:<%= (minute - viewStartMinutes) * minuteScale %>px"><%= minute === 1440 ? '24:00' : String(Math.floor(minute / 60)).padStart(2,'0') + ':00' %></span>
            <% } %>
          </div>
          <% for (const day of snapshot.days) { %>
            <div class="planner-day-body" data-date="<%= day.date %>" data-view-start="<%= viewStartMinutes %>" data-view-end="<%= viewEndMinutes %>" style="height:<%= viewMinutes * minuteScale %>px">
              <% for (let minute = viewStartMinutes; minute <= viewEndMinutes; minute += 60) { %>
                <div class="planner-hour-line" style="top:<%= (minute - viewStartMinutes) * minuteScale %>px"></div>
                <% if (minute < viewEndMinutes) { %><div class="planner-half-line" style="top:<%= (minute - viewStartMinutes + 30) * minuteScale %>px"></div><% } %>
              <% } %>
              <% for (const event of snapshot.events.filter(item => !item.allDay && item.date === day.date && item.time)) { %>
                <% const rawStart = minuteOf(event.time); %>
                <% const rawEnd = event.endDate === day.date && event.endTime ? minuteOf(event.endTime) : viewEndMinutes; %>
                <% const top = Math.max(0, rawStart - viewStartMinutes) * minuteScale; %>
                <% const height = Math.max(32, (Math.min(viewEndMinutes, rawEnd) - Math.max(viewStartMinutes, rawStart)) * minuteScale); %>
                <% if (rawEnd > viewStartMinutes && rawStart < viewEndMinutes) { %>
                  <article class="planner-event <%= event.isTask ? 'planner-task-event planner-task-' + (event.task?.planner_lane || 'work') + (event.isLate ? ' planner-task-late' : '') : 'planner-calendar-event' %>"
                           style="top:<%= top %>px;height:<%= height %>px"
                           data-task-id="<%= event.taskId || '' %>"
                           data-lane="<%= event.isTask ? (event.task?.planner_lane || 'work') : '' %>"
                           data-duration="<%= event.durationMinutes || 30 %>"
                           data-event-date="<%= day.date %>"
                           data-event-start="<%= event.time || '' %>"
                           title="<%= event.time %>–<%= event.endTime %> · <%= event.title %><%= event.isLate ? ' · Late' : '' %>">
                    <% if (!event.isTask) { %><div class="planner-event-time"><%= event.time %><% if (event.endTime) { %>–<%= event.endTime %><% } %></div><% } %>
                    <div class="planner-event-title"><% if (event.isLate) { %><span class="planner-late-marker" aria-label="Late" title="Scheduled after its due date">!</span><% } %><%= event.title %></div>
                    <% if (event.isTask) { %>
                      <button type="button" class="planner-unschedule" draggable="false" data-unschedule="<%= event.taskId %>" aria-label="Remove <%= event.title %> from calendar">×</button>
                      <div class="planner-resize-handle" draggable="false" data-resize="<%= event.taskId %>" title="Drag to resize"></div>
                    <% } else if (event.location) { %>
                      <div class="planner-event-location"><%= event.location %></div>
                    <% } %>
                  </article>
                <% } %>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>
</div>

<div class="planner-toast" id="planner-toast" role="status" aria-live="polite"></div>
<script>window.__PLANNER__ = <%- plannerJson %>;</script>
<script src="/task-planner.js?v=20260810c"></script>
<%- include('partials/crm-foot') %>
