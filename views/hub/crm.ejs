<%- include('partials/crm-head', { title: 'People', active: 'contacts' }) %>
<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Connected CRM</p>
    <h1>People</h1>
    <p>Contacts, their companies, shared meetings, decisions, and open work.</p>
  </div>
</section>

<section class="section-card crm-search-card">
  <form method="GET" action="/crm/contacts" class="crm-note-form">
    <input
      type="search"
      name="q"
      value="<%= q %>"
      placeholder="Search people, notes, companies, and facts..."
      aria-label="Search people and notes"
    >
    <button class="btn" type="submit">Search</button>
    <% if (q) { %><a class="btn btn-ghost" href="/crm/contacts">Clear</a><% } %>
  </form>
  <% if (q) { %>
    <p class="crm-search-summary"><%= contacts.length %> <%= contacts.length === 1 ? 'person' : 'people' %> matched “<%= q %>”</p>
  <% } else { %>
    <p class="crm-search-summary">Search includes archived facts, contact notes, and People wiki notes.</p>
  <% } %>
</section>

<section class="section-card">
  <form class="crm-note-form" id="crm-note-form">
    <input name="text" id="crm-note" placeholder="Add a note, e.g. Rob approved the lite licence for Jina" required>
    <button class="btn" type="submit">Add note</button>
  </form>
  <p class="crm-form-message" id="crm-note-message"></p>
</section>

<section class="section-card" id="add-person-section" style="display:none">
  <h3 style="margin:0 0 12px">Add person</h3>
  <form method="POST" action="/crm/contacts" class="crm-form-grid" id="add-person-form">
    <label>Full name<input name="name" placeholder="Full name" required></label>
    <label>Email<input name="email" type="email" placeholder="name@example.com"></label>
    <label>Phone<input name="phone" placeholder="+353 …"></label>
    <label>Company
      <select name="company_id" id="add-person-company">
        <option value="">No company</option>
        <% for (const co of companies) { %><option value="<%= co.id %>"><%= co.name %></option><% } %>
        <option value="__new__">+ New company…</option>
      </select>
    </label>
    <label id="add-person-new-company" style="display:none">New company name<input name="new_company_name" placeholder="Company name"></label>
    <label>Role at company<input name="role" placeholder="e.g. Head of partnerships"></label>
    <label>First contacted<input name="first_contacted" type="date"></label>
    <label class="wide">How we met<input name="how_we_met" placeholder="e.g. Introduced by Rob at the licence review call"></label>
    <label class="wide">Notes<input name="notes" placeholder="Notes (optional)"></label>
    <div style="display:flex;gap:8px;align-items:center;">
      <button class="btn" type="submit">Add person</button>
      <span class="crm-muted" style="font-size:12px;">Only the name is required — the rest saves context you'd otherwise lose.</span>
    </div>
  </form>
</section>
<div style="margin:0 0 16px">
  <button class="btn btn-subtle" id="toggle-add-person">+ Add person</button>
  <% if (q && !contacts.length) { %>
    <button class="btn" id="create-from-search" data-name="<%= q %>">Create new contact: “<%= q %>”</button>
  <% } %>
</div>

<section class="crm-card-grid">
  <% for (const contact of contacts) { %>
    <a class="mgmt-card crm-link-card" href="/crm/contact/<%= contact.id %>">
      <div class="crm-card-title">
        <span><%= contact.name %></span>
        <% if (contact.facts.length) { %><span class="crm-count"><%= contact.facts.length %> fact<%= contact.facts.length !== 1 ? 's' : '' %></span><% } %>
      </div>
      <% if (contact.company_name || (contact.keepWarmOverdueDays > 0)) { %>
        <div class="crm-badges">
          <% if (contact.keepWarmOverdueDays > 0) { %><span class="crm-badge" style="color:var(--crm-danger,#c0392b);border-color:currentColor;">check-in <%= contact.keepWarmOverdueDays %>d overdue</span><% } %>
          <% if (contact.company_name) { %><span class="crm-badge"><%= contact.company_name %></span><% } %>
          <% if (contact.company_role) { %><span class="crm-badge subtle"><%= contact.company_role %></span><% } %>
        </div>
      <% } %>
      <% if (contact.email) { %><div class="crm-muted"><%= contact.email %></div><% } %>
      <% if (contact.facts.length) { %>
        <ul class="crm-compact-list">
          <% for (const fact of contact.facts.slice(0, q ? 1 : 3)) { %>
            <% const ageDays = Math.floor((Date.now() / 1000 - fact.created_at) / 86400); %>
            <li><%= fact.fact %> <span style="font-size:11px;opacity:.5;white-space:nowrap;"><%= ageDays === 0 ? 'today' : ageDays + 'd' %><%= fact.status === 'follow_up' ? ' · follow-up' : '' %></span></li>
          <% } %>
        </ul>
      <% } %>
      <% if (q && contact.searchSnippets.length) { %>
        <div class="crm-search-matches">
          <span>Matched</span>
          <% for (const snippet of contact.searchSnippets) { %><p><%= snippet %></p><% } %>
        </div>
      <% } %>
    </a>
  <% } %>
</section>
<% if (!contacts.length) { %>
  <div class="crm-empty"><%= q ? `No people or notes matched “${q}”.` : 'No contacts yet. Use the note form above or add a person directly.' %></div>
<% } %>

<script>
document.getElementById('toggle-add-person').addEventListener('click', () => {
  const section = document.getElementById('add-person-section');
  const btn = document.getElementById('toggle-add-person');
  const open = section.style.display === 'none';
  section.style.display = open ? '' : 'none';
  btn.textContent = open ? '− Cancel' : '+ Add person';
  if (open) section.querySelector('input[name=name]').focus();
});

document.getElementById('add-person-company').addEventListener('change', e => {
  document.getElementById('add-person-new-company').style.display = e.target.value === '__new__' ? '' : 'none';
});

const createFromSearch = document.getElementById('create-from-search');
if (createFromSearch) {
  createFromSearch.addEventListener('click', () => {
    const section = document.getElementById('add-person-section');
    section.style.display = '';
    const nameInput = section.querySelector('input[name=name]');
    nameInput.value = createFromSearch.dataset.name;
    document.getElementById('toggle-add-person').textContent = '− Cancel';
    nameInput.focus();
  });
}

document.getElementById('crm-note-form').addEventListener('submit', async event => {
  event.preventDefault();
  const input = document.getElementById('crm-note');
  const message = document.getElementById('crm-note-message');
  message.textContent = 'Saving...';
  message.classList.remove('error');
  try {
    const response = await fetch('/api/crm/note', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: input.value }),
    });
    const result = await response.json();
    if (!response.ok || !result.ok) throw new Error(result.error || result.message || 'Could not save note');
    if (result.detail && result.detail.contactId) {
      const d = result.detail;
      const actionLabel = d.action === 'mark_done' ? 'Marked done' : 'Fact saved';
      message.innerHTML = `<span style="display:inline-flex;gap:8px;align-items:baseline;flex-wrap:wrap;">
        <strong>${actionLabel}</strong>
        <span>→ <a href="/crm/contact/${d.contactId}">${d.contactName}</a></span>
        ${d.fact ? `<span style="opacity:.75;">“${d.fact}”</span>` : ''}
        ${d.followUp ? `<span style="opacity:.75;">follow-up: ${d.followUp}</span>` : ''}
      </span>`;
    } else {
      message.textContent = result.message;
    }
    input.value = '';
    setTimeout(() => location.reload(), 2000);
  } catch (error) {
    message.textContent = error.message;
    message.classList.add('error');
  }
});
</script>
<%- include('partials/crm-foot') %>
