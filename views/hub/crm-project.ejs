<%- include('partials/crm-head', { title: project.name, active: 'projects' }) %>
<script>
async function taskAction(id, action) {
  const r = await fetch(`/api/tasks/${id}/${action}`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + (j.error || action));
}
</script>

<a class="crm-back" href="/crm/projects">Projects</a>

<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Project</p>
    <h1><%= project.name %></h1>
    <p style="font-family:monospace;font-size:13px;opacity:.6;">/<%= project.slug %></p>
    <div class="crm-badges" style="margin-top:4px;">
      <% if (projectHealth) { %>
        <% const healthColor = { blocked: 'var(--crm-danger,#c0392b)', stale: 'var(--crm-danger,#c0392b)', quiet: '#b8860b' }[projectHealth]; %>
        <span class="crm-badge<%= healthColor ? '' : ' subtle' %>" <% if (healthColor) { %>style="color:<%= healthColor %>;border-color:currentColor;"<% } %>><%= projectHealth %><%= projectMeta.status ? '' : ' (derived)' %></span>
      <% } %>
      <% if (projectMeta.deadline) { %>
        <% const daysLeft = Math.ceil((Date.parse(projectMeta.deadline) - Date.now()) / 86400000); %>
        <span class="crm-badge subtle" <% if (daysLeft < 0) { %>style="color:var(--crm-danger,#c0392b);border-color:currentColor;"<% } %>>target <%= projectMeta.deadline %><%= daysLeft >= 0 ? ` · ${daysLeft}d left` : ` · ${-daysLeft}d over` %></span>
      <% } %>
    </div>
    <% if (projectMeta.scope) { %><p style="font-size:13px;margin-top:6px;"><%= projectMeta.scope %></p><% } %>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
    <button class="btn btn-subtle" id="project-settings-toggle">Settings</button>
    <a class="btn" href="/c/<%= project.slug %>">Open AI Chat →</a>
  </div>
</section>

<section class="section-card" id="project-settings" style="display:none;">
  <h3 style="margin:0 0 12px;">Project settings</h3>
  <form class="crm-form-grid" id="project-meta-form">
    <label>Status
      <select name="status">
        <option value="">Derived from activity</option>
        <% for (const s of ['planning','active','blocked','completed','closed']) { %>
          <option value="<%= s %>" <%= projectMeta.status === s ? 'selected' : '' %>><%= s %></option>
        <% } %>
      </select>
    </label>
    <label>Target completion<input name="deadline" type="date" value="<%= projectMeta.deadline || '' %>"></label>
    <label class="wide">Scope<input name="scope" value="<%= projectMeta.scope || '' %>" placeholder="One sentence on scope and outcome"></label>
    <div style="display:flex;gap:8px;align-items:center;">
      <button class="btn" type="submit">Save</button>
      <button class="btn btn-subtle" type="button" id="project-lifecycle-toggle"><%= projectHealth === 'closed' ? 'Reopen project' : 'Close project' %></button>
      <span class="crm-muted" id="project-meta-msg" style="font-size:12px;">Stored as declared knowledge (manual atoms), not columns.</span>
    </div>
  </form>
  <hr style="border:0;border-top:1px solid var(--border);margin:16px 0;">
  <form class="crm-form-grid" id="project-rename-form">
    <label>Project name<input name="name" value="<%= project.name %>" required></label>
    <label>Slug<input name="slug" value="<%= project.slug %>" required pattern="[a-z0-9-]+"></label>
    <div style="display:flex;gap:8px;align-items:center;">
      <button class="btn btn-subtle" type="submit">Rename everywhere</button>
      <span class="crm-muted" id="project-rename-msg" style="font-size:12px;">Updates local task, email, meeting and report references atomically.</span>
    </div>
  </form>
</section>

<div class="crm-two-col">

  <!-- ── Left: Tasks + People ──────────────────────────────────────────── -->
  <div class="crm-stack">

    <section class="section-card">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;">
        <h2 style="margin:0;">Tasks
          <% const openTasks = tasks.filter(t => t.status === 'needsAction' && !t.deleted_at); %>
          <% if (openTasks.length) { %><span class="crm-count"><%= openTasks.length %></span><% } %>
        </h2>
        <div style="display:flex;gap:6px;align-items:baseline;">
          <% for (const [key, label] of [['all','All'],['overdue','Overdue'],['due-soon','Due soon']]) { %>
            <button class="btn btn-sm btn-ghost project-task-filter" data-filter="<%= key %>" <%= key === 'all' ? 'style="font-weight:600;"' : '' %>><%= label %></button>
          <% } %>
          <a href="?show_history=<%= showHistory ? '0' : '1' %>" style="font-size:12px;opacity:.6;">
            <%= showHistory ? 'Hide history' : 'Show history' %>
          </a>
        </div>
      </div>
      <% const histTasks = tasks.filter(t => t.status !== 'needsAction' || t.deleted_at); %>
      <% for (const t of openTasks) { %>
        <%- include('partials/task-row', { t, showHistory }) %>
      <% } %>
      <% if (!openTasks.length) { %><p class="crm-muted">No open tasks for this project.</p><% } %>
      <% if (showHistory) { %>
        <% for (const t of histTasks) { %>
          <%- include('partials/task-row', { t, showHistory }) %>
        <% } %>
      <% } %>
      <!-- Quick-add task for this project -->
      <form class="crm-inline-form" id="project-task-form" style="margin-top:12px;flex-wrap:wrap;">
        <input name="title" placeholder="Add a task…" required style="flex:1;min-width:160px;">
        <input name="project_slug" type="hidden" value="<%= project.slug %>">
        <input name="due" type="date" title="Due date (optional)" style="max-width:140px;font-size:13px;">
        <button class="btn btn-sm" type="submit">Add</button>
      </form>
      <p class="crm-muted" id="project-task-msg" style="font-size:12px;margin-top:4px;"></p>
    </section>

    <section class="section-card">
      <% const doneMilestones = milestones.filter(m => m.status === 'retired'); %>
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;">
        <h2 style="margin:0;">Milestones
          <% if (milestones.length) { %><span class="crm-count"><%= doneMilestones.length %>/<%= milestones.length %></span><% } %>
        </h2>
      </div>
      <% if (milestones.length) { %>
        <div style="height:6px;background:var(--border);border-radius:3px;overflow:hidden;margin-bottom:12px;">
          <div style="height:100%;width:<%= Math.round(doneMilestones.length / milestones.length * 100) %>%;background:var(--accent,#4648d4);"></div>
        </div>
      <% } %>
      <% for (const m of milestones) { %>
        <div class="crm-action">
          <span style="font-size:13px;<%= m.status === 'retired' ? 'text-decoration:line-through;opacity:.55;' : '' %>"><%= m.value %></span>
          <div style="display:flex;gap:6px;flex-shrink:0;">
            <% if (m.status === 'retired') { %>
              <button class="btn btn-sm btn-ghost" onclick="milestoneAction('<%= m.id %>','reopen')">Reopen</button>
            <% } else { %>
              <button class="btn btn-sm btn-ghost" onclick="milestoneAction('<%= m.id %>','done')">Done</button>
            <% } %>
            <button class="btn btn-sm btn-ghost" onclick="milestoneAction('<%= m.id %>','delete')">Remove</button>
          </div>
        </div>
      <% } %>
      <% if (!milestones.length) { %><p class="crm-muted">No milestones declared yet.</p><% } %>
      <form class="crm-inline-form" id="milestone-form" style="margin-top:12px;flex-wrap:wrap;">
        <input name="name" placeholder="Milestone, e.g. Design sign-off" required style="flex:1;min-width:160px;">
        <input name="target_date" type="date" title="Target date (optional)" style="max-width:140px;font-size:13px;">
        <button class="btn btn-sm" type="submit">Add</button>
      </form>
      <p class="crm-muted" id="milestone-msg" style="font-size:12px;margin-top:4px;"></p>
    </section>

    <% const projPredicates = Object.keys(knowledgeByPredicate || {}); %>
    <% if (projPredicates.length) { %>
    <section class="section-card">
      <h2 style="margin-bottom:4px;">Knowledge</h2>
      <p class="crm-muted" style="font-size:12px;margin:0 0 12px;">Compiled from source evidence by the CRM knowledge engine and nightly synthesis — each claim links back to what produced it.</p>
      <% for (const pred of projPredicates) { %>
        <div style="margin-bottom:10px;">
          <div style="font-size:11px;text-transform:uppercase;letter-spacing:.04em;opacity:.55;margin-bottom:3px;"><%= pred.replace(/_/g,' ') %></div>
          <% for (const a of knowledgeByPredicate[pred]) { %>
            <div style="display:flex;justify-content:space-between;gap:8px;align-items:baseline;padding:4px 0;border-bottom:1px solid var(--border);">
              <span style="font-size:13px;<%= a.status === 'stale' ? 'opacity:.55;' : '' %>"><%= a.value %><% if (a.status === 'proposed') { %> <span style="font-size:10px;opacity:.6;">· proposed</span><% } %><% if (a.status === 'stale') { %> <span title="not confirmed by any source in over a year" style="font-size:10px;opacity:.6;">· stale</span><% } %></span>
              <span style="font-size:11px;white-space:nowrap;display:inline-flex;gap:6px;align-items:baseline;">
                <span style="opacity:.5;" title="confidence <%= a.confidence.toFixed(2) %>"><%= Math.round(a.confidence*100) %>%</span>
                <% a.sources.forEach(function(s){ %><a href="/crm/source/<%= s.kind %>/<%= encodeURIComponent(s.id) %>" style="opacity:.65;" title="open source: <%= s.kind.replace(/_/g,' ') %>"><%= ({document:'doc',email_summary:'email',meeting_intake:'meeting',crm_fact:'fact',completed_task:'task'})[s.kind] || s.kind %></a><% }); %>
                <% if (['stale','disputed'].includes(a.status)) { %><button class="crm-fact-archive atom-action" data-atom="<%= a.id %>" data-action="restore" title="Restore to active">restore</button><% } else { %><button class="crm-fact-archive atom-action" data-atom="<%= a.id %>" data-action="dispute" style="color:var(--crm-danger,#c0392b);opacity:.7;" title="This is wrong — the synthesis loop will re-weigh it">✕</button><% } %>
              </span>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>
    <% } %>

    <section class="section-card">
      <h2>People</h2>
      <% if (!contacts.length) { %>
        <p class="crm-muted">No people linked yet.</p>
      <% } %>
      <% for (const c of contacts) { %>
        <div class="crm-action">
          <a href="/crm/contact/<%= c.id %>">
            <strong><%= c.name %></strong>
            <% if (c.project_role) { %><span class="crm-muted"> · <%= c.project_role %></span><% } %>
            <% if (c.company_name) { %><span class="crm-muted"> · <%= c.company_name %></span><% } %>
            <% if (!directContactIds.includes(c.id)) { %><span class="crm-badge subtle" style="margin-left:6px;">auto</span><% } %>
          </a>
          <% if (directContactIds.includes(c.id)) { %>
            <button class="btn btn-sm btn-ghost" onclick="unlinkContact('<%= c.id %>')">Remove</button>
          <% } %>
        </div>
      <% } %>
      <% if (availableContacts.length) { %>
        <form class="crm-inline-form" id="link-contact-form" style="margin-top:12px;">
          <select name="contact_id" required style="flex:1;">
            <option value="">Link a person…</option>
            <% for (const c of availableContacts) { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% } %>
          </select>
          <input name="role" placeholder="Role (optional)" style="max-width:140px;">
          <button class="btn btn-sm" type="submit">Link</button>
        </form>
        <p class="crm-muted" id="link-contact-msg" style="font-size:12px;margin-top:4px;"></p>
      <% } %>
    </section>

    <section class="section-card">
      <h2>Companies</h2>
      <% if (!linkedCompanies.length) { %>
        <p class="crm-muted">No companies linked yet.</p>
      <% } %>
      <% for (const co of linkedCompanies) { %>
        <div class="crm-action">
          <a href="/crm/company/<%= co.id %>">
            <strong><%= co.name %></strong>
            <% if (co.project_role) { %><span class="crm-muted"> · <%= co.project_role %></span><% } %>
          </a>
          <button class="btn btn-sm btn-ghost" onclick="unlinkCompany('<%= co.id %>')">Remove</button>
        </div>
      <% } %>
      <% if (availableCompanies.length) { %>
        <form class="crm-inline-form" id="link-company-form" style="margin-top:12px;">
          <select name="company_id" required style="flex:1;">
            <option value="">Link a company…</option>
            <% for (const co of availableCompanies) { %>
              <option value="<%= co.id %>"><%= co.name %></option>
            <% } %>
          </select>
          <input name="role" placeholder="Role (optional)" style="max-width:140px;">
          <button class="btn btn-sm" type="submit">Link</button>
        </form>
        <p class="crm-muted" id="link-company-msg" style="font-size:12px;margin-top:4px;"></p>
      <% } %>
    </section>

    <section class="section-card" id="docs-section">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;">
        <h2 style="margin:0;">Documents <span class="crm-count" id="doc-count-badge" style="<%= projectDocs.length ? '' : 'display:none' %>"><%= projectDocs.length %></span></h2>
        <div style="display:flex;gap:8px;align-items:center;">
          <label style="display:flex;align-items:center;gap:5px;font-size:12px;color:var(--crm-muted);cursor:pointer;">
            <input type="checkbox" id="doc-to-wiki-chk" style="width:13px;height:13px;"> Also wiki
          </label>
          <button class="btn btn-sm" id="doc-upload-btn">+ Add file</button>
        </div>
      </div>
      <input type="file" id="doc-file-input" accept=".pdf,.docx,.pptx,.xlsx,.txt,.md,.csv,.png,.jpg,.jpeg,.gif,.webp" multiple style="display:none;">
      <p id="doc-upload-status" style="font-size:12px;color:var(--crm-muted);min-height:16px;margin:0 0 8px;"></p>

      <% if (!projectDocs.length) { %>
        <p class="crm-muted" id="doc-empty">No documents yet.</p>
      <% } %>
      <div id="doc-list">
        <% for (const doc of projectDocs) { %>
        <div class="crm-action" id="doc-row-<%= doc.id %>">
          <span style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= doc.filename %>"><%= doc.filename %></span>
          <div style="display:flex;gap:6px;flex-shrink:0;align-items:center;">
            <span style="font-size:11px;color:var(--crm-muted);"><%= (doc.size_bytes/1024).toFixed(0) %> KB</span>
            <button class="btn btn-sm btn-ghost" onclick="docToWiki('<%= doc.id %>',this)" title="Save to wiki">→ wiki</button>
            <button class="btn btn-sm btn-ghost" onclick="docExtractTasks('<%= doc.id %>',this)" title="Extract tasks into Google Tasks">→ tasks</button>
            <button class="btn btn-sm btn-ghost" onclick="docDelete('<%= doc.id %>',this)">Remove</button>
          </div>
        </div>
        <% } %>
      </div>
    </section>

  </div>

  <!-- ── Right: Timeline + activity ──────────────────────────────────── -->
  <div class="crm-stack">

    <section class="section-card">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;margin-bottom:8px;">
        <h2 style="margin:0;">Timeline</h2>
        <div style="display:flex;gap:4px;align-items:center;flex-wrap:wrap;">
          <% for (const [key, label] of [['all','All'],['fact','Facts'],['email','Emails'],['knowledge_event','Knowledge']]) { %>
            <button class="btn btn-sm btn-ghost timeline-filter" data-kind="<%= key %>" <%= key === 'all' ? 'style="font-weight:600;"' : '' %>><%= label %></button>
          <% } %>
          <input id="timeline-search" placeholder="Filter…" style="font-size:12px;padding:3px 8px;max-width:120px;">
        </div>
      </div>
      <% if (!projectFacts.length && !recentEmails.length && !(projectKnowledgeEvents || []).length) { %>
        <p class="crm-muted">No activity yet. Link people to this project to see their facts here.</p>
      <% } %>
      <div class="crm-timeline" id="project-timeline">
        <%
          const SOURCE_BADGE = { agentmail: 'email', gmail: 'email', dchat: 'chat', manual: 'note' };
          const TYPE_BADGE = { action: 'action', decision: 'decision' };
          // Merge facts + emails into one sorted list
          const timelineItems = [
            ...projectFacts.map(f => ({ _kind: 'fact', ts: f.created_at, ...f })),
            ...(projectKnowledgeEvents || []),
            ...recentEmails.map(e => ({ _kind: 'email', ts: e.received_at, ...e })),
          ].sort((a, b) => b.ts - a.ts).slice(0, 60);
        %>
        <% for (const item of timelineItems) { %>
          <% if (item._kind === 'fact') { %>
          <div class="crm-timeline-item" data-kind="fact">
            <time><%= new Date(item.ts * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
              <% if (TYPE_BADGE[item.fact_type]) { %><span class="crm-type <%= item.fact_type %>" style="margin-left:6px;"><%= TYPE_BADGE[item.fact_type] %></span><% } %>
            </time>
            <strong><%= item.fact %></strong>
            <span style="display:flex;justify-content:space-between;align-items:center;">
              <span><a href="/crm/contact/<%= item.contact_id %>"><%= item.contact_name %></a><% if (SOURCE_BADGE[item.source]) { %> · <span style="font-size:11px;opacity:.6;"><%= SOURCE_BADGE[item.source] %></span><% } %></span>
              <button class="crm-fact-archive" style="color:var(--crm-danger,#c0392b);opacity:.7;flex-shrink:0;" data-fact-id="<%= item.id %>" title="Mark as wrong — AI won't repeat this error">Wrong</button>
            </span>
          </div>
          <% } else if (item._kind === 'knowledge_event') { %>
          <div class="crm-timeline-item" data-kind="knowledge_event" style="border-left:2px solid var(--accent,#4648d4);padding-left:10px;border-radius:0;">
            <time><%= new Date(item.ts * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
              <span class="crm-type action" style="margin-left:6px;"><%= item.predicate.replace(/_/g, ' ') %></span>
            </time>
            <strong><%= item.value %></strong>
            <span style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-size:11px;opacity:.6;">compiled knowledge · <%= Math.round(item.confidence * 100) %>%</span>
              <span style="display:inline-flex;gap:6px;">
                <% item.sources.forEach(function(s){ %><a href="/crm/source/<%= s.kind %>/<%= encodeURIComponent(s.id) %>" style="opacity:.65;font-size:11px;" title="open source: <%= s.kind.replace(/_/g,' ') %>"><%= ({document:'doc',email_summary:'email',meeting_intake:'meeting',crm_fact:'fact',completed_task:'task'})[s.kind] || s.kind %></a><% }); %>
              </span>
            </span>
          </div>
          <% } else { %>
          <div class="crm-timeline-item" data-kind="email" style="opacity:.7;">
            <time><%= new Date(item.ts * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %></time>
            <strong style="font-weight:400;"><%= item.subject %></strong>
            <span style="font-size:12px;"><%= item.from_name || item.from_email %><% if (item.summary) { %> — <%= item.summary.slice(0,120) %><% } %></span>
          </div>
          <% } %>
        <% } %>
      </div>
    </section>

    <% if (recentMessages.length) { %>
    <section class="section-card">
      <h2>Recent chat</h2>
      <div class="crm-timeline">
        <% for (const m of recentMessages) { %>
          <div class="crm-timeline-item">
            <time><%= new Date(m.ts * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short' }) %></time>
            <strong style="font-weight:<%= m.role === 'user' ? '600' : '400' %>;">
              <%= m.role === 'user' ? 'You' : 'AI' %>
            </strong>
            <span style="white-space:pre-wrap;font-size:12px;"><%= m.content.slice(0, 200) %><%= m.content.length > 200 ? '…' : '' %></span>
          </div>
        <% } %>
      </div>
      <a class="btn btn-sm" href="/c/<%= project.slug %>" style="margin-top:12px;display:inline-block;">Open chat →</a>
    </section>
    <% } %>

  </div>
</div>

<script>
// Project settings (manual atoms)
document.getElementById('project-settings-toggle').addEventListener('click', () => {
  const el = document.getElementById('project-settings');
  el.style.display = el.style.display === 'none' ? '' : 'none';
});
document.getElementById('project-meta-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('project-meta-msg');
  msg.textContent = 'Saving…';
  try {
    const r = await fetch('/api/crm/project/<%= project.slug %>/meta', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(e.target))),
    });
    const j = await r.json();
    if (j.ok) { msg.textContent = 'Saved.'; setTimeout(() => location.reload(), 600); }
    else msg.textContent = j.error || 'Error';
  } catch (err) { msg.textContent = err.message; }
});
document.getElementById('project-lifecycle-toggle').addEventListener('click', () => {
  const form = document.getElementById('project-meta-form');
  const status = form.querySelector('[name=status]');
  const closing = status.value !== 'closed';
  if (closing && !confirm('Close this project? Its data stays available, but it will leave active project views and daily work reports.')) return;
  status.value = closing ? 'closed' : 'active';
  form.requestSubmit();
});
document.getElementById('project-rename-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('project-rename-msg');
  if (!confirm('Rename this project everywhere in the Hub?')) return;
  msg.textContent = 'Renaming…';
  try {
    const r = await fetch('/api/crm/project/<%= project.slug %>/rename', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(e.target))),
    });
    const j = await r.json();
    if (j.ok) location.assign('/crm/project/' + encodeURIComponent(j.project.slug));
    else msg.textContent = j.error || 'Error';
  } catch (err) { msg.textContent = err.message; }
});

// Milestones
document.getElementById('milestone-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('milestone-msg');
  msg.textContent = 'Adding…';
  try {
    const r = await fetch('/api/crm/project/<%= project.slug %>/milestones', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(e.target))),
    });
    const j = await r.json();
    if (j.ok) location.reload();
    else msg.textContent = j.error || 'Error';
  } catch (err) { msg.textContent = err.message; }
});
async function milestoneAction(id, action) {
  if (action === 'delete' && !confirm('Remove this milestone?')) return;
  const r = await fetch(`/api/crm/project-milestones/${id}/${action}`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}

// Task filters (open tasks only — history keeps its own toggle)
document.querySelectorAll('.project-task-filter').forEach(btn => {
  btn.addEventListener('click', () => {
    const mode = btn.dataset.filter;
    document.querySelectorAll('.project-task-filter').forEach(b => b.style.fontWeight = b === btn ? '600' : '');
    const soonCutoff = new Date(Date.now() + 7 * 86400000).toLocaleDateString('sv-SE');
    document.querySelectorAll('.crm-task-row[data-task-status=open]').forEach(row => {
      const due = row.dataset.taskDue;
      const overdue = row.dataset.taskOverdue === '1';
      let show = true;
      if (mode === 'overdue') show = overdue;
      else if (mode === 'due-soon') show = Boolean(due) && !overdue && due <= soonCutoff;
      row.style.display = show ? '' : 'none';
    });
  });
});

// Timeline filter + search
let timelineKind = 'all';
function applyTimelineFilter() {
  const q = document.getElementById('timeline-search').value.trim().toLowerCase();
  document.querySelectorAll('#project-timeline .crm-timeline-item').forEach(el => {
    const kindOk = timelineKind === 'all' || el.dataset.kind === timelineKind;
    const textOk = !q || el.textContent.toLowerCase().includes(q);
    el.style.display = kindOk && textOk ? '' : 'none';
  });
}
document.querySelectorAll('.timeline-filter').forEach(btn => {
  btn.addEventListener('click', () => {
    timelineKind = btn.dataset.kind;
    document.querySelectorAll('.timeline-filter').forEach(b => b.style.fontWeight = b === btn ? '600' : '');
    applyTimelineFilter();
  });
});
document.getElementById('timeline-search').addEventListener('input', applyTimelineFilter);

// Wrong fact
document.addEventListener('click', async e => {
  const btn = e.target.closest('[data-fact-id]');
  if (!btn) return;
  const id = btn.dataset.factId;
  btn.disabled = true;
  const r = await fetch(`/api/crm/facts/${id}/wrong`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) btn.closest('.crm-timeline-item').remove();
  else { btn.disabled = false; alert('Error: ' + j.error); }
});

