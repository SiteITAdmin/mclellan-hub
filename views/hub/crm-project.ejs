<%- include('partials/crm-head', { title: project.name, active: 'projects' }) %>
<script>
async function taskAction(id, action) {
  const r = await fetch(`/api/tasks/${id}/${action}`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + (j.error || action));
}
</script>

<a class="crm-back" href="/crm/projects">Projects</a>

<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Project</p>
    <h1><%= project.name %></h1>
    <p style="font-family:monospace;font-size:13px;opacity:.6;">/<%= project.slug %></p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
    <a class="btn" href="/c/<%= project.slug %>">Open AI Chat →</a>
  </div>
</section>

<div class="crm-two-col">

  <!-- ── Left: Tasks + People ──────────────────────────────────────────── -->
  <div class="crm-stack">

    <section class="section-card">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;">
        <h2 style="margin:0;">Tasks
          <% const openTasks = tasks.filter(t => t.status === 'needsAction' && !t.deleted_at); %>
          <% if (openTasks.length) { %><span class="crm-count"><%= openTasks.length %></span><% } %>
        </h2>
        <a href="?show_history=<%= showHistory ? '0' : '1' %>" style="font-size:12px;opacity:.6;">
          <%= showHistory ? 'Hide history' : 'Show history' %>
        </a>
      </div>
      <% const histTasks = tasks.filter(t => t.status !== 'needsAction' || t.deleted_at); %>
      <% for (const t of openTasks) { %>
        <%- include('partials/task-row', { t, showHistory }) %>
      <% } %>
      <% if (!openTasks.length) { %><p class="crm-muted">No open tasks for this project.</p><% } %>
      <% if (showHistory) { %>
        <% for (const t of histTasks) { %>
          <%- include('partials/task-row', { t, showHistory }) %>
        <% } %>
      <% } %>
      <!-- Quick-add task for this project -->
      <form class="crm-inline-form" id="project-task-form" style="margin-top:12px;">
        <input name="title" placeholder="Add a task…" required style="flex:1;">
        <input name="project_slug" type="hidden" value="<%= project.slug %>">
        <button class="btn btn-sm" type="submit">Add</button>
      </form>
      <p class="crm-muted" id="project-task-msg" style="font-size:12px;margin-top:4px;"></p>
    </section>

    <% const projPredicates = Object.keys(knowledgeByPredicate || {}); %>
    <% if (projPredicates.length) { %>
    <section class="section-card">
      <h2 style="margin-bottom:4px;">Knowledge</h2>
      <p class="crm-muted" style="font-size:12px;margin:0 0 12px;">Compiled from source evidence by the CRM knowledge engine and nightly synthesis — each claim links back to what produced it.</p>
      <% for (const pred of projPredicates) { %>
        <div style="margin-bottom:10px;">
          <div style="font-size:11px;text-transform:uppercase;letter-spacing:.04em;opacity:.55;margin-bottom:3px;"><%= pred.replace(/_/g,' ') %></div>
          <% for (const a of knowledgeByPredicate[pred]) { %>
            <div style="display:flex;justify-content:space-between;gap:8px;align-items:baseline;padding:4px 0;border-bottom:1px solid var(--border);">
              <span style="font-size:13px;"><%= a.value %><% if (a.status === 'proposed') { %> <span style="font-size:10px;opacity:.6;">· proposed</span><% } %></span>
              <span style="font-size:11px;white-space:nowrap;display:inline-flex;gap:6px;align-items:baseline;">
                <span style="opacity:.5;" title="confidence <%= a.confidence.toFixed(2) %>"><%= Math.round(a.confidence*100) %>%</span>
                <% a.sources.forEach(function(s){ %><a href="/crm/source/<%= s.kind %>/<%= encodeURIComponent(s.id) %>" style="opacity:.65;" title="open source: <%= s.kind.replace(/_/g,' ') %>"><%= ({document:'doc',email_summary:'email',meeting_intake:'meeting',crm_fact:'fact',completed_task:'task'})[s.kind] || s.kind %></a><% }); %>
              </span>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>
    <% } %>

    <section class="section-card">
      <h2>People</h2>
      <% if (!contacts.length) { %>
        <p class="crm-muted">No people linked yet.</p>
      <% } %>
      <% for (const c of contacts) { %>
        <div class="crm-action">
          <a href="/crm/contact/<%= c.id %>">
            <strong><%= c.name %></strong>
            <% if (c.project_role) { %><span class="crm-muted"> · <%= c.project_role %></span><% } %>
            <% if (c.company_name) { %><span class="crm-muted"> · <%= c.company_name %></span><% } %>
            <% if (!directContactIds.includes(c.id)) { %><span class="crm-badge subtle" style="margin-left:6px;">auto</span><% } %>
          </a>
          <% if (directContactIds.includes(c.id)) { %>
            <button class="btn btn-sm btn-ghost" onclick="unlinkContact('<%= c.id %>')">Remove</button>
          <% } %>
        </div>
      <% } %>
      <% if (availableContacts.length) { %>
        <form class="crm-inline-form" id="link-contact-form" style="margin-top:12px;">
          <select name="contact_id" required style="flex:1;">
            <option value="">Link a person…</option>
            <% for (const c of availableContacts) { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% } %>
          </select>
          <input name="role" placeholder="Role (optional)" style="max-width:140px;">
          <button class="btn btn-sm" type="submit">Link</button>
        </form>
        <p class="crm-muted" id="link-contact-msg" style="font-size:12px;margin-top:4px;"></p>
      <% } %>
    </section>

    <section class="section-card">
      <h2>Companies</h2>
      <% if (!linkedCompanies.length) { %>
        <p class="crm-muted">No companies linked yet.</p>
      <% } %>
      <% for (const co of linkedCompanies) { %>
        <div class="crm-action">
          <a href="/crm/company/<%= co.id %>">
            <strong><%= co.name %></strong>
            <% if (co.project_role) { %><span class="crm-muted"> · <%= co.project_role %></span><% } %>
          </a>
          <button class="btn btn-sm btn-ghost" onclick="unlinkCompany('<%= co.id %>')">Remove</button>
        </div>
      <% } %>
      <% if (availableCompanies.length) { %>
        <form class="crm-inline-form" id="link-company-form" style="margin-top:12px;">
          <select name="company_id" required style="flex:1;">
            <option value="">Link a company…</option>
            <% for (const co of availableCompanies) { %>
              <option value="<%= co.id %>"><%= co.name %></option>
            <% } %>
          </select>
          <input name="role" placeholder="Role (optional)" style="max-width:140px;">
          <button class="btn btn-sm" type="submit">Link</button>
        </form>
        <p class="crm-muted" id="link-company-msg" style="font-size:12px;margin-top:4px;"></p>
      <% } %>
    </section>

    <section class="section-card" id="docs-section">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;">
        <h2 style="margin:0;">Documents <span class="crm-count" id="doc-count-badge" style="<%= projectDocs.length ? '' : 'display:none' %>"><%= projectDocs.length %></span></h2>
        <div style="display:flex;gap:8px;align-items:center;">
          <label style="display:flex;align-items:center;gap:5px;font-size:12px;color:var(--crm-muted);cursor:pointer;">
            <input type="checkbox" id="doc-to-wiki-chk" style="width:13px;height:13px;"> Also wiki
          </label>
          <button class="btn btn-sm" id="doc-upload-btn">+ Add file</button>
        </div>
      </div>
      <input type="file" id="doc-file-input" accept=".pdf,.docx,.pptx,.xlsx,.txt,.md,.csv,.png,.jpg,.jpeg,.gif,.webp" multiple style="display:none;">
      <p id="doc-upload-status" style="font-size:12px;color:var(--crm-muted);min-height:16px;margin:0 0 8px;"></p>

      <% if (!projectDocs.length) { %>
        <p class="crm-muted" id="doc-empty">No documents yet.</p>
      <% } %>
      <div id="doc-list">
        <% for (const doc of projectDocs) { %>
        <div class="crm-action" id="doc-row-<%= doc.id %>">
          <span style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= doc.filename %>"><%= doc.filename %></span>
          <div style="display:flex;gap:6px;flex-shrink:0;align-items:center;">
            <span style="font-size:11px;color:var(--crm-muted);"><%= (doc.size_bytes/1024).toFixed(0) %> KB</span>
            <button class="btn btn-sm btn-ghost" onclick="docToWiki('<%= doc.id %>',this)" title="Save to wiki">→ wiki</button>
            <button class="btn btn-sm btn-ghost" onclick="docExtractTasks('<%= doc.id %>',this)" title="Extract tasks into Google Tasks">→ tasks</button>
            <button class="btn btn-sm btn-ghost" onclick="docDelete('<%= doc.id %>',this)">Remove</button>
          </div>
        </div>
        <% } %>
      </div>
    </section>

  </div>

  <!-- ── Right: Timeline + activity ──────────────────────────────────── -->
  <div class="crm-stack">

    <section class="section-card">
      <h2>Timeline</h2>
      <% if (!projectFacts.length && !recentEmails.length && !(projectKnowledgeEvents || []).length) { %>
        <p class="crm-muted">No activity yet. Link people to this project to see their facts here.</p>
      <% } %>
      <div class="crm-timeline">
        <%
          const SOURCE_BADGE = { agentmail: 'email', gmail: 'email', dchat: 'chat', manual: 'note' };
          const TYPE_BADGE = { action: 'action', decision: 'decision' };
          // Merge facts + emails into one sorted list
          const timelineItems = [
            ...projectFacts.map(f => ({ _kind: 'fact', ts: f.created_at, ...f })),
            ...(projectKnowledgeEvents || []),
            ...recentEmails.map(e => ({ _kind: 'email', ts: e.received_at, ...e })),
          ].sort((a, b) => b.ts - a.ts).slice(0, 60);
        %>
        <% for (const item of timelineItems) { %>
          <% if (item._kind === 'fact') { %>
          <div class="crm-timeline-item">
            <time><%= new Date(item.ts * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
              <% if (TYPE_BADGE[item.fact_type]) { %><span class="crm-type <%= item.fact_type %>" style="margin-left:6px;"><%= TYPE_BADGE[item.fact_type] %></span><% } %>
            </time>
            <strong><%= item.fact %></strong>
            <span style="display:flex;justify-content:space-between;align-items:center;">
              <span><a href="/crm/contact/<%= item.contact_id %>"><%= item.contact_name %></a><% if (SOURCE_BADGE[item.source]) { %> · <span style="font-size:11px;opacity:.6;"><%= SOURCE_BADGE[item.source] %></span><% } %></span>
              <button class="crm-fact-archive" style="color:var(--crm-danger,#c0392b);opacity:.7;flex-shrink:0;" data-fact-id="<%= item.id %>" title="Mark as wrong — AI won't repeat this error">Wrong</button>
            </span>
          </div>
          <% } else if (item._kind === 'knowledge_event') { %>
          <div class="crm-timeline-item">
            <time><%= new Date(item.ts * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
              <span class="crm-type action" style="margin-left:6px;"><%= item.predicate.replace(/_/g, ' ') %></span>
            </time>
            <strong><%= item.value %></strong>
            <span style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-size:11px;opacity:.6;">compiled knowledge · <%= Math.round(item.confidence * 100) %>%</span>
              <span style="display:inline-flex;gap:6px;">
                <% item.sources.forEach(function(s){ %><a href="/crm/source/<%= s.kind %>/<%= encodeURIComponent(s.id) %>" style="opacity:.65;font-size:11px;" title="open source: <%= s.kind.replace(/_/g,' ') %>"><%= ({document:'doc',email_summary:'email',meeting_intake:'meeting',crm_fact:'fact',completed_task:'task'})[s.kind] || s.kind %></a><% }); %>
              </span>
            </span>
          </div>
          <% } else { %>
          <div class="crm-timeline-item" style="opacity:.7;">
            <time><%= new Date(item.ts * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %></time>
            <strong style="font-weight:400;"><%= item.subject %></strong>
            <span style="font-size:12px;"><%= item.from_name || item.from_email %><% if (item.summary) { %> — <%= item.summary.slice(0,120) %><% } %></span>
          </div>
          <% } %>
        <% } %>
      </div>
    </section>

    <% if (recentMessages.length) { %>
    <section class="section-card">
      <h2>Recent chat</h2>
      <div class="crm-timeline">
        <% for (const m of recentMessages) { %>
          <div class="crm-timeline-item">
            <time><%= new Date(m.ts * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short' }) %></time>
            <strong style="font-weight:<%= m.role === 'user' ? '600' : '400' %>;">
              <%= m.role === 'user' ? 'You' : 'AI' %>
            </strong>
            <span style="white-space:pre-wrap;font-size:12px;"><%= m.content.slice(0, 200) %><%= m.content.length > 200 ? '…' : '' %></span>
          </div>
        <% } %>
      </div>
      <a class="btn btn-sm" href="/c/<%= project.slug %>" style="margin-top:12px;display:inline-block;">Open chat →</a>
    </section>
    <% } %>

  </div>
</div>

<script>
// Wrong fact
document.addEventListener('click', async e => {
  const btn = e.target.closest('[data-fact-id]');
  if (!btn) return;
  const id = btn.dataset.factId;
  btn.disabled = true;
  const r = await fetch(`/api/crm/facts/${id}/wrong`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) btn.closest('.crm-timeline-item').remove();
  else { btn.disabled = false; alert('Error: ' + j.error); }
});

// Link contact to project
const linkContactForm = document.getElementById('link-contact-form');
if (linkContactForm) {
  linkContactForm.addEventListener('submit', async e => {
    e.preventDefault();
    const msg = document.getElementById('link-contact-msg');
    const data = Object.fromEntries(new FormData(e.target));
    // Link from the contact's side (same junction table)
    msg.textContent = 'Linking…';
    try {
      const r = await fetch(`/api/crm/contacts/${data.contact_id}/projects`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project_id: '<%= project.id %>', role: data.role }),
      });
      const j = await r.json();
      if (j.ok) location.reload();
      else msg.textContent = j.error || 'Error';
    } catch (err) { msg.textContent = err.message; }
  });
}

const linkCompanyForm = document.getElementById('link-company-form');
if (linkCompanyForm) {
  linkCompanyForm.addEventListener('submit', async e => {
    e.preventDefault();
    const msg = document.getElementById('link-company-msg');
    const data = Object.fromEntries(new FormData(e.target));
    msg.textContent = 'Linking…';
    try {
      const r = await fetch(`/api/crm/companies/${data.company_id}/projects`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project_id: '<%= project.id %>', role: data.role }),
      });
      const j = await r.json();
      if (j.ok) location.reload();
      else msg.textContent = j.error || 'Error';
    } catch (err) { msg.textContent = err.message; }
  });
}

async function unlinkCompany(companyId) {
  const r = await fetch(`/api/crm/companies/${companyId}/projects/unlink`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ project_id: '<%= project.id %>' }),
  });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}

async function unlinkContact(contactId) {
  const r = await fetch(`/api/crm/contacts/${contactId}/projects/unlink`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ project_id: '<%= project.id %>' }),
  });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}

document.getElementById('project-task-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('project-task-msg');
  const data = Object.fromEntries(new FormData(e.target));
  msg.textContent = 'Adding…';
  try {
    const r = await fetch('/api/tasks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const j = await r.json();
    if (j.ok) { msg.textContent = 'Added!'; e.target.reset(); setTimeout(() => location.reload(), 800); }
    else msg.textContent = j.error || 'Error';
  } catch (err) { msg.textContent = err.message; }
});
</script>

<script>
(function() {
  const uploadBtn  = document.getElementById('doc-upload-btn');
  const fileInput  = document.getElementById('doc-file-input');
  const toWikiChk  = document.getElementById('doc-to-wiki-chk');
  const statusEl   = document.getElementById('doc-upload-status');
  const docList    = document.getElementById('doc-list');
  const emptyEl    = document.getElementById('doc-empty');
  const badgeEl    = document.getElementById('doc-count-badge');
  const projectSlug = '<%= project.slug %>';
  let docCount = <%= projectDocs.length %>;

  function updateBadge() {
    badgeEl.textContent = docCount;
    badgeEl.style.display = docCount ? '' : 'none';
  }

  uploadBtn.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', async () => {
    const files = Array.from(fileInput.files);
    if (!files.length) return;
    const sendToWiki = toWikiChk.checked;
    uploadBtn.disabled = true;

    const errors = [];
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      statusEl.textContent = files.length > 1
        ? `Uploading ${file.name} (${i + 1}/${files.length})…`
        : `Uploading ${file.name}…`;

      const fd = new FormData();
      fd.append('file', file);
      fd.append('projectSlug', projectSlug);
      if (sendToWiki) fd.append('toWiki', '1');

      try {
        const r = await fetch('/api/upload', { method: 'POST', body: fd });
        const d = await r.json();
        if (!r.ok || !d.ok) { errors.push(`${file.name}: ${d.error || 'Upload failed'}`); continue; }

        if (emptyEl) emptyEl.style.display = 'none';
        const row = document.createElement('div');
        row.className = 'crm-action';
        row.id = 'doc-row-' + d.document.id;
        const kb = (d.document.size / 1024).toFixed(0);
        row.innerHTML = `
          <span style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${d.document.filename}">${d.document.filename}</span>
          <div style="display:flex;gap:6px;flex-shrink:0;align-items:center;">
            <span style="font-size:11px;color:var(--crm-muted);">${kb} KB</span>
            <button class="btn btn-sm btn-ghost" onclick="docToWiki('${d.document.id}',this)" title="Save to wiki">→ wiki</button>
            <button class="btn btn-sm btn-ghost" onclick="docDelete('${d.document.id}',this)">Remove</button>
          </div>`;
        docList.prepend(row);
        docCount++;
        updateBadge();

        if (files.length === 1) {
          if (d.wiki?.slug) {
            statusEl.innerHTML = `✓ Saved · <a href="https://wiki.mclellan.scot/page/${d.wiki.slug}" target="_blank" style="color:var(--crm-link,#4648d4);">Wiki: ${d.wiki.title} ↗</a>`;
          } else if (d.wiki?.error) {
            statusEl.textContent = `✓ Saved · Wiki failed: ${d.wiki.error}`;
          } else {
            statusEl.textContent = `✓ Saved ${d.document.filename}`;
          }
        }
      } catch (err) {
        errors.push(`${file.name}: ${err.message}`);
      }
    }

    if (files.length > 1) {
      const saved = files.length - errors.length;
      statusEl.textContent = errors.length
        ? `✓ ${saved}/${files.length} saved · ✖ ${errors.join(', ')}`
        : `✓ ${saved} files saved`;
    }
    uploadBtn.disabled = false;
    fileInput.value = '';
  });

  window.docToWiki = async function(id, btn) {
    btn.textContent = '…';
    btn.disabled = true;
    try {
      const r = await fetch('/api/documents/' + id + '/to-wiki', { method: 'POST' });
      const d = await r.json();
      if (d.ok) {
        btn.outerHTML = `<a href="https://wiki.mclellan.scot/page/${d.slug}" target="_blank" class="btn btn-sm" style="font-size:11px;">wiki ↗</a>`;
      } else {
        btn.textContent = '⚠ ' + (d.error || 'Failed');
        btn.disabled = false;
      }
    } catch (err) { btn.textContent = '⚠ error'; btn.disabled = false; }
  };

  window.docExtractTasks = async function(id, btn) {
    btn.textContent = '…';
    btn.disabled = true;
    try {
      const r = await fetch('/api/documents/' + id + '/extract-tasks', { method: 'POST' });
      const d = await r.json();
      if (d.ok) {
        btn.textContent = d.created > 0 ? `✓ ${d.created} tasks` : 'no tasks';
        btn.title = d.created + ' created, ' + d.skipped + ' already existed';
      } else {
        btn.textContent = '⚠ error';
        btn.title = d.error || 'Failed';
        btn.disabled = false;
      }
    } catch (err) { btn.textContent = '⚠ error'; btn.disabled = false; }
  };

  window.docDelete = async function(id, btn) {
    if (!confirm('Remove this document?')) return;
    btn.disabled = true;
    try {
      const r = await fetch('/api/documents/' + id + '/delete', { method: 'POST' });
      const d = await r.json();
      if (d.ok) {
        document.getElementById('doc-row-' + id)?.remove();
        docCount = Math.max(0, docCount - 1);
        updateBadge();
        if (!docCount && emptyEl) emptyEl.style.display = '';
      } else { btn.disabled = false; alert('Error: ' + d.error); }
    } catch (err) { btn.disabled = false; alert(err.message); }
  };
})();
</script>

<%- include('partials/crm-foot') %>
