<%- include('partials/crm-head', { title: 'Questions', active: 'questions' }) %>

<style>
  .q-card { margin-top:14px; border-left:4px solid var(--crm-border,#dfe3e8); }
  .q-card[data-kind="meeting_question"] { border-left-color:#7c3aed; }
  .q-card[data-kind="task_owner"] { border-left-color:#0284c7; }
  .q-card[data-kind="person_alias"] { border-left-color:#059669; }
  .q-card[data-kind="attribution_correction"] { border-left-color:#d97706; }
  .q-card[data-kind="note_transcription"] { border-left-color:#be123c; }
  .q-doubt { margin:0 0 10px; font-size:12px; color:var(--crm-muted,#667085); }
  .q-doubt code { background:rgba(127,127,127,.12); padding:1px 5px; border-radius:4px; }
  .q-form textarea.q-transcript { min-height:220px; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:13px; line-height:1.5; }
  .q-card:target { box-shadow:0 0 0 3px color-mix(in srgb, var(--accent,#7c6af5) 40%, transparent); }
  .q-question { margin:2px 0 6px; font-size:1.05rem; font-weight:600; line-height:1.4; }
  .q-context { color:var(--crm-muted,#667085); font-size:12px; margin:0 0 10px; }
  .q-context a { color:inherit; }
  .q-form { display:grid; gap:8px; }
  .q-form textarea { width:100%; min-height:64px; font:inherit; padding:8px 10px; border-radius:8px; border:1px solid var(--crm-border,#dfe3e8); }
  .q-row { display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end; }
  .q-row label { display:grid; gap:4px; font-size:12px; color:var(--crm-muted,#667085); }
  .q-row select, .q-row input { font:inherit; padding:7px 9px; border-radius:8px; border:1px solid var(--crm-border,#dfe3e8); min-width:200px; }
  .q-excerpt { margin:0 0 12px; }
  .q-excerpt-head { margin:0 0 4px; font-size:12px; color:var(--crm-muted,#667085); }
  .q-excerpt blockquote { margin:0 0 6px; padding:8px 12px; border-left:3px solid var(--crm-border,#dfe3e8); background:rgba(127,127,127,.06); border-radius:0 6px 6px 0; font-size:13px; line-height:1.5; }
  .q-time { color:var(--crm-muted,#667085); font-variant-numeric:tabular-nums; font-size:11px; margin-right:4px; }
  .q-discard { margin-top:8px; }
  .q-discard .btn { font-size:12px; padding:4px 10px; }
  .q-note { font-size:12px; color:var(--crm-muted,#667085); margin:6px 0 0; }
  .q-empty { padding:22px; text-align:center; color:var(--crm-muted,#667085); }
  .q-answered summary { cursor:pointer; color:var(--crm-muted,#667085); }
  .q-answered li { margin:8px 0; font-size:13px; line-height:1.5; }
</style>

<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Open questions</p>
    <h1><%= groups.total %> thing<%= groups.total === 1 ? '' : 's' %> the Hub can't decide without you</h1>
    <p>Every question here was raised by a recurring check against your own meetings and records. Answering one writes it into the knowledge layer with a link back to where it came from, and the checks stop asking.</p>
    <% if (!showAll && groups.shown < groups.total) { %>
      <p class="crm-muted">Showing the <%= groups.shown %> most recent. <a href="/crm/questions?all=1">Show all <%= groups.total %></a>.</p>
    <% } else if (showAll && groups.total > 15) { %>
      <p class="crm-muted">Showing all <%= groups.total %>. <a href="/crm/questions">Back to the recent ones</a>.</p>
    <% } %>
  </div>
</section>

<% if (saved) { %>
  <section class="section-card" style="border-left:4px solid var(--crm-success,#16865b);">
    <strong>Saved.</strong> <%= saved %>
    <% if (restoreKey) { %>
      <form method="post" action="/crm/questions/restore" style="display:inline;margin-left:8px;">
        <input type="hidden" name="key" value="<%= restoreKey %>">
        <button class="btn" type="submit">Undo</button>
      </form>
    <% } %>
  </section>
<% } %>
<% if (error) { %>
  <section class="section-card" style="border-left:4px solid var(--crm-danger,#c0392b);">
    <strong>Not saved.</strong> <%= error %>
  </section>
<% } %>

<% if (!groups.total) { %>
  <section class="section-card q-empty">Nothing open. Every question the checks raised has an answer.</section>
<% } %>

<% if (groups.attribution_corrections.length) { %>
  <h2 style="margin:26px 0 0;font-size:15px;">Attribution corrections (<%= groups.counts.attribution_corrections %>)</h2>
  <% for (const item of groups.attribution_corrections) { %>
    <section class="section-card q-card" data-kind="attribution_correction" id="q-<%= item.key %>">
      <p class="q-question"><%= item.question %></p>
      <p class="q-context">
        <a href="/crm/meeting-intake?intake=<%= item.intake_id %>">Open the full meeting</a>
        · whole-transcript GPT-5.6 Terra review
        <% if (item.confidence) { %> · <%= Math.round(item.confidence * 100) %>% confidence<% } %>
      </p>
      <% if (item.evidence) { %>
        <div class="q-excerpt">
          <p class="q-excerpt-head"><strong>Source evidence</strong></p>
          <blockquote><%= item.evidence %></blockquote>
        </div>
      <% } %>
      <% if (item.owners && item.owners.length) { %>
        <p class="q-note">Linked evidence currently names: <%= item.owners.map(owner => owner.name).join(', ') %>.</p>
      <% } %>
      <form class="q-form" method="post" action="/crm/questions/attribution">
        <input type="hidden" name="key" value="<%= item.key %>">
        <input type="hidden" name="intake_id" value="<%= item.intake_id %>">
        <input type="hidden" name="review_key" value="<%= item.review_key %>">
        <input type="hidden" name="question" value="<%= item.question %>">
        <div class="q-row">
          <label>Correct person
            <select name="contact_id">
              <option value=""><%= item.proposed_contact_name ? `Use proposed: ${item.proposed_contact_name}` : 'No person / apply removal' %></option>
              <% for (const contact of contacts) { %>
                <option value="<%= contact.id %>" <%= item.proposed_contact_id === contact.id ? 'selected' : '' %>><%= contact.name %></option>
              <% } %>
            </select>
          </label>
          <button class="btn primary" type="submit">Apply correction</button>
        </div>
      </form>
      <form method="post" action="/crm/questions/discard" class="q-discard">
        <input type="hidden" name="key" value="<%= item.key %>">
        <input type="hidden" name="kind" value="attribution_correction">
        <input type="hidden" name="question" value="<%= item.question %>">
        <input type="hidden" name="source_kind" value="meeting_intake">
        <input type="hidden" name="source_id" value="<%= item.intake_id %>">
        <button class="btn subtle" type="submit">Keep current attribution</button>
      </form>
      <p class="q-note">This correction is stored as source-backed attribution evidence. It does not create an alias.</p>
    </section>
  <% } %>
<% } %>

<% if (groups.note_transcriptions && groups.note_transcriptions.length) { %>
  <h2 style="margin:26px 0 0;font-size:15px;">Handwritten pages to check (<%= groups.counts.note_transcriptions %>)</h2>
  <p class="crm-muted" style="margin:4px 0 0;font-size:12px;">
    Read by the hub, not trusted by it. Open the page, fix what it got wrong, and save your reading.
  </p>
  <% for (const item of groups.note_transcriptions) { %>
    <section class="section-card q-card" data-kind="note_transcription" id="q-<%= item.key %>">
      <p class="q-question"><%= item.question %></p>
      <p class="q-context">
        <a href="<%= item.document_url %>" target="_blank" rel="noopener"><%= item.document_name %></a>
        · <%= item.page_count %> page<%= item.page_count === 1 ? '' : 's' %>
        · <%= item.line_count %> line<%= item.line_count === 1 ? '' : 's' %>
        <% if (item.low_confidence_lines) { %> · <%= item.low_confidence_lines %> the hub doubted<% } %>
        <% if (item.truncated) { %> · only the first pages were read<% } %>
        · read by Apple Vision on the Mac
      </p>
      <% if (item.doubtful && item.doubtful.length) { %>
        <p class="q-doubt">
          Least certain: <% for (const line of item.doubtful) { %><code><%= line %></code> <% } %>
        </p>
      <% } %>
      <form class="q-form" method="post" action="/crm/notes/transcription">
        <input type="hidden" name="key" value="<%= item.key %>">
        <input type="hidden" name="file" value="<%= item.file %>">
        <textarea class="q-transcript" name="transcription" required><%= item.transcription %></textarea>
        <div><button class="btn primary" type="submit">Save my reading</button></div>
      </form>
      <form method="post" action="/crm/questions/discard" class="q-discard">
        <input type="hidden" name="key" value="<%= item.key %>">
        <input type="hidden" name="kind" value="note_transcription">
        <input type="hidden" name="question" value="<%= item.question %>">
        <input type="hidden" name="source_kind" value="document">
        <input type="hidden" name="source_id" value="<%= item.file %>">
        <button class="btn subtle" type="submit" title="Nothing worth keeping on this page">Discard</button>
      </form>
    </section>
  <% } %>
<% } %>

<% if (groups.meeting_questions.length) { %>
  <h2 style="margin:26px 0 0;font-size:15px;">From your meetings (<%= groups.counts.meeting_questions %>)</h2>
  <% for (const item of groups.meeting_questions) { %>
    <section class="section-card q-card" data-kind="meeting_question" id="q-<%= item.key %>">
      <p class="q-question"><%= item.question %></p>
      <p class="q-context">
        <a href="/crm/meeting-intake?intake=<%= item.intake_id %>"><%= item.title %></a>
        <% if (item.project_name) { %> · <a href="/crm/project/<%= item.project_slug %>"><%= item.project_name %></a><% } %>
        · raised by the meeting-intake check
      </p>
      <% if (item.context && item.context.quotes && item.context.quotes.length) { %>
        <div class="q-excerpt">
          <p class="q-excerpt-head">
            <strong><%= item.context.speaker %></strong>
            <% if (item.context.matched) { %>on this topic<% } else if (item.context.turn_count) { %>· <%= item.context.turn_count %> turn<%= item.context.turn_count === 1 ? '' : 's' %> in this meeting<% } %>
          </p>
          <% for (const quote of item.context.quotes) { %>
            <blockquote><span class="q-time"><%= quote.time %></span> <%= quote.text %></blockquote>
          <% } %>
        </div>
      <% } %>
      <form class="q-form" method="post" action="/crm/questions/answer">
        <input type="hidden" name="key" value="<%= item.key %>">
        <input type="hidden" name="intake_id" value="<%= item.intake_id %>">
        <input type="hidden" name="project_slug" value="<%= item.project_slug || '' %>">
        <input type="hidden" name="meeting_title" value="<%= item.title %>">
        <input type="hidden" name="question" value="<%= item.question %>">
        <textarea name="answer" placeholder="Answer it the way you'd tell a colleague — e.g. everyone gets 100GB" required></textarea>
        <div><button class="btn primary" type="submit">Save answer</button></div>
      </form>
      <form method="post" action="/crm/questions/discard" class="q-discard">
        <input type="hidden" name="key" value="<%= item.key %>">
        <input type="hidden" name="kind" value="meeting_question">
        <input type="hidden" name="question" value="<%= item.question %>">
        <input type="hidden" name="source_kind" value="meeting_intake">
        <input type="hidden" name="source_id" value="<%= item.intake_id %>">
        <button class="btn subtle" type="submit" title="Side chat, not a real question — never raise it again">Discard</button>
      </form>
    </section>
  <% } %>
<% } %>

<% if (groups.task_owners.length) { %>
  <h2 style="margin:26px 0 0;font-size:15px;">Actions with no known owner (<%= groups.counts.task_owners %>)</h2>
  <% for (const item of groups.task_owners) { %>
    <section class="section-card q-card" data-kind="task_owner" id="q-<%= item.key %>">
      <p class="q-question"><%= item.task %></p>
      <p class="q-context">
        transcript says <strong><%= item.owner %></strong>, who isn't a known person ·
        <a href="/crm/meeting-intake?intake=<%= item.intake_id %>"><%= item.title %></a>
        <% if (item.project_name) { %> · <a href="/crm/project/<%= item.project_slug %>"><%= item.project_name %></a><% } %>
      </p>
      <% if (item.context && item.context.quotes && item.context.quotes.length) { %>
        <div class="q-excerpt">
          <p class="q-excerpt-head">
            <strong><%= item.context.speaker %></strong>
            <% if (item.context.matched) { %>on this topic<% } else if (item.context.turn_count) { %>· <%= item.context.turn_count %> turn<%= item.context.turn_count === 1 ? '' : 's' %> in this meeting<% } %>
          </p>
          <% for (const quote of item.context.quotes) { %>
            <blockquote><span class="q-time"><%= quote.time %></span> <%= quote.text %></blockquote>
          <% } %>
        </div>
      <% } %>
      <form class="q-form" method="post" action="/crm/questions/owner">
        <input type="hidden" name="key" value="<%= item.key %>">
        <input type="hidden" name="intake_id" value="<%= item.intake_id %>">
        <input type="hidden" name="question" value="<%= item.question %>">
        <input type="hidden" name="task" value="<%= item.task %>">
        <input type="hidden" name="spoken_owner" value="<%= item.owner %>">
        <input type="hidden" name="meeting_title" value="<%= item.title %>">
        <div class="q-row">
          <label>Existing person
            <select name="contact_id">
              <option value="">Choose…</option>
              <% for (const contact of contacts) { %>
                <option value="<%= contact.id %>"><%= contact.name %></option>
              <% } %>
            </select>
          </label>
          <label>Or add them
            <input name="new_contact_name" placeholder="Full name">
          </label>
          <button class="btn primary" type="submit">Set owner</button>
        </div>
      </form>
      <form method="post" action="/crm/questions/discard" class="q-discard">
        <input type="hidden" name="key" value="<%= item.key %>">
        <input type="hidden" name="kind" value="task_owner">
        <input type="hidden" name="question" value="<%= item.question %>">
        <input type="hidden" name="source_kind" value="meeting_intake">
        <input type="hidden" name="source_id" value="<%= item.intake_id %>">
        <button class="btn subtle" type="submit" title="Side chat, not a real question — never raise it again">Discard</button>
      </form>
      <p class="q-note">"<%= item.owner %>" is kept as an alias on whoever you pick, so the next transcript matches them without asking.</p>
    </section>
  <% } %>
<% } %>

<% if (groups.person_aliases.length) { %>
  <h2 style="margin:26px 0 0;font-size:15px;">People who may be the same person (<%= groups.counts.person_aliases %>)</h2>
  <% for (const item of groups.person_aliases) { %>
    <section class="section-card q-card" data-kind="person_alias" id="q-<%= item.key %>">
      <p class="q-question"><%= item.question %></p>
      <p class="q-context">
        <% item.contact_ids.forEach((id, i) => { %>
          <a href="/crm/contact/<%= id %>"><%= item.contacts[i] %></a><%= i < item.contact_ids.length - 1 ? ' · ' : '' %>
        <% }) %>
        <% if (item.shared_projects && item.shared_projects.length) { %> · both on <%= item.shared_projects.join(', ') %><% } %>
        · flagged as <%= (item.reason || '').replace(/_/g, ' ') %>
      </p>
      <% if (item.people_context && item.people_context.length) { %>
        <div class="q-excerpt">
          <% for (const person of item.people_context) { %>
            <p class="q-excerpt-head"><strong><%= person.name %></strong></p>
            <blockquote><%= person.evidence || 'Nothing recorded about them yet.' %></blockquote>
          <% } %>
        </div>
      <% } %>
      <form class="q-form" method="post" action="/crm/questions/alias">
        <input type="hidden" name="key" value="<%= item.key %>">
        <input type="hidden" name="question" value="<%= item.question %>">
        <input type="hidden" name="contact_ids" value="<%= item.contact_ids.join(',') %>">
        <input type="hidden" name="contact_names" value="<%= item.contacts.join('|') %>">
        <% if (item.alias_overlaps && item.alias_overlaps.length) { %>
          <div class="q-row">
            <label>Also remove the clashing alias
              <select name="remove">
                <option value="">Leave aliases alone</option>
                <% for (const overlap of item.alias_overlaps) { %>
                  <option value="<%= overlap.contact_id %>::<%= overlap.alias %>">Remove "<%= overlap.alias %>" from <%= overlap.contact_name %></option>
                <% } %>
              </select>
            </label>
          </div>
        <% } %>
        <div class="q-row">
          <button class="btn primary" type="submit" name="decision" value="different_people">Different people</button>
          <button class="btn" type="submit" name="decision" value="same_person">Same person</button>
        </div>
      </form>
      <form method="post" action="/crm/questions/discard" class="q-discard">
        <input type="hidden" name="key" value="<%= item.key %>">
        <input type="hidden" name="kind" value="person_alias">
        <input type="hidden" name="question" value="<%= item.question %>">
        <input type="hidden" name="source_kind" value="contacts">
        <input type="hidden" name="source_id" value="<%= item.contact_ids.join(',') %>">
        <button class="btn subtle" type="submit" title="Side chat, not a real question — never raise it again">Discard</button>
      </form>
      <p class="q-note">Either answer stops the nightly flag. Merging two contact records is not automated — if they're the same person, the records still need combining by hand.</p>
    </section>
  <% } %>
<% } %>

<% if (answered.length) { %>
  <details class="section-card q-answered" style="margin-top:26px;">
    <summary><%= answered.length %> already answered</summary>
    <ul>
      <% for (const row of answered.slice(0, 40)) {
        let discarded = false;
        try { discarded = JSON.parse(row.resolution || '{}').decision === 'discarded'; } catch (e) { discarded = false; }
      %>
        <li>
          <strong><%= row.question %></strong><br>
          <%= row.answer %>
          <span class="crm-muted">· <%= new Date(row.created_at * 1000).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></span>
          <% if (discarded) { %>
            <form method="post" action="/crm/questions/restore" style="display:inline;margin-left:6px;">
              <input type="hidden" name="key" value="<%= row.question_key %>">
              <button class="btn subtle" type="submit" style="font-size:11px;padding:2px 8px;">Restore</button>
            </form>
          <% } %>
        </li>
      <% } %>
    </ul>
  </details>
<% } %>

<%- include('partials/crm-foot') %>
