<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Humaniser · McLellan Hub</title>
<link rel="stylesheet" href="/hub.css">
<style>
body.hub-page { height: auto !important; min-height: 100vh; overflow: auto !important; background: var(--bg-page, #f4f3fb); }
.hz-wrap { max-width: 1180px; margin: 0 auto; padding: 28px 16px 90px; }
.hz-kicker { color: var(--accent); background: var(--accent-light); border-radius: 999px; padding: 5px 10px; font-family: var(--mono); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; display:inline-flex; margin-bottom: 12px; }
.hz-title { font-size: clamp(30px, 5vw, 48px); line-height: 1; margin: 0; }
.hz-lead { color: var(--text-dim); max-width: 780px; margin-top: 12px; font-size: 15px; line-height: 1.6; }
.hz-controls { display:flex; gap:14px; flex-wrap:wrap; align-items:flex-end; margin: 22px 0 14px; }
.hz-field { display:flex; flex-direction:column; gap:5px; }
.hz-field label { font-size: 11px; font-family: var(--mono); font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); }
.hz-field input, .hz-field select { padding: 9px 11px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); font-size: 14px; font-family: inherit; }
.hz-field input { min-width: 280px; }
.hz-grid { display:grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items:start; }
@media (max-width: 900px) { .hz-grid { grid-template-columns: 1fr; } }
.hz-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow-sm); overflow:hidden; }
.hz-panel-head { display:flex; justify-content:space-between; align-items:center; gap:12px; padding: 12px 14px; border-bottom: 1px solid var(--border); }
.hz-panel-head h2 { margin:0; font-size: 15px; }
.hz-panel-head .hz-meta { color: var(--text-dim); font-size: 12px; font-family: var(--mono); }
textarea#src { width:100%; box-sizing:border-box; border:none; padding:14px; min-height: 340px; resize:vertical; font-size: 14px; line-height: 1.6; font-family: var(--mono); background: transparent; color: var(--text); }
textarea#src:focus { outline: none; }
#outText { padding:14px; min-height: 340px; white-space: pre-wrap; font-size: 14px; line-height: 1.7; }
#outText:empty::before { content: "Your humanised draft will appear here."; color: var(--text-muted); }
.hz-marker { background: rgba(232,160,0,.16); border-bottom: 1px dashed rgba(232,160,0,.7); padding: 0 2px; border-radius: 3px; font-weight: 600; }
.hz-btn { appearance:none; border:none; cursor:pointer; border-radius: 10px; padding: 11px 18px; font-size: 14px; font-weight: 700; font-family: inherit; }
.hz-btn.primary { background: var(--accent); color:#fff; }
.hz-btn.primary:disabled { opacity:.55; cursor:default; }
.hz-btn.ghost { background: var(--surface); border: 1px solid var(--border); color: var(--text-dim); padding: 8px 12px; font-size: 12px; }
.hz-actions { display:flex; gap:10px; align-items:center; }
.hz-report { margin-top: 18px; }
.hz-stats { display:flex; gap:10px; flex-wrap:wrap; margin: 4px 0 16px; }
.hz-stat { background: var(--surface); border:1px solid var(--border); border-radius: 10px; padding: 9px 12px; min-width: 110px; }
.hz-stat .k { font-size: 10px; font-family: var(--mono); text-transform:uppercase; letter-spacing:.06em; color: var(--text-muted); }
.hz-stat .v { font-size: 18px; font-weight: 700; margin-top: 3px; }
.hz-stat .d { font-size: 11px; color: var(--text-dim); margin-top: 2px; }
.risk-high { color:#a33b31; } .risk-medium { color:#8a5a00; } .risk-low { color:#0f6b3a; }
.hz-changes { display:grid; gap:8px; }
.hz-change { background: var(--surface); border:1px solid var(--border); border-radius: 10px; padding: 11px 13px; }
.hz-change .tag { display:inline-flex; font-size:10px; font-family: var(--mono); font-weight:700; text-transform:uppercase; letter-spacing:.05em; color: var(--accent); background: var(--accent-light); border-radius:999px; padding:3px 8px; margin-bottom:7px; }
.hz-change .layer { display:inline-flex; font-size:9px; font-family: var(--mono); font-weight:700; text-transform:uppercase; letter-spacing:.05em; border-radius:999px; padding:3px 7px; margin: 0 0 7px 6px; }
.hz-change .layer.surface { color:#5a4a00; background: rgba(232,160,0,.14); }
.hz-change .layer.discourse { color:#1f4d7a; background: rgba(31,77,122,.12); }
.hz-change .ba { font-size: 13px; line-height:1.5; }
.hz-change .ba del { color:#a33b31; text-decoration: line-through; opacity:.8; }
.hz-change .ba ins { color:#0f6b3a; text-decoration: none; }
.hz-change .why { color: var(--text-dim); font-size: 12px; margin-top: 6px; }
.hz-note { color: var(--text-dim); font-size: 12px; margin-top: 8px; font-style: italic; }
.hz-err { color:#a33b31; font-size: 13px; margin-top: 10px; }
.hz-spin { display:none; }
.loading .hz-spin { display:inline; }
.loading .hz-btn-label { display:none; }
.hz-disclaimer { margin-top: 22px; padding: 12px 14px; border:1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 8px; background: var(--surface); color: var(--text-dim); font-size: 12.5px; line-height: 1.6; max-width: 900px; }
</style>
</head>
<body class="hub-page">
<%- include('partials/top-nav') %>
<div class="hz-wrap">
  <span class="hz-kicker">Editing tool</span>
  <h1 class="hz-title">AI Text Humaniser</h1>
  <p class="hz-lead">Paste AI-generated prose and it gets redrafted to read like a person wrote it. It edits two layers: the six <strong>surface</strong> tells (rule of three, uniform sentence length, predictable transitions, flat tone, thesaurus vocabulary, surface generality) and six <strong>discourse</strong> tells that survive surface edits — over-explaining, moralising, somatic emotion, sensory over-writing, rigid chronological order, and writing as if no one is reading. It never fabricates data or sources; where a specific figure or reference would help it flags a spot for you to fill in.</p>

  <div class="hz-controls">
    <div class="hz-field">
      <label for="field">Field / register</label>
      <input id="field" type="text" placeholder="e.g. clinical care, M365 consulting, academic chemistry" value="">
    </div>
    <div class="hz-field">
      <label for="aggressiveness">Intensity</label>
      <select id="aggressiveness">
        <option value="light">Light — clearest tells only</option>
        <option value="balanced" selected>Balanced — thorough pass</option>
        <option value="heavy">Heavy — restructure rhythm</option>
      </select>
    </div>
    <button id="run" class="hz-btn primary"><span class="hz-btn-label">Humanise</span><span class="hz-spin">Working…</span></button>
  </div>

  <div class="hz-grid">
    <div class="hz-panel">
      <div class="hz-panel-head">
        <h2>AI input</h2>
        <span class="hz-meta"><span id="srcCount">0</span> / <%= maxChars %></span>
      </div>
      <textarea id="src" placeholder="Paste the AI-generated text here…"></textarea>
    </div>
    <div class="hz-panel">
      <div class="hz-panel-head">
        <h2>Humanised draft</h2>
        <div class="hz-actions">
          <button id="copy" class="hz-btn ghost" disabled>Copy</button>
        </div>
      </div>
      <div id="outText"></div>
    </div>
  </div>

  <div id="err" class="hz-err"></div>

  <div id="report" class="hz-report" hidden>
    <div class="hz-stats" id="stats"></div>
    <h2 style="font-size:16px; margin: 6px 0 10px;">What changed</h2>
    <div class="hz-changes" id="changes"></div>
    <p class="hz-note" id="riskNote"></p>
  </div>

  <div class="hz-disclaimer">
    AI-detector scores (Originality.ai, Turnitin, GPTZero) are probabilistic and unreliable — they produce false positives on genuine human writing and can be fooled by edited AI text. Treat any "risk" estimate here as a rough guide, not a guarantee, and use this to make AI drafts read better, not to misrepresent authorship where that matters (e.g. academic submissions).
  </div>
</div>

<script>
(() => {
  const $ = id => document.getElementById(id);
  const src = $('src'), out = $('outText'), runBtn = $('run'), copyBtn = $('copy');
  const err = $('err'), report = $('report'), stats = $('stats'), changes = $('changes');
  const MAX = <%= maxChars %>;

  const esc = s => String(s == null ? '' : s).replace(/[&<>]/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;' }[c]));
  const highlightMarkers = html =>
    html.replace(/\[ADD SPECIFIC (?:FIGURE|SOURCE):[^\]]*\]/gi, m => `<span class="hz-marker">${m}</span>`);

  src.addEventListener('input', () => { $('srcCount').textContent = src.value.length; });

  const PATTERN_LABEL = {
    rule_of_three: 'Rule of three', burstiness: 'Burstiness', transitions: 'Transitions',
    nuance: 'Nuance', vocabulary: 'Vocabulary', surface_depth: 'Depth',
    over_explanation: 'Over-explanation', moralising: 'Moralising', emotion_naming: 'Emotion naming',
    sensory_density: 'Sensory density', presentation_order: 'Presentation order', audience_address: 'Audience address',
  };
  const SURFACE_PATTERNS = new Set(['rule_of_three', 'burstiness', 'transitions', 'nuance', 'vocabulary', 'surface_depth']);
  const layerOf = c => c.layer === 'surface' || c.layer === 'discourse'
    ? c.layer : (SURFACE_PATTERNS.has(c.pattern) ? 'surface' : 'discourse');
  const riskClass = r => r === 'high' ? 'risk-high' : r === 'medium' ? 'risk-medium' : r === 'low' ? 'risk-low' : '';

  function renderStats(r) {
    const b = r.scan_before || {}, a = r.scan_after || {};
    const db = r.scan_discourse_before || {}, da = r.scan_discourse_after || {};
    const rows = [
      ['Detector risk', `<span class="${riskClass(r.estimated_detector_risk_before)}">${esc(r.estimated_detector_risk_before)}</span> → <span class="${riskClass(r.estimated_detector_risk_after)}">${esc(r.estimated_detector_risk_after)}</span>`, 'model estimate'],
      ['Burstiness', `${esc(b.burstiness)} → ${esc(a.burstiness)}`, 'sentence variety (higher = human)'],
      ['Rule-of-three', `${esc(b.rule_of_three_count)} → ${esc(a.rule_of_three_count)}`, 'triad lists remaining'],
      ['Transition openers', `${esc(b.transition_openers)} → ${esc(a.transition_openers)}`, 'However/Therefore/etc.'],
      ['Wordy terms', `${(b.wordy_terms||[]).length} → ${(a.wordy_terms||[]).length}`, 'thesaurus vocabulary'],
      ['Discourse flags', `${esc(db.flags_raised)} → ${esc(da.flags_raised)}`, 'structural AI tells raised'],
      ['Moralising', `${esc(db.moralising_count)} → ${esc(da.moralising_count)}`, 'stated-lesson sentences'],
      ['Over-explanation', `${esc(db.over_explanation_count)} → ${esc(da.over_explanation_count)}`, '"which means…" explainers'],
    ];
    stats.innerHTML = rows.map(([k, v, d]) =>
      `<div class="hz-stat"><div class="k">${k}</div><div class="v">${v}</div><div class="d">${d}</div></div>`).join('');
  }

  function renderChanges(list) {
    if (!list.length) { changes.innerHTML = '<p class="hz-note">The model reported no major structural edits.</p>'; return; }
    changes.innerHTML = list.map(c => {
      const layer = layerOf(c);
      return `
      <div class="hz-change">
        <span class="tag">${esc(PATTERN_LABEL[c.pattern] || c.pattern)}</span><span class="layer ${layer}">${layer}</span>
        <div class="ba"><del>${esc(c.before)}</del> <ins>${esc(c.after)}</ins></div>
        ${c.why ? `<div class="why">${esc(c.why)}</div>` : ''}
      </div>`;
    }).join('');
  }

  async function run() {
    err.textContent = '';
    const text = src.value.trim();
    if (!text) { err.textContent = 'Paste some AI-generated text first.'; return; }
    if (text.length > MAX) { err.textContent = `Text is too long (${text.length}). Limit is ${MAX}.`; return; }
    runBtn.disabled = true; document.body.classList.add('loading');
    out.textContent = ''; report.hidden = true; copyBtn.disabled = true;
    try {
      const resp = await fetch('/api/humanize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text, field: $('field').value, aggressiveness: $('aggressiveness').value }),
      });
      // A gateway/restart blip returns an HTML error page, not JSON — parsing it
      // gave the cryptic "Unexpected token '<'". Detect that and say so plainly.
      const ct = resp.headers.get('content-type') || '';
      if (!ct.includes('application/json')) {
        throw new Error(resp.status >= 500
          ? `The server was briefly unavailable (${resp.status}) — this can happen for a moment during a deploy. Please try again.`
          : `Unexpected response from the server (${resp.status}). Please try again.`);
      }
      const data = await resp.json();
      if (!resp.ok) throw new Error(data.error || `Request failed (${resp.status})`);
      out.dataset.raw = data.humanized_text;
      out.innerHTML = highlightMarkers(esc(data.humanized_text));
      copyBtn.disabled = false;
      renderStats(data);
      renderChanges(data.changes || []);
      $('riskNote').textContent = data.risk_note || '';
      report.hidden = false;
    } catch (e) {
      err.textContent = e.message;
    } finally {
      runBtn.disabled = false; document.body.classList.remove('loading');
    }
  }

  runBtn.addEventListener('click', run);
  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(out.dataset.raw || out.textContent);
      copyBtn.textContent = 'Copied'; setTimeout(() => copyBtn.textContent = 'Copy', 1400);
    } catch { /* clipboard blocked */ }
  });
})();
</script>
</body>
</html>
