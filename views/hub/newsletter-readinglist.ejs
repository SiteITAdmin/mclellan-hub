<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= feed.name %> — Reading List</title>
<link rel="stylesheet" href="/hub.css">
<style>
* { box-sizing: border-box; }
body { background: var(--bg-page, #f4f3fb); font-family: Georgia, 'Times New Roman', serif; margin: 0; }
.reader-wrap { max-width: 680px; margin: 0 auto; padding: 40px 20px 120px; }
.reader-nav { font-family: system-ui, sans-serif; font-size: 13px; color: var(--text-dim, #767586); display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 8px; }
.reader-nav a { color: inherit; text-decoration: none; }
.reader-nav a:hover { color: var(--primary, #7c6af5); }
.page-heading { font-family: system-ui, sans-serif; font-size: 22px; font-weight: 700; margin: 0 0 6px; }
.page-sub { font-family: system-ui, sans-serif; font-size: 13px; color: var(--text-dim); margin: 0 0 12px; }
.toc { font-family: system-ui, sans-serif; background: var(--bg, #faf9fb); border: 1px solid var(--border, #dddaf0); border-radius: 10px; padding: 16px 20px; margin-bottom: 48px; }
.toc h2 { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-dim); margin: 0 0 10px; }
.toc ol { margin: 0; padding-left: 20px; }
.toc li { font-size: 13px; margin-bottom: 5px; }
.toc a { color: var(--primary, #7c6af5); text-decoration: none; }
.toc a:hover { text-decoration: underline; }
.toc-date { color: var(--text-dim); font-size: 11px; margin-left: 6px; }
.article-entry { margin-bottom: 72px; }
.article-entry + .article-entry { border-top: 2px solid var(--border, #dddaf0); padding-top: 64px; }
.article-title { font-size: clamp(20px, 3.5vw, 28px); font-weight: 700; line-height: 1.25; margin: 0 0 12px; font-family: system-ui, sans-serif; }
.article-title a { color: inherit; text-decoration: none; }
.article-meta { font-family: system-ui, sans-serif; font-size: 13px; color: var(--text-dim); margin-bottom: 28px; display: flex; gap: 16px; flex-wrap: wrap; }
.article-meta a { color: inherit; }
.article-body { font-size: 18px; line-height: 1.75; color: var(--text, #15131e); }
.article-body h1, .article-body h2, .article-body h3 { font-family: system-ui, sans-serif; margin: 2em 0 0.5em; line-height: 1.3; }
.article-body h1 { font-size: 1.4em; }
.article-body h2 { font-size: 1.2em; }
.article-body h3 { font-size: 1.05em; }
.article-body p { margin: 0 0 1.2em; }
.article-body ul, .article-body ol { margin: 0 0 1.2em; padding-left: 1.6em; }
.article-body li { margin-bottom: 0.4em; }
.article-body strong { font-weight: 700; }
.article-body em { font-style: italic; }
.article-body a { color: var(--primary, #7c6af5); }
.article-body blockquote { border-left: 3px solid var(--primary, #7c6af5); margin: 1.5em 0; padding: 0.5em 1.2em; color: var(--text-dim); font-style: italic; }
.article-body hr { border: none; border-top: 1px solid var(--border, #dddaf0); margin: 2em 0; }
.article-body code { font-family: monospace; background: var(--bg, #faf9fb); border: 1px solid var(--border, #dddaf0); border-radius: 4px; padding: 1px 5px; font-size: 0.85em; }
.back-to-top { font-family: system-ui, sans-serif; font-size: 12px; color: var(--text-dim); text-decoration: none; display: block; text-align: right; margin-top: 32px; }
@media (max-width: 600px) { .reader-wrap { padding: 24px 16px 80px; } .article-body { font-size: 17px; } }
</style>
</head>
<body>
<%- include('partials/top-nav') %>
<div class="reader-wrap">
  <nav class="reader-nav">
    <a href="/newsletter/creator/<%= feed.creator_slug %>">← <%= feed.name %></a>
    <span><%= articles.length %> articles · <%= articles.reduce((s, a) => s + (a.word_count || 0), 0).toLocaleString() %> words total</span>
  </nav>

  <h1 class="page-heading"><%= feed.name %></h1>
  <p class="page-sub">Full reading list — load this page before going offline.</p>

  <% if (articles.length > 1) { %>
  <div class="toc" id="top">
    <h2>Contents</h2>
    <ol>
      <% for (const a of articles) { %>
        <li>
          <a href="#article-<%= a.id %>"><%= a.title %></a>
          <span class="toc-date"><%= new Date(a.published_at * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %></span>
        </li>
      <% } %>
    </ol>
  </div>
  <% } %>

  <% for (const a of articles) { %>
    <div class="article-entry" id="article-<%= a.id %>">
      <h2 class="article-title">
        <a href="/newsletter/creator/<%= feed.creator_slug %>/article/<%= a.id %>"><%= a.title %></a>
      </h2>
      <div class="article-meta">
        <span><%= new Date(a.published_at * 1000).toLocaleDateString('en-GB', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %></span>
        <span><%= a.word_count %> words</span>
        <a href="<%= a.url %>" target="_blank" rel="noopener">Substack ↗</a>
      </div>
      <div class="article-body"><%- markdownToHtml(a.content_markdown) %></div>
      <% if (articles.length > 1) { %>
        <a class="back-to-top" href="#top">↑ Back to contents</a>
      <% } %>
    </div>
  <% } %>

  <% if (!articles.length) { %>
    <p style="font-family:system-ui;color:var(--text-dim)">No articles fetched yet.</p>
  <% } %>
</div>
</body>
</html>
