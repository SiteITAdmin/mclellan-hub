<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dublin ↔ Edinburgh Flights</title>
<link rel="stylesheet" href="/hub.css">
<style>
body.hub-page { height: auto !important; min-height: 100vh; overflow: auto !important; }

.fl-wrap { max-width: 1100px; margin: 0 auto; padding: 28px 16px 80px; }

.fl-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 28px; gap: 12px; flex-wrap: wrap;
}
.fl-header-left { display: flex; flex-direction: column; gap: 4px; }
.fl-back { font-size: 12px; color: var(--text-muted); text-decoration: none; }
.fl-back:hover { color: var(--accent); text-decoration: none; }
.fl-title { font-size: 22px; font-weight: 700; font-family: var(--serif); margin: 0; }
.fl-subtitle { font-size: 13px; color: var(--text-dim); margin: 0; }

.fl-add-btn {
  background: var(--accent); color: var(--accent-ink);
  border: none; border-radius: 10px; padding: 10px 18px;
  font-size: 14px; font-weight: 600; font-family: var(--font);
  cursor: pointer; transition: background .15s; white-space: nowrap;
}
.fl-add-btn:hover { background: var(--accent-hover); }

/* ── Stats cards ──────────────────────────────────────────────────────────── */
.fl-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; margin-bottom: 20px; }
.fl-reality-section { margin-top: 24px; margin-bottom: 20px; }
.fl-reality-heading {
  font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
  color: var(--text-muted); margin-bottom: 10px; padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
}
.fl-reality-note {
  font-size: 12px; color: var(--text-muted); margin-top: 10px; line-height: 1.5;
}

.fl-stat {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 12px; padding: 16px 18px;
  display: flex; flex-direction: column; gap: 4px;
}
.fl-stat-value { font-size: 28px; font-weight: 700; font-family: var(--serif); line-height: 1.1; }
.fl-stat-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); }
.fl-stat-sub { font-size: 12px; color: var(--text-dim); }
.fl-stat.good .fl-stat-value { color: var(--success); }
.fl-stat.warn .fl-stat-value { color: #c87800; }
.fl-stat.bad  .fl-stat-value { color: var(--error); }

/* ── Direction row ────────────────────────────────────────────────────────── */
.fl-dir-row { display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; }
.fl-dir-chip {
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: 20px; padding: 6px 14px; font-size: 13px; font-weight: 600;
  display: flex; align-items: center; gap: 8px;
}
.fl-dir-chip .count { color: var(--accent); font-size: 15px; }

/* ── Table ────────────────────────────────────────────────────────────────── */
.fl-table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; }

table.fl-table { min-width: 820px; border-collapse: collapse; font-size: 13px; }
table.fl-table thead { background: var(--surface2); }
table.fl-table th {
  padding: 10px 12px; text-align: left; font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted);
  border-bottom: 1px solid var(--border); white-space: nowrap;
}
table.fl-table td {
  padding: 11px 12px; border-bottom: 1px solid var(--border);
  vertical-align: middle; color: var(--text);
}
table.fl-table tbody tr:last-child td { border-bottom: none; }
table.fl-table tbody tr:hover { background: var(--surface2); }

.fl-date {
  white-space: nowrap; font-weight: 600; min-width: 100px;
  position: sticky; left: 0; z-index: 1;
  background: var(--surface, #fff);
}
table.fl-table thead th:first-child {
  position: sticky; left: 0; z-index: 2;
  background: var(--surface2);
}
.fl-flnr { font-family: var(--mono); font-size: 12px; font-weight: 600; }
.fl-flnr a { color: var(--text); }
.fl-flnr a:hover { color: var(--accent); text-decoration: underline; }

.fl-dir-badge {
  display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px;
  font-weight: 700; letter-spacing: .04em; white-space: nowrap;
}
.fl-dir-badge.dub-edi { background: rgba(70,72,212,.1); color: #3537b8; }
.fl-dir-badge.edi-dub { background: rgba(47,138,90,.12); color: #217a4d; }
.fl-dir-badge.dub-gla { background: rgba(200,100,0,.1); color: #904000; }
.fl-dir-badge.gla-dub { background: rgba(140,60,160,.1); color: #6a1a80; }

.fl-time-cell { white-space: nowrap; }
.fl-time-row { display: flex; align-items: center; gap: 6px; }
.fl-time-sched { color: var(--text-dim); font-size: 12px; }
.fl-time-actual { font-weight: 600; }
.fl-delay {
  display: inline-block; padding: 1px 6px; border-radius: 8px;
  font-size: 11px; font-weight: 700; white-space: nowrap;
}
.fl-delay.on-time  { background: rgba(47,138,90,.12); color: #217a4d; }
.fl-delay.minor    { background: rgba(232,160,0,.12); color: #8a5a00; }
.fl-delay.major    { background: rgba(220,90,0,.12); color: #a03000; }
.fl-delay.severe   { background: rgba(196,52,43,.12); color: var(--error); }
.fl-delay.early    { background: rgba(47,138,90,.08); color: #217a4d; }
.fl-delay.unknown  { background: var(--surface3); color: var(--text-muted); }

.fl-status-badge {
  display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 700;
}
.fl-status-badge.completed  { background: rgba(47,138,90,.1); color: #217a4d; }
.fl-status-badge.cancelled  { background: rgba(196,52,43,.1); color: var(--error); }
.fl-status-badge.diverted   { background: rgba(232,160,0,.12); color: #8a5a00; }

.fl-actions { display: flex; gap: 6px; align-items: center; white-space: nowrap; }
.fl-icon-btn {
  background: none; border: 1px solid var(--border); border-radius: 7px;
  padding: 4px 8px; font-size: 12px; cursor: pointer; color: var(--text-dim);
  font-family: var(--font); transition: border-color .12s, color .12s;
}
.fl-icon-btn:hover { border-color: var(--accent); color: var(--accent); }
.fl-icon-btn.danger:hover { border-color: var(--error); color: var(--error); }
.fl-link-btn {
  font-size: 11px; color: var(--accent); text-decoration: none;
  border: 1px solid var(--border); border-radius: 7px; padding: 3px 7px;
  white-space: nowrap;
}
.fl-link-btn:hover { border-color: var(--accent); text-decoration: none; }

.fl-notes-cell { max-width: 200px; color: var(--text-dim); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.fl-empty { padding: 48px 24px; text-align: center; color: var(--text-dim); }
.fl-empty p { margin: 0 0 16px; font-size: 15px; }

/* ── Modal ────────────────────────────────────────────────────────────────── */
.fl-backdrop {
  display: none; position: fixed; inset: 0; background: rgba(0,0,0,.35);
  z-index: 200; align-items: center; justify-content: center;
}
.fl-backdrop.open { display: flex; }

.fl-modal {
  background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
  padding: 28px 28px 24px; width: 100%; max-width: 560px;
  max-height: 90vh; overflow-y: auto;
  box-shadow: 0 8px 40px rgba(70,72,212,.12);
}
.fl-modal h3 { font-size: 18px; margin: 0 0 20px; font-family: var(--serif); }

.fl-form { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
.fl-form .full { grid-column: 1 / -1; }

.fl-field { display: flex; flex-direction: column; gap: 5px; }
.fl-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); }

.fl-input, .fl-select {
  padding: 9px 11px; border: 1px solid var(--border); border-radius: 9px;
  font-size: 14px; font-family: var(--font); background: var(--surface2); color: var(--text);
  width: 100%;
}
.fl-input:focus, .fl-select:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
.fl-select { cursor: pointer; }

.fl-times { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.fl-modal-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
.fl-btn-cancel {
  background: none; border: 1px solid var(--border); border-radius: 9px;
  padding: 9px 18px; font-size: 14px; font-family: var(--font); cursor: pointer;
  color: var(--text-dim); transition: border-color .12s;
}
.fl-btn-cancel:hover { border-color: var(--text-dim); }
.fl-btn-save {
  background: var(--accent); color: var(--accent-ink); border: none;
  border-radius: 9px; padding: 9px 22px; font-size: 14px; font-weight: 600;
  font-family: var(--font); cursor: pointer; transition: background .15s;
}
.fl-btn-save:hover { background: var(--accent-hover); }
.fl-btn-save:disabled { opacity: .5; cursor: default; }

.fl-status-msg { font-size: 13px; color: var(--text-dim); margin-top: 8px; min-height: 18px; }

/* ── Tracker / API note ───────────────────────────────────────────────────── */
.fl-tracker-note {
  background: var(--surface2); border: 1px solid var(--border); border-radius: 10px;
  padding: 12px 14px; margin-bottom: 12px; font-size: 13px; color: var(--text-dim); line-height: 1.6;
}
.fl-tracker-note a { color: var(--accent); }

.fl-api-bar {
  display: flex; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;
}
.fl-fetch-btn {
  background: var(--surface); color: var(--accent); border: 1px solid var(--accent);
  border-radius: 10px; padding: 8px 16px; font-size: 13px; font-weight: 600;
  font-family: var(--font); cursor: pointer; transition: background .15s;
}
.fl-fetch-btn:hover { background: var(--accent-light); }
.fl-fetch-btn:disabled { opacity: .5; cursor: default; }
.fl-api-status { font-size: 13px; color: var(--text-dim); }

/* ── Look up button inside modal ─────────────────────────────────────────── */
.fl-lookup-row {
  display: flex; align-items: center; gap: 10px; grid-column: 1 / -1;
  border-top: 1px solid var(--border); padding-top: 14px; margin-top: 2px; flex-wrap: wrap;
}
.fl-lookup-btn {
  background: var(--surface2); color: var(--accent); border: 1px solid var(--border);
  border-radius: 9px; padding: 7px 14px; font-size: 13px; font-weight: 600;
  font-family: var(--font); cursor: pointer; transition: border-color .12s;
}
.fl-lookup-btn:hover { border-color: var(--accent); }
.fl-lookup-btn:disabled { opacity: .5; cursor: default; }
.fl-lookup-status { font-size: 12px; color: var(--text-dim); }

@media (max-width: 600px) {
  .fl-form { grid-template-columns: 1fr; }
  .fl-form .full { grid-column: 1; }
  .fl-modal { padding: 20px 16px 18px; }
}
</style>
</head>
<body class="hub-page" style="background: var(--bg-page, #f4f3fb);">
<main>
<div class="fl-wrap">

  <!-- Header -->
  <div class="fl-header">
    <div class="fl-header-left">
      <a href="/_home" class="fl-back">← Hub home</a>
      <h1 class="fl-title">Dublin ↔ Edinburgh Flights</h1>
      <p class="fl-subtitle">Personal flight log — scheduled vs actual times, delay tracking</p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button class="fl-add-btn" style="background:var(--surface);color:var(--accent);border:1px solid var(--accent);" id="import-btn">Import Excel</button>
      <button class="fl-add-btn" id="add-flight-btn">+ Add flight</button>
    </div>
  </div>

  <!-- Stats -->
  <div class="fl-stats">
    <div class="fl-stat">
      <div class="fl-stat-value"><%= stats.total %></div>
      <div class="fl-stat-label">Total flights</div>
      <div class="fl-stat-sub"><%= stats.cancelled %> cancelled</div>
    </div>

    <% if (stats.onTimePct !== null) { %>
    <div class="fl-stat <%= stats.onTimePct >= 75 ? 'good' : stats.onTimePct >= 50 ? 'warn' : 'bad' %>">
      <div class="fl-stat-value"><%= stats.onTimePct %>%</div>
      <div class="fl-stat-label">On time</div>
      <div class="fl-stat-sub">≤5 min late · <%= stats.onTimeSample %> flights with data</div>
    </div>
    <% } else { %>
    <div class="fl-stat">
      <div class="fl-stat-value" style="color:var(--text-muted)">—</div>
      <div class="fl-stat-label">On time</div>
      <div class="fl-stat-sub">No arrival data yet</div>
    </div>
    <% } %>

    <% if (stats.avgArrDelay !== null) { %>
    <div class="fl-stat <%= stats.avgArrDelay <= 0 ? 'good' : stats.avgArrDelay <= 20 ? 'warn' : 'bad' %>">
      <div class="fl-stat-value"><%= stats.avgArrDelay > 0 ? '+' : '' %><%= stats.avgArrDelay %>m</div>
      <div class="fl-stat-label">Avg arrival delay</div>
      <div class="fl-stat-sub"><%= stats.onTimeSample %> flights with data</div>
    </div>
    <% } else { %>
    <div class="fl-stat">
      <div class="fl-stat-value" style="color:var(--text-muted)">—</div>
      <div class="fl-stat-label">Avg arrival delay</div>
      <div class="fl-stat-sub">No data yet</div>
    </div>
    <% } %>

    <% if (stats.worstArrDelay !== null) { %>
    <div class="fl-stat <%= stats.worstArrDelay <= 15 ? 'good' : stats.worstArrDelay <= 60 ? 'warn' : 'bad' %>">
      <div class="fl-stat-value">+<%= stats.worstArrDelay %>m</div>
      <div class="fl-stat-label">Worst delay</div>
      <div class="fl-stat-sub">Longest arrival delay</div>
    </div>
    <% } else { %>
    <div class="fl-stat">
      <div class="fl-stat-value" style="color:var(--text-muted)">—</div>
      <div class="fl-stat-label">Worst delay</div>
      <div class="fl-stat-sub">No data yet</div>
    </div>
    <% } %>

    <div class="fl-stat">
      <div class="fl-stat-value" style="font-size:22px">FR</div>
      <div class="fl-stat-label">Ryanair</div>
      <div class="fl-stat-sub"><%= stats.ryanair.count %> flights
        <% if (stats.ryanair.onTimePct !== null) { %> · <%= stats.ryanair.onTimePct %>% on time (<%= stats.ryanair.sample %> with data)<% } %></div>
    </div>

    <div class="fl-stat">
      <div class="fl-stat-value" style="font-size:22px">EI</div>
      <div class="fl-stat-label">Aer Lingus</div>
      <div class="fl-stat-sub"><%= stats.aerLingus.count %> flights
        <% if (stats.aerLingus.onTimePct !== null) { %> · <%= stats.aerLingus.onTimePct %>% on time (<%= stats.aerLingus.sample %> with data)<% } %></div>
    </div>
  </div>

  <!-- Direction split -->
  <div class="fl-dir-row">
    <div class="fl-dir-chip"><span>DUB → EDI</span><span class="count"><%= stats.dubToEdi %></span></div>
    <div class="fl-dir-chip"><span>EDI → DUB</span><span class="count"><%= stats.ediToDub %></span></div>
    <% if (stats.dubToGla > 0) { %>
    <div class="fl-dir-chip"><span>DUB → GLA</span><span class="count"><%= stats.dubToGla %></span></div>
    <% } %>
    <% if (stats.glaToDub > 0) { %>
    <div class="fl-dir-chip"><span>GLA → DUB</span><span class="count"><%= stats.glaToDub %></span></div>
    <% } %>
  </div>

  <!-- Schedule vs reality -->
  <% if (stats.avgActualDuration !== null) { %>
  <div class="fl-reality-section">
    <div class="fl-reality-heading">Schedule vs reality</div>
    <div class="fl-stats" style="margin-bottom:0">

      <div class="fl-stat good">
        <div class="fl-stat-value"><%= stats.avgActualDuration %>m</div>
        <div class="fl-stat-label">Avg actual flight</div>
        <div class="fl-stat-sub">Gate to gate · <%= stats.avgActualDuration < 60 ? stats.avgActualDuration + ' min' : Math.floor(stats.avgActualDuration/60) + 'h ' + (stats.avgActualDuration%60) + 'm' %></div>
      </div>

      <div class="fl-stat warn">
        <div class="fl-stat-value"><%= stats.avgSchedDuration !== null ? (Math.floor(stats.avgSchedDuration/60) + 'h ' + (stats.avgSchedDuration%60) + 'm') : '—' %></div>
        <div class="fl-stat-label">Advertised block time</div>
        <div class="fl-stat-sub">What you're sold on the booking</div>
      </div>

      <div class="fl-stat <%= stats.bufferMinutes > 15 ? 'warn' : '' %>">
        <div class="fl-stat-value">+<%= stats.bufferMinutes %>m</div>
        <div class="fl-stat-label">Built-in buffer</div>
        <div class="fl-stat-sub">Per flight · boosts airline on-time stats</div>
      </div>

      <% if (stats.depOnTimePct !== null) { %>
      <div class="fl-stat <%= stats.depOnTimePct >= 75 ? 'good' : stats.depOnTimePct >= 50 ? 'warn' : 'bad' %>">
        <div class="fl-stat-value"><%= stats.depOnTimePct %>%</div>
        <div class="fl-stat-label">Departed on time</div>
        <div class="fl-stat-sub">≤5 min after sched dep · <%= stats.depOnTimeSample %> flights</div>
      </div>
      <% } %>

      <% if (stats.realOnTimePct !== null) { %>
      <div class="fl-stat <%= stats.realOnTimePct >= 75 ? 'good' : stats.realOnTimePct >= 50 ? 'warn' : 'bad' %>">
        <div class="fl-stat-value"><%= stats.realOnTimePct %>%</div>
        <div class="fl-stat-label">On time — fair measure</div>
        <div class="fl-stat-sub">Landed within sched dep + <%= stats.avgActualDuration %>m + 5 · <%= stats.realLateSample %> flights</div>
      </div>
      <% } %>

      <% if (stats.onTimePct !== null) { %>
      <div class="fl-stat <%= stats.onTimePct >= 75 ? 'good' : stats.onTimePct >= 50 ? 'warn' : 'bad' %>">
        <div class="fl-stat-value"><%= stats.onTimePct %>%</div>
        <div class="fl-stat-label">On time — airline's claim</div>
        <div class="fl-stat-sub">Landed ≤5 min after padded arrival · <%= stats.onTimeSample %> flights</div>
      </div>
      <% } %>

    </div>
    <p class="fl-reality-note">
      Both airlines schedule <%= stats.avgSchedDuration !== null ? Math.floor(stats.avgSchedDuration/60) + 'h ' + (stats.avgSchedDuration%60) + 'm' : '~1h 07m' %> for a route that consistently takes <%= stats.avgActualDuration %>m in the air.
      The <%= stats.bufferMinutes %>-minute buffer means a plane can push back late and still clock as "on time" — which is exactly what's happening.
    </p>
  </div>
  <% } %>

  <!-- API / tracker note -->
  <div class="fl-tracker-note">
    Add your flights using just the flight number + date from your Ryanair app, then click
    <strong>Fetch missing times</strong> to auto-fill actual times via Flightradar24.
    Ryanair: FR#### · Aer Lingus: EI### · easyJet: U2####.
  </div>

  <div class="fl-api-bar">
    <button id="bulk-lookup-btn" class="fl-fetch-btn">Fetch missing times</button>
    <span id="bulk-status" class="fl-api-status"></span>
  </div>

  <!-- Flights table -->
  <% if (flights.length === 0) { %>
  <div class="fl-empty">
    <p>No flights logged yet. Add your first DUB ↔ EDI flight to get started.</p>
    <button class="fl-add-btn" id="add-flight-btn-empty">+ Add first flight</button>
  </div>
  <% } else { %>
  <div class="fl-table-wrap">
    <table class="fl-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Route</th>
          <th>Flight</th>
          <th>Airline</th>
          <th>Departure</th>
          <th>Arrival</th>
          <th>Status</th>
          <th>Notes</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (const f of flights) { %>
        <%
          const depDelay = f.dep_delay;
          const arrDelay = f.arr_delay;

          function delayClass(d) {
            if (d === null) return 'unknown';
            if (d <= 0) return 'early';
            if (d <= 5) return 'on-time';
            if (d <= 30) return 'minor';
            if (d <= 60) return 'major';
            return 'severe';
          }
          function delayLabel(d) {
            if (d === null) return '?';
            if (d < 0) return d + 'm';
            if (d === 0) return 'On time';
            return '+' + d + 'm';
          }

          const faBase = f.flight_number ? 'https://www.flightaware.com/live/flight/' + f.flight_number : null;
          const fr24Base = f.flight_number ? 'https://www.flightradar24.com/flight/' + f.flight_number : null;
          const dateFormatted = f.flight_date ? new Date(f.flight_date + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
        %>
        <tr data-id="<%= f.id %>"
            data-flight='<%- JSON.stringify({
              id: f.id,
              flight_number: f.flight_number,
              airline: f.airline,
              direction: f.direction,
              flight_date: f.flight_date,
              scheduled_dep: f.scheduled_dep,
              actual_dep: f.actual_dep,
              scheduled_arr: f.scheduled_arr,
              actual_arr: f.actual_arr,
              status: f.status,
              notes: f.notes,
              tracker_url: f.tracker_url
            }).replace(/'/g, "&#39;") %>'>
          <td class="fl-date"><%= dateFormatted %></td>
          <td>
            <%
              const dirClass = { 'DUB-EDI':'dub-edi','EDI-DUB':'edi-dub','DUB-GLA':'dub-gla','GLA-DUB':'gla-dub' }[f.direction] || '';
              const dirLabel = f.direction.replace('-',' → ');
            %>
            <span class="fl-dir-badge <%= dirClass %>"><%= dirLabel %></span>
          </td>
          <td class="fl-flnr">
            <% if (f.flight_number && faBase) { %>
              <a href="<%= faBase %>" target="_blank" rel="noopener"><%= f.flight_number %></a>
            <% } else { %>
              <span style="color:var(--text-muted)">—</span>
            <% } %>
          </td>
          <td><%= f.airline || '—' %></td>
          <td class="fl-time-cell">
            <% if (f.scheduled_dep) { %>
              <div class="fl-time-row">
                <span class="fl-time-sched"><%= f.scheduled_dep %></span>
                <% if (f.actual_dep) { %>
                  <span>→</span>
                  <span class="fl-time-actual"><%= f.actual_dep %></span>
                  <span class="fl-delay <%= delayClass(depDelay) %>"><%= delayLabel(depDelay) %></span>
                <% } %>
              </div>
            <% } else { %>
              <span style="color:var(--text-muted)">—</span>
            <% } %>
          </td>
          <td class="fl-time-cell">
            <% if (f.scheduled_arr) { %>
              <div class="fl-time-row">
                <span class="fl-time-sched"><%= f.scheduled_arr %></span>
                <% if (f.actual_arr) { %>
                  <span>→</span>
                  <span class="fl-time-actual"><%= f.actual_arr %></span>
                  <span class="fl-delay <%= delayClass(arrDelay) %>"><%= delayLabel(arrDelay) %></span>
                <% } %>
              </div>
            <% } else { %>
              <span style="color:var(--text-muted)">—</span>
            <% } %>
          </td>
          <td>
            <span class="fl-status-badge <%= f.status %>">
              <%= f.status.charAt(0).toUpperCase() + f.status.slice(1) %>
            </span>
          </td>
          <td class="fl-notes-cell" title="<%= f.notes %>"><%= f.notes || '' %></td>
          <td class="fl-actions">
            <% if (f.tracker_url) { %>
              <a href="<%= f.tracker_url %>" target="_blank" rel="noopener" class="fl-link-btn" title="Custom tracker link">Track</a>
            <% } else if (fr24Base) { %>
              <a href="<%= fr24Base %>" target="_blank" rel="noopener" class="fl-link-btn" title="FlightRadar24">FR24</a>
            <% } %>
            <button class="fl-icon-btn edit-btn" title="Edit">Edit</button>
            <button class="fl-icon-btn danger delete-btn" title="Delete">Del</button>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>

</div>
</main>

<!-- Import modal -->
<div class="fl-backdrop" id="import-backdrop">
  <div class="fl-modal" role="dialog" aria-label="Import flights">
    <h3>Import from Ryanair Excel</h3>
    <p style="font-size:13px;color:var(--text-dim);margin-bottom:16px;line-height:1.6;">
      Upload your <strong>ryanair_flights_v4.xlsx</strong> (or any file using the same column layout).
      Scheduled departure/arrival times are imported automatically. Actual times can be fetched
      afterwards via <em>Fetch missing times</em>. Already-imported flights are skipped.
    </p>
    <div class="fl-field">
      <label class="fl-label" for="import-file">Excel file (.xlsx)</label>
      <input type="file" id="import-file" class="fl-input" accept=".xlsx,.xls">
    </div>
    <div class="fl-status-msg" id="import-status"></div>
    <div class="fl-modal-footer">
      <button class="fl-btn-cancel" id="import-cancel">Cancel</button>
      <button class="fl-btn-save" id="import-submit">Import</button>
    </div>
  </div>
</div>

<!-- Add / Edit modal -->
<div class="fl-backdrop" id="flight-backdrop">
  <div class="fl-modal" role="dialog" aria-label="Flight details">
    <h3 id="modal-title">Add flight</h3>
    <input type="hidden" id="edit-id">
    <div class="fl-form">
      <div class="fl-field full">
        <label class="fl-label" for="f-date">Date *</label>
        <input type="date" id="f-date" class="fl-input" required>
      </div>
      <div class="fl-field">
        <label class="fl-label" for="f-direction">Direction *</label>
        <select id="f-direction" class="fl-select">
          <option value="DUB-EDI">DUB → Edinburgh (EDI)</option>
          <option value="EDI-DUB">EDI → Dublin (DUB)</option>
          <option value="DUB-GLA">DUB → Glasgow (GLA)</option>
          <option value="GLA-DUB">GLA → Dublin (DUB)</option>
        </select>
      </div>
      <div class="fl-field">
        <label class="fl-label" for="f-status">Status *</label>
        <select id="f-status" class="fl-select">
          <option value="completed">Completed</option>
          <option value="cancelled">Cancelled</option>
          <option value="diverted">Diverted</option>
        </select>
      </div>
      <div class="fl-field">
        <label class="fl-label" for="f-flnr">Flight number</label>
        <input type="text" id="f-flnr" class="fl-input" placeholder="e.g. FR4521" list="airline-flights">
        <datalist id="airline-flights">
          <option value="FR4521"><option value="FR4522"><option value="FR4523"><option value="FR4524">
          <option value="EI428"><option value="EI429">
        </datalist>
      </div>
      <div class="fl-field">
        <label class="fl-label" for="f-airline">Airline</label>
        <input type="text" id="f-airline" class="fl-input" placeholder="e.g. Ryanair" list="airline-names">
        <datalist id="airline-names">
          <option value="Ryanair"><option value="Aer Lingus"><option value="easyJet"><option value="Loganair">
        </datalist>
      </div>

      <div class="fl-field full">
        <label class="fl-label">Departure times (HH:MM, 24h)</label>
        <div class="fl-times">
          <div class="fl-field">
            <label class="fl-label" for="f-sdep" style="font-size:10px">Scheduled</label>
            <input type="time" id="f-sdep" class="fl-input">
          </div>
          <div class="fl-field">
            <label class="fl-label" for="f-adep" style="font-size:10px">Actual</label>
            <input type="time" id="f-adep" class="fl-input">
          </div>
        </div>
      </div>

      <div class="fl-field full">
        <label class="fl-label">Arrival times (HH:MM, 24h)</label>
        <div class="fl-times">
          <div class="fl-field">
            <label class="fl-label" for="f-sarr" style="font-size:10px">Scheduled</label>
            <input type="time" id="f-sarr" class="fl-input">
          </div>
          <div class="fl-field">
            <label class="fl-label" for="f-aarr" style="font-size:10px">Actual</label>
            <input type="time" id="f-aarr" class="fl-input">
          </div>
        </div>
      </div>

      <div class="fl-lookup-row">
        <button type="button" id="lookup-btn" class="fl-lookup-btn">Look up times via Flightradar24</button>
        <span id="lookup-status" class="fl-lookup-status"></span>
      </div>

      <div class="fl-field full">
        <label class="fl-label" for="f-tracker">Tracker URL</label>
        <input type="url" id="f-tracker" class="fl-input" placeholder="Paste FlightAware / FR24 link for this specific flight">
      </div>

      <div class="fl-field full">
        <label class="fl-label" for="f-notes">Notes</label>
        <input type="text" id="f-notes" class="fl-input" placeholder="e.g. Delayed at gate, fog, rebooked via X">
      </div>
    </div>

    <div class="fl-status-msg" id="modal-status"></div>
    <div class="fl-modal-footer">
      <button class="fl-btn-cancel" id="modal-cancel">Cancel</button>
      <button class="fl-btn-save" id="modal-save">Save flight</button>
    </div>
  </div>
</div>

<script>
(function () {
  const backdrop = document.getElementById('flight-backdrop');
  const cancelBtn = document.getElementById('modal-cancel');
  const saveBtn = document.getElementById('modal-save');
  const statusEl = document.getElementById('modal-status');
  const titleEl = document.getElementById('modal-title');
  const editIdEl = document.getElementById('edit-id');

  const fields = {
    date: document.getElementById('f-date'),
    direction: document.getElementById('f-direction'),
    status: document.getElementById('f-status'),
    flnr: document.getElementById('f-flnr'),
    airline: document.getElementById('f-airline'),
    sdep: document.getElementById('f-sdep'),
    adep: document.getElementById('f-adep'),
    sarr: document.getElementById('f-sarr'),
    aarr: document.getElementById('f-aarr'),
    tracker: document.getElementById('f-tracker'),
    notes: document.getElementById('f-notes'),
  };

  function openModal(data) {
    editIdEl.value = data?.id || '';
    titleEl.textContent = data ? 'Edit flight' : 'Add flight';
    statusEl.textContent = '';
    fields.date.value = data?.flight_date || '';
    fields.direction.value = data?.direction || 'DUB-EDI';
    fields.status.value = data?.status || 'completed';
    fields.flnr.value = data?.flight_number || '';
    fields.airline.value = data?.airline || '';
    fields.sdep.value = data?.scheduled_dep || '';
    fields.adep.value = data?.actual_dep || '';
    fields.sarr.value = data?.scheduled_arr || '';
    fields.aarr.value = data?.actual_arr || '';
    fields.tracker.value = data?.tracker_url || '';
    fields.notes.value = data?.notes || '';
    saveBtn.disabled = false;
    saveBtn.textContent = 'Save flight';
    backdrop.classList.add('open');
    setTimeout(() => fields.date.focus(), 80);
  }

  function closeModal() { backdrop.classList.remove('open'); }

  cancelBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', e => { if (e.target === backdrop) closeModal(); });

  document.getElementById('add-flight-btn')?.addEventListener('click', () => openModal(null));
  document.getElementById('add-flight-btn-empty')?.addEventListener('click', () => openModal(null));

  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const row = btn.closest('tr');
      const data = JSON.parse(row.dataset.flight);
      openModal(data);
    });
  });

  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr');
      const id = row.dataset.id;
      if (!confirm('Delete this flight record?')) return;
      btn.disabled = true;
      try {
        const r = await fetch('/api/flights/' + id + '/delete', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        if (r.ok) { row.remove(); updateTotals(); }
        else btn.disabled = false;
      } catch (_) { btn.disabled = false; }
    });
  });

  function updateTotals() {
    const remaining = document.querySelectorAll('tbody tr').length;
    if (remaining === 0) window.location.reload();
  }

  saveBtn.addEventListener('click', async () => {
    const date = fields.date.value;
    const direction = fields.direction.value;
    if (!date) { statusEl.textContent = 'Date is required.'; return; }
    if (!direction) { statusEl.textContent = 'Direction is required.'; return; }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';
    statusEl.textContent = '';

    const payload = {
      flight_number: fields.flnr.value.trim(),
      airline: fields.airline.value.trim(),
      direction,
      flight_date: date,
      scheduled_dep: fields.sdep.value,
      actual_dep: fields.adep.value,
      scheduled_arr: fields.sarr.value,
      actual_arr: fields.aarr.value,
      status: fields.status.value,
      notes: fields.notes.value.trim(),
      tracker_url: fields.tracker.value.trim(),
    };

    const id = editIdEl.value;
    const url = id ? '/api/flights/' + id : '/api/flights';
    const method = id ? 'PUT' : 'POST';

    try {
      const r = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify(payload),
      });
      const d = await r.json();
      if (!r.ok) {
        statusEl.textContent = '✖ ' + (d.error || 'Failed');
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save flight';
        return;
      }
      window.location.reload();
    } catch (err) {
      statusEl.textContent = '✖ ' + err.message;
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save flight';
    }
  });

  // ── Excel import ──────────────────────────────────────────────────────────
  const importBtn = document.getElementById('import-btn');
  const importBackdrop = document.getElementById('import-backdrop');
  const importCancelBtn = document.getElementById('import-cancel');
  const importSubmitBtn = document.getElementById('import-submit');
  const importFileInput = document.getElementById('import-file');
  const importStatusEl  = document.getElementById('import-status');

  importBtn?.addEventListener('click', () => {
    importFileInput.value = '';
    importStatusEl.textContent = '';
    importSubmitBtn.disabled = false;
    importSubmitBtn.textContent = 'Import';
    importBackdrop.classList.add('open');
  });
  importCancelBtn?.addEventListener('click', () => importBackdrop.classList.remove('open'));
  importBackdrop?.addEventListener('click', e => { if (e.target === importBackdrop) importBackdrop.classList.remove('open'); });

  importSubmitBtn?.addEventListener('click', async () => {
    const file = importFileInput.files?.[0];
    if (!file) { importStatusEl.textContent = 'Pick an .xlsx file first.'; return; }
    importSubmitBtn.disabled = true;
    importSubmitBtn.textContent = 'Importing…';
    importStatusEl.textContent = 'Reading file…';
    const fd = new FormData();
    fd.append('file', file);
    try {
      const r = await fetch('/api/flights/import', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      const d = await r.json();
      if (!r.ok) { importStatusEl.textContent = '✖ ' + (d.error || 'Import failed'); importSubmitBtn.disabled = false; importSubmitBtn.textContent = 'Import'; return; }
      importStatusEl.textContent = `✓ ${d.inserted} flights imported, ${d.skipped} skipped (duplicates/unknown routes). Reloading…`;
      setTimeout(() => window.location.reload(), 1400);
    } catch (err) {
      importStatusEl.textContent = '✖ ' + err.message;
      importSubmitBtn.disabled = false;
      importSubmitBtn.textContent = 'Import';
    }
  });

  // ── AviationStack single-flight lookup ────────────────────────────────────
  const lookupBtn = document.getElementById('lookup-btn');
  const lookupStatus = document.getElementById('lookup-status');

  lookupBtn.addEventListener('click', async () => {
    const flnr = fields.flnr.value.trim();
    const date = fields.date.value;
    if (!flnr || !date) {
      lookupStatus.textContent = 'Enter a flight number and date first.';
      return;
    }
    lookupBtn.disabled = true;
    lookupBtn.textContent = 'Looking up…';
    lookupStatus.textContent = '';
    try {
      const r = await fetch('/api/flights/lookup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ flight_number: flnr, flight_date: date }),
      });
      const d = await r.json();
      if (!r.ok) { lookupStatus.textContent = '✖ ' + (d.error || 'Lookup failed'); return; }
      if (d.scheduled_dep) fields.sdep.value = d.scheduled_dep;
      if (d.actual_dep)    fields.adep.value = d.actual_dep;
      if (d.scheduled_arr) fields.sarr.value = d.scheduled_arr;
      if (d.actual_arr)    fields.aarr.value = d.actual_arr;
      if (d.status)        fields.status.value = d.status;
      if (d.airline && !fields.airline.value) fields.airline.value = d.airline;
      lookupStatus.textContent = '✓ Times filled in — review and save.';
    } catch (err) {
      lookupStatus.textContent = '✖ ' + err.message;
    } finally {
      lookupBtn.disabled = false;
      lookupBtn.textContent = 'Look up times via Flightradar24';
    }
  });

  // ── Flightradar24 bulk lookup ─────────────────────────────────────────────
  const bulkBtn = document.getElementById('bulk-lookup-btn');
  const bulkStatus = document.getElementById('bulk-status');

  bulkBtn.addEventListener('click', async () => {
    bulkBtn.disabled = true;
    bulkBtn.textContent = 'Fetching…';
    bulkStatus.textContent = 'Looking up missing times — this may take a moment…';
    try {
      const r = await fetch('/api/flights/bulk-lookup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: '{}',
      });
      const d = await r.json();
      if (!r.ok) { bulkStatus.textContent = '✖ ' + (d.error || 'Failed'); return; }
      if (d.updated === 0 && d.failed === 0) {
        bulkStatus.textContent = 'All flights already have time data.';
      } else {
        bulkStatus.textContent = `✓ Updated ${d.updated} flight${d.updated !== 1 ? 's' : ''}${d.failed ? ` · ${d.failed} failed` : ''} — reloading…`;
        setTimeout(() => window.location.reload(), 1200);
      }
    } catch (err) {
      bulkStatus.textContent = '✖ ' + err.message;
    } finally {
      bulkBtn.disabled = false;
      bulkBtn.textContent = 'Fetch missing times';
    }
  });
})();
</script>
</body>
</html>
