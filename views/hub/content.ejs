<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Content — McLellan Hub</title>
<link rel="stylesheet" href="/hub.css">
<style>
body.hub-page { height: auto !important; min-height: 100vh; overflow: auto !important; }
.content-wrap { max-width: 1200px; margin: 0 auto; padding: 24px 20px 80px; }

.back-link { font-size: 13px; color: var(--text-dim); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 20px; }
.back-link:hover { color: var(--accent, #4648d4); }
.page-title { font-size: 24px; font-weight: 700; margin: 0 0 4px; }
.page-sub { font-size: 13px; color: var(--text-dim); margin: 0 0 28px; }

/* Generate box */
.gen-box {
  background: var(--surface, #f4f3fb);
  border: 1px solid var(--border, #e0ddf0);
  border-radius: 16px; padding: 20px; margin-bottom: 24px;
}
.gen-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-dim); margin-bottom: 10px; }
.gen-row { display: flex; gap: 10px; }
.gen-input {
  flex: 1; padding: 10px 14px; font-size: 14px;
  border: 1px solid var(--border, #e0ddf0); border-radius: 10px;
  background: var(--bg, #fff); color: var(--text, #15131e); font-family: inherit; outline: none;
  transition: border-color .15s, box-shadow .15s;
}
.gen-input:focus { border-color: var(--accent, #4648d4); box-shadow: 0 0 0 3px rgba(70,72,212,.1); }
.gen-btn {
  padding: 10px 22px; background: var(--accent, #4648d4); color: #fff;
  border: none; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer;
  white-space: nowrap; font-family: inherit; transition: opacity .15s;
}
.gen-btn:disabled { opacity: .5; cursor: default; }
.gen-btn:not(:disabled):hover { opacity: .9; }

.spicy-row { display: flex; gap: 6px; margin-top: 10px; align-items: center; }
.spicy-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-dim); white-space: nowrap; }
.spicy-btn {
  padding: 5px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; cursor: pointer;
  border: 1.5px solid var(--border, #e0ddf0); background: transparent; font-family: inherit;
  color: var(--text-dim); transition: all .12s;
}
.spicy-btn[data-spicy="professional"].active { background: rgba(70,72,212,.1); border-color: #4648d4; color: #4648d4; }
.spicy-btn[data-spicy="challenging"].active  { background: rgba(245,158,11,.12); border-color: #d97706; color: #b45309; }
.spicy-btn[data-spicy="provocative"].active  { background: rgba(239,68,68,.1); border-color: #ef4444; color: #dc2626; }
.spicy-btn:not(.active):hover { border-color: var(--accent, #4648d4); color: var(--accent, #4648d4); }

.gen-progress { margin-top: 14px; display: none; }
.gen-progress.visible { display: block; }
.progress-track { height: 3px; background: var(--border, #e0ddf0); border-radius: 2px; margin-bottom: 8px; overflow: hidden; }
.progress-fill { height: 100%; background: var(--accent, #4648d4); border-radius: 2px; transition: width .5s ease; }
.progress-msg { font-size: 12px; color: var(--text-dim); }

/* Stats */
.stats-row { display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
.stat-pill { background: var(--surface, #f4f3fb); border: 1px solid var(--border, #e0ddf0); border-radius: 8px; padding: 8px 14px; font-size: 13px; }
.stat-pill strong { font-size: 18px; font-weight: 700; color: var(--accent, #4648d4); display: block; line-height: 1.2; }
.stat-pill span { font-size: 11px; color: var(--text-dim); }

/* Toolbar: sort + filter */
.toolbar { display: flex; flex-direction: column; gap: 10px; margin-bottom: 18px; }
.toolbar-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.toolbar-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-dim); white-space: nowrap; margin-right: 2px; }
.sort-btn, .filter-chip {
  padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 500;
  border: 1px solid var(--border, #e0ddf0); background: transparent; cursor: pointer;
  color: var(--text-dim); font-family: inherit; transition: background .12s, color .12s, border-color .12s;
}
.sort-btn:hover, .filter-chip:hover { border-color: var(--accent, #4648d4); color: var(--accent, #4648d4); }
.sort-btn.active, .filter-chip.active { background: var(--accent, #4648d4); color: #fff; border-color: var(--accent, #4648d4); }

/* Badges */
.badge {
  padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 600; line-height: 1.6;
  display: inline-flex; align-items: center; white-space: nowrap;
}
.badge-processing { background: rgba(245,158,11,.12); color: #d97706; }
.badge-error      { background: rgba(239,68,68,.12);  color: #dc2626; }
.badge-draft      { background: rgba(70,72,212,.12);  color: #4648d4; }
.badge-scheduled  { background: rgba(124,58,237,.12); color: #7c3aed; }
.badge-published  { background: rgba(16,185,129,.12); color: #059669; }
.badge-type       { background: rgba(0,0,0,.06); color: var(--text-dim); font-weight: 400; }
.badge-spicy-professional { background: rgba(70,72,212,.08); color: #4648d4; }
.badge-spicy-challenging  { background: rgba(245,158,11,.12); color: #b45309; }
.badge-spicy-provocative  { background: rgba(239,68,68,.12);  color: #dc2626; }
.badge-score      { background: rgba(70,72,212,.12); color: var(--accent, #4648d4); font-weight: 700; }
.badge-date       { background: rgba(124,58,237,.08); color: #7c3aed; font-weight: 400; }

/* Post list */
.post-list { display: flex; flex-direction: column; gap: 6px; }

.post-row {
  background: var(--bg, #fff);
  border: 1px solid var(--border, #e0ddf0);
  border-left: 4px solid var(--row-accent, var(--border, #e0ddf0));
  border-radius: 10px;
  overflow: hidden;
  transition: box-shadow .15s;
}
.post-row:hover { box-shadow: 0 2px 12px rgba(0,0,0,.07); }
.post-row[data-status="processing"] { --row-accent: #f59e0b; }
.post-row[data-status="error"]      { --row-accent: #ef4444; }
.post-row[data-status="draft"]      { --row-accent: var(--accent, #4648d4); }
.post-row[data-status="scheduled"]  { --row-accent: #7c3aed; }
.post-row[data-status="published"]  { --row-accent: #10b981; }

.row-main {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 16px; cursor: default;
}
.row-date { font-size: 11px; color: var(--text-dim); white-space: nowrap; min-width: 72px; }
.row-topic { flex: 1; font-size: 14px; font-weight: 600; color: var(--text, #15131e); line-height: 1.3; min-width: 0; }
.row-badges { display: flex; flex-wrap: wrap; gap: 4px; flex-shrink: 0; }
.row-actions { display: flex; gap: 5px; flex-shrink: 0; }

@media (max-width: 700px) {
  /* Switch row to block — topic gets full width, no flex fighting */
  .row-main { display: block; padding: 12px 14px; }
  .row-topic { display: block; margin-bottom: 8px; min-width: 0; white-space: normal; word-break: break-word; }
  .row-date  { display: inline; font-size: 11px; margin-right: 6px; }
  .row-badges { display: inline-flex; flex-wrap: wrap; gap: 4px; vertical-align: middle; }
  .row-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .row-actions .btn-sm { flex: 1; justify-content: center; min-height: 40px; }
  /* Toolbar */
  .toolbar-row { gap: 6px; }
  .sort-btn, .filter-chip { padding: 4px 10px; font-size: 11px; }
  /* Expand panel */
  .expand-panel { padding: 12px 14px 16px; }
  .score-grid { grid-template-columns: 1fr 1fr; }
  .schedule-row { flex-direction: column; align-items: stretch; }
  .schedule-input { width: 100%; }
}

/* Buttons */
.btn-sm {
  padding: 4px 11px; font-size: 12px; border-radius: 7px; cursor: pointer;
  border: 1px solid var(--border, #e0ddf0); background: transparent;
  color: var(--text, #15131e); font-family: inherit; transition: background .12s;
  text-decoration: none; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;
}
.btn-sm:hover { background: rgba(0,0,0,.05); }
.btn-sm.primary { background: var(--accent, #4648d4); color: #fff; border-color: var(--accent, #4648d4); }
.btn-sm.primary:hover { opacity: .9; background: var(--accent, #4648d4); }
.btn-sm.danger { color: #dc2626; border-color: rgba(220,38,38,.3); }
.btn-sm.danger:hover { background: rgba(220,38,38,.07); }
.btn-sm.view-btn.open { background: var(--accent, #4648d4); color: #fff; border-color: var(--accent, #4648d4); }

/* Expand panel */
.expand-panel { display: none; padding: 16px 20px 18px; border-top: 1px solid var(--border, #e0ddf0); background: var(--surface, #f4f3fb); }
.expand-panel.open { display: block; }

.panel-section { margin-bottom: 14px; }
.panel-label {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
  color: var(--text-dim); margin-bottom: 6px;
}
.panel-draft {
  font-size: 13px; line-height: 1.65; color: var(--text, #15131e);
  white-space: pre-wrap; word-break: break-word;
  background: var(--bg, #fff); border: 1px solid var(--border, #e0ddf0);
  border-radius: 8px; padding: 12px 14px; max-height: 340px; overflow-y: auto;
}

.score-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 6px; margin: 8px 0; }
.score-item { background: var(--bg, #fff); border: 1px solid var(--border, #e0ddf0); border-radius: 8px; padding: 8px 10px; }
.score-item-key { font-size: 10px; color: var(--text-dim); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 2px; }
.score-item-val { font-size: 18px; font-weight: 700; color: var(--accent, #4648d4); line-height: 1; }

.fix-item { font-size: 12px; margin-bottom: 4px; line-height: 1.45; }
.fix-item strong { color: var(--text, #15131e); }

.links-row { display: flex; gap: 8px; flex-wrap: wrap; }
.schedule-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.schedule-input, .type-select {
  padding: 6px 10px; border: 1px solid var(--border, #e0ddf0); border-radius: 8px;
  font-size: 13px; background: var(--bg, #fff); color: var(--text, #15131e); font-family: inherit; outline: none;
}
.schedule-input:focus, .type-select:focus { border-color: var(--accent, #4648d4); }

.status-row { display: flex; gap: 6px; flex-wrap: wrap; }

.empty-state { text-align: center; padding: 48px 24px; color: var(--text-dim); }
.empty-state p { font-size: 14px; }
</style>
</head>
<body class="hub-page" style="background: var(--bg, #fcf8ff); min-height: 100vh;">
<%- include('partials/top-nav') %>
<main>
<div class="content-wrap">

  <a href="/" class="back-link">← Back to hub</a>
  <h1 class="page-title">Content</h1>
  <p class="page-sub">Generate and manage LinkedIn posts — research, draft, score, refine, carousel.</p>

  <!-- Generate -->
  <div class="gen-box">
    <div class="gen-label">New post</div>
    <div class="gen-row">
      <input class="gen-input" id="gen-topic" type="text"
        placeholder="Topic or idea — e.g. Microsoft Copilot Pages for Teams" />
      <button class="gen-btn" id="gen-btn">Generate</button>
    </div>
    <div class="gen-row" style="margin-top:8px;">
      <input class="gen-input" id="gen-source-url" type="url"
        placeholder="Source URL (optional) — paste an article to anchor research to its facts" style="font-size:12px;color:var(--text-dim);" />
    </div>
    <div class="spicy-row">
      <span class="spicy-label">Tone:</span>
      <button class="spicy-btn active" data-spicy="professional">Professional</button>
      <button class="spicy-btn" data-spicy="challenging">Challenging</button>
      <button class="spicy-btn" data-spicy="provocative">Provocative</button>
    </div>
    <div class="gen-progress" id="gen-progress">
      <div class="progress-track"><div class="progress-fill" id="progress-fill" style="width:5%"></div></div>
      <div class="progress-msg" id="progress-msg">Starting…</div>
    </div>
  </div>

  <!-- Stats -->
  <%
    const totalPosts = posts.length;
    const published = posts.filter(p => p.status === 'published').length;
    const scheduled = posts.filter(p => p.status === 'scheduled').length;
    const typeCounts = {};
    posts.forEach(p => { if (p.content_type) typeCounts[p.content_type] = (typeCounts[p.content_type] || 0) + 1; });
    const topType = Object.entries(typeCounts).sort((a,b) => b[1]-a[1])[0];
  %>
  <% if (totalPosts > 0) { %>
  <div class="stats-row">
    <div class="stat-pill"><strong><%= totalPosts %></strong><span>Total posts</span></div>
    <div class="stat-pill"><strong><%= published %></strong><span>Published</span></div>
    <div class="stat-pill"><strong><%= scheduled %></strong><span>Scheduled</span></div>
    <% if (topType) { %><div class="stat-pill"><strong><%= topType[1] %></strong><span><%= topType[0] %></span></div><% } %>
  </div>
  <% } %>

  <!-- Toolbar -->
  <div class="toolbar">
    <div class="toolbar-row">
      <span class="toolbar-label">Sort:</span>
      <button class="sort-btn active" data-sort="date-desc">Newest first</button>
      <button class="sort-btn" data-sort="date-asc">Oldest first</button>
      <button class="sort-btn" data-sort="score-desc">Highest score</button>
      <button class="sort-btn" data-sort="published-desc">Published date</button>
    </div>
    <div class="toolbar-row">
      <span class="toolbar-label">Filter:</span>
      <button class="filter-chip active" data-filter="all">All</button>
      <button class="filter-chip" data-filter="status:processing">Processing</button>
      <button class="filter-chip" data-filter="status:draft">Draft</button>
      <button class="filter-chip" data-filter="status:scheduled">Scheduled</button>
      <button class="filter-chip" data-filter="status:published">Published</button>
      <% for (const t of contentTypes) { %>
      <button class="filter-chip" data-filter="type:<%= t %>"><%= t %></button>
      <% } %>
    </div>
  </div>

  <!-- Post list -->
  <div class="post-list" id="post-list">
  <% if (!posts.length) { %>
    <div class="empty-state"><p>No posts yet. Generate your first LinkedIn post above.</p></div>
  <% } %>
  <% for (const p of posts) { %>
  <%
    const scoreVal = p.score?.overall_score;
    const scoreNum = scoreVal ? parseFloat(scoreVal) : 0;
    const dateStr = new Date(p.created_at * 1000).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    const statusLabel = { processing: 'Processing…', error: 'Error', draft: 'Draft', scheduled: 'Scheduled', published: 'Published' }[p.status] || p.status;
    const calTopic = encodeURIComponent('Post: ' + p.topic);
    const calDetail = encodeURIComponent(p.preview || p.topic);
    const calDate = (p.scheduled_date || '').replace(/-/g, '');
    const calUrl = p.scheduled_date ? `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${calTopic}&dates=${calDate}/${calDate}&details=${calDetail}` : '';
  %>
  <div class="post-row" id="row-<%= p.id %>"
    data-status="<%= p.status %>"
    data-type="<%= p.content_type || '' %>"
    data-created="<%= p.created_at %>"
    data-score="<%= scoreNum %>"
    data-published="<%= p.published_at || '' %>"
    data-scheduled="<%= p.scheduled_date || '' %>">

    <div class="row-main">
      <span class="row-date"><%= dateStr %></span>
      <span class="row-topic"><%= p.topic %></span>
      <div class="row-badges">
        <span class="badge badge-<%= p.status %>"><%= statusLabel %></span>
        <% if (scoreVal) { %><span class="badge badge-score"><%= scoreVal %>/5</span><% } %>
        <% if (p.spiciness && p.spiciness !== 'professional') { %><span class="badge badge-spicy-<%= p.spiciness %>"><%= p.spiciness %></span><% } %>
        <% if (p.content_type) { %><span class="badge badge-type"><%= p.content_type %></span><% } %>
        <% if (p.scheduled_date) { %><span class="badge badge-date">📅 <%= p.scheduled_date %></span><% } %>
      </div>
      <div class="row-actions">
        <% if (p.status !== 'processing') { %>
        <button class="btn-sm view-btn" onclick="toggleExpand('<%= p.id %>')">View</button>
        <% } %>
        <% if (p.carousel_url) { %><a href="<%= p.carousel_url %>" target="_blank" class="btn-sm">PDF</a><% } %>
        <% if (!p.carousel_url && p.status !== 'processing' && (p.draft || p.preview)) { %><button class="btn-sm" id="retry-btn-<%= p.id %>" onclick="retryCarousel('<%= p.id %>')">Retry PDF</button><% } %>
        <% if (calUrl) { %><a href="<%= calUrl %>" target="_blank" class="btn-sm">📅 Cal</a><% } %>
        <% if (p.status !== 'processing') { %>
        <button class="btn-sm danger" onclick="deletePost('<%= p.id %>')">Delete</button>
        <% } %>
      </div>
    </div>

    <% if (p.status !== 'processing') { %>
    <div class="expand-panel" id="expand-<%= p.id %>">

      <!-- Content type -->
      <div class="panel-section">
        <div class="panel-label">Content type</div>
        <select class="type-select" onchange="setType('<%= p.id %>', this.value)">
          <option value="">— Select type —</option>
          <% for (const t of contentTypes) { %>
          <option value="<%= t %>" <%= p.content_type === t ? 'selected' : '' %>><%= t %></option>
          <% } %>
        </select>
      </div>

      <!-- Score -->
      <% if (scoreVal) { %>
      <div class="panel-section">
        <div class="panel-label">Score — <%= scoreVal %>/5</div>
        <% if (p.score?.recruiter_value) { %><div style="font-size:12px;color:var(--text-dim);margin-bottom:8px;"><%= p.score.recruiter_value %></div><% } %>
        <% if (p.score?.axis_scores && Object.keys(p.score.axis_scores).length) { %>
        <div class="score-grid">
          <% for (const [k, v] of Object.entries(p.score.axis_scores)) { %>
          <div class="score-item">
            <div class="score-item-key"><%= k.replace(/_/g, ' ') %></div>
            <div class="score-item-val"><%= v %>/5</div>
          </div>
          <% } %>
        </div>
        <% } %>
        <% if (p.score?.top_fixes?.length) { %>
        <div class="panel-label" style="margin-top:10px;">Top fixes</div>
        <% for (const f of (p.score.top_fixes || [])) { %>
        <div class="fix-item"><strong><%= f.problem %></strong> → <%= f.fix %></div>
        <% } %>
        <% } %>
        <% if (p.score?.recruiter_perspective) { %>
        <div style="font-size:12px;color:var(--text-dim);margin-top:8px;font-style:italic;"><%= p.score.recruiter_perspective %></div>
        <% } %>
      </div>
      <% } %>

      <!-- Draft -->
      <div class="panel-section">
        <div class="panel-label">Refined draft</div>
        <div class="panel-draft" id="draft-<%= p.id %>">
          <button class="btn-sm" onclick="loadDraft('<%= p.id %>')">Load draft</button>
        </div>
      </div>

      <!-- Links -->
      <% if (p.carousel_url || p.sheet_url) { %>
      <div class="panel-section">
        <div class="panel-label">Links</div>
        <div class="links-row">
          <% if (p.carousel_url) { %><a href="<%= p.carousel_url %>" target="_blank" class="btn-sm">Carousel PDF</a><% } %>
          <% if (p.sheet_url) { %><a href="<%= p.sheet_url %>" target="_blank" class="btn-sm">Google Sheet</a><% } %>
        </div>
      </div>
      <% } %>

      <!-- Schedule -->
      <div class="panel-section">
        <div class="panel-label">Schedule</div>
        <div class="schedule-row">
          <input type="date" class="schedule-input" id="date-<%= p.id %>" value="<%= p.scheduled_date || '' %>" />
          <button class="btn-sm primary" onclick="schedulePost('<%= p.id %>')">Save date</button>
          <span id="cal-link-<%= p.id %>">
            <% if (calUrl) { %><a href="<%= calUrl %>" target="_blank" class="btn-sm">Add to Calendar</a><% } %>
          </span>
        </div>
      </div>

      <!-- Status -->
      <div class="panel-section">
        <div class="panel-label">Status</div>
        <div class="status-row">
          <button class="btn-sm<%= p.status === 'draft' ? ' primary' : '' %>" onclick="setStatus('<%= p.id %>', 'draft')">Draft</button>
          <button class="btn-sm<%= p.status === 'scheduled' ? ' primary' : '' %>" onclick="setStatus('<%= p.id %>', 'scheduled')">Scheduled</button>
          <button class="btn-sm<%= p.status === 'published' ? ' primary' : '' %>" onclick="setStatus('<%= p.id %>', 'published')">Published</button>
        </div>
      </div>

    </div>
    <% } %>
  </div>
  <% } %>
  </div>

</div>
</main>

<script>
// ── Generate ──────────────────────────────────────────────────────────────────
const genBtn = document.getElementById('gen-btn');
const genInput = document.getElementById('gen-topic');
const genSourceUrl = document.getElementById('gen-source-url');
const genProgress = document.getElementById('gen-progress');
const progressFill = document.getElementById('progress-fill');
const progressMsg = document.getElementById('progress-msg');
let pollTimer = null;

// Spiciness picker
let activeSpiciness = 'professional';
document.querySelectorAll('.spicy-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.spicy-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    activeSpiciness = this.dataset.spicy;
  });
});

function setProgress(pct, msg) {
  progressFill.style.width = pct + '%';
  progressMsg.textContent = msg;
}

genInput.addEventListener('keydown', e => { if (e.key === 'Enter') startGenerate(); });
genBtn.addEventListener('click', startGenerate);

async function startGenerate() {
  const topic = genInput.value.trim();
  if (!topic) { genInput.focus(); return; }
  const sourceUrl = genSourceUrl.value.trim();
  genBtn.disabled = true;
  genBtn.textContent = 'Generating…';
  genProgress.classList.add('visible');
  setProgress(5, sourceUrl ? 'Fetching source article…' : 'Starting pipeline…');
  try {
    const body = { topic, spiciness: activeSpiciness };
    if (sourceUrl) body.sourceUrl = sourceUrl;
    const r = await fetch('/api/content/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const d = await r.json();
    if (!r.ok || !d.postId) throw new Error(d.error || 'Failed to start pipeline');
    beginPolling(d.postId);
  } catch (err) {
    setProgress(0, 'Error: ' + err.message);
    genBtn.disabled = false;
    genBtn.textContent = 'Generate';
  }
}

function beginPolling(postId) {
  let tick = 0;
  const MSGS = [
    'Researching topic…', 'Reading sources…', 'Synthesising research…',
    'Drafting post…', 'Scoring draft…', 'Refining post…',
    'Creating carousel…', 'Uploading to Drive…', 'Saving to calendar…',
  ];
  pollTimer = setInterval(async () => {
    tick++;
    setProgress(Math.min(90, 5 + tick * 3), MSGS[Math.floor(tick / 3) % MSGS.length]);
    try {
      const r = await fetch('/api/content/posts/' + postId);
      if (!r.ok) return;
      const d = await r.json();
      const status = d.post?.status;
      if (status && status !== 'processing') {
        clearInterval(pollTimer);
        setProgress(100, status === 'error' ? 'Pipeline encountered an error.' : 'Done — refreshing…');
        setTimeout(() => window.location.reload(), 1500);
      }
    } catch (_) {}
  }, 3000);
}

// ── Expand panel ──────────────────────────────────────────────────────────────
window.toggleExpand = function(id) {
  const panel = document.getElementById('expand-' + id);
  const btn = document.querySelector('#row-' + id + ' .view-btn');
  if (!panel) return;
  const open = panel.classList.toggle('open');
  if (btn) btn.classList.toggle('open', open);
};

// ── Load draft ────────────────────────────────────────────────────────────────
window.loadDraft = async function(id) {
  const el = document.getElementById('draft-' + id);
  el.textContent = 'Loading…';
  try {
    const r = await fetch('/api/content/posts/' + id);
    const d = await r.json();
    el.textContent = d.post?.refined_draft || d.post?.draft || '(no draft yet)';
  } catch (err) {
    el.textContent = 'Error: ' + err.message;
  }
};

// ── Content type ──────────────────────────────────────────────────────────────
window.setType = async function(id, type) {
  await fetch('/api/content/posts/' + id + '/type', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ type }),
  }).catch(() => {});
};

// ── Status ────────────────────────────────────────────────────────────────────
window.setStatus = async function(id, status) {
  const r = await fetch('/api/content/posts/' + id + '/status', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status }),
  });
  if (r.ok) window.location.reload();
};

// ── Schedule ──────────────────────────────────────────────────────────────────
window.schedulePost = async function(id) {
  const date = document.getElementById('date-' + id)?.value;
  if (!date) return;
  const r = await fetch('/api/content/posts/' + id + '/schedule', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ date }),
  });
  if (r.ok) window.location.reload();
};

// ── Retry carousel ────────────────────────────────────────────────────────────
window.retryCarousel = async function(id) {
  const btn = document.getElementById('retry-btn-' + id);
  if (btn) { btn.disabled = true; btn.textContent = 'Retrying…'; }
  try {
    const r = await fetch('/api/content/posts/' + id + '/retry-carousel', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
    });
    if (!r.ok) { const d = await r.json(); throw new Error(d.error || 'Failed'); }
    // Poll until no longer processing
    const poll = setInterval(async () => {
      try {
        const pr = await fetch('/api/content/posts/' + id);
        const pd = await pr.json();
        if (pd.post?.status !== 'processing') {
          clearInterval(poll);
          window.location.reload();
        }
      } catch (_) {}
    }, 3000);
  } catch (err) {
    if (btn) { btn.disabled = false; btn.textContent = 'Retry PDF'; }
    alert('Error: ' + err.message);
  }
};

// ── Delete ────────────────────────────────────────────────────────────────────
window.deletePost = async function(id) {
  if (!confirm('Delete this post? This cannot be undone.')) return;
  const r = await fetch('/api/content/posts/' + id + '/delete', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
  });
  if (r.ok) {
    const row = document.getElementById('row-' + id);
    if (row) row.remove();
  }
};

// ── Filter ────────────────────────────────────────────────────────────────────
let activeFilter = 'all';
document.querySelectorAll('.filter-chip').forEach(chip => {
  chip.addEventListener('click', function() {
    document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
    this.classList.add('active');
    activeFilter = this.dataset.filter;
    applyFilterSort();
  });
});

// ── Sort ──────────────────────────────────────────────────────────────────────
let activeSort = 'date-desc';
document.querySelectorAll('.sort-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    activeSort = this.dataset.sort;
    applyFilterSort();
  });
});

function applyFilterSort() {
  const list = document.getElementById('post-list');
  const rows = Array.from(list.querySelectorAll('.post-row'));

  // Filter
  rows.forEach(row => {
    let show = true;
    if (activeFilter !== 'all') {
      const [kind, val] = activeFilter.split(':');
      show = kind === 'status' ? row.dataset.status === val : row.dataset.type === val;
    }
    row.style.display = show ? '' : 'none';
  });

  // Sort visible rows
  const visible = rows.filter(r => r.style.display !== 'none');
  visible.sort((a, b) => {
    switch (activeSort) {
      case 'date-asc':  return Number(a.dataset.created) - Number(b.dataset.created);
      case 'date-desc': return Number(b.dataset.created) - Number(a.dataset.created);
      case 'score-desc': return Number(b.dataset.score) - Number(a.dataset.score);
      case 'published-desc': {
        return Number(b.dataset.published || 0) - Number(a.dataset.published || 0);
      }
      default: return 0;
    }
  });
  visible.forEach(row => list.appendChild(row));
}
</script>

