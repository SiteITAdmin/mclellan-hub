<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Content — Create — McLellan Hub</title>
<link rel="stylesheet" href="/hub.css">
<%- include('partials/content-styles') %>
</head>
<body class="hub-page" style="background: var(--bg, #fcf8ff); min-height: 100vh;">
<%- include('partials/top-nav') %>
<main>
<div class="content-wrap">

  <h1 class="page-title">Content</h1>
  <p class="page-sub">Generate LinkedIn posts — research, draft, score, refine, carousel. Cadence and topic planning live in <a href="/lin/plan" style="color:var(--accent,#4648d4)">Plan</a>; work-in-progress posts in <a href="/lin/queue" style="color:var(--accent,#4648d4)">Queue</a>.</p>

  <%- include('partials/content-tabs', { contentTab: 'create' }) %>

  <!-- Generate -->
  <div class="gen-box">
    <div class="gen-label">New post</div>
    <div class="gen-row">
      <input class="gen-input" id="gen-topic" type="text"
        placeholder="Topic or idea — e.g. Microsoft Copilot Pages for Teams" />
      <button class="gen-btn" id="gen-btn">Generate</button>
    </div>
    <div class="gen-row" style="margin-top:8px;">
      <input class="gen-input" id="gen-source-url" type="url"
        placeholder="Source URL (optional) — paste an article to anchor research to its facts" style="font-size:12px;color:var(--text-dim);" />
    </div>
    <div class="spicy-row">
      <span class="spicy-label">Tone:</span>
      <button class="spicy-btn active" data-spicy="professional">Professional</button>
      <button class="spicy-btn" data-spicy="challenging">Challenging</button>
      <button class="spicy-btn" data-spicy="provocative">Provocative</button>
    </div>
    <div class="gen-progress" id="gen-progress">
      <div class="progress-track"><div class="progress-fill" id="progress-fill" style="width:5%"></div></div>
      <div class="progress-msg" id="progress-msg">Starting…</div>
    </div>
  </div>

  <!-- Today's researched suggestions -->
  <% const daysWithSuggestions = topicPlan.days.filter(d => d.suggestions.length).slice(0, 2); %>
  <% if (daysWithSuggestions.length) { %>
  <section class="cadence-box">
    <div class="cadence-head">
      <h2 class="cadence-title">Researched suggestions</h2>
      <a href="/lin/plan" class="cadence-link">Topic plan →</a>
    </div>
    <div class="topic-days">
      <% for (const day of daysWithSuggestions) { %>
        <div class="topic-day">
          <div class="topic-day-title"><%= day.label %></div>
          <% for (const topic of day.suggestions) { %>
            <div class="topic-item">
              <div class="topic-title"><%= topic.title %></div>
              <% if (topic.summary) { %><div class="topic-summary"><%= String(topic.summary).slice(0, 180) %></div><% } %>
              <div class="topic-foot">
                <span class="topic-source"><%= topic.source_kind || topic.category || topic.source_name || topic.item_type || 'intel' %> · <%= day.preference.tone %></span>
                <button class="btn-sm" type="button" data-topic="<%= topic.title %>" data-tone="<%= day.preference.tone %>" data-source-url="<%= topic.source_url || '' %>" onclick="useTopic(this.dataset.topic, this.dataset.tone, this.dataset.sourceUrl)">Use</button>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>
  <% } else { %>
  <section class="cadence-box">
    <div class="cadence-head">
      <h2 class="cadence-title">Researched suggestions</h2>
      <a href="/lin/plan" class="cadence-link">Topic plan →</a>
    </div>
    <p style="font-size:13px;color:var(--text-dim);margin:0">No researched suggestions yet. Set day topics and run research on the <a href="/lin/plan" style="color:var(--accent,#4648d4)">Plan</a> tab.</p>
  </section>
  <% } %>

  <!-- Recent activity -->
  <% if (recentPosts.length) { %>
  <section class="cadence-box">
    <div class="cadence-head">
      <h2 class="cadence-title">Recent</h2>
      <a href="/lin/queue" class="cadence-link">Full queue →</a>
    </div>
    <% for (const p of recentPosts) { %>
      <div style="display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--border,#e0ddf0);font-size:13px">
        <span class="badge badge-<%= p.status %>"><%= { processing: 'Processing…', error: 'Error', draft: 'Draft', scheduled: 'Scheduled', published: 'Published' }[p.status] || p.status %></span>
        <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= p.display_title || p.topic %></span>
        <span style="font-size:11px;color:var(--text-dim);white-space:nowrap"><%= new Date(p.created_at * 1000).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></span>
      </div>
    <% } %>
  </section>
  <% } %>

</div>
</main>

<script>
// ── Generate ──────────────────────────────────────────────────────────────────
const genBtn = document.getElementById('gen-btn');
const genInput = document.getElementById('gen-topic');
const genSourceUrl = document.getElementById('gen-source-url');
const genProgress = document.getElementById('gen-progress');
const progressFill = document.getElementById('progress-fill');
const progressMsg = document.getElementById('progress-msg');
let pollTimer = null;

window.useTopic = function(title, tone, sourceUrl) {
  genInput.value = title;
  genSourceUrl.value = sourceUrl || '';
  if (tone) {
    const btn = document.querySelector(`.spicy-btn[data-spicy="${tone}"]`);
    if (btn) btn.click();
  }
  genInput.focus();
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

// Spiciness picker
let activeSpiciness = 'professional';
document.querySelectorAll('.spicy-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.spicy-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    activeSpiciness = this.dataset.spicy;
  });
});

function setProgress(pct, msg) {
  progressFill.style.width = pct + '%';
  progressMsg.textContent = msg;
}

genInput.addEventListener('keydown', e => { if (e.key === 'Enter') startGenerate(); });
genBtn.addEventListener('click', startGenerate);

// Prefill from Plan tab "Use" links (/lin?topic=…&tone=…&sourceUrl=…)
(() => {
  const params = new URLSearchParams(window.location.search);
  const topic = params.get('topic');
  if (!topic) return;
  useTopic(topic, params.get('tone') || '', params.get('sourceUrl') || '');
  history.replaceState(null, '', '/lin');
})();

async function startGenerate() {
  const topic = genInput.value.trim();
  if (!topic) { genInput.focus(); return; }
  const sourceUrl = genSourceUrl.value.trim();
  genBtn.disabled = true;
  genBtn.textContent = 'Generating…';
  genProgress.classList.add('visible');
  setProgress(5, sourceUrl ? 'Fetching source article…' : 'Starting pipeline…');
  try {
    const body = { topic, spiciness: activeSpiciness };
    if (sourceUrl) body.sourceUrl = sourceUrl;
    const r = await fetch('/api/content/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const d = await r.json();
    if (!r.ok || !d.postId) throw new Error(d.error || 'Failed to start pipeline');
    beginPolling(d.postId);
  } catch (err) {
    setProgress(0, 'Error: ' + err.message);
    genBtn.disabled = false;
    genBtn.textContent = 'Generate';
  }
}

function beginPolling(postId) {
  let tick = 0;
  const MSGS = [
    'Researching topic…', 'Reading sources…', 'Synthesising research…',
    'Drafting post…', 'Scoring draft…', 'Refining post…',
    'Creating carousel…', 'Uploading to Drive…', 'Saving to calendar…',
  ];
  pollTimer = setInterval(async () => {
    tick++;
    setProgress(Math.min(90, 5 + tick * 3), MSGS[Math.floor(tick / 3) % MSGS.length]);
    try {
      const r = await fetch('/api/content/posts/' + postId);
      if (!r.ok) return;
      const d = await r.json();
      const status = d.post?.status;
      if (status && status !== 'processing') {
        clearInterval(pollTimer);
        setProgress(100, status === 'error' ? 'Pipeline encountered an error.' : 'Done — opening queue…');
        setTimeout(() => { window.location.href = '/lin/queue'; }, 1200);
      }
    } catch (_) {}
  }, 3000);
}
</script>

</body>
</html>
