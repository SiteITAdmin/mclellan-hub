<%- include('partials/crm-head', { title: contact.name, active: 'contacts' }) %>
<script>
async function taskAction(id, action) {
  const r = await fetch(`/api/tasks/${id}/${action}`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + (j.error || action + ' failed'));
}
</script>
<a class="crm-back" href="/crm/contacts">People</a>
<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Contact</p>
    <h1><%= contact.name %></h1>
    <p>
      <% if (contact.email) { %><a href="mailto:<%= contact.email %>"><%= contact.email %></a><% } %>
      <% if (contact.email && contact.phone) { %> · <% } %>
      <% if (contact.phone) { %><a href="tel:<%= contact.phone %>"><%= contact.phone %></a><% } %>
    </p>
    <% if (companies.length) { %>
      <p>
        <% for (const company of companies) { %>
          <a href="/crm/company/<%= company.id %>"><%= company.name %></a><%= company.role ? ` · ${company.role}` : '' %>
        <% } %>
      </p>
    <% } else { %><p>No company linked yet.</p><% } %>
    <p class="crm-muted" style="font-size:13px;">
      <% if (contact.last_contacted_at) { %>
        <% const daysSince = Math.floor((Date.now() / 1000 - contact.last_contacted_at) / 86400); %>
        Last contacted: <%= daysSince === 0 ? 'today' : daysSince === 1 ? 'yesterday' : `${daysSince} days ago` %><%= contact.keep_warm_days ? ` · keep-warm every ${contact.keep_warm_days}d` : '' %>
        <% if (contact.keep_warm_days && daysSince > contact.keep_warm_days) { %>
          <span style="color:var(--crm-danger,#c0392b);font-weight:600;">· check-in <%= daysSince - contact.keep_warm_days %>d overdue</span>
        <% } else if (contact.keep_warm_days) { %>
          <span>· next check-in in <%= contact.keep_warm_days - daysSince %>d</span>
        <% } %>
      <% } else { %>
        No contact recorded yet<%= contact.keep_warm_days ? ` · keep-warm every ${contact.keep_warm_days}d` : '' %>
      <% } %>
      <button class="btn btn-sm btn-ghost" id="touchpoint-toggle" style="margin-left:8px;">Record touchpoint</button>
    </p>
    <form id="touchpoint-form" style="display:none;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px;">
      <input name="date" type="date" required style="font-size:13px;padding:4px 8px;">
      <input name="note" placeholder="What happened? (optional)" style="font-size:13px;padding:4px 8px;min-width:220px;">
      <button class="btn btn-sm" type="submit">Save</button>
      <span class="crm-muted" id="touchpoint-msg" style="font-size:12px;"></span>
    </form>
  </div>
</section>

<div class="crm-two-col">
  <section class="section-card">
    <% if (upcomingMeetings.length) { %>
      <h2>Upcoming meetings</h2>
      <div class="crm-timeline" style="margin-bottom:24px;">
        <% for (const meeting of upcomingMeetings) { %>
          <a class="crm-timeline-item crm-timeline-upcoming" href="/crm/meeting/<%= meeting.id %>">
            <time><%= meeting.meeting_date %><%= meeting.meeting_time ? ` · ${meeting.meeting_time}` : '' %></time>
            <strong><%= meeting.title %></strong>
            <span><%= meeting.company_name || 'Meeting' %></span>
          </a>
        <% } %>
      </div>
    <% } %>
    <h2>Timeline</h2>
    <div class="crm-timeline">
      <% for (const meeting of pastMeetings) { %>
        <a class="crm-timeline-item" href="/crm/meeting/<%= meeting.id %>">
          <time><%= meeting.meeting_date %><%= meeting.meeting_time ? ` · ${meeting.meeting_time}` : '' %></time>
          <strong><%= meeting.title %></strong>
          <span><%= meeting.company_name || 'Meeting' %></span>
        </a>
      <% } %>
      <% for (const fact of facts) { %>
        <div class="crm-timeline-item<%= fact.status === 'archived' ? ' crm-timeline-archived' : '' %>">
          <time><%= new Date(fact.created_at * 1000).toLocaleDateString('en-GB') %>
            <% if (fact.status === 'follow_up') { %>
              <span class="crm-type follow_up" style="margin-left:6px;">follow-up</span>
              <% if (fact.due_date) { %>
                <% const overdue = fact.due_date <= new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Dublin' }); %>
                <span style="margin-left:6px;font-size:11px;<%= overdue ? 'color:var(--crm-danger,#c0392b);font-weight:600;' : 'opacity:.6;' %>"><%= overdue ? '⚠ overdue ' : 'due ' %><%= fact.due_date %></span>
              <% } %>
            <% } %>
            <% if (fact.status === 'archived') { %><span style="font-size:10px;opacity:.5;margin-left:6px;">archived</span><% } %>
          </time>
          <strong id="fact-text-<%= fact.id %>"><%= fact.fact %></strong>
          <form class="crm-fact-edit-form" id="fact-edit-<%= fact.id %>" data-fact-id="<%= fact.id %>" style="display:none;">
            <textarea name="fact" rows="3" required><%= fact.fact %></textarea>
            <% if (fact.status === 'follow_up') { %>
              <label style="font-size:12px;opacity:.7;display:flex;gap:6px;align-items:center;margin-top:4px;">Due
                <input type="date" name="due_date" value="<%= fact.due_date || '' %>" style="font-size:12px;padding:2px 6px;">
              </label>
            <% } %>
            <div class="crm-fact-edit-actions">
              <button class="btn btn-sm" type="submit">Save</button>
              <button class="btn btn-sm btn-ghost" type="button" onclick="cancelFactEdit('<%= fact.id %>')">Cancel</button>
              <span class="crm-muted crm-fact-edit-msg"></span>
            </div>
          </form>
          <span style="display:flex;justify-content:space-between;align-items:center;">
            <span><% if (fact.meeting_id) { %><a href="/crm/meeting/<%= fact.meeting_id %>"><%= fact.meeting_title %></a> · <% } %><%= fact.source !== 'dchat' ? fact.source : '' %></span>
            <span class="crm-fact-actions">
              <button class="crm-fact-archive" onclick="startFactEdit('<%= fact.id %>')" title="Edit this fact">Edit</button>
              <% if (fact.status !== 'archived') { %>
                <button class="crm-fact-archive" onclick="archiveFact('<%= fact.id %>')" title="Archive this fact">Archive</button>
              <% } else { %>
                <button class="crm-fact-archive" onclick="unarchiveFact('<%= fact.id %>')" title="Restore fact">Restore</button>
              <% } %>
              <button class="crm-fact-archive" style="color:var(--crm-danger,#c0392b);opacity:.7;" onclick="wrongFact('<%= fact.id %>')" title="Mark as wrong — AI won't repeat this error">Wrong</button>
            </span>
          </span>
        </div>
      <% } %>
      <% if (!meetings.length && !facts.length) { %><p class="crm-muted">Nothing in the timeline yet.</p><% } %>
    </div>
  </section>

  <aside class="crm-stack">
    <section class="section-card">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;">
        <h2 style="margin:0;">Tasks</h2>
        <a href="?show_history=<%= showHistory ? '0' : '1' %>" style="font-size:12px;opacity:.6;"><%= showHistory ? 'Hide history' : 'Show history' %></a>
      </div>
      <% const openTasks = tasks.filter(t => t.status === 'needsAction' && !t.deleted_at); %>
      <% const histTasks = tasks.filter(t => t.status !== 'needsAction' || t.deleted_at); %>
      <% for (const t of openTasks) { %>
        <%- include('partials/task-row', { t, showHistory }) %>
      <% } %>
      <% if (!openTasks.length) { %><p class="crm-muted">No open tasks.</p><% } %>
      <% if (showHistory) { %>
        <% for (const t of histTasks) { %>
          <%- include('partials/task-row', { t, showHistory }) %>
        <% } %>
      <% } %>
      <!-- Quick add task for this contact -->
      <form class="crm-inline-form" id="contact-task-form" style="margin-top:12px;flex-wrap:wrap;">
        <input name="title" placeholder="Add a task…" required style="flex:1;min-width:160px;">
        <input name="contact_id" type="hidden" value="<%= contact.id %>">
        <input name="due" type="date" title="Due date (optional)" style="max-width:140px;font-size:13px;">
        <% if (linkedProjects.length || availableProjects.length) { %>
          <select name="project_slug" title="Project (optional)" style="max-width:150px;font-size:13px;">
            <option value="">No project</option>
            <% for (const p of linkedProjects) { %><option value="<%= p.slug %>"><%= p.name %></option><% } %>
            <% for (const p of availableProjects) { %><option value="<%= p.slug %>"><%= p.name %></option><% } %>
          </select>
        <% } %>
        <button class="btn btn-sm" type="submit">Add</button>
      </form>
      <p class="crm-muted" id="contact-task-msg" style="font-size:12px;margin-top:4px;"></p>
    </section>

    <% const predicates = Object.keys(knowledgeByPredicate || {}); %>
    <% if (predicates.length) { %>
    <section class="section-card">
      <h2 style="margin-bottom:4px;">Knowledge</h2>
      <p class="crm-muted" style="font-size:12px;margin:0 0 12px;">Compiled from source evidence by the CRM knowledge engine and nightly synthesis — each claim links back to what produced it.</p>
      <% for (const pred of predicates) { %>
        <div style="margin-bottom:10px;">
          <div style="font-size:11px;text-transform:uppercase;letter-spacing:.04em;opacity:.55;margin-bottom:3px;"><%= pred.replace(/_/g,' ') %></div>
          <% for (const a of knowledgeByPredicate[pred]) { %>
            <div style="display:flex;justify-content:space-between;gap:8px;align-items:baseline;padding:4px 0;border-bottom:1px solid var(--border);">
              <span style="font-size:13px;<%= a.status === 'stale' ? 'opacity:.55;' : '' %>"><%= a.value %><% if (a.status === 'proposed') { %> <span title="awaiting review" style="font-size:10px;opacity:.6;">· proposed</span><% } %><% if (a.status === 'stale') { %> <span title="not confirmed by any source in over a year" style="font-size:10px;opacity:.6;">· stale</span><% } %></span>
              <span style="font-size:11px;white-space:nowrap;display:inline-flex;gap:6px;align-items:baseline;">
                <span style="opacity:.5;" title="confidence <%= a.confidence.toFixed(2) %>"><%= Math.round(a.confidence*100) %>%</span>
                <% a.sources.forEach(function(s){ %><a href="/crm/source/<%= s.kind %>/<%= encodeURIComponent(s.id) %>" style="opacity:.65;" title="open source: <%= s.kind.replace(/_/g,' ') %>"><%= ({document:'doc',email_summary:'email',meeting_intake:'meeting',crm_fact:'fact',completed_task:'task'})[s.kind] || s.kind %></a><% }); %>
              </span>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>
    <% } %>

    <section class="section-card">
      <h2>Also worked with</h2>
      <div class="crm-badges">
        <% for (const person of workedWith) { %><a class="crm-badge" href="/crm/contact/<%= person.id %>"><%= person.name %></a><% } %>
      </div>
      <% if (!workedWith.length) { %><p class="crm-muted">No shared context yet.</p><% } %>
    </section>

    <% if (companies.length || availableCompanies.length) { %>
    <section class="section-card">
      <h2>Companies</h2>
      <p class="crm-muted crm-section-help">The company and role marked below are shown as tags on the People page.</p>
      <% for (const co of companies) { %>
        <div class="crm-action" id="co-row-<%= co.id %>">
          <div class="crm-company-link-details">
            <div class="crm-company-link-title">
              <a href="/crm/company/<%= co.id %>"><strong><%= co.name %></strong></a>
              <% if (co.is_primary) { %><span class="crm-badge">Shown on People card</span><% } %>
            </div>
            <span class="crm-role-display crm-muted" id="co-role-<%= co.id %>" data-company-id="<%= co.id %>" data-role="<%= co.role || '' %>" style="font-size:13px;cursor:pointer;" title="Click to edit role"><%= co.role ? ('· ' + co.role) : '+ role' %></span>
            <span class="crm-role-edit" id="co-role-edit-<%= co.id %>" style="display:none;gap:4px;align-items:center;">
              <input id="co-role-input-<%= co.id %>" style="font-size:13px;padding:2px 6px;max-width:160px;" placeholder="Role…" value="<%= co.role || '' %>">
              <button class="btn btn-sm save-role-btn" data-company-id="<%= co.id %>">Save</button>
              <button class="btn btn-sm btn-ghost cancel-role-btn" data-company-id="<%= co.id %>">Cancel</button>
            </span>
          </div>
          <div class="crm-company-link-actions">
            <% if (!co.is_primary) { %><button class="btn btn-sm btn-ghost" onclick="makePrimaryCompany('<%= co.id %>')">Show on People card</button><% } %>
            <button class="btn btn-sm btn-ghost" onclick="unlinkCompany('<%= co.id %>')">Remove</button>
          </div>
        </div>
      <% } %>
      <% if (availableCompanies.length) { %>
        <form class="crm-inline-form" id="link-company-form" style="margin-top:12px;">
          <select name="company_id" required style="flex:1;">
            <option value="">Link a company…</option>
            <% for (const co of availableCompanies) { %>
              <option value="<%= co.id %>"><%= co.name %></option>
            <% } %>
          </select>
          <input name="role" placeholder="Role (optional)" style="max-width:140px;">
          <label class="crm-checkbox"><input type="checkbox" name="is_primary" value="1"<%= companies.length ? '' : ' checked' %>> Show on People card</label>
          <button class="btn btn-sm" type="submit">Link</button>
        </form>
        <p class="crm-muted" id="link-company-msg" style="font-size:12px;margin-top:4px;"></p>
      <% } %>
    </section>
    <% } %>

    <section class="section-card">
      <h2>Projects</h2>
      <% if (!linkedProjects.length) { %><p class="crm-muted">No projects linked.</p><% } %>
      <% for (const p of linkedProjects) { %>
        <div class="crm-action">
          <a href="/crm/project/<%= p.slug %>"><strong><%= p.name %></strong><% if (p.role) { %> <span class="crm-muted">· <%= p.role %></span><% } %></a>
          <button class="btn btn-sm btn-ghost" onclick="unlinkProject('<%= p.id %>')">Remove</button>
        </div>
      <% } %>
      <% if (availableProjects.length) { %>
        <form class="crm-inline-form" id="link-project-form" style="margin-top:12px;">
          <select name="project_id" required style="flex:1;">
            <option value="">Link a project…</option>
            <% for (const p of availableProjects) { %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% } %>
          </select>
          <input name="role" placeholder="Role (optional)" list="project-role-taxonomy" style="max-width:140px;">
          <datalist id="project-role-taxonomy">
            <option value="owner"></option>
            <option value="stakeholder"></option>
            <option value="decision-maker"></option>
            <option value="vendor"></option>
            <option value="end-user"></option>
          </datalist>
          <button class="btn btn-sm" type="submit">Link</button>
        </form>
        <p class="crm-muted" id="link-project-msg" style="font-size:12px;margin-top:4px;"></p>
      <% } %>
    </section>

    <section class="section-card">
      <h2>Edit contact</h2>
      <form class="crm-form-grid" id="contact-edit-form">
        <label class="wide">Name
          <input name="name" value="<%= contact.name %>" required>
        </label>
        <label class="wide">Aliases <span style="font-size:11px;opacity:.6;">comma-separated</span>
          <input name="aliases" value="<%= (() => { try { return JSON.parse(contact.aliases || '[]').join(', '); } catch { return ''; } })() %>">
        </label>
        <label class="wide">Email address
          <input name="email" type="email" value="<%= contact.email || '' %>" placeholder="name@example.com">
        </label>
        <label class="wide">Phone
          <input name="phone" value="<%= contact.phone || '' %>" placeholder="+353 …">
        </label>
        <label>Birthday
          <input name="birthday" type="date" value="<%= contact.birthday && contact.birthday.length === 10 ? contact.birthday : '' %>">
        </label>
        <label>Keep in touch
          <select name="keep_warm_days">
            <option value="">Off</option>
            <option value="30" <%= contact.keep_warm_days === 30 ? 'selected' : '' %>>Every 30 days</option>
            <option value="60" <%= contact.keep_warm_days === 60 ? 'selected' : '' %>>Every 60 days</option>
            <option value="90" <%= contact.keep_warm_days === 90 ? 'selected' : '' %>>Every 90 days</option>
          </select>
        </label>
        <div style="display:flex;gap:8px;align-items:center;">
          <button class="btn" type="submit">Save</button>
          <span class="crm-muted" id="contact-edit-msg" style="font-size:12px;"></span>
        </div>
      </form>

      <section class="crm-section" style="margin-top:24px;">
        <h3 class="crm-section-title">Merge into another contact</h3>
        <p class="crm-muted" style="font-size:13px;margin-bottom:8px;">Move all facts, meetings, and links from this contact into a different one, then delete this record. Use when two contacts represent the same person.</p>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <input id="merge-search" type="text" placeholder="Search contacts…" style="flex:1;min-width:160px;">
          <button class="btn btn-ghost" id="merge-btn" disabled>Merge into selected</button>
        </div>
        <div id="merge-results" style="margin-top:6px;font-size:13px;"></div>
        <span class="crm-muted" id="merge-msg" style="font-size:12px;"></span>
      </section>

      <section class="crm-section" style="margin-top:24px;">
        <h3 class="crm-section-title">Delete contact</h3>
        <p class="crm-muted" style="font-size:13px;margin-bottom:8px;">Remove this CRM contact and its direct CRM links. Use for placeholder people such as transcript speaker labels.</p>
        <button class="btn btn-ghost" id="delete-contact-btn" style="color:var(--crm-danger,#c0392b);border-color:currentColor;">Delete contact</button>
        <span class="crm-muted" id="delete-contact-msg" style="font-size:12px;"></span>
      </section>
    </section>
  </aside>
</div>
<script>
// Manual touchpoint recorder
document.getElementById('touchpoint-toggle').addEventListener('click', () => {
  const form = document.getElementById('touchpoint-form');
  const open = form.style.display === 'none';
  form.style.display = open ? 'flex' : 'none';
  if (open) {
    const dateInput = form.elements.date;
    if (!dateInput.value) dateInput.value = new Date().toLocaleDateString('sv-SE');
    dateInput.focus();
  }
});
document.getElementById('touchpoint-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('touchpoint-msg');
  msg.textContent = 'Saving…';
  try {
    const r = await fetch('/api/crm/contacts/<%= contact.id %>/touchpoint', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(e.target))),
    });
    const j = await r.json();
    if (j.ok) { msg.textContent = 'Saved.'; setTimeout(() => location.reload(), 600); }
    else msg.textContent = j.error || 'Error';
  } catch (err) { msg.textContent = err.message; }
});

// Fact edit/archive/unarchive
function startFactEdit(id) {
  document.getElementById('fact-text-' + id).style.display = 'none';
  const form = document.getElementById('fact-edit-' + id);
  form.style.display = 'grid';
  form.querySelector('textarea').focus();
}
function cancelFactEdit(id) {
  document.getElementById('fact-edit-' + id).style.display = 'none';
  document.getElementById('fact-text-' + id).style.display = '';
}
document.querySelectorAll('.crm-fact-edit-form').forEach(form => {
  form.addEventListener('submit', async e => {
    e.preventDefault();
    const id = form.dataset.factId;
    const fact = form.elements.fact.value.trim();
    const msg = form.querySelector('.crm-fact-edit-msg');
    const btn = form.querySelector('button[type=submit]');
    btn.disabled = true;
    msg.textContent = 'Saving…';
    try {
      const body = { fact };
      if (form.elements.due_date) body.due_date = form.elements.due_date.value;
      const r = await fetch(`/api/crm/facts/${id}/edit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const j = await r.json();
      if (!j.ok) {
        msg.textContent = j.error || 'Error';
        return;
      }
      document.getElementById('fact-text-' + id).textContent = fact;
      cancelFactEdit(id);
      if (!j.projectionSynced) {
        alert('CRM fact saved, but its People note copy could not be updated: ' + (j.projectionWarning || 'unknown error'));
      }
    } catch (err) {
      msg.textContent = err.message;
    } finally {
      btn.disabled = false;
    }
  });
});

async function archiveFact(id) {
  const r = await fetch(`/api/crm/facts/${id}/archive`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}
async function unarchiveFact(id) {
  const r = await fetch(`/api/crm/facts/${id}/unarchive`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}
async function wrongFact(id) {
  const r = await fetch(`/api/crm/facts/${id}/wrong`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}

// Company link/unlink
const linkCompanyForm = document.getElementById('link-company-form');
if (linkCompanyForm) {
  linkCompanyForm.addEventListener('submit', async e => {
    e.preventDefault();
    const msg = document.getElementById('link-company-msg');
    const data = Object.fromEntries(new FormData(e.target));
    msg.textContent = 'Linking…';
    try {
      const r = await fetch('/api/crm/contacts/<%= contact.id %>/companies', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
      });
      const j = await r.json();
      if (j.ok) location.reload();
      else msg.textContent = j.error || 'Error';
    } catch (err) { msg.textContent = err.message; }
  });
}

async function unlinkCompany(companyId) {
  const r = await fetch('/api/crm/contacts/<%= contact.id %>/companies/unlink', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ company_id: companyId }),
  });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}

async function makePrimaryCompany(companyId) {
  const r = await fetch('/api/crm/contacts/<%= contact.id %>/companies/primary', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ company_id: companyId }),
  });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}

document.querySelectorAll('.crm-role-display').forEach(el => {
  el.addEventListener('click', () => {
    const companyId = el.dataset.companyId;
    el.style.display = 'none';
    const editEl = document.getElementById('co-role-edit-' + companyId);
    editEl.style.display = 'flex';
    const input = document.getElementById('co-role-input-' + companyId);
    input.focus();
    input.onkeydown = e => {
      if (e.key === 'Enter') doSaveRole(companyId);
      if (e.key === 'Escape') doCancelRole(companyId);
    };
  });
});

document.querySelectorAll('.cancel-role-btn').forEach(btn => {
  btn.addEventListener('click', () => doCancelRole(btn.dataset.companyId));
});

document.querySelectorAll('.save-role-btn').forEach(btn => {
  btn.addEventListener('click', () => doSaveRole(btn.dataset.companyId));
});

function doCancelRole(companyId) {
  document.getElementById('co-role-edit-' + companyId).style.display = 'none';
  document.getElementById('co-role-' + companyId).style.display = '';
}

async function doSaveRole(companyId) {
  const role = document.getElementById('co-role-input-' + companyId).value.trim();
  const r = await fetch('/api/crm/contacts/<%= contact.id %>/companies/role', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ company_id: companyId, role }),
  });
  const j = await r.json();
  if (j.ok) {
    const display = document.getElementById('co-role-' + companyId);
    display.textContent = role ? ('· ' + role) : '+ role';
    doCancelRole(companyId);
  } else alert('Error: ' + j.error);
}

// Project link/unlink
const linkProjectForm = document.getElementById('link-project-form');
if (linkProjectForm) {
  linkProjectForm.addEventListener('submit', async e => {
    e.preventDefault();
    const msg = document.getElementById('link-project-msg');
    const data = Object.fromEntries(new FormData(e.target));
    msg.textContent = 'Linking…';
    try {
      const r = await fetch('/api/crm/contacts/<%= contact.id %>/projects', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
      });
      const j = await r.json();
      if (j.ok) location.reload();
      else msg.textContent = j.error || 'Error';
    } catch (err) { msg.textContent = err.message; }
  });
}

async function unlinkProject(projectId) {
  const r = await fetch('/api/crm/contacts/<%= contact.id %>/projects/unlink', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ project_id: projectId }),
  });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}

document.getElementById('contact-edit-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('contact-edit-msg');
  const btn = e.target.querySelector('button[type=submit]');
  const data = Object.fromEntries(new FormData(e.target));
  btn.disabled = true; msg.textContent = 'Saving…';
  try {
    const r = await fetch('/api/crm/contacts/<%= contact.id %>/edit', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
    });
    const j = await r.json();
    if (j.ok) {
      msg.textContent = 'Saved.';
      document.title = data.name + ' — McLellan Hub CRM';
      document.querySelector('.crm-hero h1').textContent = data.name;
      const warning = j.profileSynced === false ? ` Wiki profile warning: ${j.profileWarning || 'not synchronized'}` : '';
      msg.textContent = 'Saved.' + warning;
      setTimeout(() => { msg.textContent = ''; }, 2500);
    } else { msg.textContent = j.error || 'Error'; }
  } catch (err) { msg.textContent = err.message; }
  finally { btn.disabled = false; }
});

document.getElementById('contact-task-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('contact-task-msg');
  const data = Object.fromEntries(new FormData(e.target));
  msg.textContent = 'Adding…';
  try {
    const r = await fetch('/api/tasks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
    const j = await r.json();
    if (j.ok) { msg.textContent = 'Added!'; e.target.reset(); setTimeout(() => location.reload(), 800); }
    else msg.textContent = j.error || 'Error';
  } catch (err) { msg.textContent = err.message; }
});

// Contact merge
let mergeTargetId = null;
const mergeSearch = document.getElementById('merge-search');
const mergeResults = document.getElementById('merge-results');
const mergeBtn = document.getElementById('merge-btn');
const mergeMsg = document.getElementById('merge-msg');
const deleteContactBtn = document.getElementById('delete-contact-btn');
const deleteContactMsg = document.getElementById('delete-contact-msg');
const CURRENT_ID = '<%= contact.id %>';
const CURRENT_NAME = <%- JSON.stringify(contact.name) %>;

let mergeDebounce;
mergeSearch.addEventListener('input', () => {
  clearTimeout(mergeDebounce);
  mergeTargetId = null;
  mergeBtn.disabled = true;
  const q = mergeSearch.value.trim();
  if (q.length < 2) { mergeResults.innerHTML = ''; return; }
  mergeDebounce = setTimeout(async () => {
    const resp = await fetch(`/api/crm/contacts?q=${encodeURIComponent(q)}`);
    const contacts = await resp.json();
    const filtered = contacts.filter(c => c.id !== CURRENT_ID).slice(0, 6);
    if (!filtered.length) { mergeResults.innerHTML = '<span class="crm-muted">No matches</span>'; return; }
    mergeResults.innerHTML = filtered.map(c =>
      `<div style="padding:4px 0;cursor:pointer;border-bottom:1px solid var(--border)" data-id="${c.id}" data-name="${c.name.replace(/"/g,'&quot;')}">
        ${c.name}${c.email ? ` <span class="crm-muted">(${c.email})</span>` : ''}
      </div>`
    ).join('');
    mergeResults.querySelectorAll('[data-id]').forEach(el => {
      el.addEventListener('click', () => {
        mergeTargetId = el.dataset.id;
        mergeSearch.value = el.dataset.name;
        mergeResults.innerHTML = `<span style="color:var(--accent)">Selected: ${el.dataset.name}</span>`;
        mergeBtn.disabled = false;
      });
    });
  }, 300);
});

mergeBtn.addEventListener('click', async () => {
  if (!mergeTargetId) return;
  if (!confirm(`Merge "<%= contact.name %>" into the selected contact? This cannot be undone.`)) return;
  mergeBtn.disabled = true;
  mergeMsg.textContent = 'Merging…';
  try {
    const r = await fetch(`/api/crm/contacts/<%= contact.id %>/merge`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ targetId: mergeTargetId }),
    });
    const j = await r.json();
    if (j.ok) {
      mergeMsg.textContent = `Merged into ${j.into}. Redirecting…`;
      setTimeout(() => { window.location.href = `/crm/contact/${mergeTargetId}`; }, 1000);
    } else {
      mergeMsg.textContent = j.error || 'Error';
      mergeBtn.disabled = false;
  }
  } catch (err) { mergeMsg.textContent = err.message; mergeBtn.disabled = false; }
});

deleteContactBtn.addEventListener('click', async () => {
  if (!confirm(`Delete "${CURRENT_NAME}" from CRM? This removes its direct facts, meeting attendance, and company/project links. This cannot be undone.`)) return;
  deleteContactBtn.disabled = true;
  deleteContactMsg.textContent = 'Deleting...';
  try {
    const r = await fetch(`/api/crm/contacts/${CURRENT_ID}/delete`, { method: 'POST' });
    const j = await r.json();
    if (j.ok) {
      window.location.href = '/crm/contacts';
    } else {
      deleteContactMsg.textContent = j.error || 'Error';
      deleteContactBtn.disabled = false;
    }
  } catch (err) {
    deleteContactMsg.textContent = err.message;
    deleteContactBtn.disabled = false;
  }
});
</script>
