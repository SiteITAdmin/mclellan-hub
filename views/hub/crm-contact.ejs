<%- include('partials/crm-head', { title: contact.name, active: 'contacts' }) %>
<script>
async function taskAction(id, action) {
  const r = await fetch(`/api/tasks/${id}/${action}`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + (j.error || action + ' failed'));
}
</script>
<a class="crm-back" href="/crm/contacts">People</a>
<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Contact</p>
    <h1><%= contact.name %></h1>
    <% if (companies.length) { %>
      <p>
        <% for (const company of companies) { %>
          <a href="/crm/company/<%= company.id %>"><%= company.name %></a><%= company.role ? ` · ${company.role}` : '' %>
        <% } %>
      </p>
    <% } else { %><p>No company linked yet.</p><% } %>
  </div>
</section>

<div class="crm-two-col">
  <section class="section-card">
    <h2>Timeline</h2>
    <div class="crm-timeline">
      <% for (const meeting of meetings) { %>
        <a class="crm-timeline-item" href="/crm/meeting/<%= meeting.id %>">
          <time><%= meeting.meeting_date %><%= meeting.meeting_time ? ` · ${meeting.meeting_time}` : '' %></time>
          <strong><%= meeting.title %></strong>
          <span><%= meeting.company_name || 'Meeting' %></span>
        </a>
      <% } %>
      <% for (const fact of facts) { %>
        <div class="crm-timeline-item">
          <time><%= new Date(fact.created_at * 1000).toLocaleDateString('en-GB') %></time>
          <strong><span class="crm-type <%= fact.fact_type || 'fact' %>"><%= fact.fact_type || 'fact' %></span> <%= fact.fact %></strong>
          <span>
            Subject: <%= fact.subject_name %>
            <% if (fact.meeting_id) { %> · <a href="/crm/meeting/<%= fact.meeting_id %>"><%= fact.meeting_title %></a><% } %>
          </span>
        </div>
      <% } %>
      <% if (!meetings.length && !facts.length) { %><p class="crm-muted">Nothing in the timeline yet.</p><% } %>
    </div>
  </section>

  <aside class="crm-stack">
    <section class="section-card">
      <h2>Open actions</h2>
      <% for (const action of openActions) { %>
        <div class="crm-action">
          <span><%= action.fact %></span>
          <form method="post" action="/crm/facts/<%= action.id %>/complete"><button class="btn btn-sm" type="submit">Done</button></form>
        </div>
      <% } %>
      <% if (!openActions.length) { %><p class="crm-muted">No open actions.</p><% } %>
    </section>

    <section class="section-card">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;">
        <h2 style="margin:0;">Tasks</h2>
        <a href="?show_history=<%= showHistory ? '0' : '1' %>" style="font-size:12px;opacity:.6;"><%= showHistory ? 'Hide history' : 'Show history' %></a>
      </div>
      <% const openTasks = tasks.filter(t => t.status === 'needsAction' && !t.deleted_at); %>
      <% const histTasks = tasks.filter(t => t.status !== 'needsAction' || t.deleted_at); %>
      <% for (const t of openTasks) { %>
        <%- include('partials/task-row', { t, showHistory }) %>
      <% } %>
      <% if (!openTasks.length) { %><p class="crm-muted">No open tasks.</p><% } %>
      <% if (showHistory) { %>
        <% for (const t of histTasks) { %>
          <%- include('partials/task-row', { t, showHistory }) %>
        <% } %>
      <% } %>
      <!-- Quick add task for this contact -->
      <form class="crm-inline-form" id="contact-task-form" style="margin-top:12px;">
        <input name="title" placeholder="Add a task…" required style="flex:1;">
        <input name="contact_id" type="hidden" value="<%= contact.id %>">
        <button class="btn btn-sm" type="submit">Add</button>
      </form>
      <p class="crm-muted" id="contact-task-msg" style="font-size:12px;margin-top:4px;"></p>
    </section>

    <section class="section-card">
      <h2>Also worked with</h2>
      <div class="crm-badges">
        <% for (const person of workedWith) { %><a class="crm-badge" href="/crm/contact/<%= person.id %>"><%= person.name %></a><% } %>
      </div>
      <% if (!workedWith.length) { %><p class="crm-muted">No shared context yet.</p><% } %>
    </section>
  </aside>
</div>
<script>
document.getElementById('contact-task-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('contact-task-msg');
  const data = Object.fromEntries(new FormData(e.target));
  msg.textContent = 'Adding…';
  try {
    const r = await fetch('/api/tasks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
    const j = await r.json();
    if (j.ok) { msg.textContent = 'Added!'; e.target.reset(); setTimeout(() => location.reload(), 800); }
    else msg.textContent = j.error || 'Error';
  } catch (err) { msg.textContent = err.message; }
});
</script>
<%- include('partials/crm-foot') %>
