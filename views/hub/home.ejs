<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>McLellan Hub</title>
<link rel="stylesheet" href="/hub.css">
<style>
body.hub-page { height: auto !important; min-height: 100vh; overflow: auto !important; }
.home-wrap { max-width: 780px; margin: 0 auto; padding: 32px 16px 80px; }
.home-greeting { font-size: 26px; font-weight: 700; margin: 0 0 4px; }
.home-date { font-size: 13px; color: var(--text-dim); margin: 0 0 28px; }

/* Today strip */
.today-strip {
  background: var(--surface, #f4f3fb);
  border: 1px solid var(--border, #e0ddf0);
  border-radius: 14px;
  padding: 16px 20px;
  margin-bottom: 32px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.today-strip-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-dim); margin-bottom: 2px; }
.today-items { display: flex; flex-wrap: wrap; gap: 8px; }
.today-item {
  display: inline-flex; align-items: center; gap: 7px;
  background: var(--bg); border: 1px solid var(--border);
  border-radius: 20px; padding: 5px 12px; font-size: 13px;
}
.today-item.done { border-color: #4caf8a; background: rgba(76,175,138,.08); color: #2e7d60; }
.today-item.warn { border-color: #e8a000; background: rgba(232,160,0,.08); color: #8a5a00; }
.today-item.event { border-color: var(--primary, #4648d4); background: rgba(70,72,212,.06); color: var(--primary); }
.today-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex-shrink: 0; }

/* Hub tiles */
.hub-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; margin-bottom: 36px; }
.hub-tile {
  background: var(--bg); border: 1px solid var(--border);
  border-radius: 14px; padding: 22px 20px;
  text-decoration: none; color: var(--text);
  display: flex; flex-direction: column; gap: 8px;
  transition: border-color .15s, box-shadow .15s;
  cursor: pointer;
}
.hub-tile:hover { border-color: var(--primary); box-shadow: 0 4px 16px rgba(70,72,212,.1); }
.hub-tile-icon { font-size: 28px; line-height: 1; }
.hub-tile-label { font-size: 16px; font-weight: 700; }
.hub-tile-desc { font-size: 12px; color: var(--text-dim); line-height: 1.5; }
.hub-tile-meta { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
.hub-tile-pill {
  display: inline-flex; align-items: center;
  min-height: 20px; padding: 3px 8px; border-radius: 999px;
  border: 1px solid var(--border); color: var(--text-dim);
  font-size: 11px; font-weight: 700; line-height: 1;
}

/* Recent section */
.recents-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-dim); margin: 0 0 12px; }
.recent-row { display: flex; flex-direction: column; gap: 6px; }
.recent-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px;
  background: var(--bg); border: 1px solid var(--border); border-radius: 10px;
  text-decoration: none; color: var(--text); font-size: 13px; transition: border-color .12s; }
.recent-item:hover { border-color: var(--primary); }
.recent-item-label { flex: 1; font-weight: 500; }
.recent-item-meta { font-size: 12px; color: var(--text-dim); white-space: nowrap; }
</style>
</head>
<body class="hub-page" style="background: var(--bg-page, #f4f3fb);">
<main>
<div class="home-wrap">

  <p class="home-greeting">Good to see you, <%= user.charAt(0).toUpperCase() + user.slice(1) %>.</p>
  <p class="home-date"><%= today %></p>

  <!-- ── Today strip ──────────────────────────────────────────────────────── -->
  <div class="today-strip">
    <div class="today-strip-title">Today</div>
    <div class="today-items">

      <% if (calendarEvents.length === 0) { %>
        <a href="https://calendar.google.com" target="_blank" rel="noopener" class="today-item warn"><span class="today-dot"></span> Check Google Calendar</a>
      <% } else { %>
        <% for (const ev of calendarEvents) { %>
          <span class="today-item event"><span class="today-dot"></span><%= ev.time ? ev.time + ' · ' : '' %><%= ev.summary %></span>
        <% } %>
        <a href="https://calendar.google.com" target="_blank" rel="noopener" class="today-item" style="font-size:12px;color:var(--text-dim);">Open Calendar</a>
      <% } %>

      <% if (recentMeeting) { %>
        <span class="today-item">Last meeting: <strong style="margin-left:4px"><%= recentMeeting %></strong></span>
      <% } %>

    </div>
  </div>

  <!-- ── Hub tiles ────────────────────────────────────────────────────────── -->
  <div class="hub-tiles">

    <a href="/c" class="hub-tile">
      <div class="hub-tile-icon">💬</div>
      <div class="hub-tile-label">AI Chat</div>
      <div class="hub-tile-desc">Ask anything, work on a project, or pick up a recent conversation.</div>
    </a>

    <a href="https://wiki.mclellan.scot" class="hub-tile">
      <div class="hub-tile-icon">📚</div>
      <div class="hub-tile-label">Projects &amp; Wiki</div>
      <div class="hub-tile-desc">Browse synthesised knowledge by project, topic, or person.</div>
    </a>

    <a href="/crm" class="hub-tile">
      <div class="hub-tile-icon">👥</div>
      <div class="hub-tile-label">CRM &amp; People</div>
      <div class="hub-tile-desc">Contacts, meeting history, facts, and briefings.</div>
    </a>

    <a href="/debrief" class="hub-tile">
      <div class="hub-tile-icon">🎤</div>
      <div class="hub-tile-label">Daily Debrief</div>
      <div class="hub-tile-desc">Record the day — transcribed and saved verbatim to Obsidian.</div>
    </a>

    <a href="/lin" class="hub-tile">
      <div class="hub-tile-icon">✍️</div>
      <div class="hub-tile-label">Content</div>
      <div class="hub-tile-desc">Generate, score, and manage LinkedIn posts. Research → draft → carousel.</div>
    </a>

    <a href="/flights" class="hub-tile">
      <div class="hub-tile-icon">✈️</div>
      <div class="hub-tile-label">Flights</div>
      <div class="hub-tile-desc">Dublin ↔ Edinburgh flight log. Scheduled vs actual, delay tracking.</div>
    </a>

    <a href="/newsletter" class="hub-tile">
      <div class="hub-tile-icon">📰</div>
      <div class="hub-tile-label">Intelligence</div>
      <div class="hub-tile-desc">Weekly briefing from your newsletters. Curate topics and generate a digest.</div>
      <div class="hub-tile-meta">
        <span class="hub-tile-pill"><%= nlThisWeek.total %> topics</span>
        <% if (nlThisWeek.total > 0) { %><span class="hub-tile-pill"><%= nlThisWeek.selected %> selected</span><% } %>
      </div>
    </a>

    <a href="/token-burn" class="hub-tile">
      <div class="hub-tile-icon">◈</div>
      <div class="hub-tile-label">Token Burn</div>
      <div class="hub-tile-desc">Codex, Claude Code, and McLellan OpenRouter usage by day. Exact logs stay separate from estimates.</div>
      <div class="hub-tile-meta">
        <span class="hub-tile-pill"><%= formatTokens(tokenBurn.importedExact) %> exact</span>
        <span class="hub-tile-pill"><%= tokenBurn.lastDate || 'no rows' %></span>
      </div>
    </a>

  </div>

  <!-- ── Recent chats ─────────────────────────────────────────────────────── -->
  <% if (recentConvs.length) { %>
  <p class="recents-title">Recent conversations</p>
  <div class="recent-row">
    <% for (const c of recentConvs.slice(0, 5)) { %>
    <a href="/c/<%= c.id %>" class="recent-item">
      <span class="recent-item-label"><%= c.title || 'Untitled conversation' %></span>
      <span class="recent-item-meta"><%= new Date(c.created_at * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short' }) %></span>
    </a>
    <% } %>
  </div>
  <% } %>

  <form method="POST" action="/logout" style="margin-top: 48px; text-align: center;">
    <button type="submit" style="background:none; border:none; font-size:13px; color:var(--text-dim); cursor:pointer; padding:8px 16px; border-radius:8px; transition:color .15s;">Sign out</button>
  </form>

</div>
</main>
</body>
</html>
