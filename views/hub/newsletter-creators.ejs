<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Creators — McLellan Hub</title>
<link rel="stylesheet" href="/hub.css">
<style>
body.hub-page { height: auto !important; min-height: 100vh; overflow: auto !important; }
.nl-wrap { max-width: 900px; margin: 0 auto; padding: 32px 16px 80px; }
.nl-heading { font-size: 22px; font-weight: 700; margin: 0 0 4px; }
.nl-sub { font-size: 13px; color: var(--text-dim); margin: 0 0 28px; }
.creator-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; margin-bottom: 32px; }
.creator-card { background: var(--bg, #faf9fb); border: 1px solid var(--border, #dddaf0); border-radius: 12px; padding: 20px; text-decoration: none; color: inherit; display: block; transition: border-color .15s; }
.creator-card:hover { border-color: var(--primary, #7c6af5); }
.creator-card h3 { margin: 0 0 6px; font-size: 15px; }
.creator-meta { font-size: 12px; color: var(--text-dim); display: flex; gap: 12px; flex-wrap: wrap; }
.creator-badge { background: var(--primary-light, #ede9fd); color: var(--primary, #7c6af5); border-radius: 6px; padding: 2px 8px; font-size: 11px; font-weight: 600; }
.add-form { background: var(--bg, #faf9fb); border: 1px solid var(--border, #dddaf0); border-radius: 12px; padding: 20px; margin-bottom: 32px; display: none; }
.add-form h3 { margin: 0 0 16px; font-size: 15px; }
.form-row { display: flex; gap: 8px; flex-wrap: wrap; }
.form-row input { flex: 1; min-width: 140px; padding: 8px 10px; border: 1px solid var(--border, #dddaf0); border-radius: 8px; font-size: 13px; background: var(--input-bg, #fff); color: inherit; }
.btn { padding: 8px 16px; background: var(--primary, #7c6af5); color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; }
.btn-subtle { background: transparent; color: var(--text-dim); border: 1px solid var(--border, #dddaf0); }
.msg { font-size: 12px; color: var(--text-dim); margin-top: 8px; }
</style>
</head>
<body class="hub-page">
<%- include('partials/hub-nav', { active: 'newsletter' }) %>
<div class="nl-wrap">
  <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;">
    <h1 class="nl-heading">Creator Feeds</h1>
    <a href="/newsletter" style="font-size:13px;color:var(--text-dim);">← Intelligence</a>
  </div>
  <p class="nl-sub">RSS feeds from creators — full articles ingested to the wiki, briefings on demand.</p>

  <div style="margin-bottom:16px;display:flex;gap:8px;">
    <button class="btn btn-subtle" id="toggle-add">+ Add feed</button>
    <% if (feeds.length) { %>
      <form method="POST" action="/admin/rss-feeds/fetch-all" style="display:inline;">
        <button class="btn btn-subtle" type="submit">↻ Fetch all</button>
      </form>
    <% } %>
    <a class="btn btn-subtle" href="/admin/rss-feeds">Manage feeds →</a>
  </div>

  <div class="add-form" id="add-form">
    <h3>Add creator feed</h3>
    <form method="POST" action="/admin/rss-feeds">
      <div class="form-row">
        <input name="name" placeholder="Creator name (e.g. Nate's Newsletter)" required>
        <input name="creator_slug" placeholder="Slug (e.g. nate)" required>
        <input name="url" placeholder="RSS feed URL" required style="flex:2;">
        <button class="btn" type="submit">Add</button>
      </div>
    </form>
  </div>

  <div class="creator-grid">
    <% for (const feed of feeds) { %>
      <a class="creator-card" href="/newsletter/creator/<%= feed.creator_slug %>">
        <h3><%= feed.name %></h3>
        <div class="creator-meta">
          <span class="creator-badge"><%= feed.creator_slug %></span>
          <span><%= feed.article_count || 0 %> article<%= feed.article_count !== 1 ? 's' : '' %></span>
          <% if (feed.latest_article_at) { %><span>Latest <%= new Date(feed.latest_article_at * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short' }) %></span><% } %>
          <% if (!feed.enabled) { %><span style="color:#e55;">disabled</span><% } %>
        </div>
      </a>
    <% } %>
    <% if (!feeds.length) { %>
      <p style="color:var(--text-dim);font-size:13px;">No creator feeds yet. Add one above.</p>
    <% } %>
  </div>
</div>
<script>
document.getElementById('toggle-add').addEventListener('click', () => {
  const form = document.getElementById('add-form');
  const btn = document.getElementById('toggle-add');
  const open = form.style.display === 'none' || !form.style.display;
  form.style.display = open ? 'block' : 'none';
  btn.textContent = open ? '− Cancel' : '+ Add feed';
  if (open) form.querySelector('input').focus();
});
</script>
</body>
</html>
