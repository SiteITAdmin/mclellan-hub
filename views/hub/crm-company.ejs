<%- include('partials/crm-head', { title: company.name, active: 'companies' }) %>
<script>
async function taskAction(id, action) {
  const r = await fetch(`/api/tasks/${id}/${action}`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + (j.error || action + ' failed'));
}
</script>
<a class="crm-back" href="/crm/companies">Companies</a>
<section class="crm-hero"><div><p class="crm-eyebrow"><%= company.type || 'Company' %></p><h1><%= company.name %></h1><p><%= company.notes || 'Company context and activity.' %></p></div><% if (company.website) { %><a class="btn" href="<%= company.website %>" target="_blank" rel="noreferrer">Website</a><% } %></section>

<div class="crm-two-col">
  <div class="crm-stack">
    <section class="section-card">
      <h2>Company details</h2>
      <form class="crm-form-grid" method="post" action="/crm/company/<%= company.id %>">
        <label>Name<input name="name" value="<%= company.name %>" required></label>
        <label>Type<select name="type"><option value="">Not set</option><% for (const type of ['employer','client','vendor','partner']) { %><option value="<%= type %>" <%= company.type === type ? 'selected' : '' %>><%= type %></option><% } %></select></label>
        <label class="wide">Website<input name="website" type="url" value="<%= company.website || '' %>"></label>
        <label class="wide">Notes<textarea name="notes" rows="3"><%= company.notes || '' %></textarea></label>
        <% for (const f of (identity || [])) { %>
          <label class="wide"><%= f.label %>
            <% if (f.multiline) { %>
              <textarea name="<%= f.key %>" rows="2" data-identity="<%= f.key %>"><%= f.value %></textarea>
            <% } else { %>
              <input name="<%= f.key %>" value="<%= f.value %>" data-identity="<%= f.key %>">
            <% } %>
            <% if (f.suggestion) { %>
              <span class="crm-muted" style="display:block;font-size:12px;margin-top:4px;">Found in ingested email:
                <a href="#" class="crm-suggest-fill" data-field="<%= f.key %>" data-value="<%= f.suggestion %>"><%= f.suggestion %></a></span>
            <% } %>
          </label>
        <% } %>
        <button class="btn" type="submit">Save details</button>
      </form>
      <form class="crm-danger-form" method="post" action="/crm/company/<%= company.id %>/delete" onsubmit="return confirm('Delete this company? Meetings and facts will be kept without the company link.')">
        <button type="submit">Delete company</button>
      </form>
    </section>

    <section class="section-card">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;">
        <h2 style="margin:0;">Tasks <% const openCount = tasks.filter(t => t.status === 'needsAction' && !t.deleted_at).length; if (openCount) { %><span class="crm-count"><%= openCount %></span><% } %></h2>
        <a href="?show_history=<%= showHistory ? '0' : '1' %>" style="font-size:12px;opacity:.6;"><%= showHistory ? 'Hide history' : 'Show history' %></a>
      </div>
      <% const openTasks = tasks.filter(t => t.status === 'needsAction' && !t.deleted_at); %>
      <% const histTasks = tasks.filter(t => t.status !== 'needsAction' || t.deleted_at); %>
      <% for (const t of openTasks) { %>
        <%- include('partials/task-row', { t, showHistory }) %>
      <% } %>
      <% if (!openTasks.length) { %><p class="crm-muted">No open tasks.</p><% } %>
      <% if (showHistory) { %>
        <% for (const t of histTasks) { %>
          <%- include('partials/task-row', { t, showHistory }) %>
        <% } %>
      <% } %>
      <!-- Quick add task for this company -->
      <form class="crm-inline-form" id="company-task-form" style="margin-top:12px;flex-wrap:wrap;">
        <input name="title" placeholder="Add a task for this company…" required style="flex:1;min-width:160px;">
        <input name="company_id" type="hidden" value="<%= company.id %>">
        <select name="contact_id" style="max-width:180px;">
          <option value="">No person</option>
          <% for (const c of contacts) { %><option value="<%= c.id %>"><%= c.name %></option><% } %>
        </select>
        <input name="due" type="date" title="Due date (optional)" style="max-width:140px;font-size:13px;">
        <button class="btn btn-sm" type="submit">Add</button>
      </form>
      <p class="crm-muted" id="company-task-msg" style="font-size:12px;margin-top:4px;"></p>
    </section>

    <section class="section-card">
      <h2>People</h2>
      <% for (const contact of contacts) { %>
        <a class="crm-row-link" href="/crm/contact/<%= contact.id %>"><strong><%= contact.name %></strong><span><%= contact.role || 'Role not set' %><%= contact.is_primary ? ' · Shown on People card' : '' %></span></a>
      <% } %>
      <% if (!contacts.length) { %><p class="crm-muted">No contacts linked.</p><% } %>
      <form class="crm-inline-form" method="post" action="/crm/company/<%= company.id %>/contacts" style="flex-wrap:wrap;">
        <select name="contact_id" id="company-link-contact" required>
          <option value="">Link a contact</option>
          <% for (const contact of availableContacts) { %><option value="<%= contact.id %>"><%= contact.name %></option><% } %>
          <option value="__new__">+ New person…</option>
        </select>
        <span id="company-new-person" style="display:none;gap:6px;">
          <input name="new_name" placeholder="Full name">
          <input name="new_email" type="email" placeholder="Email (optional)">
        </span>
        <input name="role" placeholder="Role">
        <label class="crm-checkbox"><input type="checkbox" name="is_primary" value="1"> Show on People card</label>
        <button class="btn btn-sm" type="submit">Link</button>
      </form>
      <script>
      document.getElementById('company-link-contact').addEventListener('change', e => {
        const span = document.getElementById('company-new-person');
        span.style.display = e.target.value === '__new__' ? 'inline-flex' : 'none';
        span.querySelector('input[name=new_name]').required = e.target.value === '__new__';
      });
      </script>
    </section>

    <% const predicates = Object.keys(knowledgeByPredicate || {}); %>
    <% if (predicates.length) { %>
    <section class="section-card">
      <h2 style="margin-bottom:4px;">Knowledge</h2>
      <p class="crm-muted" style="font-size:12px;margin:0 0 12px;">Compiled from source evidence by the CRM knowledge engine and nightly synthesis — each claim links back to what produced it.</p>
      <% for (const pred of predicates) { %>
        <div style="margin-bottom:10px;">
          <div style="font-size:11px;text-transform:uppercase;letter-spacing:.04em;opacity:.55;margin-bottom:3px;"><%= pred.replace(/_/g,' ') %></div>
          <% for (const a of knowledgeByPredicate[pred]) { %>
            <div style="display:flex;justify-content:space-between;gap:8px;align-items:baseline;padding:4px 0;border-bottom:1px solid var(--border);">
              <span style="font-size:13px;<%= a.status === 'stale' ? 'opacity:.55;' : '' %>"><%= a.value %><% if (a.status === 'proposed') { %> <span title="awaiting review" style="font-size:10px;opacity:.6;">· proposed</span><% } %><% if (a.status === 'stale') { %> <span title="not confirmed by any source in over a year" style="font-size:10px;opacity:.6;">· stale</span><% } %></span>
              <span style="font-size:11px;white-space:nowrap;display:inline-flex;gap:6px;align-items:baseline;">
                <span style="opacity:.5;" title="confidence <%= a.confidence.toFixed(2) %>"><%= Math.round(a.confidence*100) %>%</span>
                <% a.sources.forEach(function(s){ %><a href="/crm/source/<%= s.kind %>/<%= encodeURIComponent(s.id) %>" style="opacity:.65;" title="open source: <%= s.kind.replace(/_/g,' ') %>"><%= ({document:'doc',email_summary:'email',meeting_intake:'meeting',crm_fact:'fact',completed_task:'task'})[s.kind] || s.kind %></a><% }); %>
                <% if (['stale','disputed'].includes(a.status)) { %><button class="crm-fact-archive atom-action" data-atom="<%= a.id %>" data-action="restore" title="Restore to active">restore</button><% } else { %><button class="crm-fact-archive atom-action" data-atom="<%= a.id %>" data-action="dispute" style="color:var(--crm-danger,#c0392b);opacity:.7;" title="This is wrong — the synthesis loop will re-weigh it">✕</button><% } %>
              </span>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>
    <% } %>

    <section class="section-card">
      <% if (upcomingMeetings.length) { %>
        <h2>Upcoming meetings</h2>
        <% for (const meeting of upcomingMeetings) { %>
          <a class="crm-row-link crm-row-upcoming" href="/crm/meeting/<%= meeting.id %>">
            <strong><%= meeting.title %></strong>
            <span><%= meeting.meeting_date %><%= meeting.meeting_time ? ` · ${meeting.meeting_time}` : '' %></span>
          </a>
        <% } %>
        <% if (pastMeetings.length) { %>
          <h2 style="margin-top:20px;">Past meetings</h2>
        <% } %>
      <% } else { %>
        <h2>Meetings</h2>
      <% } %>
      <% for (const meeting of pastMeetings) { %><a class="crm-row-link" href="/crm/meeting/<%= meeting.id %>"><strong><%= meeting.title %></strong><span><%= meeting.meeting_date %></span></a><% } %>
      <% if (!meetings.length) { %><p class="crm-muted">No meetings yet.</p><% } %>
    </section>
  </div>
  <section class="section-card">
    <h2>Company timeline</h2>
    <div class="crm-timeline">
      <% for (const fact of facts) { %>
        <div class="crm-timeline-item"><time><%= new Date(fact.created_at * 1000).toLocaleDateString('en-GB') %></time><strong><span class="crm-type <%= fact.fact_type || 'fact' %>"><%= fact.fact_type || 'fact' %></span> <%= fact.fact %></strong><span><a href="/crm/contact/<%= fact.contact_id %>"><%= fact.subject_name %></a><% if (fact.meeting_id) { %> · <a href="/crm/meeting/<%= fact.meeting_id %>"><%= fact.meeting_title %></a><% } %></span></div>
      <% } %>
      <% if (!facts.length) { %><p class="crm-muted">No facts across this company yet.</p><% } %>
    </div>
  </section>
</div>

<script>
document.getElementById('company-task-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('company-task-msg');
  const data = Object.fromEntries(new FormData(e.target));
  msg.textContent = 'Adding…';
  try {
    const r = await fetch('/api/tasks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
    const j = await r.json();
    if (j.ok) { msg.textContent = 'Added!'; e.target.reset(); setTimeout(() => location.reload(), 800); }
    else msg.textContent = j.error || 'Error';
  } catch (err) { msg.textContent = err.message; }
});
</script>

<script>
document.querySelectorAll('.crm-suggest-fill').forEach(link => {
  link.addEventListener('click', e => {
    e.preventDefault();
    const field = document.querySelector(`[data-identity="${link.dataset.field}"]`);
    if (field) { field.value = link.dataset.value; field.focus(); }
  });
});
</script>

<script>
document.querySelectorAll('.atom-action').forEach(btn => {
  btn.addEventListener('click', async () => {
    const action = btn.dataset.action;
    let reason = '';
    if (action === 'dispute') reason = prompt('Why is this wrong? (optional — helps the synthesis re-weigh it)') || '';
    btn.disabled = true;
    const r = await fetch(`/api/crm/atoms/${btn.dataset.atom}/${action}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason }),
    });
    const j = await r.json();
    if (j.ok) location.reload();
    else { btn.disabled = false; alert(j.error || 'Error'); }
  });
});
</script>
<%- include('partials/crm-foot') %>
