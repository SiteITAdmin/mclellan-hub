<%- include('partials/crm-head', { title: 'Suggestions', active: 'suggestions' }) %>

<style>
  .suggestion-toolbar { display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
  .suggestion-card { margin-top:14px; border-left:4px solid var(--crm-border,#dfe3e8); }
  .suggestion-card[data-domain="opportunity"] { border-left-color:#7c3aed; }
  .suggestion-card[data-domain="travel"] { border-left-color:#0284c7; }
  .suggestion-card[data-domain="contact"] { border-left-color:#059669; }
  .suggestion-card.is-accepted { background:color-mix(in srgb, var(--crm-success,#16865b) 8%, var(--crm-card,#fff)); border-left-color:var(--crm-success,#16865b); }
  .suggestion-card.is-not-this-time { background:color-mix(in srgb, #d97706 7%, var(--crm-card,#fff)); }
  .suggestion-card.is-dismissed { opacity:.86; }
  .suggestion-card.is-wrong { opacity:.76; }
  .suggestion-card-head { display:flex; justify-content:space-between; gap:18px; align-items:flex-start; }
  .suggestion-title { margin:4px 0 8px; font-size:1.08rem; }
  .suggestion-number { color:var(--crm-muted,#667085); font-variant-numeric:tabular-nums; }
  .suggestion-actions { flex:0 0 auto; display:flex; flex-wrap:wrap; gap:6px; justify-content:flex-end; }
  .suggestion-body { line-height:1.55; white-space:pre-line; }
  .suggestion-feedback { margin-top:12px; padding:12px; border-radius:8px; background:rgba(192,57,43,.08); }
  .suggestion-feedback p { margin:4px 0; }
  .suggestion-evidence { margin-top:12px; }
  .suggestion-evidence summary { cursor:pointer; color:var(--crm-muted,#667085); }
  .suggestion-evidence pre { white-space:pre-wrap; overflow-wrap:anywhere; max-height:420px; overflow:auto; font-size:12px; line-height:1.45; padding:12px; border-radius:8px; background:rgba(127,127,127,.08); }
  @media (max-width:680px) { .suggestion-card-head { flex-direction:column; } }
</style>

<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Action radar &amp; review queue</p>
    <h1>Suggestions you can act on</h1>
    <p>Create task is the strongest positive signal. Not this time says the idea was sound but the timing or scope missed. Dismiss is a weaker signal; Wrong stores your explanation and teaches a hard correction. Nothing becomes knowledge before you create a task.</p>
  </div>
  <div>
    <button type="button" class="btn" id="generate-contact-reasons" onclick="generateContactReasons()">Suggest reasons to contact people</button>
    <p class="crm-muted" style="margin:8px 0 0;max-width:340px;">One candidate per person who has no open contact-linked task.</p>
  </div>
</section>

<section class="section-card">
  <div class="suggestion-toolbar" aria-label="Suggestion filters">
    <% for (const [key, label] of [['all','All'],['open','Open'],['accepted','Task created'],['not_this_time','Not this time'],['dismissed','Dismissed'],['wrong','Wrong'],['expired','Expired']]) { %>
      <% if (key === 'all' || counts[key]) { %>
        <button type="button" class="btn btn-sm <%= key === 'all' ? '' : 'btn-ghost' %> suggestion-filter" data-status="<%= key %>">
          <%= label %> (<%= counts[key] || 0 %>)
        </button>
      <% } %>
    <% } %>
    <select id="suggestion-domain" style="margin-left:auto;font-size:13px;padding:5px 8px;">
      <option value="all">All types</option>
      <option value="opportunity">Opportunities</option>
      <option value="travel">Travel</option>
      <option value="contact">People to contact</option>
    </select>
  </div>
  <p class="crm-muted" id="suggestion-visible-count" style="margin:12px 0 0;"></p>
</section>

<section id="suggestion-list">
  <% if (!suggestions.length) { %>
    <div class="section-card" style="margin-top:14px;"><p class="crm-muted">No action suggestions yet. Generate contact reasons above, or wait for the next opportunity/travel run.</p></div>
  <% } %>
  <% for (const s of suggestions) { %>
    <article class="section-card suggestion-card <%= s.status === 'accepted' ? 'is-accepted' : s.status === 'not_this_time' ? 'is-not-this-time' : s.status === 'dismissed' ? 'is-dismissed' : s.status === 'wrong' ? 'is-wrong' : '' %>"
             data-status="<%= s.status %>" data-domain="<%= s.domain %>">
      <div class="suggestion-card-head">
        <div>
          <div class="crm-task-meta">
            <span class="suggestion-number">Suggestion #<%= s.short_code || '—' %></span>
            <span class="crm-badge"><%= s.domain === 'contact' ? 'person' : s.domain %></span>
            <span class="crm-badge subtle"><%= s.status === 'accepted' ? 'task created' : s.status === 'not_this_time' ? 'not this time' : s.status %></span>
            <% if (s.domain === 'contact' && s.status === 'open') { %><span class="crm-badge subtle">candidate · not knowledge</span><% } %>
            <span class="crm-muted"><%= new Date(s.created_at * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %></span>
          </div>
          <h2 class="suggestion-title"><%= s.title %></h2>
        </div>
        <div class="suggestion-actions">
          <% if (s.status === 'open') { %>
            <button type="button" class="btn btn-sm" onclick="acceptSuggestion('<%= s.id %>')">Create task</button>
            <button type="button" class="btn btn-sm btn-ghost" onclick="notThisTimeSuggestion('<%= s.id %>')">Not this time</button>
            <button type="button" class="btn btn-sm btn-ghost" onclick="dismissSuggestion('<%= s.id %>')">Dismiss</button>
            <% if (s.evidenceParsed) { %><button type="button" class="btn btn-sm btn-ghost" onclick="showSuggestionWhy('<%= s.id %>')">Why?</button><% } %>
            <button type="button" class="btn btn-sm btn-ghost" style="color:var(--crm-danger,#c0392b);" onclick="markSuggestionWrong('<%= s.id %>')">Wrong</button>
          <% } else if (s.status === 'accepted') { %>
            <span class="crm-badge" style="background:#dcfce7;color:#166534;" title="Strongest positive learning signal: 100/100">Task created · strong positive signal</span>
          <% } else if (s.status === 'not_this_time') { %>
            <span class="crm-badge" style="background:#fef3c7;color:#92400e;" title="Positive timing/scope signal: 60/100">Good idea · not this time</span>
          <% } else if (s.status === 'dismissed') { %>
            <span class="crm-badge subtle" title="Weak implicit learning signal: 25/100">Dismissed · signal recorded</span>
          <% } else if (s.status === 'wrong') { %>
            <span class="crm-badge" style="background:#fee2e2;color:#991b1b;">Wrong · learned</span>
          <% } %>
        </div>
      </div>
      <div class="suggestion-body"><%= s.body %></div>

      <% if (s.feedback_reason || s.learned_rule) { %>
        <div class="suggestion-feedback">
          <% if (s.feedback_reason) { %><p><strong>Your explanation:</strong> <%= s.feedback_reason %></p><% } %>
          <% if (s.learned_rule) { %><p><strong>Learned rule:</strong> <%= s.learned_rule %></p><% } %>
        </div>
      <% } %>

      <% if (s.evidenceParsed) { %>
        <details class="suggestion-evidence" id="evidence-<%= s.id %>">
          <summary>Why this was suggested · source evidence</summary>
          <pre><%= typeof s.evidenceParsed === 'string' ? s.evidenceParsed : JSON.stringify(s.evidenceParsed, null, 2) %></pre>
        </details>
      <% } %>
    </article>
  <% } %>
</section>

<script>
let suggestionStatus = 'all';
let suggestionDomain = 'all';

function filterSuggestions() {
  let visible = 0;
  document.querySelectorAll('.suggestion-card').forEach(card => {
    const show = (suggestionStatus === 'all' || card.dataset.status === suggestionStatus)
      && (suggestionDomain === 'all' || card.dataset.domain === suggestionDomain);
    card.hidden = !show;
    if (show) visible++;
  });
  document.getElementById('suggestion-visible-count').textContent = `${visible} suggestion${visible === 1 ? '' : 's'} shown`;
}

document.querySelectorAll('.suggestion-filter').forEach(button => {
  button.addEventListener('click', () => {
    suggestionStatus = button.dataset.status;
    document.querySelectorAll('.suggestion-filter').forEach(item => {
      item.classList.toggle('btn-ghost', item !== button);
    });
    filterSuggestions();
  });
});
document.getElementById('suggestion-domain').addEventListener('change', event => {
  suggestionDomain = event.target.value;
  filterSuggestions();
});
filterSuggestions();

async function postSuggestionAction(id, action) {
  const response = await fetch(`/api/suggestions/${id}/${action}`, { method: 'POST' });
  const result = await response.json();
  if (!response.ok || !result.ok) throw new Error(result.error || result.message || `${action} failed`);
  return result;
}

async function acceptSuggestion(id) {
  try {
    const result = await postSuggestionAction(id, 'accept');
    alert([result.message, result.warning].filter(Boolean).join('\n\n'));
    location.reload();
  } catch (err) {
    alert('Could not accept this suggestion: ' + err.message);
  }
}

async function dismissSuggestion(id) {
  try {
    await postSuggestionAction(id, 'dismiss');
    location.reload();
  } catch (err) {
    alert('Could not dismiss this suggestion: ' + err.message);
  }
}

async function notThisTimeSuggestion(id) {
  try {
    await postSuggestionAction(id, 'not-this-time');
    location.reload();
  } catch (err) {
    alert('Could not close this as Not this time: ' + err.message);
  }
}

function showSuggestionWhy(id) {
  const details = document.getElementById(`evidence-${id}`);
  if (!details) return;
  details.open = true;
  details.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

async function generateContactReasons() {
  const button = document.getElementById('generate-contact-reasons');
  button.disabled = true;
  button.textContent = 'Reviewing people…';
  try {
    const response = await fetch('/api/suggestions/contact-reasons/run', { method: 'POST' });
    const result = await response.json();
    if (!response.ok || !result.ok) throw new Error(result.error || 'Generation failed');
    alert(result.created
      ? `${result.created} contact suggestion${result.created === 1 ? '' : 's'} created.`
      : 'No new contact suggestions were needed. People may already have open tasks or suggestions.');
    location.reload();
  } catch (err) {
    button.disabled = false;
    button.textContent = 'Suggest reasons to contact people';
    alert('Could not generate contact reasons: ' + err.message);
  }
}

async function markSuggestionWrong(id) {
  const reason = prompt('Why is this suggestion wrong? Your explanation will be used to improve future suggestions.');
  if (reason === null) return;
  if (!reason.trim()) {
    alert('Please give a short explanation so the Hub has something reliable to learn from.');
    return;
  }
  if (!confirm('Mark this suggestion Wrong and teach the suggestion system from your explanation?')) return;
  try {
    const response = await fetch(`/api/suggestions/${id}/wrong`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason: reason.trim() }),
    });
    const result = await response.json();
    if (!response.ok || !result.ok) throw new Error(result.error || 'Learning failed');
    const fallback = result.usedFallback ? '\n\nA conservative fallback rule was saved because model analysis was unavailable.' : '';
    alert(`Learned rule:\n${result.lesson}\n\nEvidence count: ${result.evidenceCount}${fallback}`);
    location.reload();
  } catch (err) {
    alert('Could not learn from this suggestion: ' + err.message);
  }
}
</script>

<%- include('partials/crm-foot') %>
