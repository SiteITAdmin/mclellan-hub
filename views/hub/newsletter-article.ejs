<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= article.title %> — McLellan Hub</title>
<link rel="stylesheet" href="/hub.css">
<style>
* { box-sizing: border-box; }
body { background: var(--bg-page, #f4f3fb); font-family: Georgia, 'Times New Roman', serif; margin: 0; }
.reader-wrap { max-width: 680px; margin: 0 auto; padding: 40px 20px 120px; }
.reader-nav { font-family: system-ui, sans-serif; font-size: 13px; color: var(--text-dim, #767586); display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; flex-wrap: wrap; gap: 8px; }
.reader-nav a { color: inherit; text-decoration: none; }
.reader-nav a:hover { color: var(--primary, #7c6af5); }
.article-title { font-size: clamp(22px, 4vw, 30px); font-weight: 700; line-height: 1.25; margin: 0 0 16px; font-family: system-ui, sans-serif; }
.article-meta { font-family: system-ui, sans-serif; font-size: 13px; color: var(--text-dim, #767586); margin-bottom: 36px; display: flex; gap: 16px; flex-wrap: wrap; }
.article-meta a { color: inherit; }
.article-body { font-size: 18px; line-height: 1.75; color: var(--text, #15131e); }
.article-body h1, .article-body h2, .article-body h3 { font-family: system-ui, sans-serif; margin: 2em 0 0.5em; line-height: 1.3; }
.article-body h1 { font-size: 1.5em; }
.article-body h2 { font-size: 1.25em; }
.article-body h3 { font-size: 1.1em; }
.article-body p { margin: 0 0 1.2em; }
.article-body ul, .article-body ol { margin: 0 0 1.2em; padding-left: 1.6em; }
.article-body li { margin-bottom: 0.4em; }
.article-body strong { font-weight: 700; }
.article-body em { font-style: italic; }
.article-body a { color: var(--primary, #7c6af5); }
.article-body blockquote { border-left: 3px solid var(--primary, #7c6af5); margin: 1.5em 0; padding: 0.5em 1.2em; color: var(--text-dim, #767586); font-style: italic; }
.article-body hr { border: none; border-top: 1px solid var(--border, #dddaf0); margin: 2em 0; }
.article-body code { font-family: monospace; background: var(--bg, #faf9fb); border: 1px solid var(--border, #dddaf0); border-radius: 4px; padding: 1px 5px; font-size: 0.85em; }
.pagination { font-family: system-ui, sans-serif; margin-top: 60px; padding-top: 24px; border-top: 1px solid var(--border, #dddaf0); display: flex; justify-content: space-between; gap: 16px; }
.page-link { flex: 1; padding: 14px 16px; border: 1px solid var(--border, #dddaf0); border-radius: 10px; text-decoration: none; color: inherit; }
.page-link.next { text-align: right; }
.page-link-label { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-dim); display: block; margin-bottom: 4px; }
.page-link-title { font-size: 13px; font-weight: 600; line-height: 1.35; }
.page-link:hover { border-color: var(--primary, #7c6af5); }
@media (max-width: 600px) { .reader-wrap { padding: 24px 16px 80px; } .article-body { font-size: 17px; } }
</style>
</head>
<body>
<div class="reader-wrap">
  <nav class="reader-nav">
    <a href="/newsletter/creator/<%= feed.creator_slug %>">← <%= feed.name %></a>
    <span><a href="/newsletter/creator/<%= feed.creator_slug %>/read">Reading list</a> · <%= article.word_count %> words</span>
    <a href="<%= article.url %>" target="_blank" rel="noopener">View on Substack ↗</a>
  </nav>

  <h1 class="article-title"><%= article.title %></h1>
  <div class="article-meta">
    <span><%= new Date(article.published_at * 1000).toLocaleDateString('en-GB', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %></span>
  </div>

  <div class="article-body"><%- markdownToHtml(article.content_markdown) %></div>

  <div class="pagination">
    <% if (prev) { %>
      <a class="page-link prev" href="/newsletter/creator/<%= feed.creator_slug %>/article/<%= prev.id %>">
        <span class="page-link-label">← Older</span>
        <span class="page-link-title"><%= prev.title %></span>
      </a>
    <% } else { %><div></div><% } %>
    <% if (next) { %>
      <a class="page-link next" href="/newsletter/creator/<%= feed.creator_slug %>/article/<%= next.id %>">
        <span class="page-link-label">Newer →</span>
        <span class="page-link-title"><%= next.title %></span>
      </a>
    <% } else { %><div></div><% } %>
  </div>
</div>
</body>
</html>
