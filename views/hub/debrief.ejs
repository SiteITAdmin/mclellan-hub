<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Daily Debrief — McLellan Hub</title>
<link rel="stylesheet" href="/hub.css">
<style>
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; margin: 0; }
body.hub-page { height: 100vh !important; overflow: hidden !important; display: flex; flex-direction: column; background: var(--bg-page, #f4f3fb); }

.shell {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 32px 24px 48px; text-align: center;
  max-width: 480px; margin: 0 auto; width: 100%;
}

/* Idle */
.date-line { font-size: 13px; color: var(--text-dim); margin-bottom: 8px; }
.title-line { font-size: 28px; font-weight: 700; margin: 0 0 6px; }
.desc-line { font-size: 14px; color: var(--text-dim); margin: 0 0 36px; line-height: 1.5; }

.start-btn {
  padding: 20px 56px; background: var(--accent, #8083ff); color: #fff;
  border: none; border-radius: 60px; font-size: 18px; font-weight: 700; cursor: pointer;
  box-shadow: 0 6px 24px rgba(128,131,255,.35); transition: transform .15s, box-shadow .15s;
  -webkit-appearance: none;
}
.start-btn:active { transform: scale(.97); }

.back-link { margin-top: 24px; font-size: 13px; color: var(--text-dim); text-decoration: none; display: block; }
.back-link:hover { color: var(--accent, #8083ff); }

/* Interview */
.question-text {
  font-size: 22px; font-weight: 600; line-height: 1.45; color: var(--text);
  margin: 0 0 32px; min-height: 64px;
}
@media (max-width: 380px) { .question-text { font-size: 18px; } }

.pulse-wrap { margin: 0 auto 20px; position: relative; width: 88px; height: 88px; }
.pulse-bg {
  position: absolute; inset: 0; border-radius: 50%;
  background: rgba(128,131,255,.12);
  transition: background .4s;
}
.pulse-bg.listening { animation: pulse-listen 1.5s ease-in-out infinite; }
.pulse-bg.speaking { background: rgba(46,125,96,.12); }
@keyframes pulse-listen {
  0%,100% { box-shadow: 0 0 0 0 rgba(128,131,255,.35); }
  50% { box-shadow: 0 0 0 20px rgba(128,131,255,0); }
}
.pulse-icon { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 30px; }

.status-line { font-size: 14px; color: var(--text-dim); margin: 0 0 6px; min-height: 20px; }
.interim-line {
  font-size: 13px; color: var(--text-muted, #888); font-style: italic;
  min-height: 18px; max-width: 340px; margin: 0 auto 28px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.finish-btn {
  padding: 11px 28px; background: transparent; border: 1px solid var(--border);
  border-radius: 40px; font-size: 14px; color: var(--text-dim); cursor: pointer;
  -webkit-appearance: none;
}
.finish-btn:active { border-color: #c4342b; color: #c4342b; }

/* Saving / Done */
.big-icon { font-size: 40px; margin-bottom: 12px; }
.save-label { font-size: 18px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
.save-sub { font-size: 13px; color: var(--text-dim); font-family: var(--mono); word-break: break-all; }
.hub-link { margin-top: 28px; font-size: 14px; color: var(--accent, #8083ff); text-decoration: none; display: block; }
</style>
</head>
<body class="hub-page">
<%- include('partials/top-nav') %>
<main style="flex:1;display:flex;flex-direction:column;">
<div class="shell">

  <!-- ── Idle ──────────────────────────────────────────────────────────────── -->
  <div id="s-idle">
    <p class="date-line"><%= today %></p>
    <h1 class="title-line">Daily Debrief</h1>
    <p class="desc-line">Interview with manual answer recording.<br>Tap start, record each answer, then save.</p>
    <button class="start-btn" onclick="startInterview()">Start interview</button>
    <a href="/" class="back-link">← Back to hub</a>
  </div>

  <!-- ── Interview ─────────────────────────────────────────────────────────── -->
  <div id="s-interview" style="display:none;width:100%">
    <p class="question-text" id="question-text"></p>
    <div class="pulse-wrap">
      <div class="pulse-bg" id="pulse-bg"></div>
      <div class="pulse-icon" id="pulse-icon">⏳</div>
    </div>
    <p class="status-line" id="status-line">Starting…</p>
    <p class="interim-line" id="interim-line"></p>
    <div class="record-controls" id="record-controls" style="display:none">
      <button class="finish-btn record-btn" id="record-btn" onclick="startManualRecording()">Record answer</button>
      <button class="finish-btn send-btn" id="send-btn" onclick="stopAndSendManual()" style="display:none">Send answer</button>
    </div>
    <button class="finish-btn" onclick="finishInterview()">Finish &amp; save</button>
  </div>

  <!-- ── Saving ─────────────────────────────────────────────────────────────── -->
  <div id="s-saving" style="display:none">
    <div class="big-icon">💾</div>
    <p class="save-label">Saving your notes…</p>
  </div>

  <!-- ── Done ──────────────────────────────────────────────────────────────── -->
  <div id="s-done" style="display:none">
    <div class="big-icon">✓</div>
    <p class="save-label">Debrief saved</p>
    <p class="save-sub" id="done-path"></p>
    <a href="/" class="hub-link">← Back to hub</a>
  </div>

</div>
</main>

<script>
// ── State ─────────────────────────────────────────────────────────────────────
let sessionId       = null;
let messages        = [];   // [{role, content}] LLM history
let transcriptLines = [];   // displayed Q&A for saving
let interviewActive = false;

let micStream   = null;
let audioCtx    = null;
let recorder    = null;
let chunks      = [];
let listenPoll  = null;
let recordingManually = false;
const player    = new Audio();

function show(id) {
  ['s-idle','s-interview','s-saving','s-done'].forEach(s =>
    document.getElementById(s).style.display = s === id ? '' : 'none'
  );
}

// ── Screen wake ───────────────────────────────────────────────────────────────
let wakeLock = null;

async function keepAwake() {
  try {
    wakeLock = await navigator.wakeLock.request('screen');
  } catch (_) {}
}

function releaseWake() {
  try { wakeLock?.release(); } catch (_) {}
  wakeLock = null;
}

// Wake locks are dropped when the tab is hidden — reacquire on return.
document.addEventListener('visibilitychange', () => {
  if (interviewActive && document.visibilityState === 'visible') keepAwake();
});

// ── Playback (server TTS — base64 WAV) ───────────────────────────────────────
// iOS Safari won't play <audio> while the mic is capturing, and mutes/blocks a
// large data: URI. So: the mic is closed before we get here, and we play from a
// Blob URL. onDone is guarded to fire exactly once — firing it twice (onerror +
// play() rejection) was spinning up overlapping recorders (the "flicker").
function playReply(audioB64, text, onDone) {
  let fired = false, url = null, safety = null;
  const finish = () => {
    if (fired) return; fired = true;
    clearTimeout(safety);
    player.onended = null; player.onerror = null;
    if (url) { try { URL.revokeObjectURL(url); } catch (_) {} }
    onDone();
  };
  const readDelay = Math.min(9000, 600 + text.length * 60);
  if (!audioB64) { safety = setTimeout(finish, readDelay); return; }
  try {
    const bytes = Uint8Array.from(atob(audioB64), c => c.charCodeAt(0));
    url = URL.createObjectURL(new Blob([bytes], { type: 'audio/wav' }));
  } catch (_) { safety = setTimeout(finish, readDelay); return; }

  player.src = url;
  player.onended = finish;
  player.onerror = () => { safety = setTimeout(finish, readDelay); };
  // Hard stop if playback stalls without ever ending.
  safety = setTimeout(finish, 30000);
  player.play().catch(() => { clearTimeout(safety); safety = setTimeout(finish, readDelay); });
}

// ── Listening (MediaRecorder + silence detection) ─────────────────────────────
// No timeout before speech starts — thinking pauses of any length are fine.
// Once speech has been heard, 3.5s of silence ends the turn. 3 min hard cap.
const SILENCE_MS   = 3500;
const RMS_THRESHOLD = 0.012;
const MAX_TURN_MS  = 180000;

function pickMime() {
  return ['audio/mp4', 'audio/webm', ''].find(t => t === '' || MediaRecorder.isTypeSupported(t));
}

async function openMic() {
  if (micStream) return true;
  try {
    micStream = await navigator.mediaDevices.getUserMedia({
      audio: {
        echoCancellation: true,
        noiseSuppression: true,
        autoGainControl: true,
      }
    });
    return true;
  }
  catch (_) { setStatus('Microphone access denied — allow mic in Settings and try again.'); return false; }
}

function closeMic() {
  if (micStream) { micStream.getTracks().forEach(t => t.stop()); micStream = null; }
}

async function startListening() {
  if (!interviewActive) return;
  closeMic();
  setPulse('listening');
  setStatus('Tap Record answer, speak, then Send answer.');
  setRecordControls('ready');
}

async function startManualRecording() {
  if (!interviewActive || recordingManually) return;
  if (!(await openMic()) || !interviewActive) return;
  try { await audioCtx?.resume(); } catch (_) {}
  chunks = [];
  const mime = pickMime();
  recorder = new MediaRecorder(micStream, mime ? { mimeType: mime } : undefined);
  recorder.ondataavailable = e => { if (e.data.size) chunks.push(e.data); };
  recorder.start(1000);
  recordingManually = true;
  setPulse('listening');
  setStatus('Recording… tap Send answer when you finish speaking.');
  setRecordControls('recording');
}

function stopListening() {
  clearInterval(listenPoll);
  listenPoll = null;
  if (recorder && recorder.state !== 'inactive') {
    return new Promise(resolve => {
      recorder.onstop = () => resolve();
      try { recorder.stop(); } catch (_) { resolve(); }
    });
  }
  return Promise.resolve();
}

async function stopAndSendManual() {
  if (!recordingManually) return;
  await stopListening();
  recordingManually = false;
  await sendCapturedTurn();
}

// ── Interview flow ────────────────────────────────────────────────────────────
async function startInterview() {
  // AudioContext + <audio> unlock must happen inside the tap on iOS.
  // The mic opens only when Record answer is tapped, after the question plays.
  audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  audioCtx.resume().catch(() => {});
  player.muted = true;
  player.play().catch(() => {});
  player.muted = false;

  show('s-interview');
  setPulse('thinking');
  setStatus('Reading your day…');
  setQuestion('Getting your first question…');
  keepAwake();
  interviewActive = true;

  try {
    const r = await fetch('/api/debrief/start', { method: 'POST' });
    const d = await r.json();
    if (!r.ok) throw new Error(d.error || 'Failed');
    sessionId = d.sessionId;
    handleReply(d);
  } catch (err) {
    setStatus('Error: ' + err.message + ' — tap Finish to close.');
  }
}

async function endTurn(hadSpeech) {
  if (!interviewActive) return;
  await stopListening();
  if (!hadSpeech) { if (interviewActive) startListening(); return; }
  await sendCapturedTurn();
}

async function sendCapturedTurn() {
  if (!interviewActive) return;
  closeMic();
  setRecordControls('hidden');
  setPulse('thinking');
  setStatus('Got it — thinking…');
  setInterim('');

  const mime = recorder?.mimeType || pickMime() || 'audio/mp4';
  const blob = new Blob(chunks, { type: mime });
  const ext  = mime.includes('webm') ? 'webm' : 'm4a';

  const form = new FormData();
  form.append('sessionId', sessionId || '');
  form.append('history', JSON.stringify(messages));
  form.append('audio', blob, `turn.${ext}`);

  try {
    const r = await fetch('/api/debrief/turn', { method: 'POST', body: form });
    const d = await r.json();
    if (!r.ok) throw new Error(d.error || 'Failed');

    if (d.transcript) {
      messages.push({ role: 'user', content: d.transcript });
      transcriptLines.push(`**You:** ${d.transcript}`);
      setInterim(d.transcript);
    } else if (d.recording?.audioBytes) {
      setInterim(`Recorded ${Math.round(d.recording.audioBytes / 1024)} KB; no transcript.`);
    }
    handleReply(d);
  } catch (err) {
    setStatus('Error: ' + err.message + ' — tap Finish to save what we have.');
  }
}

function handleReply(d) {
  messages.push({ role: 'assistant', content: d.reply });
  transcriptLines.push(`**Interviewer:** ${d.reply}`);

  const sentences = d.reply.match(/[^.!?]+[.!?]*/g) || [d.reply];
  const qSentence = [...sentences].reverse().find(s => s.includes('?')) || d.reply;
  setQuestion(qSentence.trim());

  setPulse('speaking');
  setStatus('');
  if (d.done) {
    interviewActive = false;
    playReply(d.audio, d.reply, () => setTimeout(finishInterview, 600));
  } else {
    playReply(d.audio, d.reply, () => { if (interviewActive) startListening(); });
  }
}

async function finishInterview() {
  interviewActive = false;
  await stopListening();
  recordingManually = false;
  try { player.pause(); } catch (_) {}
  micStream?.getTracks().forEach(t => t.stop());
  setRecordControls('hidden');
  show('s-saving');

  const transcript = transcriptLines.join('\n\n');
  try {
    const r = await fetch('/api/debrief/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ transcript, sessionId }),
    });
    const d = await r.json();
    releaseWake();
    document.getElementById('done-path').textContent = d.notePath || '';
    show('s-done');
  } catch (err) {
    releaseWake();
    document.getElementById('done-path').textContent = 'Save failed: ' + err.message;
    show('s-done');
  }
}

// ── UI helpers ────────────────────────────────────────────────────────────────
function setQuestion(t) { document.getElementById('question-text').textContent = t; }
function setStatus(t)   { document.getElementById('status-line').textContent = t; }
function setInterim(t)  { document.getElementById('interim-line').textContent = t; }
function setPulse(state) {
  const bg   = document.getElementById('pulse-bg');
  const icon = document.getElementById('pulse-icon');
  bg.className = 'pulse-bg' + (state === 'listening' ? ' listening' : state === 'speaking' ? ' speaking' : '');
  icon.textContent = state === 'listening' ? '🎤' : state === 'speaking' ? '🔊' : '⏳';
  if (state === 'listening') setStatus('Listening…');
}
function setRecordControls(state) {
  const wrap = document.getElementById('record-controls');
  const record = document.getElementById('record-btn');
  const send = document.getElementById('send-btn');
  if (!wrap) return;
  wrap.style.display = state === 'hidden' ? 'none' : '';
  record.style.display = state === 'ready' ? '' : 'none';
  send.style.display = state === 'recording' ? '' : 'none';
}
</script>
</body>
</html>
