<%- include('partials/crm-head', { title: task.title, active: 'tasks' }) %>

<a class="crm-back" href="/crm/tasks">Tasks</a>

<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">
      <% if (task.contact_name) { %><a href="/crm/contact/<%= task.contact_id %>"><%= task.contact_name %></a><% } %>
      <% if (task.contact_name && task.company_name) { %> · <% } %>
      <% if (task.company_name) { %><a href="/crm/company/<%= task.company_id %>"><%= task.company_name %></a><% } %>
      <% if (!task.contact_name && !task.company_name) { %>Task<% } %>
    </p>
    <h1><%= task.title %></h1>
    <% if (task.status === 'completed') { %><span class="crm-badge" style="background:#d1fae5;color:#065f46;">Completed</span><% } %>
    <% if (task.status === 'wrong') { %><span class="crm-badge" style="background:#fee2e2;color:#991b1b;">Wrong · learned</span><% } %>
    <% if (task.deleted_at) { %><span class="crm-badge" style="background:#fee2e2;color:#991b1b;">Deleted</span><% } %>
  </div>
  <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <% if (!task.deleted_at && task.status === 'needsAction') { %>
      <% if (taskTags.assignee) { %>
        <span class="crm-badge" style="background:rgba(37,99,235,.12);color:#1d4ed8;font-weight:600;" title="Assigned to someone else — not in your planner">→ Assigned to <%= taskTags.assignee %></span>
      <% } else { %>
      <div class="task-planner-control task-planner-control-detail" data-task-planner-control data-task-id="<%= task.id %>" data-saved-lane="<%= taskTags.planner_lane || 'work' %>">
        <label title="Include this task in calendar planning">
          <input type="checkbox" <%= taskTags.planner_lane ? 'checked' : '' %> onchange="taskPlannerToggle(this)">
          <span>Planner</span>
        </label>
        <select aria-label="Planner time" onchange="taskPlannerLane(this)">
          <option value="work" <%= taskTags.planner_lane !== 'personal' ? 'selected' : '' %>>Work</option>
          <option value="personal" <%= taskTags.planner_lane === 'personal' ? 'selected' : '' %>>Personal</option>
        </select>
        <span class="task-planner-state" aria-live="polite"></span>
      </div>
      <% } %>
      <button class="btn" onclick="taskAction('<%= task.id %>', 'complete')">Mark done</button>
      <button class="btn" onclick="doneWithFollowup()" title="Mark this done and capture the tasks that came out of it">Done + add follow-up</button>
      <button class="btn" style="opacity:.6;" onclick="remindMe()" title="Set an escalating reminder for this task">🔔 Remind me</button>
      <% if (['document','email','agentmail'].includes(task.source)) { %>
        <button class="btn" style="color:var(--crm-danger,#c0392b);background:transparent;border:1px solid currentColor;" onclick="markTaskWrong('<%= task.id %>')">Wrong — teach extractor</button>
      <% } %>
      <button class="btn" style="opacity:.6;" onclick="taskAction('<%= task.id %>', 'delete')">Delete</button>
    <% } else if (task.deleted_at && task.status !== 'wrong') { %>
      <button class="btn" onclick="taskAction('<%= task.id %>', 'restore')">Restore</button>
    <% } %>
  </div>
</section>

<div class="crm-two-col">

  <!-- ── Edit form ──────────────────────────────────────────────────────── -->
  <div class="crm-stack">
    <section class="section-card">
      <h2>Task details</h2>
      <form class="crm-form-grid" id="task-edit-form">
        <label class="wide">Title
          <input name="title" value="<%= task.title %>" required>
        </label>
        <label class="wide">Notes <span style="font-size:11px;opacity:.6;">priority, effort, and planner tags are managed by the controls</span>
          <textarea name="notes" rows="5" placeholder="Context, links, background…"><%= (() => { const s = String(task.notes || '').replace(/\[\s*(priority|effort|planner|after|assignee)\s*:\s*[^\]]+\]/gi, '').replace(/\n{3,}/g, '\n\n'); return s.trim(); })() %></textarea>
        </label>
        <label>Priority
          <select name="priority">
            <option value="">— none —</option>
            <% for (const p of ['low','medium','high']) { %>
              <option value="<%= p %>" <%= taskTags.priority === p ? 'selected' : '' %>><%= p %></option>
            <% } %>
          </select>
        </label>
        <label>Effort
          <select name="effort_minutes">
            <option value="">— not sized —</option>
            <% for (const [v, l] of [[5,'5 min'],[15,'15 min'],[30,'30 min'],[60,'1 hour'],[120,'2 hours']]) { %>
              <option value="<%= v %>" <%= taskTags.effort_minutes === v ? 'selected' : '' %>><%= l %></option>
            <% } %>
            <% if (taskTags.effort_minutes && ![5,15,30,60,120].includes(taskTags.effort_minutes)) { %>
              <option value="<%= taskTags.effort_minutes %>" selected><%= taskTags.effort_minutes %> min</option>
            <% } %>
          </select>
        </label>
        <label class="wide">Only after <span style="font-size:11px;opacity:.6;">(planner won't schedule or pull this task before the linked meeting finishes)</span>
          <select name="after">
            <option value="">— no dependency —</option>
            <% for (const m of (upcomingMeetings || [])) { %>
              <option value="<%= m.value %>" <%= taskTags.after === m.value ? 'selected' : '' %>><%= new Date(m.date + 'T12:00:00Z').toLocaleDateString('en-IE', { weekday:'short', day:'numeric', month:'short', timeZone:'UTC' }) %> <%= m.time %><%= m.endTime ? '–' + m.endTime : '' %> · <%= m.title %></option>
            <% } %>
            <% if (taskTags.after && !(upcomingMeetings || []).some(m => m.value === taskTags.after)) { %>
              <option value="<%= taskTags.after %>" selected>Current dependency (<%= taskTags.after.startsWith('cal:') ? 'linked meeting' : taskTags.after %>)</option>
            <% } %>
          </select>
        </label>
        <label>Due date <span style="font-size:11px;opacity:.6;">(syncs to Google)</span>
          <input name="due" type="date" value="<%= task.due || '' %>">
        </label>
        <label>Reminder time <span style="font-size:11px;opacity:.6;">(Dublin, local to the Hub — not synced; use Remind me for alerts)</span>
          <input name="deadline" type="datetime-local"
            value="<%= task.deadline ? task.deadline.slice(0,16) : (task.due ? task.due + 'T09:00' : '') %>">
        </label>
        <label>Person
          <select name="contact_id">
            <option value="">— none —</option>
            <% for (const c of contacts) { %>
              <option value="<%= c.id %>" <%= task.contact_id === c.id ? 'selected' : '' %>><%= c.name %></option>
            <% } %>
          </select>
        </label>
        <label>Company
          <select name="company_id">
            <option value="">— none —</option>
            <% for (const co of companies) { %>
              <option value="<%= co.id %>" <%= task.company_id === co.id ? 'selected' : '' %>><%= co.name %></option>
            <% } %>
          </select>
        </label>
        <label>Project
          <select name="project_slug">
            <option value="">— none —</option>
            <% for (const p of projects) { %>
              <option value="<%= p.slug %>" <%= task.project_slug === p.slug ? 'selected' : '' %>><%= p.name %></option>
            <% } %>
          </select>
        </label>
        <label class="wide">Assign to someone else <span style="font-size:11px;opacity:.6;">(takes it out of your planner and into "assigned to others"; leave blank to keep it yours)</span>
          <input name="assignee" list="assignee-options" value="<%= taskTags.assignee || '' %>" placeholder="Name of whoever is doing it" autocomplete="off">
          <datalist id="assignee-options">
            <% for (const c of contacts) { %><option value="<%= c.name %>"></option><% } %>
          </datalist>
        </label>
        <div style="display:flex;gap:8px;align-items:center;">
          <button class="btn" type="submit">Save changes</button>
          <span class="crm-muted" id="edit-msg" style="font-size:12px;"></span>
        </div>
      </form>
    </section>

    <section class="section-card">
      <h2>Task context</h2>
      <% if (originMeeting) { %>
        <div class="crm-action">
          <span style="font-size:13px;">Spawned by meeting: <a href="/crm/meeting/<%= originMeeting.id %>"><strong><%= originMeeting.title %></strong></a> <span class="crm-muted">(<%= originMeeting.meeting_date %>)</span></span>
        </div>
      <% } %>
      <% if (typeof parentTask !== 'undefined' && parentTask) { %>
        <div class="crm-action">
          <span style="font-size:13px;">Follows on from: <a href="/crm/tasks/<%= parentTask.id %>"><strong><%= parentTask.title %></strong></a><% if (parentTask.status === 'completed') { %> <span class="crm-muted">(done)</span><% } %></span>
        </div>
      <% } %>
      <% if (typeof followupTasks !== 'undefined' && followupTasks.length) { %>
        <p style="font-size:13px;font-weight:600;margin:10px 0 4px;">Follow-ups from this task</p>
        <% for (const f of followupTasks) { %>
          <div class="crm-action">
            <span style="font-size:13px;">→ <a href="/crm/tasks/<%= f.id %>"><%= f.title %></a><% if (f.status === 'completed') { %> <span class="crm-muted">(done)</span><% } %></span>
          </div>
        <% } %>
      <% } %>
      <% if (task.project_slug) { %>
        <div class="crm-action"><span style="font-size:13px;">Project: <a href="/crm/project/<%= task.project_slug %>"><%= task.project_slug %></a></span></div>
      <% } %>
      <% if (relatedReminders.length) { %>
        <p style="font-size:13px;font-weight:600;margin:10px 0 4px;">Reminders chasing this task</p>
        <% for (const r of relatedReminders) { %>
          <div class="crm-action">
            <span style="font-size:13px;">#<%= r.short_code %> · <%= r.status %><% if (r.next_fire_at && !['done','cancelled'].includes(r.status)) { %> · next <%= new Date(r.next_fire_at * 1000).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit', timeZone:'Europe/Dublin' }) %><% } %><% if (r.escalation_level > 0) { %> · pinged <%= r.escalation_level %>×<% } %></span>
          </div>
        <% } %>
      <% } %>
      <% if (!originMeeting && !task.project_slug && !relatedReminders.length && !(typeof parentTask !== 'undefined' && parentTask) && !(typeof followupTasks !== 'undefined' && followupTasks.length)) { %>
        <p class="crm-muted">No origin meeting, project, or reminders linked yet.</p>
      <% } %>
    </section>

    <section class="section-card">
      <h2>Source &amp; sync</h2>
      <dl class="crm-dl">
        <dt>Source</dt><dd><%= task.source %><% if (task.source_id) { %> <span class="crm-muted">(<%= task.source_id.slice(0, 20) %>…)</span><% } %></dd>
        <dt>Google Task ID</dt><dd style="font-size:11px;word-break:break-all;"><%= task.google_task_id %></dd>
        <dt>Created</dt><dd><%= new Date(task.created_at * 1000).toLocaleString('en-GB') %></dd>
        <% if (task.completed_at) { %><dt>Completed</dt><dd><%= new Date(task.completed_at * 1000).toLocaleString('en-GB') %></dd><% } %>
        <dt>Last synced</dt><dd><%= new Date(task.synced_at * 1000).toLocaleString('en-GB') %></dd>
      </dl>
    </section>
  </div>

  <!-- ── Subtasks ───────────────────────────────────────────────────────── -->
  <section class="section-card">
    <h2>Subtasks
      <% const openSubs = task.subtasks.filter(s => s.status === 'needsAction' && !s.deleted_at); %>
      <% const doneSubs = task.subtasks.filter(s => s.status === 'completed' || s.deleted_at); %>
      <% if (task.subtasks.length) { %>
        <span class="crm-count"><%= openSubs.length %> open</span>
      <% } %>
    </h2>

    <% if (!task.subtasks.length) { %>
      <p class="crm-muted">No subtasks yet.</p>
    <% } %>

    <% for (const s of openSubs) { %>
      <div class="crm-subtask-row" id="sub-<%= s.id %>">
        <label class="crm-subtask-check">
          <input type="checkbox" onchange="completeSub('<%= s.id %>', '<%= s.google_task_id %>')">
          <span class="crm-subtask-title"><%= s.title %></span>
        </label>
        <button class="crm-subtask-del" onclick="deleteSub('<%= s.id %>')" title="Delete subtask">×</button>
      </div>
    <% } %>

    <% if (doneSubs.length) { %>
      <details style="margin-top:12px;">
        <summary style="font-size:12px;color:var(--crm-muted);cursor:pointer;user-select:none;">
          <%= doneSubs.length %> completed / deleted
        </summary>
        <% for (const s of doneSubs) { %>
          <div class="crm-subtask-row task-done" style="margin-top:8px;">
            <span class="crm-subtask-title" style="text-decoration:line-through;opacity:.5;"><%= s.title %></span>
            <% if (s.deleted_at) { %>
              <button class="crm-subtask-del" onclick="restoreSub('<%= s.id %>')" title="Restore">↩</button>
            <% } %>
          </div>
        <% } %>
      </details>
    <% } %>

    <!-- Add subtask inline -->
    <form class="crm-inline-form" id="subtask-form" style="margin-top:16px;">
      <input name="title" placeholder="Add a subtask…" required style="flex:1;">
      <button class="btn btn-sm" type="submit">Add</button>
    </form>
    <p class="crm-muted" id="subtask-msg" style="font-size:12px;margin-top:4px;"></p>
  </section>

</div>

<script>
const TASK_ID = '<%= task.id %>';

// Save edits
document.getElementById('task-edit-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('edit-msg');
  const btn = e.target.querySelector('button[type=submit]');
  const data = Object.fromEntries(new FormData(e.target));
  btn.disabled = true;
  msg.textContent = 'Saving…';
  try {
    const r = await fetch(`/api/tasks/${TASK_ID}/update`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const j = await r.json();
    if (j.ok) {
      msg.textContent = 'Saved.';
      setTimeout(() => { msg.textContent = ''; }, 2500);
    } else {
      msg.textContent = j.error || 'Error saving.';
    }
  } catch (err) {
    msg.textContent = err.message;
  } finally {
    btn.disabled = false;
  }
});

// Top-level task actions (complete / delete / restore)
function remindMe() {
  document.getElementById('remind-pop')?.remove();
  const pop = document.createElement('div');
  pop.id = 'remind-pop';
  pop.style.cssText = 'position:fixed;z-index:60;top:30%;left:50%;transform:translateX(-50%);background:var(--bg-card,#fff);border:1px solid var(--border,#ccc);border-radius:10px;padding:16px;box-shadow:0 8px 30px rgba(0,0,0,.18);display:grid;gap:10px;min-width:300px;';
  const tomorrow = '<%= new Date(Date.now() + 86400000).toLocaleDateString("sv-SE", { timeZone: "Europe/Dublin" }) %>T09:00';
  pop.innerHTML = `
    <strong style="font-size:14px;">Remind me about this task</strong>
    <label style="font-size:12px;display:grid;gap:4px;">When
      <input id="remind-when" type="datetime-local" value="${tomorrow}" style="font-size:13px;padding:4px 8px;">
    </label>
    <span style="font-size:11px;opacity:.6;">Unanswered reminders escalate after 30 min, 3 h, then 24 h. Marking the reminder done also completes this task.</span>
    <div style="display:flex;gap:8px;">
      <button class="btn btn-sm" id="remind-save">Set reminder</button>
      <button class="btn btn-sm btn-ghost" id="remind-cancel">Cancel</button>
      <span id="remind-msg" style="font-size:12px;opacity:.7;"></span>
    </div>`;
  document.body.appendChild(pop);
  pop.querySelector('#remind-cancel').onclick = () => pop.remove();
  pop.querySelector('#remind-save').onclick = async () => {
    const when = pop.querySelector('#remind-when').value;
    if (!when) return;
    const msg = pop.querySelector('#remind-msg');
    msg.textContent = 'Setting…';
    const r = await fetch('/api/reminders', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kind: 'task', target_id: '<%= task.id %>', title: <%- JSON.stringify(task.title) %>, remind_at: when }),
    });
    const j = await r.json();
    if (j.ok) { msg.textContent = `#${j.reminder.short_code} set.`; setTimeout(() => location.reload(), 700); }
    else msg.textContent = j.error || 'Error';
  };
}

// Mark done + capture the follow-up tasks that came out of this one. Several at
// once — one per line. Each becomes a task linked back to this (now completed) one.
function doneWithFollowup() {
  document.getElementById('followup-pop')?.remove();
  const pop = document.createElement('div');
  pop.id = 'followup-pop';
  pop.style.cssText = 'position:fixed;z-index:60;top:22%;left:50%;transform:translateX(-50%);background:var(--bg-card,#fff);border:1px solid var(--border,#ccc);border-radius:10px;padding:16px;box-shadow:0 8px 30px rgba(0,0,0,.18);display:grid;gap:10px;min-width:340px;max-width:90vw;';
  pop.innerHTML = `
    <strong style="font-size:14px;">Mark done &amp; add follow-ups</strong>
    <label style="font-size:12px;display:grid;gap:4px;">Follow-up tasks <span style="opacity:.6;">(one per line)</span>
      <textarea id="followup-titles" rows="4" placeholder="e.g. Send Ken the OU list\nSet up the new user accounts" style="font-size:13px;padding:6px 8px;"></textarea>
    </label>
    <label style="font-size:12px;display:grid;gap:4px;">Due date <span style="opacity:.6;">(optional, applies to all)</span>
      <input id="followup-due" type="date" style="font-size:13px;padding:4px 8px;">
    </label>
    <span style="font-size:11px;opacity:.6;">This task is completed and each follow-up is linked back to it. Follow-ups start unscheduled — add them to the planner later.</span>
    <div style="display:flex;gap:8px;align-items:center;">
      <button class="btn btn-sm" id="followup-save">Done + create</button>
      <button class="btn btn-sm btn-ghost" id="followup-cancel">Cancel</button>
      <span id="followup-msg" style="font-size:12px;opacity:.7;"></span>
    </div>`;
  document.body.appendChild(pop);
  const ta = pop.querySelector('#followup-titles');
  ta.focus();
  pop.querySelector('#followup-cancel').onclick = () => pop.remove();
  pop.querySelector('#followup-save').onclick = async () => {
    const followups = ta.value.split('\n').map(s => s.trim()).filter(Boolean);
    const msg = pop.querySelector('#followup-msg');
    if (!followups.length) { msg.textContent = 'Add at least one follow-up.'; return; }
    msg.textContent = 'Saving…';
    try {
      const r = await fetch(`/api/tasks/<%= task.id %>/complete-followup`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ followups, due: pop.querySelector('#followup-due').value || null }),
      });
      const j = await r.json();
      if (j.ok) window.location.href = '/crm/tasks';
      else msg.textContent = j.error || 'Error';
    } catch (err) { msg.textContent = err.message; }
  };
}

async function taskAction(id, action) {
  const r = await fetch(`/api/tasks/${id}/${action}`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) window.location.href = '/crm/tasks';
  else alert('Error: ' + (j.error || action));
}

// Add subtask
document.getElementById('subtask-form').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = document.getElementById('subtask-msg');
  const input = e.target.querySelector('input[name=title]');
  const title = input.value.trim();
  if (!title) return;
  msg.textContent = 'Adding…';
  try {
    const r = await fetch(`/api/tasks/${TASK_ID}/subtasks`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title }),
    });
    const j = await r.json();
    if (j.ok) { input.value = ''; msg.textContent = ''; location.reload(); }
    else msg.textContent = j.error || 'Error';
  } catch (err) { msg.textContent = err.message; }
});

// Complete a subtask by checking the checkbox
async function completeSub(localId, googleTaskId) {
  const row = document.getElementById('sub-' + localId);
  if (row) row.style.opacity = '.4';
  try {
    const r = await fetch(`/api/tasks/${localId}/complete`, { method: 'POST' });
    const j = await r.json();
    if (j.ok) setTimeout(() => location.reload(), 400);
    else { if (row) row.style.opacity = ''; alert('Error: ' + j.error); }
  } catch (err) { if (row) row.style.opacity = ''; alert(err.message); }
}

async function deleteSub(localId) {
  const r = await fetch(`/api/tasks/${localId}/delete`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}

async function restoreSub(localId) {
  const r = await fetch(`/api/tasks/${localId}/restore`, { method: 'POST' });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert('Error: ' + j.error);
}
</script>

<%- include('partials/crm-foot') %>
