<%- include('partials/crm-head', { title: 'Projects', active: 'projects' }) %>
<section class="crm-hero">
  <div>
    <p class="crm-eyebrow">Work in progress</p>
    <h1>Projects</h1>
    <p>Each project is a workspace — with tasks, people, and recent email activity attached.</p>
  </div>
</section>

<section class="crm-card-grid">
  <% for (const p of projects) { %>
    <a class="mgmt-card crm-link-card" href="/crm/project/<%= p.slug %>">
      <div class="crm-card-title">
        <span><%= p.name %></span>
        <% if (p.openTasks > 0) { %>
          <span class="crm-count"><%= p.openTasks %> task<%= p.openTasks !== 1 ? 's' : '' %></span>
        <% } %>
      </div>
      <div class="crm-badges" style="margin-top:6px;">
        <span class="crm-badge subtle"><%= p.slug %></span>
        <% if (p.lastActivity) { %>
          <span class="crm-badge subtle">Active <%= new Date(p.lastActivity * 1000).toLocaleDateString('en-GB', { day:'numeric', month:'short' }) %></span>
        <% } %>
      </div>
    </a>
  <% } %>
  <% if (!projects.length) { %>
    <div class="crm-empty">No projects yet. Create one from AI Chat using a project slug.</div>
  <% } %>
</section>

<%- include('partials/crm-foot') %>
