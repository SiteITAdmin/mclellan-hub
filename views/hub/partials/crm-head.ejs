<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title><%= title %> — McLellan Hub CRM</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/hub.modern.css?v=20260507b">
<link rel="stylesheet" href="/crm.css?v=20260809c">
</head>
<body class="crm-body">
<%- include('top-nav') %>
<header class="crm-topbar">
  <span class="crm-brand">CRM</span>
  <nav>
    <% for (const item of nav) { %>
      <a href="<%= item.href %>" class="<%= item.href.includes(active) ? 'active' : '' %>"><%= item.label %></a>
    <% } %>
  </nav>
</header>
<main class="crm-page">
