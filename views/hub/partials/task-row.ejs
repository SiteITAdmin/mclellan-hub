<div class="crm-task-row<%= t.deleted_at ? ' task-deleted' : t.status === 'completed' ? ' task-done' : '' %>"
     data-task-status="<%= t.deleted_at ? 'deleted' : t.status === 'completed' ? 'completed' : 'open' %>"
     data-task-due="<%= t.effective_due || (t.due ? String(t.due).slice(0, 10) : '') %>"
     data-task-overdue="<%= t.is_overdue ? '1' : '0' %>"
     data-task-priority="<%= t.priority || '' %>"
     data-task-effort="<%= t.effort_minutes || '' %>"
     data-task-planner="<%= t.planner_lane || '' %>"
     data-task-assignee="<%= t.assignee || '' %>"
     data-task-project="<%= t.project_slug || '' %>"
     data-task-project-name="<%= (t.project_name || t.project_slug || '').toLowerCase() %>">
  <div class="crm-task-main">
    <a class="crm-task-title" href="/crm/tasks/<%= t.id %>"><%= t.title %></a>
    <% const notesLine = t.notes_preview !== undefined ? t.notes_preview : (t.notes ? t.notes.split('\n')[0].slice(0, 120) : ''); %>
    <% if (notesLine) { %><span class="crm-task-notes"><%= notesLine %></span><% } %>
    <div class="crm-task-meta">
      <% if (t.priority) { %>
        <% const pStyle = { high: 'color:var(--crm-danger,#c0392b);border-color:currentColor;font-weight:600;', medium: 'color:#b8860b;border-color:currentColor;', low: '' }[t.priority]; %>
        <span class="crm-badge" style="<%= pStyle %>"><%= t.priority %></span>
      <% } %>
      <% if (t.effort_minutes) { %><span class="crm-badge subtle"><%= t.effort_minutes >= 60 ? (t.effort_minutes / 60) + 'h' : t.effort_minutes + 'm' %></span><% } %>
      <% if (t.subtask_total) { %><span class="crm-badge subtle"><%= t.subtask_open %>/<%= t.subtask_total %> subtasks</span><% } %>
      <% if (t.due) { %>
        <% const isOverdue = Boolean(t.is_overdue); %>
        <% const depDeferred = Boolean(t.dependency_deferred); %>
        <span class="crm-badge" <%- isOverdue ? 'style="background:rgba(192,57,43,.12);color:var(--crm-danger,#c0392b);font-weight:600;" title="Overdue — escalating reminder active"' : '' %>><%= isOverdue ? '🔔 overdue · ' : '' %><%= new Date(t.due).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %></span>
        <% if (depDeferred) { %>
          <% const _floorDate = String(t.dep_not_before).slice(0, 10); const _floorTime = String(t.dep_not_before).slice(11, 16); %>
          <span class="crm-badge" style="background:rgba(37,99,235,.12);color:#1d4ed8;" title="Stored due date unchanged; overdue status and automatic reminders wait until this dependency clears">🔒 not before <%= new Date(`${_floorDate}T12:00:00Z`).toLocaleDateString('en-GB', { day:'numeric', month:'short' }) %><%= _floorTime && _floorTime !== '00:00' ? ` ${_floorTime}` : '' %><%= t.dep_title ? ` · ${t.dep_title}` : '' %></span>
        <% } %>
      <% } %>
      <% if (t.contact_name) { %>
        <a class="crm-badge" href="/crm/contact/<%= t.contact_id %>"><%= t.contact_name %></a>
      <% } %>
      <% if (t.company_name) { %>
        <a class="crm-badge subtle" href="/crm/company/<%= t.company_id %>"><%= t.company_name %></a>
      <% } %>
      <% if (t.project_slug) { %>
        <a class="crm-badge subtle" href="/c/<%= t.project_slug %>"><%= t.project_name || t.project_slug %></a>
      <% } %>
      <% if (t.assignee) { %>
        <span class="crm-badge" style="background:rgba(37,99,235,.12);color:#1d4ed8;font-weight:600;" title="Assigned to someone else — not in your planner">→ <%= t.assignee %></span>
      <% } %>
      <% if (!t.contact_name && !t.company_name && !t.project_slug && t.status === 'needsAction' && !t.deleted_at) { %>
        <a class="crm-badge subtle" href="/crm/tasks/<%= t.id %>" style="opacity:.7;" title="No person, company, or project linked — open to add context">+ add context</a>
      <% } %>
      <span class="crm-badge subtle"><%= t.source %></span>
    </div>
  </div>
  <div class="crm-task-actions">
    <% if (!t.deleted_at && t.status === 'needsAction') { %>
      <% if (!t.assignee) { %>
      <div class="task-planner-control" data-task-planner-control data-task-id="<%= t.id %>" data-saved-lane="<%= t.planner_lane || 'work' %>">
        <label title="Include this task in calendar planning">
          <input type="checkbox" <%= t.planner_lane ? 'checked' : '' %> onchange="taskPlannerToggle(this)">
          <span>Planner</span>
        </label>
        <select aria-label="Planner time for <%= t.title %>" onchange="taskPlannerLane(this)">
          <option value="work" <%= t.planner_lane !== 'personal' ? 'selected' : '' %>>Work</option>
          <option value="personal" <%= t.planner_lane === 'personal' ? 'selected' : '' %>>Personal</option>
        </select>
        <span class="task-planner-state" aria-live="polite"></span>
      </div>
      <% } %>
      <button class="btn btn-sm" onclick="taskAction('<%= t.id %>', 'complete')">Done</button>
      <% if (['document','email','agentmail'].includes(t.source)) { %>
        <button class="btn btn-sm btn-ghost" style="color:var(--crm-danger,#c0392b);" onclick="markTaskWrong('<%= t.id %>')">Wrong</button>
      <% } %>
      <button class="btn btn-sm btn-ghost" onclick="taskAction('<%= t.id %>', 'delete')">Delete</button>
    <% } else if (t.deleted_at && t.status === 'wrong') { %>
      <span class="crm-badge" style="background:#fee2e2;color:#991b1b;">Wrong · learned</span>
    <% } else if (t.deleted_at) { %>
      <button class="btn btn-sm btn-ghost" onclick="taskAction('<%= t.id %>', 'restore')">Restore</button>
    <% } %>
  </div>
</div>
