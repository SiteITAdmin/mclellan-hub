<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Token Burn · McLellan Hub</title>
<link rel="stylesheet" href="/hub.css">
<style>
body.hub-page { height: auto !important; min-height: 100vh; overflow: auto !important; background: var(--bg-page, #f4f3fb); }
.burn-wrap { max-width: 1120px; margin: 0 auto; padding: 32px 16px 80px; }
.burn-top { display:flex; justify-content:space-between; gap:18px; align-items:flex-start; margin-bottom:22px; flex-wrap:wrap; }
.back-link { color: var(--text-dim); font-size: 13px; }
.burn-kicker { color: var(--accent); background: var(--accent-light); border-radius: 999px; padding: 5px 10px; font-family: var(--mono); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; display:inline-flex; margin-bottom: 10px; }
.burn-title { font-size: clamp(32px, 6vw, 58px); line-height: .95; margin:0; }
.burn-lead { color: var(--text-dim); max-width: 760px; margin-top: 14px; font-size: 15px; line-height: 1.6; }
.burn-grid { display:grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 14px; margin-bottom: 18px; }
.burn-card, .burn-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow-sm); }
.burn-card { padding: 16px; min-height: 112px; }
.burn-label { color: var(--text-muted); font-size: 11px; font-family: var(--mono); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
.burn-value { display:block; margin-top: 8px; font-family: var(--display); font-size: 30px; line-height: 1; font-weight: 700; }
.burn-note { color: var(--text-dim); font-size: 12px; margin-top: 8px; }
.burn-panel { overflow:hidden; margin-top: 16px; }
.burn-panel-head { display:flex; justify-content:space-between; gap:16px; padding: 15px 16px; border-bottom: 1px solid var(--border); }
.burn-panel-head h2 { margin:0; font-size: 20px; }
.burn-panel-head p { margin: 4px 0 0; color: var(--text-dim); font-size: 13px; max-width: 420px; }
.fidelity { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:18px; }
.pill { display:inline-flex; align-items:center; min-height:24px; padding:4px 9px; border-radius:999px; border:1px solid var(--border); font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.06em; color:var(--text-dim); }
.pill.exact { color:#0f6b3a; border-color:rgba(15,107,58,.35); background:#eef7f2; }
.pill.floor { color:#8a5a00; border-color:rgba(232,160,0,.35); background:rgba(232,160,0,.08); }
.pill.rough { color:#a33b31; border-color:rgba(196,52,43,.35); background:rgba(196,52,43,.07); }
.heatmap { display:grid; grid-template-columns: repeat(auto-fill, minmax(16px, 1fr)); gap:5px; padding:16px; }
.heat-cell { aspect-ratio:1/1; border-radius:3px; border:1px solid rgba(15,23,42,.06); background:var(--surface2); }
.heat1 { background:#eef1ff; }
.heat2 { background:#daddff; }
.heat3 { background:#bfc3ff; }
.heat4 { background:#999eff; }
.heat5 { background:var(--accent); }
.burn-two { display:grid; grid-template-columns: minmax(0,1fr) minmax(340px,.8fr); gap:16px; }
.source-grid, .top-list, .action-list { display:grid; gap:10px; padding:16px; }
.source-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
.source-box { border-top:1px solid var(--border); padding-top:12px; }
.source-box strong { display:block; font-size:22px; margin-top:6px; }
.row-list { width:100%; border-collapse:collapse; min-width:760px; }
.row-list th, .row-list td { padding:11px 12px; border-bottom:1px solid var(--border); text-align:left; font-size:13px; color:var(--text-dim); font-variant-numeric:tabular-nums; }
.row-list th { color:var(--accent); font-size:11px; font-family:var(--mono); text-transform:uppercase; letter-spacing:.08em; }
.table-wrap { overflow-x:auto; }
.top-day { display:grid; grid-template-columns:110px 1fr 1fr; gap:10px; align-items:center; font-size:13px; color:var(--text-dim); }
.top-day strong { color:var(--text); }
.action-list p { color:var(--text-dim); margin:4px 0 0; font-size:13px; line-height:1.5; }
.or-detail { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; padding:16px; }
.or-list { border-top:1px solid var(--border); padding-top:12px; }
.or-list h3 { font-size:15px; margin:0 0 10px; }
.or-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:4px 10px; padding:9px 0; border-bottom:1px solid var(--border); }
.or-name { color:var(--text-dim); font-size:13px; overflow-wrap:anywhere; }
.or-tokens { color:var(--accent); font-weight:800; font-variant-numeric:tabular-nums; font-size:13px; }
.or-meta { grid-column:1 / -1; color:var(--text-muted); font-size:12px; }
@media (max-width: 860px) {
  .burn-grid, .burn-two, .source-grid, .or-detail { grid-template-columns: 1fr; }
}
</style>
</head>
<body class="hub-page">
<%- include('partials/top-nav') %>
<main class="burn-wrap">
  <div class="burn-top">
    <div>
      <a class="back-link" href="/">← Back to hub</a>
      <div style="margin-top:18px"><span class="burn-kicker">Measured AI usage</span></div>
      <h1 class="burn-title">Token burn</h1>
      <p class="burn-lead">Exact Codex, Claude Code, and API logs are kept separate from chat estimates. McLellan hub OpenRouter usage comes from the live request log table so daily usage can build from here.</p>
    </div>
  </div>

  <div class="fidelity" aria-label="Fidelity legend">
    <span class="pill exact">measured</span>
    <span class="pill floor">activity floor</span>
    <span class="pill rough">not populated</span>
    <span class="burn-note">Consumer chat estimates are intentionally absent. Current totals use measured logs and OpenRouter exports.</span>
  </div>

  <section class="burn-grid">
    <div class="burn-card"><span class="burn-label">Imported exact</span><strong class="burn-value"><%= formatTokens(tokenBurn.importedExact) %></strong><p class="burn-note"><%= tokenBurn.firstDate || 'n/a' %> to <%= tokenBurn.lastDate || 'n/a' %></p></div>
    <div class="burn-card"><span class="burn-label">Codex</span><strong class="burn-value"><%= formatTokens(tokenBurn.codex) %></strong><p class="burn-note">Local session token counters</p></div>
    <div class="burn-card"><span class="burn-label">Claude Code</span><strong class="burn-value"><%= formatTokens(tokenBurn.claudeCode) %></strong><p class="burn-note">Message usage, including cache tokens</p></div>
    <div class="burn-card"><span class="burn-label">Hub OpenRouter live</span><strong class="burn-value"><%= formatTokens(tokenBurn.liveExact) %></strong><p class="burn-note"><%= formatUsd(tokenBurn.liveCost) %> logged in current hub DB</p></div>
  </section>

  <section class="burn-panel">
    <div class="burn-panel-head">
      <div><span class="burn-label">Daily burn</span><h2>Log heatmap</h2></div>
      <p>Colored by imported exact tokens. The OpenRouter live lane is shown separately below to avoid accidental double counting.</p>
    </div>
    <div class="heatmap">
      <% for (const row of tokenBurn.importedDaily) { %>
        <span class="heat-cell heat<%= heatLevel(row.exact_total, tokenBurn.maxDay) %>" title="<%= row.date %>: <%= formatTokens(row.exact_total) %> exact · <%= row.driver %>"></span>
      <% } %>
    </div>
  </section>

  <section class="burn-two">
    <article class="burn-panel">
      <div class="burn-panel-head">
        <div><span class="burn-label">Distribution</span><h2>Exact sources</h2></div>
        <p>Consumer chat estimates are intentionally absent. OpenRouter export detail is shown below.</p>
      </div>
      <div class="source-grid">
        <div class="source-box"><span class="pill exact">exact</span><strong><%= formatTokens(tokenBurn.codex) %></strong><p class="burn-note">Codex</p></div>
        <div class="source-box"><span class="pill exact">exact</span><strong><%= formatTokens(tokenBurn.claudeCode) %></strong><p class="burn-note">Claude Code</p></div>
        <div class="source-box"><span class="pill exact">exact</span><strong><%= formatTokens(tokenBurn.api) %></strong><p class="burn-note">Historical hub + Synthadoc API</p></div>
        <div class="source-box"><span class="pill exact">exact</span><strong><%= formatTokens(tokenBurn.openRouter.tokens) %></strong><p class="burn-note">OpenRouter export detail below</p></div>
      </div>
    </article>

    <article class="burn-panel">
      <div class="burn-panel-head">
        <div><span class="burn-label">Top days</span><h2>Peak exact burn</h2></div>
      </div>
      <div class="top-list">
        <% for (const row of tokenBurn.topDays) { %>
          <div class="top-day"><strong><%= row.date %></strong><span><%= formatTokens(row.exact_total) %></span><span><%= row.driver %></span></div>
        <% } %>
      </div>
    </article>
  </section>

  <section class="burn-panel">
    <div class="burn-panel-head">
      <div><span class="burn-label">OpenRouter export</span><h2>All API usage detail</h2></div>
      <p><%= tokenBurn.openRouter.rows %> exported generations grouped by model, app, and provider. No prompts or generation IDs are shown.</p>
    </div>
    <div class="source-grid">
      <div class="source-box"><span class="pill exact">exact</span><strong><%= formatTokens(tokenBurn.openRouter.tokens) %></strong><p class="burn-note">OpenRouter export tokens</p></div>
      <div class="source-box"><span class="pill exact">exact</span><strong><%= formatUsd(tokenBurn.openRouter.cost_usd) %></strong><p class="burn-note">OpenRouter export cost</p></div>
    </div>
    <div class="or-detail">
      <% const groups = [['Models', tokenBurn.openRouter.by_model], ['Apps', tokenBurn.openRouter.by_app], ['Providers', tokenBurn.openRouter.by_provider]]; %>
      <% for (const group of groups) { %>
        <div class="or-list">
          <h3><%= group[0] %></h3>
          <% for (const row of group[1].slice(0, 12)) { %>
            <div class="or-row">
              <span class="or-name"><%= row.label %></span>
              <span class="or-tokens"><%= formatTokens(row.tokens) %></span>
              <span class="or-meta"><%= row.calls %> calls / <%= formatUsd(row.cost_usd) %></span>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>

  <section class="burn-panel">
    <div class="burn-panel-head">
      <div><span class="burn-label">McLellan hub</span><h2>Live OpenRouter tasks</h2></div>
      <p>Hub calls grouped by task identity. `UT` means user-triggered; `AT` means an automatic task.</p>
    </div>
    <div class="table-wrap">
      <table class="row-list">
        <thead><tr><th>Task</th><th>Type</th><th>Calls</th><th>Input</th><th>Output</th><th>Total</th><th>Cost</th><th>Avg time</th></tr></thead>
        <tbody>
          <% if (!tokenBurn.liveTasks.length) { %>
            <tr><td colspan="8">No task-attributed OpenRouter rows in the current hub DB yet.</td></tr>
          <% } %>
          <% for (const row of tokenBurn.liveTasks) { %>
            <tr>
              <td><strong><%= row.label %></strong><br><span class="burn-note"><%= row.task_code %></span></td>
              <td><span class="pill <%= row.task_type === 'legacy' ? 'estimated' : 'exact' %>"><%= row.task_type %></span></td>
              <td><%= row.calls %></td>
              <td><%= formatTokens(row.tokens_in) %></td>
              <td><%= formatTokens(row.tokens_out) %></td>
              <td><span class="pill exact"><%= formatTokens(row.total) %></span></td>
              <td><%= formatUsd(row.cost_usd) %></td>
              <td><%= row.avg_duration_ms == null ? '—' : row.avg_duration_ms >= 1000 ? `${(row.avg_duration_ms / 1000).toFixed(1)}s` : `${row.avg_duration_ms}ms` %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="burn-panel">
    <div class="burn-panel-head">
      <div><span class="burn-label">McLellan hub</span><h2>Live OpenRouter daily log</h2></div>
      <p>Daily totals from the same task-attributed `request_logs` records.</p>
    </div>
    <div class="table-wrap">
      <table class="row-list">
        <thead><tr><th>Date</th><th>Calls</th><th>Input</th><th>Output</th><th>Total</th><th>Cost</th></tr></thead>
        <tbody>
          <% if (!tokenBurn.liveDaily.length) { %>
            <tr><td colspan="6">No live OpenRouter token rows in the current hub DB yet.</td></tr>
          <% } %>
          <% for (const row of tokenBurn.liveDaily.slice().reverse().slice(0, 30)) { %>
            <tr>
              <td><strong><%= row.date %></strong></td>
              <td><%= row.calls %></td>
              <td><%= formatTokens(row.tokens_in) %></td>
              <td><%= formatTokens(row.tokens_out) %></td>
              <td><span class="pill exact"><%= formatTokens(row.total) %></span></td>
              <td><%= formatUsd(row.cost_usd) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="burn-panel">
    <div class="burn-panel-head">
      <div><span class="burn-label">Moving average</span><h2>Last 30 imported days</h2></div>
      <p>Exact Codex, Claude Code, API, and OpenRouter export markers by day.</p>
    </div>
    <div class="table-wrap">
      <table class="row-list">
        <thead><tr><th>Date</th><th>Exact</th><th>Codex</th><th>Claude Code</th><th>API</th><th>OpenRouter</th><th>Driver</th></tr></thead>
        <tbody>
          <% for (const row of tokenBurn.recentDays) { %>
            <tr>
              <td><strong><%= row.date %></strong></td>
              <td><span class="pill exact"><%= formatTokens(row.exact_total) %></span></td>
              <td><%= formatTokens(row.codex_tokens) %></td>
              <td><%= formatTokens(row.claude_code_tokens) %></td>
              <td><%= formatTokens(row.api_tokens) %></td>
              <td><% if ((row.evidence || '').includes('OpenRouter activity export')) { %><span class="pill exact">export</span><% } else { %>none<% } %></td>
              <td><%= row.driver %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>
</body>
</html>
