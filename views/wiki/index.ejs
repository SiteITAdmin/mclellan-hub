<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= q ? q + ' — ' : '' %>McLellan Wiki</title>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/wiki.css">
</head>
<body>
<%- include('_nav', { page: 'home', q }) %>

<main class="wiki-main">
  <div class="wiki-hero">
    <form class="wiki-search-form" id="search-form">
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="Ask anything — searches your videos, newsletters, and documents"
        value="<%= q %>"
        autofocus
      />
      <button type="submit">Ask</button>
    </form>
    <p class="wiki-stats"><%= total %> indexed items — <%= counts['Wiki'] || 0 %> wiki · <%= counts['Meetings'] || 0 %> meetings · <%= counts['Workday'] || 0 %> workday · <%= counts['Journal'] || 0 %> journal</p>
  </div>

  <div id="results">
    <% if (q && pages.length === 0) { %>
      <p class="wiki-empty">No pages matched "<%= q %>"</p>
    <% } %>
    <% if (!q) { %>
      <h2 class="wiki-section-head">Recently added</h2>
    <% } %>
    <div id="synthesis-wrap" style="display:none">
      <div class="wiki-synthesis">
        <div class="synthesis-label">Knowledge base answer</div>
        <div id="synthesis-body"></div>
      </div>
    </div>

    <div class="wiki-cards" id="page-cards">
      <% for (const p of pages) { %>
        <a href="/page/<%= encodeURIComponent(p.slug) %>" class="wiki-card">
          <h3><%= p.title %></h3>
          <p><%= p.content.replace(/^#+ .+\n*/m, '').replace(/\[\[([^\]]+)\]\]/g, '$1').slice(0, 120) %>…</p>
          <div class="wiki-card-tags">
            <% for (const t of (p.tags || []).slice(0, 4)) { %>
              <span class="tag"><%= t %></span>
            <% } %>
          </div>
        </a>
      <% } %>
    </div>
  </div>
</main>

<script>
function escapeHtml(raw) {
  return String(raw || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
document.getElementById('search-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  const q = document.getElementById('search-input').value.trim();
  if (!q) return;
  history.pushState({}, '', '/?q=' + encodeURIComponent(q));

  document.getElementById('page-cards').innerHTML = '<p class="wiki-loading">Searching…</p>';
  document.getElementById('synthesis-wrap').style.display = 'none';

  const res = await fetch('/api/search?q=' + encodeURIComponent(q));
  const data = await res.json();

  const cards = document.getElementById('page-cards');
  if (!data.results.length && !(data.emailMatches || []).length) {
    cards.innerHTML = '<p class="wiki-empty">No matches for "' + escapeHtml(q) + '"</p>';
    return;
  }

  cards.innerHTML = data.results.map(p => {
    const provenance = [p.typeLabel, p.project, p.filename].filter(Boolean).join(' · ');
    const inner = `<div class="result-source-id">${escapeHtml(p.sourceId)}</div><h3>${escapeHtml(p.title)}</h3><p class="result-provenance">${escapeHtml(provenance)}</p><p>${escapeHtml(String(p.excerpt || '').replace(/\[\[([^\]]+)\]\]/g, '$1'))}…</p><div class="wiki-card-tags">${(p.tags||[]).slice(0,4).map(t => '<span class="tag">' + escapeHtml(t) + '</span>').join('')}</div>`;
    return p.url
      ? `<a href="${escapeHtml(p.url)}" class="wiki-card">${inner}</a>`
      : `<div class="wiki-card">${inner}</div>`;
  }).join('') + (data.emailMatches||[]).map(e => `
    <div class="wiki-card wiki-card-email">
      <h3>📧 ${escapeHtml(e.subject)}</h3>
      <p>${escapeHtml(e.summary)}</p>
    </div>
  `).join('');

  if (data.synthesis) {
    const sourceMap = Object.fromEntries([
      ...data.results.map(p => [p.sourceId, p]),
      ...(data.emailMatches || []).map(e => [e.sourceId, { ...e, title: e.subject }]),
    ]);
    const sourceLinks = ids => (ids || []).map(id => {
      const source = sourceMap[id];
      if (!source) return `<span class="answer-source">${escapeHtml(id)}</span>`;
      const label = `${id} · ${source.title}`;
      return source.url
        ? `<a class="answer-source" href="${escapeHtml(source.url)}">${escapeHtml(label)}</a>`
        : `<span class="answer-source">${escapeHtml(label)}</span>`;
    }).join('');
    const facts = (data.synthesis.facts || []).map(f => `
      <div class="answer-fact">
        <dt>${escapeHtml(f.label)}</dt>
        <dd>${escapeHtml(f.detail)}<div class="answer-sources">${sourceLinks(f.source_ids)}</div></dd>
      </div>
    `).join('');
    const gaps = (data.synthesis.gaps || []).map(g => `<li>${escapeHtml(g)}</li>`).join('');
    document.getElementById('synthesis-body').innerHTML = `
      <h1>${escapeHtml(data.synthesis.headline || q)}</h1>
      <p class="answer-summary">${escapeHtml(data.synthesis.summary || '')}</p>
      ${facts ? `<section><h2>What the sources establish</h2><dl class="answer-facts">${facts}</dl></section>` : ''}
      ${gaps ? `<section class="answer-gaps"><h2>Gaps in the record</h2><ul>${gaps}</ul></section>` : ''}
      ${data.synthesis.assessment ? `<p class="answer-assessment"><strong>Evidence assessment:</strong> ${escapeHtml(data.synthesis.assessment)}</p>` : ''}
    `;
    document.getElementById('synthesis-wrap').style.display = 'block';
  }
});
</script>
</body>
</html>
