<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Browse — McLellan Wiki</title>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/wiki.css">
</head>
<body>
<%- include('_nav', { page: 'browse', q: '' }) %>
<main class="wiki-main">
  <h1 class="wiki-page-title">Browse</h1>
  <% for (const [cat, pages] of Object.entries(byCategory).sort()) { %>
    <section class="browse-section">
      <h2 class="browse-cat"><%= cat %> <span class="browse-count"><%= pages.length %></span></h2>
      <ul class="browse-list">
        <% for (const p of pages) { %>
          <li>
            <a href="/page/<%= encodeURIComponent(p.slug) %>"><%= p.title %></a>
            <% for (const t of (p.tags || []).slice(0, 3)) { %>
              <span class="tag tag-sm"><%= t %></span>
            <% } %>
          </li>
        <% } %>
      </ul>
    </section>
  <% } %>
</main>
</body>
</html>
