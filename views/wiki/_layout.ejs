<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> — McLellan Wiki</title>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/wiki.css">
</head>
<body>
<nav class="wiki-nav">
  <a href="/" class="wiki-logo">McLellan Wiki</a>
  <div class="wiki-nav-links">
    <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Search</a>
    <a href="/browse" class="<%= page === 'browse' ? 'active' : '' %>">Browse</a>
    <a href="/ingest" class="<%= page === 'ingest' ? 'active' : '' %>">Add</a>
    <a href="https://dchat.mclellan.scot" class="wiki-nav-ext" target="_blank">dchat ↗</a>
  </div>
  <form class="wiki-nav-search" action="/" method="GET">
    <input name="q" placeholder="Search…" value="<%= locals.q || '' %>" />
  </form>
</nav>
<main class="wiki-main">
  <%- body %>
</main>
<footer class="wiki-footer">
  <form method="POST" action="/logout" style="display:inline">
    <button type="submit" class="logout-btn">Sign out</button>
  </form>
</footer>
</body>
</html>
