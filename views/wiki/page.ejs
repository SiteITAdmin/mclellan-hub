<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= page.title %> — McLellan Wiki</title>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/wiki.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/atom-one-dark.min.css">
</head>
<body>
<%- include('_nav', { page: '', q: '' }) %>
<main class="wiki-main wiki-page-wrap">
  <div class="wiki-page-meta">
    <% for (const cat of page.categories) { %><span class="tag tag-cat"><%= cat %></span><% } %>
    <% for (const t of page.tags) { %><span class="tag"><%= t %></span><% } %>
    <% if (page.created) { %><span class="meta-date"><%= new Date(page.created).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'}) %></span><% } %>
    <% if (page.confidence) { %><span class="meta-conf conf-<%= page.confidence %>"><%= page.confidence %></span><% } %>
    <% if (page.slug && (!page.type || page.type === 'wiki')) { %>
      <a href="/page/<%= encodeURIComponent(page.slug) %>/edit" class="wiki-edit-btn">Edit</a>
    <% } else if (page.slug) { %>
      <a href="/source/<%= page.slug.split('/').map(encodeURIComponent).join('/') %>/edit" class="wiki-edit-btn">Edit</a>
    <% } %>
  </div>

  <% if ((page.sources && page.sources.length) || page.project || page.filename) { %>
  <aside class="wiki-provenance">
    <strong>Built from</strong>
    <% if (page.project) { %><span><%= page.project %></span><% } %>
    <% if (page.filename) { %><span><%= page.filename %></span><% } %>
    <% for (const s of (page.sources || []).slice(0, 3)) { %>
      <% const sourceName = (s.file || '').split('/').pop().replace(/\.md$/, ''); %>
      <span><%= sourceName %><% if (s.ingested) { %> · <%= new Date(s.ingested).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'}) %><% } %></span>
    <% } %>
  </aside>
  <% } %>

  <article class="wiki-article" id="article-body">
    <p class="wiki-loading">Loading…</p>
  </article>

  <% if (page.sources && page.sources.length) { %>
  <section class="wiki-sources">
    <h3>Sources (<%= page.sources.length %>)</h3>
    <ul>
      <% for (const s of page.sources) { %>
        <li class="source-item">
          <% const name = (s.file || '').split('/').pop().replace(/\.md$/, ''); %>
          <span class="source-name"><%= name %></span>
          <% if (s.ingested) { %><span class="source-date"><%= new Date(s.ingested).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'}) %></span><% } %>
        </li>
      <% } %>
    </ul>
  </section>
  <% } %>

  <% const manual = locals.manualLinks || []; %>
  <% if (manual.length) { %>
  <section class="wiki-related wiki-confirmed">
    <h3>Confirmed links</h3>
    <p class="related-note">Verified by you. These are highlighted in the graph.</p>
    <div class="wiki-cards wiki-cards-sm">
      <% for (const m of manual) { %>
        <div class="wiki-card confirmed-card">
          <a href="<%= m.type === 'wiki' || !m.type ? '/page/' + encodeURIComponent(m.slug) : '/source/' + m.slug.split('/').map(encodeURIComponent).join('/') %>"><h3><%= m.title %></h3></a>
          <div class="related-actions">
            <span class="tag tag-sm"><%= m.relation === 'same' ? 'same person / thing' : 'related' %></span>
            <button class="link-act link-act-danger" data-link-action="unlink" data-slug="<%= m.slug %>">Unlink</button>
          </div>
        </div>
      <% } %>
    </div>
  </section>
  <% } %>

  <% if (related.length) { %>
  <section class="wiki-related">
    <h3>Suggested links</h3>
    <p class="related-note">Automatically inferred. Confirm to make a link permanent — it writes a [[wikilink]] into both pages.</p>
    <div class="wiki-cards wiki-cards-sm">
      <% for (const r of related) { %>
        <div class="wiki-card">
          <a href="<%= r.type === 'wiki' ? '/page/' + encodeURIComponent(r.slug) : '/source/' + r.slug.split('/').map(encodeURIComponent).join('/') %>"><h3><%= r.title %></h3></a>
          <div class="wiki-card-tags"><% for (const t of r.tags.slice(0,3)) { %><span class="tag tag-sm"><%= t %></span><% } %></div>
          <div class="related-actions">
            <button class="link-act" data-link-action="related" data-slug="<%= r.slug %>">Confirm link</button>
            <button class="link-act" data-link-action="same" data-slug="<%= r.slug %>">Same person / thing</button>
          </div>
        </div>
      <% } %>
    </div>
  </section>
  <% } %>
</main>

<script src="https://cdn.jsdelivr.net/npm/marked@12.0.0/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/core.min.js"></script>
<script>
  function escapeHtml(raw) {
    return String(raw || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }
  const raw = <%- JSON.stringify(page.content) %>;
  // Convert [[wikilinks]] to anchor tags
  const linked = raw.replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, (_, slug, label) => {
    const text = label || slug;
    const href = '/page/' + encodeURIComponent(slug.toLowerCase().replace(/\s+/g, '-'));
    return '[' + text + '](' + href + ')';
  });
  document.getElementById('article-body').innerHTML = marked.parse(escapeHtml(linked));
  document.getElementById('article-body').querySelectorAll('pre code').forEach(b => hljs.highlightElement(b));

  // Confirm / remove manual links from the suggested + confirmed cards
  const PAGE_SLUG = <%- JSON.stringify(page.slug || '') %>;
  document.querySelectorAll('.link-act').forEach(btn => {
    btn.addEventListener('click', async ev => {
      ev.preventDefault();
      ev.stopPropagation();
      const action = btn.dataset.linkAction;
      const other  = btn.dataset.slug;
      btn.disabled = true;
      btn.textContent = 'Saving…';
      try {
        const url  = action === 'unlink' ? '/api/graph/unlink' : '/api/graph/link';
        const body = action === 'unlink'
          ? { from: PAGE_SLUG, to: other }
          : { from: PAGE_SLUG, to: other, relation: action };
        const r = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || 'HTTP ' + r.status);
        window.location.reload();
      } catch (e) {
        btn.disabled = false;
        btn.textContent = 'Failed — retry';
      }
    });
  });
</script>
</body>
</html>
