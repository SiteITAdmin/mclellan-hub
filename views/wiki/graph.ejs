<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Graph — McLellan Wiki</title>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..800&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/wiki.css">
<style>
  body { overflow: hidden; }
  .graph-wrap {
    position: relative;
    height: calc(100vh - 52px); /* below sticky nav */
    width: 100%;
  }
  #graph-canvas { display: block; width: 100%; height: 100%; cursor: grab; }
  #graph-canvas.dragging { cursor: grabbing; }
  #graph-canvas.pointing { cursor: pointer; }

  .graph-panel {
    position: absolute;
    top: 16px;
    left: 16px;
    width: 230px;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 4px 18px rgba(25, 20, 70, .08);
    padding: 14px;
    z-index: 10;
    max-height: calc(100% - 32px);
    overflow-y: auto;
  }
  .graph-panel h2 {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text-3);
    margin: 14px 0 8px;
  }
  .graph-panel h2:first-child { margin-top: 0; }
  .graph-search {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 7px 10px;
    font-size: 13px;
    font-family: var(--font);
    background: var(--bg-soft);
    color: var(--text);
  }
  .graph-search:focus { outline: none; border-color: var(--accent); background: #fff; }

  .graph-filter {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-2);
    padding: 3px 0;
    cursor: pointer;
    user-select: none;
  }
  .graph-filter input { accent-color: var(--accent); cursor: pointer; }
  .graph-filter .swatch {
    width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
  }
  .graph-filter .count { margin-left: auto; font-size: 11px; color: var(--text-3); }

  .graph-stats { font-size: 11px; color: var(--text-3); margin-top: 12px; line-height: 1.6; }

  .graph-tooltip {
    position: absolute;
    pointer-events: none;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(0,0,0,.12);
    padding: 9px 12px;
    font-size: 12px;
    max-width: 260px;
    z-index: 20;
    display: none;
  }
  .graph-tooltip strong { display: block; font-size: 13px; margin-bottom: 2px; }
  .graph-tooltip .tt-meta { color: var(--text-3); font-size: 11px; }
  .graph-tooltip .tt-tags { margin-top: 5px; display: flex; flex-wrap: wrap; gap: 3px; }

  .graph-hint {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    color: var(--text-3);
    background: rgba(255,255,255,.85);
    border-radius: 6px;
    padding: 4px 12px;
    pointer-events: none;
  }
  .link-panel {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 260px;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: 0 4px 18px rgba(25, 20, 70, .12);
    padding: 14px;
    z-index: 10;
  }
  .link-panel h2 {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--accent);
    margin: 0 0 8px;
  }
  #link-names { font-size: 13px; font-weight: 600; margin-bottom: 8px; line-height: 1.5; }
  #link-names .ln-placeholder { color: var(--text-3); font-weight: 400; }
  .link-actions { display: flex; gap: 6px; margin-top: 8px; }
  .link-btn {
    flex: 1;
    padding: 7px 10px;
    border: none;
    border-radius: 7px;
    background: var(--accent);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font);
    cursor: pointer;
  }
  .link-btn:disabled { opacity: .45; cursor: default; }
  .link-btn-ghost { background: var(--bg-soft); color: var(--text-2); flex: 0 0 auto; }
  .link-btn.danger { background: #c0392b; }
  .link-note { font-size: 10px; color: var(--text-3); margin-top: 8px; line-height: 1.4; }
  .graph-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-3);
    font-size: 14px;
  }
  @media (max-width: 600px) {
    .graph-panel { width: 180px; top: 10px; left: 10px; padding: 10px; }
  }
</style>
</head>
<body>
<%- include('_nav', { page: 'graph', q: '' }) %>

<div class="graph-wrap">
  <canvas id="graph-canvas"></canvas>
  <div class="graph-loading" id="graph-loading">Building graph…</div>

  <div class="graph-panel">
    <h2>Find</h2>
    <input type="search" id="graph-search" class="graph-search" placeholder="Filter nodes…" autocomplete="off">
    <h2>Sources</h2>
    <div id="graph-filters"></div>
    <h2>Options</h2>
    <label class="graph-filter">
      <input type="checkbox" id="opt-connected"> Connected only
    </label>
    <label class="graph-filter">
      <input type="checkbox" id="opt-labels"> Always show labels
    </label>
    <label class="graph-filter">
      <input type="checkbox" id="opt-linkmode"> Link mode — click selects
    </label>
    <div class="graph-stats" id="graph-stats"></div>
  </div>

  <div class="graph-tooltip" id="graph-tooltip"></div>
  <div class="graph-hint">scroll to zoom · drag to pan · click to open · shift-click (or Link mode) two nodes to link them</div>

  <div class="link-panel" id="link-panel" style="display:none">
    <h2>Force a link</h2>
    <div id="link-names"></div>
    <div id="link-relation">
      <label class="graph-filter"><input type="radio" name="link-rel" value="same" checked> Same person / thing</label>
      <label class="graph-filter"><input type="radio" name="link-rel" value="related"> Related</label>
    </div>
    <div class="link-actions">
      <button id="link-confirm" class="link-btn" disabled>Select a second node</button>
      <button id="link-clear" class="link-btn link-btn-ghost">Clear</button>
    </div>
    <p class="link-note" id="link-note">Linking writes a [[wikilink]] into both pages' Related sections.</p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script>
(async function () {
  'use strict';

  const TYPE_STYLE = {
    wiki:    { color: '#5b4fcf', label: 'Wiki' },
    meeting: { color: '#e8743b', label: 'Meetings' },
    journal: { color: '#13a07e', label: 'Journal' },
    daily:   { color: '#64b5e3', label: 'Daily Notes' },
    workday: { color: '#c94f7c', label: 'Workday' },
    person:  { color: '#d9a514', label: 'People' },
    project: { color: '#0e9594', label: 'Projects' },
    'project-doc': { color: '#8a8a8a', label: 'Project files' },
    note:    { color: '#4a6fa5', label: 'Notes' },
    missing: { color: '#cfcfcf', label: 'Missing' },
  };
  const FALLBACK_COLOR = '#9a9a9a';

  const canvas  = document.getElementById('graph-canvas');
  const ctx     = canvas.getContext('2d');
  const tooltip = document.getElementById('graph-tooltip');
  const loading = document.getElementById('graph-loading');

  let raw;
  try {
    raw = await (await fetch('/api/graph')).json();
  } catch (e) {
    loading.textContent = 'Could not load graph data.';
    return;
  }

  // ── Build node/link structures ───────────────────────────────────────────
  const nodeById = new Map(raw.nodes.map(n => [n.id, { ...n, degree: 0 }]));
  const edgeMap = new Map();
  for (const e of raw.edges) {
    const a = nodeById.get(e.from), b = nodeById.get(e.to);
    if (!a || !b || a === b) continue;
    const key = e.from < e.to ? e.from + ' ' + e.to : e.to + ' ' + e.from;
    const existing = edgeMap.get(key); // collapse mutual links into one edge
    if (existing) {
      if (e.manual) { existing.manual = true; existing.relation = e.relation; }
      continue;
    }
    edgeMap.set(key, { source: e.from, target: e.to, manual: !!e.manual, relation: e.relation || null });
    a.degree++; b.degree++;
  }
  const allLinks = [...edgeMap.values()];
  const allNodes = [...nodeById.values()];

  // Neighbour lookup for hover highlighting
  const neighbours = new Map(allNodes.map(n => [n.id, new Set([n.id])]));
  for (const l of allLinks) {
    neighbours.get(l.source).add(l.target);
    neighbours.get(l.target).add(l.source);
  }

  // ── State ────────────────────────────────────────────────────────────────
  const typesPresent = [...new Set(allNodes.map(n => n.type))];
  const enabledTypes = new Set(typesPresent);
  let connectedOnly = false;
  let alwaysLabels  = false;
  let linkMode      = false;
  let searchTerm    = '';
  let transform     = d3.zoomIdentity;
  let hovered       = null;
  let selected      = [];
  let nodes = [], links = [];

  // ── Simulation ───────────────────────────────────────────────────────────
  const simulation = d3.forceSimulation()
    .force('link',    d3.forceLink().id(d => d.id)
      .distance(d => d.manual && d.relation === 'same' ? 22 : 46)
      .strength(d => d.manual ? 0.85 : 0.5))
    .force('charge',  d3.forceManyBody().strength(-90).distanceMax(420))
    .force('center',  d3.forceCenter())
    .force('collide', d3.forceCollide().radius(d => radius(d) + 3))
    .force('x',       d3.forceX().strength(0.04))
    .force('y',       d3.forceY().strength(0.04))
    .on('tick', draw);

  function radius(d) { return 3.5 + Math.min(10, Math.sqrt(d.degree) * 2.2); }
  function colour(d) { return (TYPE_STYLE[d.type] || {}).color || FALLBACK_COLOR; }

  function applyFilters() {
    nodes = allNodes.filter(n =>
      enabledTypes.has(n.type) && (!connectedOnly || n.degree > 0)
    );
    const visible = new Set(nodes.map(n => n.id));
    links = allLinks
      .map(l => ({
        source: typeof l.source === 'object' ? l.source.id : l.source,
        target: typeof l.target === 'object' ? l.target.id : l.target,
        manual: l.manual,
        relation: l.relation,
      }))
      .filter(l => visible.has(l.source) && visible.has(l.target));
    simulation.nodes(nodes);
    simulation.force('link').links(links);
    simulation.alpha(0.6).restart();
    updateStats();
  }

  // ── Canvas sizing ────────────────────────────────────────────────────────
  function resize() {
    const dpr = window.devicePixelRatio || 1;
    const { width, height } = canvas.parentElement.getBoundingClientRect();
    canvas.width  = width * dpr;
    canvas.height = height * dpr;
    draw();
  }
  window.addEventListener('resize', resize);

  // ── Drawing ──────────────────────────────────────────────────────────────
  function matchesSearch(n) {
    if (!searchTerm) return true;
    return n.label.toLowerCase().includes(searchTerm)
        || n.id.toLowerCase().includes(searchTerm)
        || (n.tags || []).some(t => t.toLowerCase().includes(searchTerm));
  }

  function draw() {
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.width / dpr, h = canvas.height / dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    ctx.translate(w / 2 + transform.x, h / 2 + transform.y);
    ctx.scale(transform.k, transform.k);

    const hoodSet  = hovered ? neighbours.get(hovered.id) : null;
    const searching = !!searchTerm;

    // Edges (manual/forced links drawn highlighted)
    for (const l of links) {
      const active = hoodSet && (l.source.id === hovered.id || l.target.id === hovered.id);
      if (l.manual) {
        ctx.lineWidth = 2 / transform.k;
        ctx.strokeStyle = active ? 'rgba(91,79,207,.95)' : 'rgba(91,79,207,.5)';
      } else {
        ctx.lineWidth = 1 / transform.k;
        ctx.strokeStyle = active ? 'rgba(91,79,207,.55)' : 'rgba(140,140,140,.18)';
      }
      ctx.beginPath();
      ctx.moveTo(l.source.x, l.source.y);
      ctx.lineTo(l.target.x, l.target.y);
      ctx.stroke();
    }

    // Nodes
    for (const n of nodes) {
      const r = radius(n);
      let alpha = 1;
      if (hoodSet && !hoodSet.has(n.id)) alpha = 0.15;
      if (searching && !matchesSearch(n)) alpha = Math.min(alpha, 0.08);
      ctx.globalAlpha = alpha;
      ctx.beginPath();
      ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
      ctx.fillStyle = colour(n);
      ctx.fill();
      if (n.fx != null) { // pinned marker
        ctx.strokeStyle = '#1a1a1a';
        ctx.lineWidth = 1.2 / transform.k;
        ctx.stroke();
      }
      if (selected.includes(n)) { // selection ring
        ctx.beginPath();
        ctx.arc(n.x, n.y, r + 3.5 / transform.k, 0, Math.PI * 2);
        ctx.strokeStyle = '#5b4fcf';
        ctx.lineWidth = 2 / transform.k;
        ctx.stroke();
      }
    }
    ctx.globalAlpha = 1;

    // Labels: hovered neighbourhood, search matches, big nodes when zoomed, or all if toggled
    const showAll = alwaysLabels || transform.k > 2.2;
    ctx.font = `${11 / transform.k}px Manrope, sans-serif`;
    ctx.textAlign = 'center';
    for (const n of nodes) {
      const inHood = hoodSet && hoodSet.has(n.id);
      const isMatch = searching && matchesSearch(n);
      const big = n.degree >= 6 && transform.k > 0.7;
      if (!(showAll || inHood || isMatch || big)) continue;
      if (hoodSet && !inHood) continue;
      if (searching && !isMatch && !inHood) continue;
      const label = n.label.length > 34 ? n.label.slice(0, 33) + '…' : n.label;
      const y = n.y + radius(n) + 11 / transform.k;
      ctx.lineWidth = 3 / transform.k;
      ctx.strokeStyle = 'rgba(250,250,250,.85)';
      ctx.strokeText(label, n.x, y);
      ctx.fillStyle = (n === hovered) ? '#1a1a1a' : '#555';
      ctx.fillText(label, n.x, y);
    }
  }

  // ── Coordinate helpers ───────────────────────────────────────────────────
  function toSim(px, py) {
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.width / dpr, h = canvas.height / dpr;
    return [
      (px - w / 2 - transform.x) / transform.k,
      (py - h / 2 - transform.y) / transform.k,
    ];
  }
  function findNode(px, py) {
    const [x, y] = toSim(px, py);
    const n = simulation.find(x, y, 14 / transform.k);
    return (n && nodes.includes(n)) ? n : null;
  }

  // ── Zoom + drag ──────────────────────────────────────────────────────────
  d3.select(canvas)
    .call(d3.drag()
      .container(canvas)
      .subject(ev => findNode(ev.x, ev.y))
      .on('start', ev => {
        if (!ev.active) simulation.alphaTarget(0.25).restart();
        ev.subject.fx = ev.subject.x;
        ev.subject.fy = ev.subject.y;
        canvas.classList.add('dragging');
      })
      .on('drag', ev => {
        const [x, y] = toSim(ev.x, ev.y);
        ev.subject.fx = x;
        ev.subject.fy = y;
      })
      .on('end', ev => {
        if (!ev.active) simulation.alphaTarget(0);
        canvas.classList.remove('dragging');
        // stay pinned where dropped; double-click unpins
      }))
    .call(d3.zoom()
      .scaleExtent([0.15, 8])
      .filter(ev => ev.type !== 'dblclick')
      .on('zoom', ev => { transform = ev.transform; draw(); }));

  // ── Hover, click, unpin ──────────────────────────────────────────────────
  canvas.addEventListener('mousemove', ev => {
    const rect = canvas.getBoundingClientRect();
    const n = findNode(ev.clientX - rect.left, ev.clientY - rect.top);
    if (n !== hovered) {
      hovered = n;
      canvas.classList.toggle('pointing', !!n);
      draw();
    }
    if (n) {
      const style = TYPE_STYLE[n.type] || { label: n.typeLabel || n.type };
      tooltip.innerHTML =
        '<strong>' + escapeHtml(n.label) + '</strong>' +
        '<span class="tt-meta">' + escapeHtml(style.label || n.type) + ' · ' + n.degree + ' link' + (n.degree === 1 ? '' : 's') + '</span>' +
        ((n.tags || []).length
          ? '<div class="tt-tags">' + n.tags.slice(0, 5).map(t => '<span class="tag tag-sm">' + escapeHtml(t) + '</span>').join('') + '</div>'
          : '');
      tooltip.style.display = 'block';
      tooltip.style.left = Math.min(ev.clientX - rect.left + 14, rect.width - 270) + 'px';
      tooltip.style.top  = (ev.clientY - rect.top + 14) + 'px';
    } else {
      tooltip.style.display = 'none';
    }
  });
  canvas.addEventListener('mouseleave', () => {
    hovered = null;
    tooltip.style.display = 'none';
    canvas.classList.remove('pointing');
    draw();
  });
  canvas.addEventListener('click', ev => {
    if (ev.defaultPrevented) return; // a drag happened
    const rect = canvas.getBoundingClientRect();
    const n = findNode(ev.clientX - rect.left, ev.clientY - rect.top);
    if (ev.shiftKey || linkMode) { // select nodes for manual linking
      if (!n || n.type === 'missing') return;
      const i = selected.indexOf(n);
      if (i >= 0) selected.splice(i, 1);
      else { selected.push(n); if (selected.length > 2) selected.shift(); }
      updateLinkPanel();
      draw();
      return;
    }
    if (!n || n.type === 'missing') return;
    const url = n.type === 'wiki'
      ? '/page/' + encodeURIComponent(n.id)
      : '/source/' + n.id.split('/').map(encodeURIComponent).join('/');
    window.location.href = url;
  });
  canvas.addEventListener('dblclick', ev => {
    const rect = canvas.getBoundingClientRect();
    const n = findNode(ev.clientX - rect.left, ev.clientY - rect.top);
    if (n) { n.fx = null; n.fy = null; simulation.alpha(0.3).restart(); }
  });

  // ── Panel controls ───────────────────────────────────────────────────────
  const filtersEl = document.getElementById('graph-filters');
  for (const t of typesPresent) {
    const style = TYPE_STYLE[t] || { color: FALLBACK_COLOR, label: t };
    const count = allNodes.filter(n => n.type === t).length;
    const label = document.createElement('label');
    label.className = 'graph-filter';
    label.innerHTML =
      '<input type="checkbox" checked data-type="' + escapeHtml(t) + '">' +
      '<span class="swatch" style="background:' + style.color + '"></span>' +
      escapeHtml(style.label) +
      '<span class="count">' + count + '</span>';
    label.querySelector('input').addEventListener('change', ev => {
      ev.target.checked ? enabledTypes.add(t) : enabledTypes.delete(t);
      applyFilters();
    });
    filtersEl.appendChild(label);
  }

  document.getElementById('opt-connected').addEventListener('change', ev => {
    connectedOnly = ev.target.checked;
    applyFilters();
  });
  document.getElementById('opt-labels').addEventListener('change', ev => {
    alwaysLabels = ev.target.checked;
    draw();
  });
  document.getElementById('opt-linkmode').addEventListener('change', ev => {
    linkMode = ev.target.checked;
    if (!linkMode) { selected = []; updateLinkPanel(); draw(); }
  });
  document.getElementById('graph-search').addEventListener('input', ev => {
    searchTerm = ev.target.value.trim().toLowerCase();
    draw();
  });

  // ── Manual link panel ────────────────────────────────────────────────────
  const linkPanel   = document.getElementById('link-panel');
  const linkNames   = document.getElementById('link-names');
  const linkConfirm = document.getElementById('link-confirm');
  const linkRel     = document.getElementById('link-relation');

  function existingManualLink(a, b) {
    return allLinks.find(l => l.manual && (
      (l.source === a.id && l.target === b.id) || (l.source === b.id && l.target === a.id)
    ));
  }

  function updateLinkPanel() {
    if (!selected.length) { linkPanel.style.display = 'none'; return; }
    linkPanel.style.display = 'block';
    linkNames.innerHTML = selected.map(n => escapeHtml(n.label)).join(' ↔ ') +
      (selected.length < 2 ? ' <span class="ln-placeholder">↔ shift-click another node…</span>' : '');
    if (selected.length < 2) {
      linkConfirm.disabled = true;
      linkConfirm.textContent = 'Select a second node';
      linkConfirm.classList.remove('danger');
      linkRel.style.display = 'block';
      return;
    }
    const existing = existingManualLink(selected[0], selected[1]);
    linkConfirm.disabled = false;
    if (existing) {
      linkConfirm.textContent = 'Remove forced link';
      linkConfirm.classList.add('danger');
      linkRel.style.display = 'none';
    } else {
      linkConfirm.textContent = 'Link these';
      linkConfirm.classList.remove('danger');
      linkRel.style.display = 'block';
    }
  }

  async function postJSON(url, body) {
    const r = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(data.error || ('HTTP ' + r.status));
    return data;
  }

  linkConfirm.addEventListener('click', async () => {
    if (selected.length < 2) return;
    const [a, b] = selected;
    linkConfirm.disabled = true;
    linkConfirm.textContent = 'Saving…';
    try {
      if (existingManualLink(a, b)) {
        await postJSON('/api/graph/unlink', { from: a.id, to: b.id });
      } else {
        const relation = document.querySelector('input[name="link-rel"]:checked').value;
        await postJSON('/api/graph/link', { from: a.id, to: b.id, relation });
      }
      window.location.reload();
    } catch (e) {
      linkConfirm.disabled = false;
      linkConfirm.textContent = 'Failed — retry';
      document.getElementById('link-note').textContent = e.message;
    }
  });

  document.getElementById('link-clear').addEventListener('click', () => {
    selected = [];
    updateLinkPanel();
    draw();
  });

  function updateStats() {
    document.getElementById('graph-stats').textContent =
      nodes.length + ' nodes · ' + links.length + ' links shown (' +
      allNodes.length + ' / ' + allLinks.length + ' total)';
  }

  function escapeHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // ── Go ───────────────────────────────────────────────────────────────────
  resize();
  applyFilters();
  loading.remove();
})();
</script>
</body>
</html>
