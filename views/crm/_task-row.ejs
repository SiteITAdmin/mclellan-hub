  <div class="rowcard task-row" data-async-row>
    <% if (task.status !== 'deleted') { %><form method="post" action="/crm/<%= space %>/tasks/<%= task.id %>/<%= task.status === 'completed' ? 'reopen' : 'complete' %>" data-async="toggle-task">
      <input type="hidden" name="revision" value="<%= task.revision %>"><input type="hidden" name="back" value="<%= taskBack %>">
      <button class="task-check<%= task.status === 'completed' ? ' is-done' : '' %>" aria-label="<%= task.status === 'completed' ? 'Reopen' : 'Complete' %> <%= task.title %>"><span aria-hidden="true">✓</span></button>
    </form><% } else { %><span aria-hidden="true">—</span><% } %>
    <div class="main"><a class="what" href="/crm/<%= space %>/tasks/<%= task.id %>"><%= task.title %></a>
      <div class="meta"><%= [...task.people, ...task.organisations, ...task.projects].map(x => x.name).join(' · ') || 'No context yet' %><% if (task.meeting) { %> · waiting for meeting<% } %></div>
      <%- include('_help-line', { h: task.help, taskId: task.id }) %>
      <% if (locals.quickDates && task.status === 'needsAction' && (!task.due || task.due < todayDate)) { %>
      <form class="quick-date-row" method="post" action="/crm/<%= space %>/tasks/review" data-async="reload">
        <input type="hidden" name="task" value="<%= task.id %>">
        <input type="hidden" name="revision" value="<%= task.revision %>">
        <input type="hidden" name="back" value="<%= taskBack %>">
        <% for (const [k, lbl] of [['today', 'Today'], ['tomorrow', 'Tomorrow'], ['nextweek', 'Next week']]) { %><button class="link-btn" type="submit" name="do" value="<%= k %>"><%= lbl %></button><% } %>
      </form>
      <% } %>
      <% if (task.sync_error || task.conflict) { %><div class="task-warning"><%= task.sync_error || 'Both copies changed — review the saved versions' %></div><% } %>
    </div>
    <div class="end"><span class="when <%= task.status === 'needsAction' && task.due && task.due < todayDate ? 'late' : '' %>"><%= task.due || 'No due date' %></span><small><%= task.pending ? 'Waiting to sync' : 'Synced' %></small></div>
  </div>
