<%# Waiting for a meeting: t.meeting is the task's state, meetingChoices the upcoming calendar entries. %>
<% const m = t.meeting; const post = `/crm/${space}/tasks/${t.id}/meeting`; const hid = `<input type="hidden" name="back" value="${back}">`; %>
<% if (m && m.state === 'linked') { %>
  <p class="meeting-wait"><span class="cal-tag">After a meeting</span> <%= m.title %>, <%= m.when %><%= m.past ? ' (held)' : '' %>.<% if (!m.past) { %> Not planned before it ends; the due date follows it if it moves.<% } %></p>
  <form method="post" action="<%= post %>" class="acts review-form"><%- hid %><button class="btn small text" name="do" value="release">No longer waits for this meeting</button></form>
<% } else { %>
  <% if (m) { %><p class="meeting-wait"><span class="cal-tag warn">Needs a meeting first</span> <%= m.lost ? `“${m.title}” has gone from your calendar. ` : '' %>Held out of your calendar until it is linked to a booked meeting.<% if (m.arrange) { %> <a href="/crm/<%= space %>/tasks/<%= m.arrange.id %>"><%= m.arrange.status === 'needsAction' ? m.arrange.title : 'The task to arrange it is ticked: link the meeting below' %></a><% } %></p><% } %>
  <% if (t.origin !== 'meeting') { %>
  <form method="post" action="<%= post %>" class="acts review-form"><%- hid %>
    <% if (meetingChoices.length) { %><select class="select" name="event" required aria-label="Meeting that <%= t.title %> waits for"><option value="">Wait for a meeting…</option><% for (const e of meetingChoices) { %><option value="<%= e.id %>"><%= e.label %></option><% } %></select>
    <button class="btn small" name="do" value="link">Due after this meeting</button><% } else { %><span class="subline">No meetings in your calendar for the next 30 days.</span><% } %>
  </form>
  <form method="post" action="<%= post %>" class="acts review-form"><%- hid %>
    <% if (!m) { %><button class="btn small text" name="do" value="hold" title="Holds it out of your calendar and adds a task to arrange the meeting">Needs a meeting that isn't booked yet</button>
    <% } else { %><button class="btn small text" name="do" value="release">Doesn't need a meeting after all</button><% } %>
  </form>
  <% } %>
<% } %>
