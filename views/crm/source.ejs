<%- include('_top') %>
<% const quoted = s.text.length > (s.text_fresh || '').length ? s.text.slice((s.text_fresh || '').length).trim() : ''; %>
<div class="crumbs"><a href="/crm/<%= space %>/captured">Captured</a> / <%= s.origin === 'krisp' ? 'Krisp transcript' : s.kind === 'note' ? 'Note' : s.kind === 'whatsapp' ? 'WhatsApp' : s.kind === 'calendar' ? 'Calendar entry' : 'Email' %></div>
<div class="title-row"><div><h1><%= s.title %></h1>
  <p class="subline"><%= fmt(s.occurred_at) %><%= s.origin === 'outlook' ? ', Outlook' : s.origin === 'whatsapp' ? ', WhatsApp' : s.origin === 'gmail' ? ', Gmail' : String(s.origin).startsWith('gmail:') ? `, ${s.origin.slice(6)}` : '' %><%= s.direction === 'out' ? ', sent by you' : s.direction === 'in' ? ', received' : '' %>. <%- include('_state', { s }) %></p></div>
  <div class="form-row" style="flex-wrap:nowrap">
  <% if (s.atomise_status === 'failed' || !s.readable) { %><form method="post" action="/crm/<%= space %>/sources/<%= s.id %>/retry"><button class="btn" type="submit">Read again</button></form><% } %>
  <% if (s.atomise_status !== 'queued' && !(s.origin === 'calendar' && s.atomise_status === 'ignored')) { %><form method="post" action="/crm/<%= space %>/sources/<%= s.id %>/move-space"><button class="btn" type="submit" title="Its facts are taken back and it is read again in the other space">Move to <%= space === 'work' ? 'Personal' : 'Work' %></button></form><% } %>
  </div>
</div>
<% if (s.space_by) { const sp = space === 'work' ? 'Work' : 'Personal'; %>
<p class="subline space-why"><%= s.space_by === 'ask' ? `Under ${sp} for now: Claude decides Work or Personal when it reads this.`
  : s.space_by === 'clues' ? `In ${sp} because ${s.space_why}.`
  : s.space_why ? `In ${sp}: ${s.space_why}.` : '' %></p>
<% } %>
<section class="grid first">
  <div class="s8" style="display:flex;flex-direction:column;gap:var(--gap)">
    <div class="panel">
      <div class="panel-head"><h2>Facts from this</h2><span class="chip"><%= s.atoms.length %></span></div>
      <% if (!s.atoms.length) { %><div class="empty"><%= s.atomise_status === 'done' ? 'Nothing in this worth remembering, according to Claude.' : 'Not read yet.' %></div><% } %>
      <% for (const a of s.atoms) { %><%- include('_atom', { a }) %><% } %>
    </div>
    <div class="panel">
      <div class="panel-head"><h2>Text</h2></div>
      <div class="source-text"><%= s.text_fresh || s.text %></div>
      <% if (quoted) { %><details style="margin-top:14px"><summary>Earlier in the thread</summary><div class="source-text quoted" style="margin-top:8px"><%= quoted.slice(0, 20000) %></div></details><% } %>
    </div>
  </div>
  <div class="s4 side-stack">
    <div class="panel">
      <div class="panel-head"><h2>People</h2></div>
      <% if (!s.addresses.length) { %><div class="empty"><%= s.kind === 'calendar' ? 'No attendees listed.' : 'Your own note.' %></div><% } %>
      <dl class="kv" style="margin:0">
      <% for (const a of s.addresses) { %>
        <div class="kv-row"><dt><%= a.role === 'from' ? 'From' : a.role === 'to' ? 'To' : 'Copy' %></dt>
          <dd><% if (a.person_id && a.person_space === space) { %><a class="who-link" href="/crm/<%= space %>/people/<%= a.person_id %>"><%= a.person_name %></a><% } else { %><%= a.name || a.value %><% } %><small><%= a.value %><%= a.id_status === 'ignored' ? ', not a person' : (!a.person_id ? ', not decided' : '') %></small></dd></div>
      <% } %>
      </dl>
    </div>
    <% if (speakers && speakers.labels.length) { %>
    <div class="panel">
      <div class="panel-head"><h2>Speaker names</h2></div>
      <p class="subline">Correct a speaker after the meeting was read. The original recording and the exact words stay as they were; facts, promises and tasks already made are updated in place.</p>
      <form method="post" action="/crm/<%= space %>/sources/<%= s.id %>/speaker-names">
      <% speakers.labels.forEach((speaker, i) => { %>
        <label for="speaker-name-<%= i %>"><%= speaker.label %><%= speaker.placeholder ? ' (not named yet)' : '' %></label>
        <input id="speaker-name-<%= i %>" name="name" value="<%= speaker.label %>" maxlength="80" autocomplete="off">
        <input type="hidden" name="label" value="<%= speaker.label %>">
      <% }) %>
      <p class="subline">Type the confirmed name over the label you want to change, then save. A label left as it is, or a box left empty, stays as it is.</p>
      <% if (speakers.labels.length > 1) { %><label><input type="checkbox" name="merge" value="1"> Some of these are the same person: let two speakers share one name (this can't be undone)</label><% } %>
      <% if (speakers.otherSpace) { %><p class="subline"><%= speakers.otherSpace === 1 ? 'One part' : speakers.otherSpace + ' parts' %> of this meeting moved to the other space <%= speakers.otherSpace === 1 ? 'is' : 'are' %> not changed from here.</p><% } %>
      <button class="btn" type="submit">Save speaker names</button>
      </form>
    </div>
    <% } %>
  </div>
</section>
<p><a class="btn" href="/crm/<%= space %>/tasks/new?sourceId=<%= s.id %>">Add a task from this source</a></p>

<% if (s.origin === "krisp") { %><details><summary>Original Krisp delivery</summary><pre style="white-space:pre-wrap"><%= /^krisp-intake:[a-f0-9]{64}$/.test(s.raw_ref || '') ? (krispRaw || 'Original delivery unavailable') : s.raw_ref %></pre></details><% } %>
<%- include('_bottom') %>
