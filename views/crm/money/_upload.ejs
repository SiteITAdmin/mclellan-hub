<%# The upload card. Pass `accounts` (names used before) and `limits` ({ files, readBytes }). %>
<form method="post" action="<%= base %>/upload" enctype="multipart/form-data" class="money-upload" id="money-upload">
  <label class="money-drop" id="money-drop" for="money-files">
    <strong>Drop banking screenshots here, or tap to choose</strong>
    <span>Up to <%= limits.files %> at a time, all from the same account. PNG or JPEG.</span>
    <span class="money-picked" id="money-picked" aria-live="polite"></span>
  </label>
  <input class="sr-only" type="file" id="money-files" name="images" accept="image/png,image/jpeg,image/webp" multiple required>
  <div class="form-row">
    <div class="field money-account"><label for="money-account">Account</label>
      <input class="input" type="text" id="money-account" name="account" list="money-accounts" maxlength="60" placeholder="e.g. AIB current, Revolut, Credit union" autocomplete="off" required>
      <datalist id="money-accounts"><% for (const a of accounts) { %><option value="<%= a %>"></option><% } %></datalist></div>
    <button class="btn primary" type="submit" id="money-send">Upload and read</button>
  </div>
  <p class="subline money-small">Use the same account name every time: it is how the same line on two overlapping screenshots is recognised and counted once. The picture is deleted 30 days after it is read; only the rows are kept.</p>
</form>
<script>
(() => {
  const form = document.getElementById('money-upload'), input = document.getElementById('money-files'), drop = document.getElementById('money-drop');
  const picked = document.getElementById('money-picked'), send = document.getElementById('money-send');
  const MAX_SIDE = 2400, TARGET = 2250000, MAX_FILES = <%= limits.files %>;
  const show = () => { const n = input.files.length; picked.textContent = n ? `${n} ${n === 1 ? 'screenshot' : 'screenshots'} chosen` : ''; };
  input.addEventListener('change', show);
  for (const type of ['dragenter', 'dragover']) drop.addEventListener(type, e => { e.preventDefault(); drop.classList.add('is-over'); });
  for (const type of ['dragleave', 'drop']) drop.addEventListener(type, e => { e.preventDefault(); drop.classList.remove('is-over'); });
  drop.addEventListener('drop', e => {
    try { const dt = new DataTransfer(); for (const f of [...e.dataTransfer.files].filter(f => f.type.startsWith('image/')).slice(0, MAX_FILES)) dt.items.add(f); input.files = dt.files; show(); }
    catch (_) { picked.textContent = 'This browser cannot take dropped files. Tap to choose them instead.'; }
  });

  const blobFrom = (canvas, quality) => new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', quality));
  // Phone screenshots are several megabytes; the reader takes about three. Shrink to 2400px on the long side, then lower the JPEG quality until it fits.
  async function shrink(file) {
    if (file.size <= TARGET && file.type !== 'image/webp') return file;
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, MAX_SIDE / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale); canvas.height = Math.round(bitmap.height * scale);
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    for (const quality of [0.92, 0.85, 0.78, 0.7, 0.6]) {
      const blob = await blobFrom(canvas, quality);
      if (blob && blob.size <= TARGET) return new File([blob], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' });
    }
    return file;
  }

  let ready = false;
  form.addEventListener('submit', async e => {
    if (ready || !input.files.length) return;
    e.preventDefault();
    send.disabled = true; send.textContent = 'Preparing…';
    try {
      const dt = new DataTransfer();
      for (const file of [...input.files].slice(0, MAX_FILES)) { let out = file; try { out = await shrink(file); } catch (_) {} dt.items.add(out); }
      input.files = dt.files;
    } catch (_) { /* the originals go up as they are */ }
    ready = true; send.textContent = 'Uploading…';
    form.submit();
  });
})();
</script>
