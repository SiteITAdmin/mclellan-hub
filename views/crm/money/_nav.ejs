<%# Sub-navigation shared by every Money screen. Pass `tab`: overview | transactions | receipts | subscriptions | offers | challenge. %>
<nav class="money-nav" aria-label="Money">
  <% [['overview','Overview','/crm/personal/money'],['transactions','Transactions','/crm/personal/money/transactions'],['receipts','Receipts','/crm/personal/money/receipts'],['subscriptions','Subscriptions','/crm/personal/money/subscriptions'],['offers','Offers & codes','/crm/personal/money/offers'],['challenge','Challenge','/crm/personal/money/challenge']].forEach(([key,label,href]) => { %>
    <a href="<%= href %>" <%- tab === key ? 'aria-current="page"' : '' %>><%= label %></a>
  <% }) %>
</nav>
