<%- include('../_top') %>
<div class="title-row"><div><h1>Money</h1><p class="subline">Personal only. Built from the banking screenshots you upload: no bank is connected, and nothing here is bought, cancelled or sent.</p></div></div>
<%- include('_nav') %>
<% if (problems.length) { %>
<div class="status-list money-problems" role="alert">
  <% for (const p of problems) { %><div class="status-item bad"><strong><%= p.module[0].toUpperCase() + p.module.slice(1) %>:</strong> <%= p.text %></div><% } %>
</div>
<% } %>
<% const state = { pending: 'Waiting its turn', queued: 'Being read', done: 'Read', failed: 'Could not be read', empty: 'Nothing found' }; %>
<% const checking = o.toCheck.reduce((n, g) => n + g.rows.length, 0); %>

<section class="grid <%= problems.length ? '' : 'first' %>">
  <div class="panel <%= o.hasData ? 's6' : 's12' %>">
    <div class="panel-head"><h2>Upload screenshots</h2><% if (o.waiting) { %><span class="chip"><%= o.waiting %> being read</span><% } %></div>
    <% if (!o.hasData) { %><div class="empty money-start"><strong>Nothing to show yet.</strong> Start with a screenshot of each account’s transaction list for the last month or two: scroll, screenshot, scroll, screenshot. Overlaps are fine; the same line is only counted once. The Mac reads each one in a few minutes, and the rows then wait below for you to check against the picture.</div><% } %>
    <%- include('_upload', { accounts: o.accounts, limits }) %>
  </div>
  <% if (o.hasData) { const diff = o.month.total_cents - o.lastMonthSameDays.total_cents; %>
  <div class="panel s6">
    <div class="panel-head"><h2><%= o.monthName %> so far</h2><a class="end" href="<%= base %>/transactions">All transactions</a></div>
    <p class="money-big"><%= eur(o.month.total_cents) %></p>
    <p class="money-compare">
      <% if (!o.lastMonthHeld) { %>Nothing is held for <%= o.lastMonthName %>, so there is no comparison yet. Upload that month’s screenshots to get one.
      <% } else if (diff > 0) { %><strong class="money-up"><%= eur(diff) %> more</strong> than the first <%= o.dayOfMonth %> <%= o.dayOfMonth === 1 ? 'day' : 'days' %> of <%= o.lastMonthName %> (<%= eur(o.lastMonthSameDays.total_cents) %>).
      <% } else if (diff < 0) { %><strong><%= eur(-diff) %> less</strong> than the first <%= o.dayOfMonth %> <%= o.dayOfMonth === 1 ? 'day' : 'days' %> of <%= o.lastMonthName %> (<%= eur(o.lastMonthSameDays.total_cents) %>).
      <% } else { %>The same as the first <%= o.dayOfMonth %> <%= o.dayOfMonth === 1 ? 'day' : 'days' %> of <%= o.lastMonthName %>.<% } %>
    </p>
    <p class="subline money-small"><%= o.month.count %> <%= o.month.count === 1 ? 'payment' : 'payments' %> counted. Transfers between your own accounts and income are left out.<% if (o.unchecked) { %> <a href="#check"><%= o.unchecked %> <%= o.unchecked === 1 ? 'row is' : 'rows are' %> unchecked</a>: counted, but not yet compared with the screenshot.<% } %> Only what you have uploaded is here, so a missing screenshot is missing spending.</p>
  </div>
  <% } %>
</section>

<% if (o.toCheck.length) { %>
<section class="grid" id="check" aria-label="To check"><div class="panel s12">
  <div class="panel-head"><h2>To check</h2><span class="chip"><%= checking %> <%= checking === 1 ? 'row' : 'rows' %></span></div>
  <p class="subline money-small">Compare each list with its screenshot. These rows already count in the totals; confirming them says the reader got them right.</p>
  <% for (const g of o.toCheck) { const unsure = g.rows.filter(r => r.unsure).length; %>
  <div class="money-check">
    <div class="money-shot">
      <% if (g.upload?.has_image) { %><a href="<%= base %>/uploads/<%= g.upload.id %>/image" target="_blank" rel="noopener"><img src="<%= base %>/uploads/<%= g.upload.id %>/image" alt="The screenshot these rows were read from" loading="lazy"></a>
      <% } else { %><div class="empty"><%= g.upload ? 'The picture is no longer held (it is removed 30 days after reading).' : 'The screenshot these rows came from was deleted.' %></div><% } %>
    </div>
    <div class="money-check-rows">
      <div class="money-check-head">
        <div><strong><%= g.upload?.account || g.rows[0].account || 'No account name' %></strong><% if (g.upload) { %><span class="money-tx-meta"> · uploaded <%= fmt(g.upload.created_at) %><%= g.upload.read_by ? ` · read by ${g.upload.read_by}` : '' %></span><% } %></div>
        <% if (g.upload && g.rows.length > unsure) { %><form class="inline-form" method="post" action="<%= base %>/uploads/<%= g.upload.id %>/confirm"><input type="hidden" name="back" value="<%= base %>#check"><button class="btn primary small" type="submit">These match the screenshot</button></form><% } %>
      </div>
      <% if (unsure) { %><p class="money-why"><%= unsure %> <%= unsure === 1 ? 'row is' : 'rows are' %> marked: the reader was not sure of <%= unsure === 1 ? 'it' : 'them' %>. The button above leaves <%= unsure === 1 ? 'that one' : 'those' %> for you to check one at a time.</p><% } %>
      <% if (g.upload?.note) { %><p class="subline money-small"><%= g.upload.note %></p><% } %>
      <%- include('_review', { rows: g.rows, back: `${base}#check` }) %>
    </div>
  </div>
  <% } %>
</div></section>
<% } %>

<% if (o.hasData) { %>
<section class="grid">
  <div class="panel s8">
    <div class="panel-head"><h2>Where <%= o.monthName %> went</h2></div>
    <% if (!o.categories.length) { %><div class="empty">No spending is held for <%= o.monthName %> yet. Upload this month’s screenshots.</div><% } %>
    <div class="money-bars">
    <% for (const c of o.categories) { %>
      <a class="money-bar" href="<%= base %>/transactions?month=<%= o.today.slice(0, 7) %>&amp;category=<%= encodeURIComponent(c.category) %>">
        <span class="money-bar-label"><%= c.category %></span>
        <span class="money-bar-track"><span class="money-bar-fill" style="width:<%= Math.max(1, Math.round(c.total_cents / o.categoryMax * 100)) %>%"></span></span>
        <span class="money-bar-value"><%= eur(c.total_cents) %><small><%= Math.round(c.total_cents / Math.max(1, o.month.total_cents) * 100) %>% · <%= c.count %></small></span>
      </a>
    <% } %>
    </div>
  </div>
  <div class="panel s4">
    <div class="panel-head"><h2>Top merchants this month</h2></div>
    <% if (!o.merchants.length) { %><div class="empty">Nothing yet this month.</div><% } %>
    <div class="topics-list">
      <% for (const m of o.merchants) { %><a class="topic-row" href="<%= base %>/transactions?month=<%= o.today.slice(0, 7) %>&amp;q=<%= encodeURIComponent(m.merchant) %>"><span><%= m.merchant %><small class="money-tx-meta"> <%= m.count %>×</small></span><span class="n"><%= eur(m.total_cents) %></span></a><% } %>
    </div>
  </div>
</section>

<section class="grid">
  <div class="panel s12">
    <div class="panel-head"><h2>Last six months</h2><% if (o.oldest) { %><span class="chip">records start <%= dayLabel(o.oldest) %></span><% } %></div>
    <div class="money-months">
      <% for (const m of o.months) { %>
      <a class="money-month" href="<%= base %>/transactions?month=<%= m.month %>">
        <span class="money-month-value"><%= m.total_cents ? eur(m.total_cents) : '—' %></span>
        <span class="money-month-track"><span class="money-month-fill<%= m.partial ? ' is-partial' : '' %>" style="height:<%= m.total_cents ? Math.max(3, Math.round(m.total_cents / o.monthMax * 100)) : 0 %>%"></span></span>
        <span class="money-month-label"><%= m.label %><%= m.partial ? ' so far' : '' %></span>
      </a>
      <% } %>
    </div>
    <p class="subline money-small">A dash means nothing is held for that month, not that nothing was spent.</p>
  </div>
</section>
<% } %>

<% if (cards.length) { %>
<section class="grid" aria-label="Other money tools">
  <% for (const c of cards) { %>
  <div class="panel s4 money-card<%= c.error ? ' is-bad' : '' %>">
    <div class="panel-head"><h2><%= c.title %></h2><% if (c.href) { %><a class="end" href="<%= c.href %>">Open</a><% } %></div>
    <% for (const line of c.lines || []) { %><p><%= line %></p><% } %>
  </div>
  <% } %>
</section>
<% } %>

<% if (o.uploads.length) { %>
<section class="grid"><details class="panel s12" <%= o.uploads.some(u => u.status === 'failed') ? 'open' : '' %>>
  <summary>Screenshots (<%= o.uploads.length %>)</summary>
  <% for (const u of o.uploads) { %>
  <div class="vendor-line">
    <div class="main">
      <div class="what"><%= u.account || 'No account name' %> <span class="pill <%= u.status === 'failed' ? 'neg' : u.status === 'empty' ? 'warn' : 'neutral' %>"><%= state[u.status] %></span></div>
      <div class="meta">Uploaded <%= fmt(u.created_at) %><%= u.filename ? ` · ${u.filename}` : '' %>
        <% if (u.status === 'done') { %> · <%= u.found %> <%= u.found === 1 ? 'line' : 'lines' %> read, <%= u.added %> new<%= u.period_from ? ` · ${dayLabel(u.period_from)} to ${dayLabel(u.period_to)}` : '' %><% } %>
        <%= u.read_by ? ` · read by ${u.read_by}` : '' %><%= u.attempts && ['pending', 'queued'].includes(u.status) ? ` · try ${u.attempts + 1}` : '' %><%= u.has_image ? '' : ' · picture removed' %></div>
      <% if (u.error) { %><div class="meta <%= u.status === 'failed' ? 'money-err' : '' %>"><%= u.error %></div><% } %>
      <% if (u.note) { %><div class="meta"><%= u.note %></div><% } %>
    </div>
    <% if (u.has_image) { %><a class="btn text small" href="<%= base %>/uploads/<%= u.id %>/image" target="_blank" rel="noopener">View</a><% } %>
    <% if (u.has_image && u.status !== 'queued' && u.status !== 'pending') { %><form class="inline-form" method="post" action="<%= base %>/uploads/<%= u.id %>/retry"><button class="btn small" type="submit">Read again</button></form><% } %>
    <form class="inline-form money-delete" method="post" action="<%= base %>/uploads/<%= u.id %>/delete">
      <% if (u.held) { %><label><input type="checkbox" name="rows" value="delete"> and its <%= u.held %> <%= u.held === 1 ? 'row' : 'rows' %></label><% } %>
      <button class="btn text small money-del" type="submit">Delete</button>
    </form>
  </div>
  <% } %>
</details></section>
<% } %>
<%- include('../_bottom') %>
