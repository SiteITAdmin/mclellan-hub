<%- include('_top') %>
<% const qs = (extra = {}) => {
     const p = new URLSearchParams();
     const st = extra.status !== undefined ? extra.status : status;
     const fl = extra.filter !== undefined ? extra.filter : filter;
     if (st && st !== 'needsAction') p.set('status', st);
     if (st === 'needsAction' && fl) p.set('filter', fl);
     if (q) p.set('q', q);
     if (projectId) p.set('projectId', projectId);
     if (personId) p.set('personId', personId);
     const s = p.toString();
     return `/crm/${space}/tasks${s ? `?${s}` : ''}`;
   };
   const currentBack = qs(); %>
<div class="title-row">
  <div>
    <h1>Tasks</h1>
    <p class="subline"><%= space === 'work' ? 'Work' : 'Personal' %> tasks, synced with Google every 15 minutes. Last sync: <%= sync?.last_ok ? ago(sync.last_ok) : 'not yet' %>.</p>
  </div>
  <div class="acts">
    <form class="inline-form" method="post" action="/crm/<%= space %>/tasks/sync"><button class="btn small">Sync now</button></form>
    <a class="btn small" href="/crm/<%= space %>/tasks/review">Review dates<% if (reviewCounts.late || reviewCounts.undated) { %> (<%= reviewCounts.late + reviewCounts.undated %>)<% } %></a>
    <a class="btn primary" href="/crm/<%= space %>/tasks/new"><%- icon.plus %> Add a task</a>
  </div>
</div>

<div class="task-toolbar">
  <nav class="task-tabs" aria-label="Task filter">
    <a href="<%= qs({ status: 'needsAction', filter: '' }) %>" <%- status === 'needsAction' && !filter ? 'aria-current="page"' : '' %>>Open</a>
    <a href="<%= qs({ status: 'needsAction', filter: 'overdue' }) %>" <%- status === 'needsAction' && filter === 'overdue' ? 'aria-current="page"' : '' %>>Due / Overdue<% if (reviewCounts.late) { %> (<%= reviewCounts.late %>)<% } %></a>
    <a href="<%= qs({ status: 'needsAction', filter: 'undated' }) %>" <%- status === 'needsAction' && filter === 'undated' ? 'aria-current="page"' : '' %>>No date<% if (reviewCounts.undated) { %> (<%= reviewCounts.undated %>)<% } %></a>
    <a href="<%= qs({ status: 'needsAction', filter: 'meeting' }) %>" <%- status === 'needsAction' && filter === 'meeting' ? 'aria-current="page"' : '' %>>Waiting for meeting</a>
    <a href="<%= qs({ status: 'completed', filter: '' }) %>" <%- status === 'completed' ? 'aria-current="page"' : '' %>>Completed</a>
    <a href="<%= qs({ status: 'deleted', filter: '' }) %>" <%- status === 'deleted' ? 'aria-current="page"' : '' %>>Deleted</a>
  </nav>
</div>

<form class="tasks-filters form-row" method="get" action="/crm/<%= space %>/tasks" role="search">
  <% if (status !== 'needsAction') { %><input type="hidden" name="status" value="<%= status %>"><% } %>
  <% if (filter) { %><input type="hidden" name="filter" value="<%= filter %>"><% } %>
  <input class="input" name="q" value="<%= q %>" placeholder="Filter tasks…" aria-label="Search tasks">
  <select class="select" name="projectId" aria-label="Filter by project">
    <option value="">All projects</option>
    <% for (const p of choices.projectId || []) { %><option value="<%= p.id %>" <%= projectId === p.id ? 'selected' : '' %>><%= p.name %></option><% } %>
  </select>
  <select class="select" name="personId" aria-label="Filter by person">
    <option value="">All people</option>
    <% for (const p of choices.personId || []) { %><option value="<%= p.id %>" <%= personId === p.id ? 'selected' : '' %>><%= p.name %></option><% } %>
  </select>
  <button class="btn small" type="submit">Filter</button>
  <% if (q || projectId || personId || filter) { %><a class="btn text small" href="/crm/<%= space %>/tasks">Clear</a><% } %>
</form>

<% if (sync?.last_error) { %><p class="flash bad" role="status"><%= sync.last_error %></p><% } %>
<section class="grid first"><div class="panel s12"><%- include('_tasks', { taskList: list, taskBack: currentBack, quickDates: status === 'needsAction' ? dates : null }) %></div></section>
<%- include('_bottom') %>
