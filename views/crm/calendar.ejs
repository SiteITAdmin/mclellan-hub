<%- include('_top') %>
<% const S = 7 * 60, E = 22 * 60, span = E - S;
   const clamp = m => Math.min(E, Math.max(S, m));
   const pos = i => `--top:${((clamp(i.from) - S) / span * 100).toFixed(2)}%;--h:${((clamp(i.until) - clamp(i.from)) / span * 100).toFixed(2)}%`;
   const label = space === 'work' ? 'Work' : 'Personal';
   const dayName = d => new Date(`${d.date}T12:00:00Z`).toLocaleDateString('en-IE', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
   const nowLocal = (() => { const p = new Date().toLocaleTimeString('en-GB', { timeZone: 'Europe/Dublin', hour: '2-digit', minute: '2-digit', hour12: false }).split(':'); return Number(p[0]) % 24 * 60 + Number(p[1]); })();
   const run = state.run;
   const failed = run && run.last_error && (!run.last_ok || run.last_error_at >= run.last_ok);
   const name = s => s === 'work' ? 'Work' : 'Personal';
   const pops = [];
   const own = days.flatMap(d => [...d.items.filter(i => i.type === 'event'), ...d.banners.map(b => ({ ...b, start: b.start_at, end: b.end_at }))].map(i => ({ ...i, date: d.date }))).filter((i, n, all) => all.findIndex(x => x.id === i.id) === n); %>
<div class="title-row">
  <div><h1>Calendar</h1><p class="subline"><%= label %>. Both your Work and Personal diaries are shown here. Tasks are planned into your free time and move by themselves when your diary changes. Planned <%= state.plannedAt ? ago(state.plannedAt) : 'not yet' %>; Google Calendar last updated <%= run?.last_ok ? ago(run.last_ok) : 'not yet' %>.</p></div>
  <div class="form-row">
    <% if (earlier) { %><a class="btn small" href="/crm/<%= space %>/calendar?from=<%= earlier %>">Earlier</a><% } %>
    <% if (later) { %><a class="btn small" href="/crm/<%= space %>/calendar?from=<%= later %>">Later</a><% } %>
    <a class="btn small" href="/crm/<%= space %>/calendar">Today</a>
    <form method="post" action="/crm/<%= space %>/calendar/replan"><button class="btn small">Replan now</button></form>
  </div>
</div>
<% if (failed) { %><p class="flash bad" role="status" style="margin-top:20px"><%= run.last_error %></p><% } %>

<section class="grid first"><div class="panel s12">
  <div class="cal" role="group" aria-label="Seven days from <%= dayName(days[0]) %>">
    <div class="cal-hours" aria-hidden="true"><% for (let h = 7; h < 22; h += 1) { %><span><%= String(h).padStart(2, '0') %>:00</span><% } %></div>
    <% for (const d of days) { %>
    <div class="cal-day<%= d.date === today ? ' is-today' : '' %>">
      <h2 class="cal-head"><%= d.date === today ? 'Today' : dayName(d) %></h2>
      <div class="cal-banners"><% for (const b of d.banners) { pops.push({ i: { ...b, start: b.start_at, end: b.end_at, detail: b.detail }, n: pops.length }); %><button type="button" class="cal-tag" data-pop="cal-pop-<%= pops.length - 1 %>" aria-haspopup="dialog"><%= b.title %></button><% } %><% if (notes[d.date]) { %><a class="cal-tag" href="#boox-notes" title="Handwritten on the Boox this day">Boox note</a><% } %></div>
      <div class="cal-col">
        <% if (d.window) { %><div class="cal-window" style="<%= pos({ from: d.window[0], until: d.window[1] }) %>"></div><% } %>
        <% if (d.date === today && nowLocal >= S && nowLocal <= E) { %><div class="cal-now" style="<%= pos({ from: nowLocal, until: nowLocal }) %>"></div><% } %>
        <% if (!d.items.length) { %><p class="cal-none">Nothing planned</p><% } %>
        <% for (const i of d.items) { const text = `${fmt(i.start, 'time')}–${fmt(i.end, 'time')} ${i.title}`; %>
          <% if (i.type === 'task') { %><a class="cal-item task<%= i.late ? ' late' : '' %><%= i.pinned ? ' pinned' : '' %>" data-space="<%= i.space %>" style="<%= pos(i) %>" href="/crm/<%= i.space %>/tasks/<%= i.id %>" title="<%= name(i.space) %> task: <%= text %><%= i.late ? ` (after it's due ${i.due})` : '' %><%= i.pinned ? ' (time chosen by you)' : '' %>"><span class="t"><%= fmt(i.start, 'time') %></span> <%= i.title %></a>
          <% } else if (i.type === 'event') { pops.push({ i, n: pops.length }); %><a class="cal-item event<%= i.flexible ? ' flexible' : '' %><%= i.free ? ' free' : '' %>" data-space="<%= i.space %>" style="<%= pos(i) %>" href="<%= i.link || '#' %>"<% if (i.link) { %> target="_blank" rel="noopener"<% } %> data-pop="cal-pop-<%= pops.length - 1 %>" aria-haspopup="dialog" title="<%= name(i.space) %>: <%= text %>"><span class="t"><%= fmt(i.start, 'time') %></span> <%= i.title %></a>
          <% } else { %><div class="cal-item <%= i.type %>" data-space="<%= i.space %>" style="<%= pos(i) %>" title="<%= name(i.space) %>: <%= text %>"><span class="t"><%= fmt(i.start, 'time') %></span> <%= i.title %></div><% } %>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
  <% const longDay = ts => new Date(ts * 1000).toLocaleDateString('en-IE', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Dublin' }); %>
  <% for (const { i, n } of pops) { const d = i.detail || { people: [], guests: [], transcripts: [], tasks: [], promises: [] }; %>
  <template id="cal-pop-<%= n %>">
    <div class="cal-pop-head"><span class="cal-pop-swatch" data-space="<%= i.space %>"></span><div><h2 class="cal-pop-title"><%= i.title %></h2>
      <p class="cal-pop-when"><%= longDay(i.start) %> · <%= fmt(i.start, 'time') %>–<%= fmt(i.end, 'time') %> <span class="cal-tag"><%= name(i.space) %></span></p></div></div>
    <% if (i.link) { %><p class="cal-pop-row"><a href="<%= i.link %>" target="_blank" rel="noopener">Open in Google Calendar</a></p><% } %>
    <div class="cal-pop-sec"><h3>People</h3>
      <% if (!d.people.length && !d.guests.length) { %><p class="cal-pop-none">Nobody else invited or mentioned</p><% } %>
      <% if (d.people.length) { %><ul><% for (const p of d.people) { %><li><a href="/crm/<%= p.space %>/people/<%= p.id %>"><%= p.name %></a><% if (p.via === 'Mentioned') { %> <small>mentioned</small><% } %></li><% } %></ul><% } %>
      <% if (d.guests.length) { %><p class="cal-pop-none">Not in the Hub: <%= d.guests.map(g => g.name || g.email).join(', ') %></p><% } %>
    </div>
    <div class="cal-pop-sec"><h3>Transcript</h3>
      <% if (!d.transcripts.length) { %><p class="cal-pop-none"><%= i.start > Date.now() / 1000 ? 'Not held yet' : 'None yet' %></p><% } %>
      <% if (d.transcripts.length) { %><ul><% for (const t of d.transcripts) { %><li><a href="/crm/<%= t.space %>/sources/<%= t.id %>"><%= t.title %></a> <small><%= fmt(t.occurred_at, 'time') %></small></li><% } %></ul><% } %>
    </div>
    <div class="cal-pop-sec"><h3>What happened</h3>
      <% if (!d.happened?.length) { %><p class="cal-pop-none">No transcript facts read yet. Open the transcript for the full record.</p><% } else { %>
      <ul><% for (const f of d.happened) { %><li><%= f.statement %> <a href="/crm/<%= f.source_space %>/sources/<%= f.source_id %>">Source</a></li><% } %></ul>
      <% } %>
    </div>
    <div class="cal-pop-sec"><h3>Tasks from this meeting</h3>
      <% if (!d.tasks.length) { %><p class="cal-pop-none"><%= d.promises.length ? 'None made yet' : 'None' %></p><% } %>
      <% if (d.tasks.length) { %><ul><% for (const t of d.tasks) { %><li<%- t.status === 'completed' ? ' class="done"' : '' %>><a href="/crm/<%= t.space %>/tasks/<%= t.id %>"><%= t.title %></a><% if (t.due) { %> <small>due <%= t.due %></small><% } %></li><% } %></ul><% } %>
    </div>
    <% if (d.promises.length) { %><div class="cal-pop-sec"><h3>Promised, no task yet</h3>
      <ul><% for (const p of d.promises) { %><li><%- include('_meeting-promise', { p, back: `/crm/${p.space}/calendar?from=${days[0].date}` }) %></li><% } %></ul>
    </div><% } %>
  </template>
  <% } %>
  <div class="cal-pop" id="cal-pop" role="dialog" aria-modal="false" aria-labelledby="cal-pop-label" hidden>
    <button class="cal-pop-close" type="button" aria-label="Close">×</button>
    <div class="cal-pop-body"></div>
  </div>
  <script>
  (() => {
    const pop = document.getElementById('cal-pop'), body = pop.querySelector('.cal-pop-body');
    let opener = null;
    const close = () => { if (pop.hidden) return; pop.hidden = true; opener?.focus(); opener = null; };
    const place = el => {
      const r = el.getBoundingClientRect(), w = pop.offsetWidth, h = pop.offsetHeight, vw = innerWidth, vh = innerHeight;
      let left = r.right + 8; if (left + w > vw - 8) left = r.left - w - 8; if (left < 8) left = Math.max(8, (vw - w) / 2);
      const top = Math.min(Math.max(8, r.top), Math.max(8, vh - h - 8));
      pop.style.left = `${left + scrollX}px`; pop.style.top = `${top + scrollY}px`;
    };
    document.addEventListener('click', e => {
      const el = e.target.closest('[data-pop]');
      if (el && !(e.metaKey || e.ctrlKey || e.shiftKey)) {
        e.preventDefault();
        if (opener === el && !pop.hidden) return close();
        body.replaceChildren(document.getElementById(el.dataset.pop).content.cloneNode(true));
        body.querySelector('.cal-pop-title')?.setAttribute('id', 'cal-pop-label');
        opener = el; pop.hidden = false; place(el); pop.querySelector('.cal-pop-close').focus();
        return;
      }
      if (!pop.hidden && !pop.contains(e.target)) close();
    });
    pop.querySelector('.cal-pop-close').addEventListener('click', close);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
    addEventListener('resize', close);
  })();
  </script>
  <p class="cal-key"><span class="cal-swatch task" data-space="work"></span> Work task <span class="cal-swatch task" data-space="personal"></span> Personal task <span class="cal-swatch event" data-space="work"></span> Work appointment <span class="cal-swatch event" data-space="personal"></span> Personal appointment <span class="cal-swatch window"></span> Your <%= label.toLowerCase() %> hours</p>
</div></section>

<section class="grid">
  <div class="panel s8">
    <div class="panel-head"><h2>Appointments</h2><span class="chip"><%= own.length %> in these 7 days</span></div>
    <% if (!own.length) { %><div class="empty">No appointments in these 7 days.</div><% } %>
    <div class="day-list">
    <% for (const e of own) { %>
      <div class="day-row event">
        <span class="t"><%= fmt(e.start, 'date') %> <%= fmt(e.start, 'time') %>–<%= fmt(e.end, 'time') %></span>
        <span class="what"><button class="btn small" type="button" data-pop="cal-pop-<%= pops.findIndex(p => p.i.id === e.id) %>" aria-haspopup="dialog"><%= e.title %></button></span>
        <span class="tags"><span class="cal-tag"><%= name(e.space) %></span>
        <% if (e.solo && !e.all_day && e.start > Date.now() / 1000) { %><form method="post" action="/crm/<%= space %>/calendar/flexible"><input type="hidden" name="event" value="<%= e.id %>"><input type="hidden" name="on" value="<%= e.flexible ? '0' : '1' %>"><button class="btn small" aria-pressed="<%= e.flexible %>"><%= e.flexible ? 'Flexible: the Hub may move it' : 'Fixed' %></button></form>
        <% } else { %><span class="cal-tag"><%= e.solo ? 'Fixed' : 'Fixed: others are invited' %></span><% } %>
        </span>
      </div>
    <% } %>
    </div>
    <p class="subline">An appointment stays put unless you make it flexible. A flexible one is moved in Google Calendar only when something fixed lands on top of it.<%= space === 'work' ? ' Your work diary is not connected yet, so every appointment here is from your personal calendar.' : '' %></p>
  </div>
  <div class="s4 side-stack">
    <div class="panel">
      <div class="panel-head"><h2>Needs a look</h2></div>
      <% if (!state.late.length && !state.unplanned.length) { %><div class="empty">Every open task fits before it is due.</div><% } %>
      <% for (const t of state.late) { %><p><a href="/crm/<%= space %>/tasks/<%= t.id %>"><%= t.title %></a><small class="task-via">Due <%= t.due %>, but the first free time ends <%= fmt(t.ends) %></small></p><% } %>
      <% for (const t of state.unplanned) { %><p><a href="/crm/<%= space %>/tasks/<%= t.id %>"><%= t.title %></a><small class="task-via">No free time in the next 14 days</small></p><% } %>
    </div>
    <div class="panel" id="boox-notes">
      <div class="panel-head"><h2>Boox notes</h2></div>
      <% const noted = days.filter(d => notes[d.date]); %>
      <% if (!noted.length) { %><div class="empty">Nothing handwritten in these 7 days. “New note” on the Boox app's calendar starts one for that day.</div><% } %>
      <% for (const d of noted) { for (const s of ['work', 'personal']) { const n = notes[d.date][s]; if (!n) continue; %>
      <p><strong><%= dayName(d) %></strong> <span class="cal-tag"><%= name(s) %></span>
        <% for (const src of n.sources) { %><br><a href="/crm/<%= s %>/sources/<%= src.id %>">Page <%= src.page %></a><% } %>
        <small class="task-via"><%= [n.waiting ? `${n.waiting} ${n.waiting === 1 ? 'page' : 'pages'} waiting to be read` : '', n.checking ? `${n.checking} to check` : '', n.failed ? `${n.failed} couldn't be read` : '', !n.sources.length && !n.waiting && !n.checking && !n.failed ? 'Nothing written on it yet' : ''].filter(Boolean).join(' · ') %><% if (n.checking || n.failed) { %> · <a href="/crm/notebooks">Open notebooks</a><% } %></small></p>
      <% } } %>
    </div>
    <details class="panel">
      <summary>Hours</summary>
      <form method="post" action="/crm/<%= space %>/calendar/hours" class="list" style="margin-top:14px">
        <% for (const [a, b, name] of [['workStart', 'workEnd', 'Work, Monday to Friday'], ['eveningStart', 'eveningEnd', 'Personal, weekday evenings'], ['weekendStart', 'weekendEnd', 'Personal, weekends']]) { %>
        <div class="field"><label for="h-<%= a %>"><%= name %></label><div class="form-row"><input class="input" type="time" id="h-<%= a %>" name="<%= a %>" value="<%= hours[a] %>" required aria-label="<%= name %> from"><input class="input" type="time" name="<%= b %>" value="<%= hours[b] %>" required aria-label="<%= name %> until"></div></div>
        <% } %>
        <div><button class="btn primary" type="submit">Save hours</button></div>
      </form>
    </details>
  </div>
</section>
<%- include('_bottom') %>
