<%- include('_top') %>
<div class="crumbs"><a href="/crm/<%= space %>/projects">Projects</a> / Not in a project</div>
<div class="title-row"><div><h1>Facts not in a project</h1><p class="subline"><%= total %> <%= total === 1 ? 'fact' : 'facts' %> in <%= space === 'work' ? 'Work' : 'Personal' %> <%= total === 1 ? 'isn’t' : 'aren’t' %> filed under any project, newest first. They are kept in full and still show on people, topics and search. File any of them here.</p></div></div>
<section class="grid first"><div class="panel s12">
  <% if (!list.length) { %><div class="empty">Every fact is in a project.</div><% } %>
  <% for (const a of list) { %>
    <%- include('_atom', { a }) %>
    <% if (projectChoices.length) { %><form class="file-row" method="post" action="/crm/<%= space %>/facts/<%= a.id %>/project-add">
      <input type="hidden" name="back" value="/crm/<%= space %>/facts?page=<%= pageNo %>">
      <label class="sr-only" for="f-<%= a.id %>">File under</label>
      <select class="select" id="f-<%= a.id %>" name="projectId" required><option value="">File under…</option><% for (const p of projectChoices) { %><option value="<%= p.id %>"><%= p.name %></option><% } %></select>
      <button class="btn small" type="submit">File</button>
    </form><% } %>
  <% } %>
  <div class="form-row" style="margin-top:16px">
    <% if (pageNo > 0) { %><a class="btn small" href="/crm/<%= space %>/facts?page=<%= pageNo - 1 %>">Newer</a><% } %>
    <% if ((pageNo + 1) * 50 < total) { %><a class="btn small" href="/crm/<%= space %>/facts?page=<%= pageNo + 1 %>">Older</a><% } %>
  </div>
</div></section>
<%- include('_bottom') %>
