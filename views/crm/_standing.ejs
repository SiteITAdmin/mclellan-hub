<% if (standing && !standing.tooFew) { %>
<section class="grid first"><div class="panel s12 standing">
  <div class="panel-head"><h2>Where things stand</h2><% if (standing.writtenAt) { %><span class="chip">Written <%= fmt(standing.writtenAt, 'date') %><%= standing.behind ? `, ${standing.behind} new ${standing.behind === 1 ? 'fact' : 'facts'} since` : '' %></span><% } %></div>
  <% if (standing.lines.length) { %>
  <ul class="standing-lines">
    <% for (const l of standing.lines) { %>
    <li><%= l.text %>
      <span class="cites"><% for (const s of l.sources) { %><a href="/crm/<%= space %>/sources/<%= s.id %>" title="<%= s.quote %>"><%= s.kind === 'note' ? 'Note' : s.kind === 'whatsapp' ? 'WhatsApp' : 'Email' %>, <%= fmt(s.occurred_at, 'date') %></a><% } %><% if (l.changed) { %><span class="unsure">A fact behind this has changed</span><% } %></span>
    </li>
    <% } %>
  </ul>
  <% } else if (standing.waiting && !standing.error) { %><div class="empty">The Mac will write this shortly.</div><% } %>
  <% if (standing.error) { %><div class="task-warning">Couldn't write the latest version: <%= standing.error %>. It will try again tomorrow.</div><% } %>
</div></section>
<% } %>
