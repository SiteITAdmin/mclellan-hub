<!doctype html>
<html lang="en-IE">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> – Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/crm.css">
  <link rel="manifest" href="/crm.webmanifest">
  <meta name="theme-color" content="<%= space === 'personal' ? '#e7eee5' : space === 'work' ? '#e7eef5' : '#ecece9' %>">
</head>
<body class="crm-app" data-space="<%= space || 'shared' %>">
<% const base = space || 'work'; %>
<% const swWork = locals.switchWork || '/crm/work'; %>
<% const swPersonal = locals.switchPersonal || '/crm/personal'; %>
<% const nav = (href, ic, label, key, extra) => `<a href="${href}" ${page === key ? 'aria-current="page"' : ''}>${icon[ic] || icon.note}<span>${label}</span>${extra || ''}</a>`; %>
<% const navHtml = `
  <nav class="switch" aria-label="Space">
    <a href="${swWork}" aria-current="${space === 'work'}">Work</a>
    <a href="${swPersonal}" aria-current="${space === 'personal'}">Personal</a>
  </nav>
  <nav class="nav">
    ${nav(`/crm/${base}`, 'today', 'Today', 'today')}
    ${nav(`/crm/${base}/calendar`, 'calendar', 'Calendar', 'calendar')}
    ${nav(`/crm/${base}/tasks`, 'tasks', 'Tasks', 'tasks')}
    ${nav(`/crm/${base}/meetings`, 'meeting', 'Meetings', 'meetings', locals.krispWaiting ? `<span class="count">${locals.krispWaiting}<span class="sr-only"> waiting</span></span>` : '')}
    ${base === 'work' ? nav('/crm/work/briefing', 'briefing', 'Briefing', 'briefing') : ''}
    <div class="nav-group">Knowledge</div>
    ${nav(`/crm/${base}/people`, 'people', 'People', 'people')}
    ${nav(`/crm/${base}/projects`, 'projects', 'Projects', 'projects')}
    ${nav(`/crm/${base}/organisations`, 'org', 'Organisations', 'organisations')}
    ${nav(`/crm/${base}/search`, 'search', 'Search', 'search')}
    ${nav(`/crm/${base}/reports`, 'note', 'Reports', 'reports')}
    ${nav(`/crm/${base}/captured`, 'captured', 'Captured', 'captured')}
    <div class="nav-group">Both spaces</div>
    ${nav('/crm/inbox', 'inbox', 'Inbox', 'inbox', locals.inboxCount ? `<span class="count">${locals.inboxCount}<span class="sr-only"> waiting</span></span>` : '')}
    ${nav('/crm/settings', 'settings', 'Connections & setup', 'settings')}
  </nav>`; %>
<div class="shell" data-space="<%= space || 'shared' %>">
  <aside class="sidebar" aria-label="Main">
    <a class="brand" href="/home" title="All tools"><%- icon.mark %><span>Hub</span></a>
    <%- navHtml %>
    <div class="sidebar-foot">
      <a class="btn primary" href="/crm/<%= base %>/note"><%- icon.plus %> Add a note</a>
      <div class="user"><span class="avatar" style="background:var(--active);color:var(--text)" aria-hidden="true">DM</span><div>Douglas McLellan<small><a href="/flights">Flights</a> · <a href="/money">Money</a> · <a href="/house">House</a></small></div></div>
    </div>
  </aside>
  <header class="topbar">
    <button class="hub-menu" type="button" data-drawer-open aria-controls="menu" aria-expanded="false" aria-label="Open menu"><%- icon.grid %><span>Hub</span></button>
    <nav class="switch" aria-label="Space">
      <a href="<%= swWork %>" aria-current="<%= space === 'work' %>">Work</a>
      <a href="<%= swPersonal %>" aria-current="<%= space === 'personal' %>">Personal</a>
    </nav>
  </header>
  <div class="sheet" id="menu" data-space="<%= space || 'shared' %>">
    <div class="sheet-inner">
      <div class="sheet-head">
        <a class="brand" href="/home" title="All tools"><%- icon.mark %><span>Hub</span></a>
        <button class="menu-btn" type="button" data-drawer-close aria-label="Close menu"><%- icon.close %></button>
      </div>
      <%- navHtml %>
      <p><a class="btn primary" href="/crm/<%= base %>/note"><%- icon.plus %> Add a note</a></p>
      <p class="subline" style="font-size:13px">Tools: <a href="/home">Home</a> · <a href="/flights">Flights</a> · <a href="/money">Money</a> · <a href="/house">House hunting</a></p>
    </div>
  </div>
  <main class="canvas"><div class="column">
  <% if (flash) { %><div class="flash <%= flash.level === 'bad' ? 'bad' : '' %>" role="status"><%= flash.text %></div><% } %>
