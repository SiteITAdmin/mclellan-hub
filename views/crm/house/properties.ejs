<%
  const hasFilters = Boolean(stage || search || minPrice != null || maxPrice != null || minBeds != null || minBaths != null);
  const BATH_BADGE = {
    two_plus_full: { text: '2+ full baths', status: 'approved' },
    one_full_plus_wc: { text: '1 bath + WC only', status: 'declined' },
  };
  const HEAT_BADGE = {
    gas_likely: { text: 'Gas likely', status: 'approved' },
    wet_radiators_visible: { text: 'Wet radiators', status: 'approved' },
    electric_visible: { text: 'Electric heating', status: 'declined' },
  };
%>
<section class="house-section" aria-labelledby="house-properties-heading">
  <header class="house-section-head">
    <h2 id="house-properties-heading">Properties</h2>
    <span class="house-meta"><%= visibleProperties.length %> shown</span>
  </header>
  <form class="house-filters" method="get" action="<%= base %>/properties" role="search" aria-label="Filter properties">
    <label>Search <input type="search" class="input" name="q" value="<%= search %>" placeholder="Address or area"></label>
    <label>Stage <select class="input" name="stage">
      <option value="">All stages</option>
      <% for (const [value, name] of Object.entries(stages)) { %><option value="<%= value %>" <% if (value === stage) { %>selected<% } %>><%= name %></option><% } %>
    </select></label>
    <label>Min price (€) <input type="number" class="input house-num-filter" name="minPrice" value="<%= minPrice ?? '' %>" min="0" step="5000" inputmode="numeric" placeholder="e.g. 250000"></label>
    <label>Max price (€) <input type="number" class="input house-num-filter" name="maxPrice" value="<%= maxPrice ?? '' %>" min="0" step="5000" inputmode="numeric" placeholder="e.g. 450000"></label>
    <label>Bedrooms <select class="input" name="minBeds">
      <option value="">Any</option>
      <% for (const n of [1, 2, 3, 4, 5]) { %><option value="<%= n %>" <% if (minBeds === n) { %>selected<% } %>><%= n %>+ bed</option><% } %>
    </select></label>
    <label>Bathrooms <select class="input" name="minBaths">
      <option value="">Any</option>
      <% for (const n of [1, 2, 3, 4]) { %><option value="<%= n %>" <% if (minBaths === n) { %>selected<% } %>><%= n %>+ bath</option><% } %>
    </select></label>
    <button class="btn" type="submit">Filter</button>
    <% if (hasFilters) { %><a class="house-inline" href="<%= base %>/properties">Clear filters</a><% } %>
  </form>

  <% if (!properties.length) { %>
    <div class="house-empty house-empty-card">
      <p>Save a property by hand or review a Daft alert imported from Gmail.</p>
      <a class="btn" href="<%= base %>/mail">Review mail</a>
    </div>
  <% } else if (!visibleProperties.length) { %>
    <p class="house-empty">No properties match these filters.</p>
  <% } else { %>
    <form method="get" action="<%= base %>/properties#compare">
      <input type="hidden" name="q" value="<%= search %>">
      <input type="hidden" name="stage" value="<%= stage %>">
      <% if (minPrice != null) { %><input type="hidden" name="minPrice" value="<%= minPrice %>"><% } %>
      <% if (maxPrice != null) { %><input type="hidden" name="maxPrice" value="<%= maxPrice %>"><% } %>
      <% if (minBeds != null) { %><input type="hidden" name="minBeds" value="<%= minBeds %>"><% } %>
      <% if (minBaths != null) { %><input type="hidden" name="minBaths" value="<%= minBaths %>"><% } %>
      <% if (visibleProperties.length > 1) { %>
        <div class="house-compare-controls">
          <p class="house-meta">Select two to four properties to compare.</p>
          <button class="btn" type="submit">Compare selected</button>
        </div>
      <% } %>
      <div class="house-property-grid">
        <% for (const p of visibleProperties) { const hb = HEAT_BADGE[p.heating_verdict]; const bb = BATH_BADGE[p.bathroom_verdict]; %>
          <article class="house-property-card">
            <div class="house-property-status">
              <span class="house-status" data-status="<%= p.status %>"><%= stages[p.status] || label(p.status) %></span>
              <% if (visibleProperties.length > 1) { %>
                <label class="house-check"><input type="checkbox" name="compare" value="<%= p.id %>" <% if (comparison.some(c => c.id === p.id)) { %>checked<% } %>> Compare<span class="sr-only"> <%= p.title %></span></label>
              <% } %>
            </div>
            <h3><a href="<%= propertyUrl(p.id) %>"><%= p.title %></a></h3>
            <% if (p.address && p.address !== p.title) { %><p class="house-meta"><%= p.address %></p><% } %>
            <div class="house-property-price">
              <strong><%= p.asking_price == null ? 'Price not recorded' : cost(p.asking_price) %></strong>
              <span class="house-meta"><%= [p.beds == null ? '' : p.beds === 0 ? 'Studio' : `${p.beds} bed`, p.baths == null ? '' : `${p.baths} bath`, p.area == null ? '' : `${p.area} m²`].filter(Boolean).join(' · ') %></span>
            </div>
            <% if (hb || bb) { %>
              <div class="house-area-pills">
                <% if (hb) { %><span class="house-status" data-status="<%= hb.status %>"><%= hb.text %></span><% } %>
                <% if (bb) { %><span class="house-status" data-status="<%= bb.status %>"><%= bb.text %></span><% } %>
              </div>
            <% } %>
            <% if (linkUrl(p.url)) { %>
              <div class="house-event-links">
                <a class="house-source" href="<%= linkUrl(p.url) %>" target="_blank" rel="noopener noreferrer"><%= listingLabel(p.url) %></a>
              </div>
            <% } %>
          </article>
        <% } %>
      </div>
    </form>
  <% } %>
</section>

<% if (comparison.length) { %>
<section class="house-section" id="compare" aria-labelledby="house-compare-heading">
  <header class="house-section-head"><h2 id="house-compare-heading">Property comparison</h2></header>
  <% if (comparison.length === 1) { %>
    <p class="house-empty">Select at least one more property to compare.</p>
  <% } else if (comparison.length > 4) { %>
    <p class="house-empty">Choose no more than four properties to compare.</p>
  <% } else { %>
    <div class="house-table-scroll" tabindex="0" role="region" aria-label="Scrollable property comparison">
      <table class="house-table">
        <thead><tr><th scope="col">Detail</th><% for (const p of comparison) { %><th scope="col"><a href="<%= propertyUrl(p.id) %>"><%= p.title %></a></th><% } %></tr></thead>
        <tbody>
        <% for (const [name, value] of [
          ['Asking price', p => cost(p.asking_price)],
          ['Address', p => p.address],
          ['Bedrooms', p => p.beds === 0 ? 'Studio' : p.beds],
          ['Bathrooms', p => p.baths],
          ['Floor area', p => p.area == null ? null : `${p.area} m²`],
          ['Stage', p => stages[p.status]],
          ['Next viewing', p => { const e = upcoming.find(v => v.property_id === p.id); return e ? [entryDate(e.day), e.time].filter(Boolean).join(' · ') : null; }],
          ['Latest offer', p => { const e = offers.find(v => v.property_id === p.id); return e ? [e.amount != null ? cost(e.amount) : '', label(e.status)].filter(Boolean).join(' · ') : null; }],
          ['Notes', p => p.notes],
        ]) { %>
          <tr><th scope="row"><%= name %></th><% for (const p of comparison) { %><td><%= value(p) || '—' %></td><% } %></tr>
        <% } %>
          <tr><th scope="row">Listing</th><% for (const p of comparison) { %><td><% if (linkUrl(p.url)) { %><a class="house-source" href="<%= linkUrl(p.url) %>" target="_blank" rel="noopener noreferrer"><%= listingLabel(p.url) %></a><% } else { %>—<% } %></td><% } %></tr>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<% } %>
