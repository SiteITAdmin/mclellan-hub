<% if (entries.length) { %>
  <ul class="house-events">
    <% for (const e of entries) { %>
      <% const property = propertiesById.get(e.property_id);
         const isReadOnly = typeof readOnly !== 'undefined' && readOnly;
         const listingHref = linkUrl(e.listing?.url || property?.url);
         const svHref = streetViewUrl(e.listing || property);
         const showPropertyLink = property && !isReadOnly && screen !== 'property'; %>
      <li class="house-event">
        <div>
          <% if (isReadOnly) { %><strong class="house-event-title"><%= e.title %></strong>
          <% } else { %><a class="house-event-title" href="<%= entryUrl(e.id) %>?from=<%= screen %>"><%= e.title %></a><% } %>
          <p class="house-meta">
            <%= [kinds[e.kind], property?.title, e.day ? entryDate(e.day) : (e.gmail_id ? fmt(e.occurred_at) : ''), e.time, e.person].filter(Boolean).join(' · ') %>
          </p>
          <% if (e.details) { %><p class="house-detail"><%= e.details %></p><% } %>
          <% if (listingHref || svHref || showPropertyLink || (e.gmail_id && !isReadOnly)) { %>
            <div class="house-event-links">
              <% if (listingHref) { %><a class="house-source" href="<%= listingHref %>" target="_blank" rel="noopener noreferrer"><%= listingLabel(listingHref) %></a><% } %>
              <% if (svHref) { %><a class="house-source" href="<%= svHref %>" target="_blank" rel="noopener noreferrer">Street View ↗</a><% } %>
              <% if (showPropertyLink) { %><a class="house-source" href="<%= propertyUrl(property.id) %>">Property page</a><% } %>
              <% if (e.gmail_id && !isReadOnly) { %><a class="house-source" href="<%= gmailUrl(e.gmail_id) %>" target="_blank" rel="noopener noreferrer"><%- icon.email %> Source email</a><% } %>
            </div>
          <% } %>
        </div>
        <div class="house-event-side">
          <% if (e.amount != null) { %><strong><%= cost(e.amount) %></strong><% } %>
          <% if (e.status) { %><span class="house-status" data-status="<%= e.status %>"><%= label(e.status) %></span><% } %>
          <% if (e.superseded_at) { %><span class="house-status" data-status="expired">Superseded</span><% } %>
        </div>
      </li>
    <% } %>
  </ul>
<% } else { %>
  <p class="house-empty"><%= emptyText %></p>
<% } %>
