<% const p = property, related = events.filter(e => e.property_id === p.id), old = archived.filter(e => e.property_id === p.id); %>
<section class="house-section" aria-labelledby="house-property-heading">
  <a class="house-inline" href="<%= base %>/properties">← All properties</a>
  <header class="house-section-head house-record-head">
    <div>
      <h2 id="house-property-heading"><%= p.title %></h2>
      <% if (p.address && p.address !== p.title) { %><p class="house-meta"><%= p.address %></p><% } %>
    </div>
    <div class="house-actions">
      <% const svHref = streetViewUrl(p); %>
      <% if (linkUrl(p.url)) { %><a class="btn" href="<%= linkUrl(p.url) %>" target="_blank" rel="noopener noreferrer"><%= listingLabel(p.url) %></a><% } %>
      <% if (svHref) { %><a class="btn" href="<%= svHref %>" target="_blank" rel="noopener noreferrer">Street View ↗</a><% } %>
      <a class="btn" href="<%= propertyUrl(p.id) %>/edit">Edit property</a>
    </div>
  </header>
  <dl class="house-property-facts">
    <div><dt>Asking price</dt><dd><%= cost(p.asking_price) %></dd></div>
    <div><dt>Bedrooms</dt><dd><%= p.beds === 0 ? 'Studio' : p.beds ?? '—' %></dd></div>
    <div><dt>Bathrooms</dt><dd><%= p.baths ?? '—' %></dd></div>
    <div><dt>Floor area</dt><dd><%= p.area == null ? '—' : `${p.area} m²` %></dd></div>
    <% if (p.seller_agency) { %><div><dt>Selling agent</dt><dd><%= p.seller_agency %></dd></div><% } %>
    <div><dt>Stage</dt><dd><span class="house-status" data-status="<%= p.status %>"><%= stages[p.status] || label(p.status) %></span></dd></div>
  </dl>
  <% if (p.notes) { %><p class="house-detail"><%= p.notes %></p><% } %>
  <div class="house-actions house-property-actions">
    <a class="btn primary" href="<%= newEntry({ property_id: p.id, kind: 'viewing', from: 'property' }) %>"><%- icon.calendar %> Add viewing</a>
    <a class="btn" href="<%= newEntry({ property_id: p.id, kind: 'offer', from: 'property' }) %>"><%- icon.plus %> Record offer</a>
    <a class="btn" href="<%= newEntry({ property_id: p.id, kind: 'note', from: 'property' }) %>"><%- icon.note %> Add note</a>
  </div>
</section>

<section class="house-section" id="commute" aria-labelledby="house-commute-heading">
  <header class="house-section-head">
    <div>
      <h2 id="house-commute-heading">Commute to <%= workplace.name %></h2>
      <p class="house-meta"><%= workplace.shortName %> · leaving at <%= workplace.departAm %> and returning around <%= workplace.departPm %></p>
    </div>
    <div class="house-actions">
      <form method="post" action="<%= propertyUrl(p.id) %>/commute#commute">
        <button class="btn <%= p.commute ? '' : 'primary' %>" type="submit"><%= p.commute ? 'Refresh commute' : 'Calculate commute' %></button>
      </form>
    </div>
  </header>
  <% if (typeof commuteError !== 'undefined' && commuteError) { %>
    <p class="house-valuation-error" role="alert"><%= commuteError %></p>
  <% } %>
  <% const c = p.commute, driveTo = commuteDirectionsUrl(p, { direction: 'to', mode: 'driving' }), driveFrom = commuteDirectionsUrl(p, { direction: 'from', mode: 'driving' }), transitTo = commuteDirectionsUrl(p, { direction: 'to', mode: 'transit' }); %>
  <% if (c) { %>
    <div class="house-valuation-summary house-valuation-trio">
      <div>
        <span class="house-context">7:00 AM → <%= workplace.name %></span>
        <p class="house-valuation-range"><%= formatCommuteRange(c.am_min, c.am_max) %></p>
        <p class="house-meta"><%= c.free_flow_am_min ? `Free-flow ${c.free_flow_am_min} min` : '' %><% if (c.m50_toll) { %> · M50 toll<% } %></p>
      </div>
      <div class="house-valuation-mid">
        <span class="house-context">4:00 PM ← <%= workplace.name %></span>
        <strong><%= formatCommuteRange(c.pm_min, c.pm_max) %></strong>
        <p class="house-meta"><%= c.free_flow_pm_min ? `Free-flow ${c.free_flow_pm_min} min` : '' %></p>
      </div>
      <div class="house-valuation-mid">
        <span class="house-context">Distance &amp; route</span>
        <strong><%= c.distance_km != null ? `${c.distance_km} km` : '—' %></strong>
        <p class="house-meta"><%= c.roads?.length ? `Via ${c.roads.join(', ')}` : 'Local roads' %> · <%= c.source === 'google_routes' ? 'Google weekday traffic' : 'Estimated Dublin peak' %></p>
      </div>
    </div>
  <% } else { %>
    <p class="house-empty">Click "Calculate commute" to estimate the 7:00 AM drive to <%= workplace.name %> and 4:00 PM return.</p>
  <% } %>
  <% if (driveTo || driveFrom || transitTo) { %>
    <div class="house-event-links" style="margin-top:10px">
      <% if (driveTo) { %><a class="house-source" href="<%= driveTo %>" target="_blank" rel="noopener noreferrer">Google Maps: To Beacon (drive) ↗</a><% } %>
      <% if (driveFrom) { %><a class="house-source" href="<%= driveFrom %>" target="_blank" rel="noopener noreferrer">Return home (drive) ↗</a><% } %>
      <% if (transitTo) { %><a class="house-source" href="<%= transitTo %>" target="_blank" rel="noopener noreferrer">Public transport / Luas ↗</a><% } %>
    </div>
  <% } %>
</section>

<%- include('valuation', { p }) %>

<%- include('listing-analysis', { p }) %>

<section class="house-section">
  <header class="house-section-head"><h2>Property activity</h2></header>
  <%- include('_events', { entries: related, emptyText: 'Viewings, offers and confirmed emails for this property will appear here.' }) %>
  <% if (old.length) { %>
    <details class="house-aging"><summary>Superseded updates</summary>
      <%- include('_events', { entries: old, emptyText: '' }) %>
    </details>
  <% } %>
</section>
