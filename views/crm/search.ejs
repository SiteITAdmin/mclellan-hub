<%- include('_top') %>
<div class="title-row"><div><h1>Search</h1><p class="subline">Facts, people and the text of everything captured in <%= space === 'work' ? 'Work' : 'Personal' %>.</p></div></div>
<form class="form-row" method="get" action="/crm/<%= space %>/search" role="search" style="margin-top:20px">
  <label class="sr-only" for="sq">Search</label>
  <input class="input" id="sq" name="q" value="<%= q %>" placeholder="e.g. Purview, or a question: Who do I know at Stripe?" autofocus>
  <button class="btn primary" type="submit"><%- icon.search %> Search</button>
</form>
<% if (question) { %>
<% if (question.status === 'waiting') { %><meta http-equiv="refresh" content="6;url=/crm/<%= space %>/search?ask=<%= question.id %>"><% } %>
<section class="grid first"><div class="panel s12 summary" aria-live="polite">
  <div class="panel-head"><h2><%= question.question %></h2></div>
  <% if (question.status === 'waiting') { %><p><%= question.slow ? "The Mac hasn't picked this up yet. Check com.mclellan.hub.subscription-agent-worker." : 'The Mac is working out an answer. This page refreshes by itself.' %></p>
  <% } else if (question.status === 'failed') { %><p>No answer: <%= question.error %></p>
  <% } else if (!question.lines.length) { %><p>Nothing the Hub has captured answers that.</p>
  <% } else { %>
    <% for (const l of question.lines) { %><p><%= l.text %>
      <span class="stamp" style="display:block;margin-top:2px"><% for (const x of l.people) { %><a href="/crm/<%= space %>/people/<%= x.id %>"><%= x.name %></a> <% } %><% for (const s of l.sources) { %><a href="/crm/<%= space %>/sources/<%= s.id %>" title="<%= s.title %>"><%= s.kind === 'note' ? 'Note' : s.kind === 'report' ? 'Report' : 'Email' %>, <%= fmt(s.occurred_at, 'date') %></a> <% } %></span></p><% } %>
    <p class="stamp">Answered <%= ago(question.answered_at) %> from the facts and people below. Every line links to where it came from.</p>
  <% } %>
</div></section>
<% } %>
<% if (q) { %>
<section class="grid<%= question ? '' : ' first' %>">
  <div class="panel s8">
    <div class="panel-head"><h2>Facts</h2><span class="chip"><%= results.atoms.length %></span></div>
    <% if (!results.atoms.length) { %><div class="empty">No facts match.</div><% } %>
    <% for (const a of results.atoms) { %><%- include('_atom', { a }) %><% } %>
  </div>
  <div class="s4 side-stack">
    <div class="panel"><div class="panel-head"><h2>People</h2></div>
      <% if (!results.people.length) { %><div class="empty">Nobody by that name.</div><% } %>
      <div class="topics-list"><% for (const x of results.people) { %><a class="topic-row" href="/crm/<%= space %>/people/<%= x.id %>"><span><%= x.name %></span><span class="n"><%= x.org %></span></a><% } %></div>
    </div>
    <% if (results.orgs.length) { %><div class="panel"><div class="panel-head"><h2>Organisations</h2></div>
      <div class="topics-list"><% for (const o of results.orgs) { %><a class="topic-row" href="/crm/<%= space %>/organisations/<%= o.id %>"><span><%= o.name %></span></a><% } %></div>
    </div><% } %>
    <div class="panel"><div class="panel-head"><h2>In the text</h2></div>
      <% if (!results.sources.length) { %><div class="empty">No matches.</div><% } %>
      <div class="list"><% for (const s of results.sources) { %><a class="rowcard" style="grid-template-columns:1fr" href="/crm/<%= space %>/sources/<%= s.id %>"><div class="main"><div class="what"><%= s.title %></div><div class="meta" style="white-space:normal"><%= fmt(s.occurred_at, 'date') %>. <%= s.snip %></div></div></a><% } %></div>
    </div>
  </div>
</section>
<% } %>
<%- include('_bottom') %>
