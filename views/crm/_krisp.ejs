<h2>Krisp transcripts</h2>
<p>Krisp intake <%= configured ? 'configured' : 'not configured' %>. <%= deliveries.filter(x => x.status === 'pending').length %> waiting for your choice. Unfiled recordings appear in both spaces until you choose.</p>
<p>Transcripts stay outside Search and the reader until you choose Work or Personal. Ignore recordings you do not want imported.</p>
<% for (const d of deliveries) { %>
<section class="panel"><h2><%= d.title %></h2><p><%= fmt(d.occurred_at || d.received_at) %> · <%= d.status === 'pending' ? 'Choose Work or Personal' : d.status %><%= d.sources.length ? ' · ' + [...new Set(d.sources.map(s => s.space))].join(', ') : '' %></p>
<% if (!d.readable) { %><p class="flash bad">Empty or unsupported transcript. Inspect the original delivery before choosing.</p><% } %>
<% if (d.status === 'pending') { %><details><summary>Transcript</summary><pre style="white-space:pre-wrap"><%= d.transcript %></pre></details>
<details><summary>Original Krisp delivery</summary><pre style="white-space:pre-wrap"><%= d.raw_json %></pre></details>
<form method="post" action="/crm/krisp/<%= d.id %>/classify"><input type="hidden" name="returnSpace" value="<%= space %>"><button class="btn" name="choice" value="work">Work</button> <button class="btn" name="choice" value="personal">Personal</button> <button class="btn" name="choice" value="ignore">Ignore</button></form>
<% } else { for (const source of d.sources) { %><p><a href="/crm/<%= source.space %>/sources/<%= source.id %>">View source</a></p><% } } %>
</section><% } %>
