<% const todayDate = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Dublin' }); %>
<% if (!taskList.length) { %><div class="empty">No tasks here yet.</div><% } %>
<%# Tasks in one job are shown together under the job, where the job's first task falls. %>
<% const groups = [], byJob = new Map();
   for (const task of taskList) {
     const job = task.job && task.job.open + task.job.done >= 2 ? task.job : null;
     if (job && byJob.has(job.id)) { byJob.get(job.id).items.push(task); continue; }
     const g = { job, items: [task] }; groups.push(g); if (job) byJob.set(job.id, g);
   } %>
<div class="rows">
<% for (const g of groups) { %>
  <% if (g.job) { %><div class="job-group"><%- include('_job-head', { job: g.job }) %><div class="rows"><% } %>
  <% for (const task of g.items) { %><%- include('_task-row', { task, todayDate, quickDates: locals.quickDates || null }) %><% } %>
  <% if (g.job) { %></div></div><% } %>
<% } %>
</div>
