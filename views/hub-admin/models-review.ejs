<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Prompt &amp; model review — Chat Admin — <%= user %></title>
<link rel="stylesheet" href="/portfolio.css">
<%- include('partials/models-styles') %>
<style>
  .review-head { display:flex; justify-content:space-between; align-items:flex-start; gap:18px; flex-wrap:wrap; margin-bottom:18px; }
  .review-head p { max-width:760px; margin:0; font-size:13px; line-height:1.55; color:var(--text-dim); }
  .review-grid { display:grid; grid-template-columns:repeat(5,minmax(110px,1fr)); gap:10px; margin:16px 0 22px; }
  .review-metric { border:1px solid var(--card-border); border-radius:var(--card-radius); background:var(--card-bg); padding:14px; }
  .review-metric strong { display:block; font-size:24px; line-height:1; color:var(--text); margin-bottom:6px; }
  .review-metric span { font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.05em; }
  .review-note { border:1px solid var(--card-border); border-radius:10px; padding:12px 14px; margin:0 0 16px; font-size:12px; line-height:1.5; color:var(--text-dim); background:var(--card-bg); }
  .review-note.ok { border-color:rgba(31,157,105,.35); background:rgba(31,157,105,.06); }
  .review-note.error { border-color:rgba(210,65,65,.4); background:rgba(210,65,65,.07); color:var(--text); }
  .review-table-wrap { overflow:auto; border:1px solid var(--card-border); border-radius:var(--card-radius); background:var(--card-bg); margin-bottom:20px; }
  .review-table { width:100%; border-collapse:collapse; font-size:12px; }
  .review-table th, .review-table td { padding:10px 12px; border-bottom:1px solid var(--card-border); text-align:left; vertical-align:top; }
  .review-table th { font-size:10px; text-transform:uppercase; letter-spacing:.06em; color:var(--text-dim); background:rgba(124,106,245,.04); white-space:nowrap; }
  .review-table tr:last-child td { border-bottom:0; }
  .review-table code { font-size:11px; color:var(--text); }
  .review-links { display:flex; flex-wrap:wrap; gap:6px; }
  .review-links a { font-size:11px; text-decoration:none; }
  .review-candidate { min-width:210px; }
  .review-candidate small { display:block; color:var(--text-dim); margin-top:3px; }
  .review-section-title { font-size:16px; margin:22px 0 10px; color:var(--text); }
  details.review-slots summary { cursor:pointer; font-weight:700; color:var(--text); margin-bottom:10px; }
  .review-score { font-size:18px; font-weight:800; white-space:nowrap; }
  .review-score.strong { color:#1f9d69; }
  .review-score.watch { color:#b7791f; }
  .review-score.low { color:#d24141; }
  .review-panel { display:flex; flex-wrap:wrap; gap:8px; margin:10px 0 16px; }
  .review-panel span { border:1px solid var(--card-border); border-radius:999px; padding:5px 9px; font-size:11px; color:var(--text-dim); }
  .review-panel span.primary { border-color:rgba(124,106,245,.45); color:var(--text); background:rgba(124,106,245,.08); }
  @media (max-width:850px) { .review-grid { grid-template-columns:repeat(2,minmax(120px,1fr)); } }
</style>
</head>
<body class="admin-page">

<%- include('partials/admin-header', { title: `Prompt & model review — ${user}` }) %>
<%- include('partials/models-subnav', { modelsTab: 'review' }) %>

<section class="admin-section">
  <div class="review-head">
    <p>
      Monthly effectiveness board for every governed prompt/model pairing. The primary reviewer rotates between GPT-5.6 Luna, Grok 4.5 and Claude Sonnet 5. Scores below <strong>75/100</strong> go to the other two models independently. A recommendation is emailed only when all three agree on the problem and remedy.
      Scheduled for the <strong>18th at 05:00 Europe/Dublin</strong>.
    </p>
    <form method="POST" action="/admin/models/review/_run-effectiveness">
      <button class="btn-sm" type="submit" style="background:var(--accent);color:#fff;border-color:var(--accent)">Run monthly review now</button>
    </form>
  </div>

  <div class="review-note">
    <strong>100-point rating:</strong> observed effectiveness 30 · prompt quality 25 · model-task fit 20 · reliability 10 · cost/latency 10 · governance 5. Current benchmark search is compiled once per monthly run; real Hub calls and receipts carry more weight.
  </div>

  <% if (!effectivenessReport) { %>
    <div class="review-note">No monthly effectiveness review exists yet. Output: <code><%= effectivenessReportPath %></code></div>
  <% } else { %>
    <%
      const effectivenessSummary = effectivenessReport.summary || {};
      const effectivenessGenerated = effectivenessReport.generated_at ? new Date(effectivenessReport.generated_at) : null;
      const primaryReviewer = effectivenessReport.primary_reviewer || {};
      const evidenceByFeature = Object.fromEntries((effectivenessReport.evidence || []).map(row => [row.feature, row]));
      const unanimousAppeals = (effectivenessReport.appeals || []).filter(row => row.unanimous);
    %>
    <p style="font-size:11px;color:var(--text-dim);margin:0 0 8px">
      Last monthly run: <strong><%= effectivenessGenerated && !isNaN(effectivenessGenerated) ? effectivenessGenerated.toLocaleString('en-GB', { timeZone: 'Europe/Dublin' }) : 'unknown' %></strong>
      · Month: <%= effectivenessReport.month %>
      · Trigger: <%= effectivenessReport.reason || 'unknown' %>
      · Benchmark dossier: <%= effectivenessReport.benchmark_dossier?.status || 'unknown' %>
      · Email: <%= effectivenessReport.email?.status || 'not required' %>
    </p>
    <div class="review-panel">
      <span class="primary">Primary: <%= primaryReviewer.label || primaryReviewer.key %><%= primaryReviewer.substituted ? ` → ${primaryReviewer.resolvedModelId}` : '' %></span>
      <% for (const reviewer of effectivenessReport.secondary_reviewers || []) { %><span>Appeal: <%= reviewer.label %><%= reviewer.substituted ? ` → ${reviewer.resolvedModelId}` : '' %></span><% } %>
    </div>
    <div class="review-grid">
      <div class="review-metric"><strong><%= effectivenessSummary.scored_count || 0 %></strong><span>Pairings scored</span></div>
      <div class="review-metric"><strong><%= effectivenessSummary.mean_score == null ? '—' : effectivenessSummary.mean_score %></strong><span>Mean score</span></div>
      <div class="review-metric"><strong><%= effectivenessSummary.appeal_count || 0 %></strong><span>Appeals</span></div>
      <div class="review-metric"><strong><%= effectivenessSummary.unanimous_recommendation_count || 0 %></strong><span>Unanimous</span></div>
      <div class="review-metric"><strong><%= effectivenessSummary.insufficient_evidence_count || 0 %></strong><span>Insufficient evidence</span></div>
    </div>

    <% if (unanimousAppeals.length) { %>
      <h2 class="review-section-title">Unanimous recommendations</h2>
      <div class="review-table-wrap"><table class="review-table">
        <thead><tr><th>Pairing</th><th>Three scores</th><th>Agreed issue</th><th>Recommendation</th><th>Admin</th></tr></thead>
        <tbody><% for (const appeal of unanimousAppeals) { const packet = evidenceByFeature[appeal.feature] || {}; %>
          <tr>
            <td><strong><%= packet.label || appeal.feature %></strong><br><code><%= packet.model_id || 'unresolved' %></code></td>
            <td><%= [appeal.primary, ...(appeal.secondary || [])].map(row => `${row.reviewer.label}: ${row.total_score}`).join(' · ') %></td>
            <td><%= appeal.agreed_failure_category %><br><small><%= appeal.agreed_remedy_class %></small></td>
            <td><%= appeal.primary.recommendation || appeal.primary.rationale %></td>
            <td><div class="review-links"><a href="<%= packet.admin_links?.system_slot || '/admin/models/system' %>">Model</a><a href="<%= packet.admin_links?.prompt || '/admin/models/prompts' %>">Prompt</a></div></td>
          </tr>
        <% } %></tbody>
      </table></div>
    <% } %>

    <details class="review-slots" open>
      <summary>Monthly scores (<%= (effectivenessReport.reviews || []).length %>)</summary>
      <div class="review-table-wrap"><table class="review-table">
        <thead><tr><th>Group</th><th>Prompt/model pairing</th><th>Evidence</th><th>Score</th><th>Assessment</th><th>Admin</th></tr></thead>
        <tbody><% for (const review of effectivenessReport.reviews || []) { const packet = evidenceByFeature[review.feature] || {}; %>
          <tr>
            <td><%= packet.group?.label || '' %></td>
            <td><strong><%= packet.label || review.feature %></strong><br><code><%= review.feature %></code><br><small><%= packet.model_id || 'unresolved model' %></small></td>
            <td><%= review.evidence_status %><br><small><%= packet.observed?.direct_call_count || 0 %> calls · <%= packet.observed?.receipt_count || 0 %> receipts</small></td>
            <td><span class="review-score <%= review.total_score == null ? '' : review.total_score >= 85 ? 'strong' : review.total_score >= 75 ? 'watch' : 'low' %>"><%= review.total_score == null ? '—' : `${review.total_score}/100` %></span><br><small><%= review.band %></small></td>
            <td><%= review.rationale || '—' %><% if (review.recommendation) { %><br><strong>Recommendation:</strong> <%= review.recommendation %><% } %></td>
            <td><div class="review-links"><a href="<%= packet.admin_links?.system_slot || '/admin/models/system' %>">Model</a><a href="<%= packet.admin_links?.prompt || '/admin/models/prompts' %>">Prompt</a></div></td>
          </tr>
        <% } %></tbody>
      </table></div>
    </details>

    <% if ((effectivenessReport.benchmark_dossier?.sources || []).length) { %>
      <details class="review-slots">
        <summary>Benchmark sources (<%= effectivenessReport.benchmark_dossier.sources.length %>)</summary>
        <div class="review-note"><% for (const source of effectivenessReport.benchmark_dossier.sources) { %><div><a href="<%= source.url %>" rel="noopener"><%= source.title %></a> <small>· checked <%= source.checked_at ? new Date(source.checked_at).toLocaleDateString('en-GB') : 'this run' %></small></div><% } %></div>
      </details>
    <% } %>
  <% } %>

  <h2 class="review-section-title" style="margin-top:32px">Weekly governance and model availability</h2>
  <div class="review-head">
    <p>
      Weekly governance check for every declared prompt and model slot. It compares current Hub declarations and overrides with OpenRouter's live capability catalogue, reports missing Admin locations, and finds the nearest capability-compatible replacement for unavailable or deprecated models.
      Scheduled for <strong>Sunday at 04:15 Europe/Dublin</strong>.
    </p>
    <form method="POST" action="/admin/models/review/_run">
      <button class="btn-sm" type="submit" style="background:var(--accent);color:#fff;border-color:var(--accent)">Run review now</button>
    </form>
  </div>

  <% if (message) { %><div class="review-note ok"><%= message %></div><% } %>
  <% if (error) { %><div class="review-note error"><strong>Review error:</strong> <%= error %></div><% } %>

  <div class="review-note">
    <strong>Safe automation boundary:</strong> high-confidence candidates (score 0.72+) may be added to the Catalogue as <strong>disabled</strong>. The review never activates a model, reassigns a live slot, or edits a prompt. Medium-confidence matches remain recommendations for human review.
  </div>

  <% if (!report) { %>
    <div class="review-note">No compiled review exists yet. Run it now, or wait for the next scheduled review. Output: <code><%= reportPath %></code></div>
  <% } else { %>
    <%
      const summary = report.summary || {};
      const run = report.run || {};
      const installations = run.installations || [];
      const installationByModel = Object.fromEntries(installations.map(row => [row.model_id, row]));
      const generated = report.generated_at ? new Date(report.generated_at) : null;
    %>
    <p style="font-size:11px;color:var(--text-dim);margin:0 0 8px">
      Last run: <strong><%= generated && !isNaN(generated) ? generated.toLocaleString('en-GB', { timeZone: 'Europe/Dublin' }) : 'unknown' %></strong>
      · OpenRouter catalogue: <%= report.catalog_model_count || 0 %> models
      · Trigger: <%= run.reason || 'legacy/read-only review' %>
    </p>

    <div class="review-grid">
      <div class="review-metric"><strong><%= summary.slot_count || 0 %></strong><span>Admin slots</span></div>
      <div class="review-metric"><strong><%= summary.error_count || 0 %></strong><span>Errors</span></div>
      <div class="review-metric"><strong><%= summary.warning_count || 0 %></strong><span>Warnings</span></div>
      <div class="review-metric"><strong><%= summary.auto_installable_count || 0 %></strong><span>Safe candidates</span></div>
      <div class="review-metric"><strong><%= run.inserted_disabled_count || 0 %></strong><span>Added disabled</span></div>
    </div>

    <div class="review-links" style="margin-bottom:18px">
      <a class="btn-sm" href="<%= report.admin_locations?.catalogue || '/admin/models' %>">Catalogue</a>
      <a class="btn-sm" href="<%= report.admin_locations?.system_slots || '/admin/models/system' %>">System models</a>
      <a class="btn-sm" href="<%= report.admin_locations?.prompts || '/admin/models/prompts' %>">Prompts</a>
      <a class="btn-sm" href="<%= report.admin_locations?.tiers || '/admin/models/tiers' %>">Tiers</a>
    </div>

    <h2 class="review-section-title">Findings</h2>
    <% if (!(report.issues || []).length) { %>
      <div class="review-note ok">No governance issues found.</div>
    <% } else { %>
      <div class="review-table-wrap">
        <table class="review-table">
          <thead><tr><th>Level</th><th>Feature</th><th>Finding</th><th>Nearest equivalent</th><th>Admin location</th></tr></thead>
          <tbody>
          <% for (const issue of report.issues || []) { %>
            <% const candidate = (issue.recommendations || [])[0]; const installed = candidate && installationByModel[candidate.id]; %>
            <tr>
              <td><span class="badge <%= issue.severity === 'error' ? 'badge-search-none' : 'badge-tier' %>"><%= issue.severity %></span></td>
              <td><code><%= issue.feature || '—' %></code></td>
              <td><%= issue.message %></td>
              <td class="review-candidate">
                <% if (candidate) { %>
                  <code><%= candidate.id %></code>
                  <small>score <%= Number(candidate.score || 0).toFixed(2) %> · <%= candidate.confidence || 'unknown' %><%= installed ? ` · ${installed.action === 'inserted_disabled' ? 'added disabled' : 'already in catalogue'}` : '' %></small>
                <% } else { %>—<% } %>
              </td>
              <td><div class="review-links">
                <% if (issue.admin_links?.system_slot) { %><a href="<%= issue.admin_links.system_slot %>">Model slot</a><% } %>
                <% if (issue.admin_links?.prompt) { %><a href="<%= issue.admin_links.prompt %>">Prompt</a><% } %>
                <% if (issue.admin_links?.catalogue) { %><a href="<%= issue.admin_links.catalogue %>">Catalogue</a><% } %>
              </div></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    <% } %>

    <details class="review-slots">
      <summary>Full slot inventory (<%= (report.slots || []).length %>)</summary>
      <div class="review-table-wrap">
        <table class="review-table">
          <thead><tr><th>Group</th><th>Feature</th><th>Effective model</th><th>Health</th><th>Admin location</th></tr></thead>
          <tbody>
          <% for (const slot of report.slots || []) { %>
            <tr>
              <td><%= slot.group?.label || '' %></td>
              <td><code><%= slot.feature %></code></td>
              <td><code><%= slot.effective_model_id || 'prompt only' %></code></td>
              <td><span class="badge <%= slot.live_health === 'healthy' ? 'badge-default' : 'badge-search-none' %>"><%= slot.live_health %></span></td>
              <td><div class="review-links"><a href="<%= slot.admin_links.system_slot %>">Model</a><a href="<%= slot.admin_links.prompt %>">Prompt</a></div></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </details>
  <% } %>
</section>
</body>
</html>
