<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chat Admin — <%= user %></title>
<link rel="stylesheet" href="/portfolio.css">
<style>
  :root {
    --card-radius: 12px;
    --card-border: var(--border, #dddaf0);
    --card-bg: var(--bg, #faf9fb);
    --accent: var(--primary, #7c6af5);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
    margin-top: 4px;
  }
  .proj-card {
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    padding: 16px 18px;
    transition: box-shadow 0.15s;
  }
  .proj-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.06); }

  .card-head {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;
    margin-bottom: 8px;
  }
  .card-name {
    font-size: 14px; font-weight: 600; color: var(--text, #15131e); line-height: 1.3;
  }
  .card-name a { color: inherit; text-decoration: none; }
  .card-name a:hover { text-decoration: underline; }
  .card-slug {
    font-family: var(--mono, monospace); font-size: 10px;
    color: var(--text-dim, #767586); margin-top: 2px;
  }
  .card-badges {
    display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 10px;
  }
  .badge {
    display: inline-flex; align-items: center; gap: 3px;
    padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 600; line-height: 1.5;
  }
  .badge-cv     { background: rgba(124,106,245,0.12); color: #5b4ac4; }
  .badge-tag    { background: rgba(22,160,133,0.12);  color: #0e7a65; }
  .badge-dim    { background: rgba(0,0,0,0.06); color: #666; }

  .card-meta {
    font-size: 11px; color: var(--text-dim, #767586);
    display: flex; gap: 10px; margin-bottom: 10px; flex-wrap: wrap;
  }
  .card-meta span { white-space: nowrap; }

  .card-actions {
    display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
  }
  .btn-sm {
    padding: 5px 12px; font-size: 12px; border-radius: 6px; cursor: pointer;
    border: 1px solid var(--outline, #c7c4d7); background: transparent;
    color: var(--text, #15131e); font-family: inherit; transition: background 0.12s;
    text-decoration: none; display: inline-flex; align-items: center;
  }
  .btn-sm:hover { background: rgba(0,0,0,0.05); }
  .btn-sm.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn-sm.primary:hover { opacity: 0.9; }
  .btn-sm.danger { color: #ba1a1a; border-color: #ffdad6; }
  .btn-sm.danger:hover { background: rgba(186,26,26,0.06); }

  .edit-panel {
    display: none; margin-top: 14px; padding-top: 14px;
    border-top: 1px solid var(--card-border);
  }
  .edit-panel.open { display: block; }
  .edit-form { display: flex; flex-direction: column; gap: 10px; }
  .form-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .form-row .field { flex: 1; min-width: 100px; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field label {
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--text-dim, #464554);
  }
  .field input, .field select {
    padding: 7px 10px; font-size: 13px; font-family: var(--font, sans-serif);
    border: 1px solid var(--outline, #c7c4d7); border-radius: 7px;
    background: var(--bg, #fcf8ff); color: var(--text, #1b1b23);
    outline: none; transition: border-color 0.15s; width: 100%; box-sizing: border-box;
  }
  .field input:focus, .field select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(124,106,245,0.12);
  }
  .field .check-row { display: flex; align-items: center; gap: 6px; font-size: 13px; padding-top: 4px; }
  .form-actions { display: flex; gap: 8px; margin-top: 2px; }

  /* Tag chips */
  .tag-chip { display:inline-flex; align-items:center; gap:5px; background:var(--surface,#f4f3fb); border:1px solid var(--border,#e5e3f0); border-radius:20px; padding:2px 10px; font-size:12px; color:var(--text-2,#444); white-space:nowrap; }
  .tag-chip.unassigned { background:#fff; border-style:dashed; color:var(--text-muted,#888); }
  .tag-section { display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-top:4px; }
  .tag-assign-row { display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
  .tag-assign-row select { font-size:12px; padding:2px 6px; border-radius:6px; border:1px solid var(--border,#e5e3f0); }

  /* Add project card */
  .add-card {
    border: 1px dashed var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    padding: 16px 18px;
  }
  .add-card summary {
    cursor: pointer; font-size: 13px; font-weight: 600; color: var(--text-dim, #767586);
    list-style: none;
  }
  .add-card summary::before { content: '+ '; }
</style>
</head>
<body class="admin-page">

<header class="admin-header">
  <h1>Chat Admin — <%= user %></h1>
  <nav style="display:flex;gap:12px;align-items:center;">
    <a href="/admin" style="font-weight:600">Projects</a>
    <a href="/admin/crm">CRM</a>
    <a href="/admin/models">Models</a>
    <a href="/admin/shortcuts">Cards</a>
    <a href="/admin/test">Test</a>
    <a href="/admin/linkedin">Content</a>
    <a href="/admin/chatlogs">Chat logs</a>
    <form method="POST" action="/admin/logout"><button type="submit">Sign out</button></form>
  </nav>
</header>

<section class="admin-section">
  <h2>Projects</h2>
  <p>Projects store chat memory. When a user types <code>/slug</code> at the start or end of a message, that exchange is tagged to the project.</p>

  <div class="card-grid">
  <% for (const p of projects) { %>
  <% const pTags = JSON.parse(p.wiki_tags || '[]'); %>
  <div class="proj-card" id="proj-card-<%= p.id %>">
    <div class="card-head">
      <div>
        <div class="card-name"><a href="/admin/projects/<%= p.slug %>"><%= p.name %></a></div>
        <div class="card-slug">/<%= p.slug %></div>
      </div>
      <% if (p.is_cv_context) { %><span class="badge badge-cv">CV</span><% } %>
    </div>

    <% if (pTags.length) { %>
    <div class="card-badges">
      <% for (const t of pTags) { %><span class="badge badge-tag"><%= t %></span><% } %>
    </div>
    <% } %>

    <div class="card-meta">
      <span><%= p.memory_count %> memories</span>
      <span><%= p.context_depth %> ctx depth</span>
      <% if (p.last_activity) { %><span><%= new Date(p.last_activity * 1000).toISOString().slice(0,10) %></span><% } %>
    </div>

    <div class="card-actions">
      <a href="/admin/projects/<%= p.slug %>" class="btn-sm primary">Open</a>
      <button class="btn-sm" onclick="toggleProjEdit('<%= p.id %>')">Edit</button>
    </div>

    <div class="edit-panel" id="proj-edit-<%= p.id %>">
      <form method="POST" action="/admin/projects/<%= p.id %>" class="edit-form">
        <div class="form-row">
          <div class="field">
            <label>Name</label>
            <input name="name" value="<%= p.name %>" required>
          </div>
          <div class="field">
            <label>Slug</label>
            <input name="slug" value="<%= p.slug %>" required>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Context depth</label>
            <input name="context_depth" type="number" value="<%= p.context_depth %>">
          </div>
          <div class="field">
            <label>CV context</label>
            <div class="check-row">
              <input type="checkbox" name="is_cv_context" value="1" <%= p.is_cv_context ? 'checked' : '' %>>
              <span>Include in CV</span>
            </div>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-sm primary">Save</button>
          <button type="button" class="btn-sm" onclick="toggleProjEdit('<%= p.id %>')">Cancel</button>
        </div>
      </form>
      <form method="POST" action="/admin/projects/<%= p.id %>/delete" style="margin-top:10px;padding-top:10px;border-top:1px solid var(--card-border);" onsubmit="return confirm('Delete project <%= p.slug %> and its memories?')">
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;margin-bottom:8px;">
          <input type="checkbox" name="keep_messages" value="1"> Keep messages (just untag)
        </label>
        <button type="submit" class="btn-sm danger">Delete project</button>
      </form>
    </div>
  </div>
  <% } %>

  <div class="add-card">
    <details>
      <summary>Add project</summary>
      <form method="POST" action="/admin/projects" class="edit-form" style="margin-top:12px;">
        <div class="form-row">
          <div class="field">
            <label>Name</label>
            <input name="name" placeholder="e.g. Beacon" required>
          </div>
          <div class="field">
            <label>Slug</label>
            <input name="slug" placeholder="beacon" required pattern="[a-z0-9-]+">
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Context depth</label>
            <input name="context_depth" type="number" value="20">
          </div>
          <div class="field">
            <label>CV context</label>
            <div class="check-row">
              <input type="checkbox" name="is_cv_context" value="1">
              <span>Include in CV</span>
            </div>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-sm primary">Add project</button>
        </div>
      </form>
    </details>
  </div>
  </div>
</section>

<section class="admin-section">
  <h2>Knowledge tags</h2>
  <p style="font-size:13px;color:var(--text-muted);">Tags come from synthadoc-processed wiki pages. Assign them to projects so matching articles surface in context.</p>

  <% if (!wikiTags.length) { %>
    <p style="font-size:13px;color:var(--text-muted);">No wiki tags yet — content needs to sync from the vault first.</p>
  <% } else { %>

  <% for (const p of projects) { %>
  <% const pTags = JSON.parse(p.wiki_tags || '[]'); if (!pTags.length) continue; %>
  <div style="margin-bottom:14px;">
    <div style="font-size:13px;font-weight:600;margin-bottom:6px;"><a href="/admin/projects/<%= p.slug %>" style="color:inherit;"><%= p.name %></a></div>
    <div class="tag-section">
      <% for (const t of pTags) { %>
      <span class="tag-chip">
        <%= t %>
        <button type="button" style="background:none;border:none;cursor:pointer;font-size:11px;opacity:.5;padding:0;line-height:1;" onclick="removeTag('<%= p.id %>', '<%= p.slug %>', <%- JSON.stringify(pTags) %>, '<%= t %>')">✕</button>
      </span>
      <% } %>
    </div>
  </div>
  <% } %>

  <% if (unassignedTags.length) { %>
  <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border,#e5e3f0);">
    <div style="font-size:13px;font-weight:600;color:var(--text-muted,#888);margin-bottom:8px;">Unassigned (<%= unassignedTags.length %>)</div>
    <div class="tag-section">
      <% for (const t of unassignedTags) { %>
      <span class="tag-chip unassigned" style="gap:8px;">
        <%= t %>
        <select class="tag-proj-select" data-tag="<%= t %>" style="font-size:11px;padding:1px 4px;border-radius:4px;border:1px solid var(--border,#ddd);">
          <option value="">assign to…</option>
          <% for (const p of projects) { %><option value="<%= p.id %>|<%= p.slug %>|<%- encodeURIComponent(JSON.stringify(JSON.parse(p.wiki_tags||'[]'))) %>"><%= p.name %></option><% } %>
        </select>
        <button type="button" style="font-size:11px;padding:1px 6px;" onclick="assignTag(this)">+</button>
      </span>
      <% } %>
    </div>
  </div>
  <% } else { %>
  <p style="font-size:13px;color:var(--text-muted);">All wiki tags are assigned to projects.</p>
  <% } %>

  <% } %>
</section>

<section class="admin-section">
  <h2>Email integration</h2>
  <p>Fetches new emails from Google, classifies them against your projects and contacts, and sends a digest to Google Chat at 4pm.</p>
  <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:8px;">
    <button id="btn-fetch-email" onclick="triggerEmailAction('fetch')">Fetch &amp; classify emails now</button>
    <button id="btn-digest-email" onclick="triggerEmailAction('digest')">Send email digest now</button>
    <span id="email-status" style="font-size:13px;color:var(--text-muted);"></span>
  </div>
  <pre id="email-result" style="margin-top:10px;font-size:12px;white-space:pre-wrap;display:none;background:var(--surface-raised,#f4f4f4);padding:10px;border-radius:6px;"></pre>
</section>

<section class="admin-section">
  <h2>MCP endpoints</h2>
  <p>For a future MCP server to read this project memory. Send <code>Authorization: Bearer &lt;token&gt;</code> (set <code><%= user === 'douglas' ? 'DCHAT_MCP_TOKEN' : 'NCHAT_MCP_TOKEN' %></code> in the server <code>.env</code>).</p>
  <ul style="font-family:var(--mono);font-size:13px;">
    <li>GET <code>/mcp/projects</code> — list projects with memory counts</li>
    <li>GET <code>/mcp/projects/:slug</code> — fetch memories (query: <code>?since=unix_ts&amp;limit=500</code>)</li>
  </ul>
</section>

<script>
window.toggleProjEdit = function(id) {
  const panel = document.getElementById('proj-edit-' + id);
  if (panel) panel.classList.toggle('open');
};

async function assignTag(btn) {
  const chip = btn.closest('.tag-chip');
  const sel = chip.querySelector('select');
  if (!sel.value) return;
  const [projectId, projectSlug, encodedTags] = sel.value.split('|');
  const tag = sel.dataset.tag || chip.querySelector('select').dataset.tag;
  const currentTags = JSON.parse(decodeURIComponent(encodedTags));
  if (currentTags.includes(tag)) { location.reload(); return; }
  const newTags = [...currentTags, tag];
  const fd = new FormData();
  newTags.forEach(t => fd.append('tags', t));
  await fetch(`/admin/projects/${projectId}/wiki-tags`, { method: 'POST', body: fd });
  location.reload();
}

async function removeTag(projectId, projectSlug, currentTags, tagToRemove) {
  if (!confirm(`Remove "${tagToRemove}" from this project?`)) return;
  const newTags = currentTags.filter(t => t !== tagToRemove);
  const fd = new FormData();
  newTags.forEach(t => fd.append('tags', t));
  await fetch(`/admin/projects/${projectId}/wiki-tags`, { method: 'POST', body: fd });
  location.reload();
}

async function triggerEmailAction(action) {
  const status = document.getElementById('email-status');
  const result = document.getElementById('email-result');
  const btn = document.getElementById(action === 'fetch' ? 'btn-fetch-email' : 'btn-digest-email');
  btn.disabled = true;
  status.textContent = action === 'fetch' ? 'Fetching & classifying…' : 'Sending digest…';
  result.style.display = 'none';
  try {
    const r = await fetch(`/admin/trigger-email-${action}`, { method: 'POST' });
    const d = await r.json();
    if (d.ok) {
      if (action === 'fetch') {
        status.textContent = `Done — ${d.processed ?? 0} email(s) processed, ${d.moved ?? 0} filed to labels.`;
      } else {
        status.textContent = d.message || 'Digest sent to Google Chat.';
      }
      if (d.preview) { result.textContent = d.preview; result.style.display = 'block'; }
      if (d.error) { status.textContent = `Error: ${d.error}`; }
    } else {
      status.textContent = `Error: ${d.error}`;
    }
  } catch(e) {
    status.textContent = `Request failed: ${e.message}`;
  }
  btn.disabled = false;
}
</script>

</body>
</html>
