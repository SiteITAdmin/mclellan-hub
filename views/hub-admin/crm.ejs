<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CRM — <%= user %></title>
<link rel="stylesheet" href="/portfolio.css">
<style>
  :root {
    --card-radius: 12px;
    --card-border: var(--border, #dddaf0);
    --card-bg: var(--bg, #faf9fb);
    --accent: var(--primary, #7c6af5);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
    margin-top: 4px;
  }
  .contact-card {
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    padding: 16px 18px;
    transition: box-shadow 0.15s;
  }
  .contact-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.06); }

  .card-head {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;
    margin-bottom: 6px;
  }
  .card-name { font-size: 14px; font-weight: 600; color: var(--text, #15131e); line-height: 1.3; }
  .card-aliases { font-size: 11px; color: var(--text-dim, #767586); margin-top: 2px; }

  .card-badges {
    display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 10px; margin-top: 8px;
  }
  .badge {
    display: inline-flex; align-items: center; gap: 3px;
    padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 600; line-height: 1.5;
  }
  .badge-tag  { background: rgba(22,160,133,0.12);  color: #0e7a65; }
  .badge-none { background: rgba(0,0,0,0.06); color: #999; font-weight: 400; font-style: italic; }

  .card-actions {
    display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
  }
  .btn-sm {
    padding: 5px 12px; font-size: 12px; border-radius: 6px; cursor: pointer;
    border: 1px solid var(--outline, #c7c4d7); background: transparent;
    color: var(--text, #15131e); font-family: inherit; transition: background 0.12s;
  }
  .btn-sm:hover { background: rgba(0,0,0,0.05); }
  .btn-sm.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn-sm.primary:hover { opacity: 0.9; }

  .edit-panel {
    display: none; margin-top: 14px; padding-top: 14px;
    border-top: 1px solid var(--card-border);
  }
  .edit-panel.open { display: block; }

  /* Curation controls */
  .tag-grid { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
  .tag-label {
    display: flex; align-items: center; gap: 5px;
    background: var(--surface, #f9f9fb); border: 1px solid var(--card-border);
    border-radius: 20px; padding: 3px 10px; cursor: pointer; font-size: 12px;
    transition: background 0.12s;
  }
  .tag-label:hover { background: rgba(124,106,245,0.06); }
  .tag-label input { margin: 0; accent-color: var(--accent); }
  .curation-notes {
    width: 100%; min-height: 70px; resize: vertical; box-sizing: border-box;
    border: 1px solid var(--outline, #c7c4d7); border-radius: 7px;
    background: var(--bg, #fcf8ff); color: var(--text, #1b1b23);
    padding: 8px 10px; font: inherit; font-size: 13px;
  }

  /* Matched pages */
  .matched-pages { margin-top: 12px; }
  .matched-pages-label {
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--text-dim, #767586); margin-bottom: 6px;
  }
  .matched-page-item {
    font-size: 12px; display: flex; align-items: baseline; gap: 6px;
    padding: 3px 0; border-bottom: 1px solid var(--card-border);
  }
  .matched-page-item:last-child { border-bottom: none; }
  .matched-page-item a { color: var(--accent); text-decoration: none; }
  .matched-page-item a:hover { text-decoration: underline; }
  .matched-page-tags { color: var(--text-dim, #888); font-size: 11px; }

  .form-actions { display: flex; gap: 8px; margin-top: 8px; }
</style>
</head>
<body class="admin-page">

<%- include('partials/admin-header', { title: `CRM — ${user}` }) %>

<section class="admin-section">
  <h2>Contacts (<%= contacts.length %>)</h2>
  <p style="font-size:13px;color:var(--text-muted);">Curation controls express preference and attention. Relationships and knowledge are derived from source material.</p>

  <div class="card-grid">
  <% for (const c of contacts) { %>
  <%
    const curationFlags = JSON.parse(c.curation_flags || '[]');
    const aliases = JSON.parse(c.aliases || '[]');
    const hasFlag = flag => curationFlags.includes(flag);
    const flagLabels = [
      hasFlag('pin_briefing') ? 'Pinned' : null,
      hasFlag('watch') ? 'Watch' : null,
      hasFlag('quiet_nudges') ? 'Quiet nudges' : null,
      hasFlag('sensitive') ? 'Sensitive' : null,
    ].filter(Boolean);
  %>
  <div class="contact-card" id="crm-card-<%= c.id %>">
    <div class="card-head">
      <div>
        <div class="card-name"><%= c.name %></div>
        <% if (aliases.length) { %>
          <div class="card-aliases">Also: <%= aliases.join(', ') %></div>
        <% } %>
      </div>
      <span style="font-size:11px;color:var(--text-dim);white-space:nowrap;"><%= flagLabels.length %> control<%= flagLabels.length !== 1 ? 's' : '' %></span>
    </div>

    <% if (flagLabels.length) { %>
    <div class="card-badges">
      <% for (const t of flagLabels) { %><span class="badge badge-tag"><%= t %></span><% } %>
    </div>
    <% } else { %>
    <div class="card-badges">
      <span class="badge badge-none">standard</span>
    </div>
    <% } %>

    <% if (c.curation_notes) { %>
      <p style="font-size:12px;color:var(--text-muted);margin:6px 0 0;"><%= c.curation_notes %></p>
    <% } %>

    <div class="card-actions" style="margin-top:12px;">
      <button class="btn-sm" onclick="toggleCrmEdit('<%= c.id %>')">Curate</button>
    </div>

    <div class="edit-panel" id="crm-edit-<%= c.id %>">
      <form method="POST" action="/admin/contacts/<%= c.id %>/curation">
        <div class="tag-grid">
          <label class="tag-label">
            <input type="checkbox" name="flags" value="pin_briefing" <%= hasFlag('pin_briefing') ? 'checked' : '' %>>
            Pin in briefing
          </label>
          <label class="tag-label">
            <input type="checkbox" name="flags" value="watch" <%= hasFlag('watch') ? 'checked' : '' %>>
            Watch closely
          </label>
          <label class="tag-label">
            <input type="checkbox" name="flags" value="quiet_nudges" <%= hasFlag('quiet_nudges') ? 'checked' : '' %>>
            Quiet nudges
          </label>
          <label class="tag-label">
            <input type="checkbox" name="flags" value="sensitive" <%= hasFlag('sensitive') ? 'checked' : '' %>>
            Sensitive
          </label>
        </div>
        <textarea class="curation-notes" name="curation_notes" placeholder="Optional note for why this person is pinned, watched, quiet, or sensitive."><%= c.curation_notes || '' %></textarea>
        <div class="form-actions">
          <button type="submit" class="btn-sm primary">Save curation</button>
          <button type="button" class="btn-sm" onclick="toggleCrmEdit('<%= c.id %>')">Cancel</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>
  </div>
</section>

<script>
window.toggleCrmEdit = function(id) {
  const panel = document.getElementById('crm-edit-' + id);
  if (panel) panel.classList.toggle('open');
};
</script>

</body>
</html>
