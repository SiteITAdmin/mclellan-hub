<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Knowledge — McLellan Hub</title>
<link rel="stylesheet" href="/portfolio.css">
<style>
.wrap { max-width: var(--max-w); }
.section-head { font-size:13px; font-weight:600; color:var(--text-dim); text-transform:uppercase; letter-spacing:.04em; margin:26px 0 10px; }
.intro { font-size:13px; color:var(--text-dim); margin-bottom:18px; }
.atom { display:flex; align-items:flex-start; gap:12px; padding:12px 14px; border-radius:8px; margin-bottom:8px; background:var(--surface-2, rgba(255,255,255,0.03)); border:1px solid var(--border); }
.atom-body { flex:1; font-size:13px; }
.atom-claim { color:var(--text); }
.atom-pred { color:#7c6af5; font-family:monospace; font-size:12px; }
.atom-meta { font-size:12px; color:var(--text-dim); margin-top:4px; }
.atom-actions { display:flex; gap:6px; }
.btn { padding:5px 10px; border-radius:6px; font-size:12px; cursor:pointer; border:1px solid var(--border); background:transparent; color:var(--text); }
.btn.approve { background:#3a7c5f; border-color:#3a7c5f; color:#fff; }
.btn.reject  { color:#e06c6c; }
.warn { border-left:3px solid #e06c6c; }
.empty { padding:24px 0; color:var(--text-dim); font-size:13px; }
.count { font-weight:700; }
.receipt { padding:10px 12px; border:1px solid var(--border); border-radius:8px; margin-bottom:8px; background:var(--surface-2, rgba(255,255,255,0.03)); }
.receipt-head { display:flex; justify-content:space-between; gap:10px; align-items:baseline; font-size:13px; }
.receipt-stage { color:#7c6af5; font-family:monospace; font-size:12px; }
.receipt-status { font-size:11px; border:1px solid var(--border); border-radius:999px; padding:1px 7px; color:var(--text-dim); }
.receipt-status.error { color:#e06c6c; border-color:#e06c6c; }
.receipt-status.skipped { color:#b9822b; border-color:#b9822b; }
.receipt-body { font-size:12px; color:var(--text-dim); margin-top:4px; }
</style>
</head>
<body class="admin-page">

<%- include('partials/admin-header', { title: `Knowledge — ${user}` }) %>

<section class="admin-section wrap">
  <p class="intro">
    The knowledge layer is compiled from your documents, emails, meetings and CRM facts by the nightly synthesis job.
    This queue shows what needs a human eye: claims the linker was unsure about, contradictions, and possible duplicate contacts.
    Approving a proposed claim makes it active and visible on the contact; rejecting retires it.
  </p>

  <div class="section-head">Proposed claims (<span class="count"><%= queue.proposed.length %></span>)</div>
  <% if (!queue.proposed.length) { %>
    <div class="empty">Nothing waiting. The linker has been confident about everything it found.</div>
  <% } else { %>
    <% queue.proposed.forEach(function(a){ %>
      <div class="atom">
        <div class="atom-body">
          <div class="atom-claim"><strong><%= a.subject_label %></strong> <span class="atom-pred"><%= a.predicate %></span> <%= a.value %></div>
          <div class="atom-meta">confidence <%= a.confidence.toFixed(2) %> · <%= a.subject_id ? 'linked to an entity' : 'no entity matched' %> · derived by <%= a.derived_by || 'synthesis' %></div>
        </div>
        <div class="atom-actions">
          <form method="post" action="/admin/knowledge/atom/<%= a.id %>/approve"><button class="btn approve" type="submit">Approve</button></form>
          <form method="post" action="/admin/knowledge/atom/<%= a.id %>/reject"><button class="btn reject" type="submit">Reject</button></form>
        </div>
      </div>
    <% }); %>
  <% } %>

  <div class="section-head">Contradictions (<span class="count"><%= queue.contradictions.length %></span>)</div>
  <% if (!queue.contradictions.length) { %>
    <div class="empty">No conflicting single-valued facts.</div>
  <% } else { %>
    <% queue.contradictions.forEach(function(c){ %>
      <div class="atom warn">
        <div class="atom-body">
          <div class="atom-claim"><strong><%= c.subjectLabel %></strong> has <%= c.values.length %> values for <span class="atom-pred"><%= c.predicate %></span></div>
          <% c.values.forEach(function(v){ %>
            <div class="atom-meta">• <%= v.value %> (conf <%= v.confidence.toFixed(2) %>)
              <form method="post" action="/admin/knowledge/atom/<%= v.id %>/reject" style="display:inline"><button class="btn reject" type="submit">Retire</button></form>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  <% } %>

  <div class="section-head">Possible duplicate contacts (<span class="count"><%= queue.duplicateContacts.length %></span>)</div>
  <% if (!queue.duplicateContacts.length) { %>
    <div class="empty">No likely duplicates.</div>
  <% } else { %>
    <% queue.duplicateContacts.forEach(function(p){ %>
      <div class="atom warn">
        <div class="atom-body">
          <div class="atom-claim"><strong><%= p.a.name %></strong> &nbsp;↔&nbsp; <strong><%= p.b.name %></strong></div>
          <div class="atom-meta"><%= p.reasons.join(', ') %></div>
        </div>
      </div>
    <% }); %>
  <% } %>

  <div class="section-head">Maintenance</div>
  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:20px">
    <button id="dedup-btn" onclick="runDedup()" style="padding:7px 16px;background:var(--accent,#7c6af5);color:#fff;border:none;border-radius:7px;font-size:13px;cursor:pointer;font-family:inherit">
      Deduplicate atoms
    </button>
    <span id="dedup-status" style="font-size:13px;color:var(--text-dim)">
      Merges atoms where one value is a substring of another within the same entity+predicate group.
    </span>
  </div>

  <div class="section-head">CRM knowledge-engine receipts (<span class="count"><%= (receipts || []).length %></span>)</div>
  <% if (!(receipts || []).length) { %>
    <div class="empty">No CRM knowledge-engine receipts yet. The scheduled engine will start leaving source triage and synthesis decisions here.</div>
  <% } else { %>
    <% receipts.forEach(function(r){ %>
      <div class="receipt">
        <div class="receipt-head">
          <div>
            <span class="receipt-stage"><%= r.stage %></span>
            <span class="atom-meta"> · <%= r.source_kind %>/<%= r.source_id %></span>
          </div>
          <span class="receipt-status <%= r.status %>"><%= r.status %></span>
        </div>
        <div class="receipt-body">
          <%= r.summary || 'No summary.' %>
          <% if (r.model_id) { %> · model <%= r.model_id %><% } %>
          <% if (r.payload && r.payload.knowledge_value) { %> · value <%= r.payload.knowledge_value %><% } %>
          <% if (typeof r.payload.confidence === 'number') { %> · confidence <%= r.payload.confidence.toFixed(2) %><% } %>
        </div>
      </div>
    <% }); %>
  <% } %>

  <div class="section-head">Stale claims (<span class="count"><%= queue.stale.length %></span>)</div>
  <% if (!queue.stale.length) { %>
    <div class="empty">Nothing stale.</div>
  <% } else { %>
    <% queue.stale.forEach(function(a){ %>
      <div class="atom">
        <div class="atom-body">
          <div class="atom-claim"><strong><%= a.subject_label %></strong> <span class="atom-pred"><%= a.predicate %></span> <%= a.value %></div>
          <div class="atom-meta">not reconfirmed in over a year</div>
        </div>
        <div class="atom-actions">
          <form method="post" action="/admin/knowledge/atom/<%= a.id %>/approve"><button class="btn approve" type="submit">Still true</button></form>
          <form method="post" action="/admin/knowledge/atom/<%= a.id %>/reject"><button class="btn reject" type="submit">Retire</button></form>
        </div>
      </div>
    <% }); %>
  <% } %>
</section>

<script>
async function runDedup() {
  const btn = document.getElementById('dedup-btn');
  const status = document.getElementById('dedup-status');
  btn.disabled = true;
  btn.textContent = 'Running…';
  status.textContent = 'Scanning atom groups…';
  try {
    const r = await fetch('/admin/knowledge/dedup', { method: 'POST' });
    const d = await r.json();
    if (d.ok) {
      status.textContent = `Done — scanned ${d.scanned} atoms, merged ${d.merged} duplicates.`;
      status.style.color = d.merged > 0 ? '#3a7c5f' : 'var(--text-dim)';
    } else {
      status.textContent = `Error: ${d.error}`;
      status.style.color = '#e06c6c';
    }
  } catch(e) {
    status.textContent = `Request failed: ${e.message}`;
    status.style.color = '#e06c6c';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Deduplicate atoms';
  }
}
</script>
</body>
</html>
