<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Newsletter ingestion — <%= user %></title>
<link rel="stylesheet" href="/portfolio.css">
<style>
.audit-note { color: var(--text-dim); font-size: 13px; margin: -6px 0 18px; max-width: 900px; }
.audit-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin-bottom: 18px; }
.audit-controls label { display: grid; gap: 4px; color: var(--text-dim); font-size: 12px; }
.audit-controls select { min-width: 130px; padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--text); }
.audit-controls button, .audit-controls a { padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--text-dim); text-decoration: none; font-size: 13px; }
.audit-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
.audit-table { width: 100%; min-width: 1180px; border-collapse: collapse; font-size: 12px; }
.audit-table th { position: sticky; top: 0; background: var(--surface-raised, var(--surface)); color: var(--text-muted); text-align: left; padding: 9px; border-bottom: 1px solid var(--border); white-space: nowrap; }
.audit-table td { padding: 10px 9px; border-bottom: 1px solid var(--border); vertical-align: top; }
.audit-table tr:last-child td { border-bottom: 0; }
.audit-title { min-width: 220px; max-width: 320px; }
.audit-title strong { display: block; color: var(--text); font-size: 13px; margin-bottom: 3px; }
.muted { color: var(--text-muted); }
.mono { font-family: var(--mono); overflow-wrap: anywhere; }
.badge { display: inline-block; padding: 2px 6px; border-radius: 999px; font: 600 11px var(--mono); background: var(--accent-light); color: var(--accent); }
.badge.fallback, .badge.failed { background: #fee8e8; color: #b13a3a; }
.badge.running { background: #fff3d6; color: #8b6518; }
.badge.stored { background: var(--surface-raised, #eee); color: var(--text-muted); }
.output-row td { padding: 0 10px 10px; background: var(--surface); }
.output-row details { color: var(--text-dim); }
.output-list { display: grid; gap: 7px; margin: 8px 0 3px; }
.output-item { padding: 8px 10px; border-left: 3px solid var(--border-strong); background: var(--bg); }
.output-item strong { color: var(--text); }
.inspect { color: var(--primary); font-weight: 600; text-decoration: none; }
.empty { padding: 24px; color: var(--text-muted); }
</style>
</head>
<body class="admin-page">
<%- include('partials/admin-header', { title: `Newsletter ingestion — ${user}` }) %>

<section class="admin-section">
  <p class="audit-note">
    One row per stored newsletter or RSS document. Older rows reconstruct the audit from existing document and item data;
    newly processed rows also include attempts, requested/actual model, usage, duration, fallback and error details.
  </p>

  <form class="audit-controls" method="GET">
    <label>Source
      <select name="source_kind">
        <option value="">All</option>
        <option value="email" <%= filters.sourceKind === 'email' ? 'selected' : '' %>>Email</option>
        <option value="rss" <%= filters.sourceKind === 'rss' ? 'selected' : '' %>>RSS</option>
      </select>
    </label>
    <label>Status
      <select name="status">
        <option value="">All</option>
        <% for (const value of ['complete', 'fallback', 'failed', 'running', 'stored']) { %>
          <option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>><%= value %></option>
        <% } %>
      </select>
    </label>
    <label>Model
      <select name="model">
        <option value="">All</option>
        <% for (const value of models) { %>
          <option value="<%= value %>" <%= filters.model === value ? 'selected' : '' %>><%= value %></option>
        <% } %>
      </select>
    </label>
    <label>Rows
      <select name="limit">
        <% for (const value of [25, 50, 100, 250, 500]) { %>
          <option value="<%= value %>" <%= filters.limit === value ? 'selected' : '' %>><%= value %></option>
        <% } %>
      </select>
    </label>
    <button type="submit">Apply</button>
    <a href="/admin/newsletter-ingestion">Clear</a>
    <span class="muted"><%= rows.length %> result<%= rows.length === 1 ? '' : 's' %></span>
  </form>

  <% if (!rows.length) { %>
    <p class="empty">No ingestion records match these filters.</p>
  <% } else { %>
  <div class="audit-wrap">
    <table class="audit-table">
      <thead>
        <tr>
          <th>Time</th>
          <th>Input</th>
          <th>Admission</th>
          <th>Stored</th>
          <th>Extraction</th>
          <th>Model</th>
          <th>Output</th>
          <th>Usage</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      <% for (const row of rows) {
           const timestamp = row.audit_at || row.published_at || row.created_at;
           const time = timestamp ? new Date(timestamp * 1000).toLocaleString('en-GB', {
             day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false
           }) : '—';
           const modelId = row.resolved_model_id || '';
           const modelLabel = row.item_model_label && row.item_model_label !== modelId ? row.item_model_label : '';
           const duration = row.duration_ms == null ? '—' : row.duration_ms >= 1000 ? `${(row.duration_ms / 1000).toFixed(1)}s` : `${row.duration_ms}ms`;
      %>
        <tr>
          <td class="mono"><%= time %></td>
          <td class="audit-title">
            <strong><%= row.title %></strong>
            <span class="muted"><%= row.sender_name || row.sender_email || 'Unknown sender' %></span>
          </td>
          <td>
            <span class="badge"><%= row.source_kind %></span><br>
            <strong><%= row.source_name || 'Unmatched source' %></strong><br>
            <span class="muted"><%= row.match_type ? `${row.match_type}: ${row.match_value}` : 'No source rule' %></span>
          </td>
          <td><strong><%= Number(row.source_chars || 0).toLocaleString('en-GB') %></strong> chars<br><span class="muted mono"><%= row.id.slice(0, 8) %></span></td>
          <td>
            <span class="badge <%= row.resolved_status %>"><%= row.resolved_status %></span><br>
            <span class="muted"><%= row.run_method || row.extraction_method || 'not recorded' %></span>
            <% if (row.attempt_count > 1) { %><br><span class="muted"><%= row.attempt_count %> attempts</span><% } %>
            <% if (!row.run_id) { %><br><span class="muted">historical</span><% } %>
          </td>
          <td class="mono">
            <%= modelLabel || modelId || 'not recorded' %>
            <% if (modelLabel && modelId) { %><br><span class="muted"><%= modelId %></span><% } %>
            <% if (row.requested_model_id && row.actual_model_id && row.requested_model_id !== row.actual_model_id) { %>
              <br><span class="muted">requested: <%= row.requested_model_id %></span>
            <% } %>
          </td>
          <td><strong><%= row.item_count %></strong> items<br><span class="muted"><%= Number(row.output_chars || 0).toLocaleString('en-GB') %> chars</span></td>
          <td class="mono">
            <% if (row.run_id) { %>
              <%= row.tokens_in || 0 %> in / <%= row.tokens_out || 0 %> out<br>
              <span class="muted">$<%= Number(row.cost_usd || 0).toFixed(5) %> · <%= duration %></span>
            <% } else { %>
              <span class="muted">not recorded</span>
            <% } %>
          </td>
          <td><a class="inspect" href="/admin/newsletter-ingestion/<%= row.id %>">Inspect</a></td>
        </tr>
        <tr class="output-row">
          <td colspan="9">
            <details>
              <summary>View extracted output (<%= row.items.length %> item<%= row.items.length === 1 ? '' : 's' %>)</summary>
              <div class="output-list">
                <% if (!row.items.length) { %>
                  <div class="muted">No extracted items were stored.</div>
                <% } %>
                <% for (const item of row.items) { %>
                  <div class="output-item">
                    <strong><%= item.title %></strong>
                    <span class="muted"> · <%= item.item_type %><%= item.category ? ` · ${item.category}` : '' %> · <%= Number(item.content_chars || 0).toLocaleString('en-GB') %> chars</span>
                    <% if (item.summary) { %><div><%= item.summary %></div><% } %>
                  </div>
                <% } %>
              </div>
            </details>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
</body>
</html>
