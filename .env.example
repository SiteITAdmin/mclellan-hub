OPENROUTER_API_KEY=
MISTRAL_API_KEY=
OPENAI_TRANSCRIPTION_API_KEY=
WORKDAY_WEBHOOK_SECRET=
WORKDAY_MOBILE_TOKEN=
WORKDAY_NARRATIVE_MODEL=free
WORKDAY_TRANSCRIPTION_MODEL=openai/whisper-large-v3
SYNTHADOC_BIN=
PERPLEXITY_API_KEY=
AVIATIONSTACK_KEY=
GOOGLE_AI_API_KEY=
SESSION_SECRET=

GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
CONTACT_FROM_NAME=Nakai portfolio
NAKAI_CONTACT_TO=

DOUGLAS_HUB_PASSWORD=
NAKAI_HUB_PASSWORD=
DOUGLAS_ADMIN_PASSWORD=
NAKAI_ADMIN_PASSWORD=

NODE_ENV=production
PORT=3000

HERMES_WEBHOOK_SECRET=

# Restrict scheduled briefings to these users (comma-separated)
BRIEFING_USERS=douglas
# Optional destination for standalone high-salience CRM suggestion emails.
# Falls back to WORK_BRIEF_EMAIL, then SYSTEM_REPORT_EMAIL.
CRM_SUGGESTION_EMAIL=

# Absolute path to the Obsidian vault root on this machine
VAULT_PATH=
VAULT_SYNC_KEY=
HUB_URL=

# Base URL used for the clickable fix links in the Daily Consigliere Report.
# Falls back to HUB_URL, then https://dchat.mclellan.scot.
HUB_PUBLIC_URL=

# Daily Boox / Onyx Drive notebook ingest. Prefer folder ID if available.
BOOX_DRIVE_ENABLED=0
BOOX_DRIVE_USER=douglas
BOOX_DRIVE_FOLDER_ID=
BOOX_DRIVE_FOLDER_PATH=onyx/NoteMax/Notebooks
BOOX_DRIVE_VAULT_ROOT=
HUB_DB_PATH=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_TO_DOUGLAS=

# Nakai daily briefing
NAKAI_GOOGLE_EMAILS=
NAKAI_DAILY_BRIEFING_GMAIL_USER=douglas
# Secret token for the /nakai/briefing-request endpoint (generate with: openssl rand -hex 32)
NAKAI_BRIEFING_REQUEST_TOKEN=

# Content research driver:
#   (empty)  plain Exa/Brave web search on the Hub host
#   grok     run the locally authenticated Grok CLI+last30days on THIS host
#            (needs the Grok CLI and a Python 3.12+ engine)
#   mac      VPS enqueues jobs; Mac mini pull-worker runs Grok+last30days
#            and POSTs suggestions back (recommended for production VPS)
# LAST30DAYS_ENGINE_PATH: last30days skill root (scripts/last30days.py child).
# CONTENT_RESEARCH_WORKER_SECRET: shared bearer for Mac worker API (openssl rand -hex 32).
# CONTENT_RESEARCH_CLAIM_STALE_SEC: reclaim after worker death (default 2700).
# CONTENT_RESEARCH_FALLBACK_AFTER_SEC: web-search fallback if Mac never finishes (default 7200).
# Mac worker uses its authenticated Grok CLI subscription; it needs HUB_URL +
# the same WORKER_SECRET, but no OpenRouter key. GROK_CLI_PATH defaults to
# ~/.grok/bin/grok and GROK_RESEARCH_CLI_MODEL defaults to grok-4.5.
CONTENT_RESEARCH_DRIVER=
LAST30DAYS_ENGINE_PATH=
CONTENT_RESEARCH_WORKER_SECRET=
CONTENT_RESEARCH_CLAIM_STALE_SEC=
CONTENT_RESEARCH_FALLBACK_AFTER_SEC=
GROK_CLI_PATH=
GROK_RESEARCH_CLI_MODEL=
