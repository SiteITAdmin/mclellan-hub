OPENROUTER_API_KEY=
OPENAI_TRANSCRIPTION_API_KEY=
WORKDAY_WEBHOOK_SECRET=
WORKDAY_MOBILE_TOKEN=
WORKDAY_NARRATIVE_MODEL=free
WORKDAY_TRANSCRIPTION_MODEL=openai/whisper-large-v3
SYNTHADOC_BIN=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=
SESSION_SECRET=

GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
CONTACT_FROM_NAME=Nakai portfolio
NAKAI_CONTACT_TO=

DOUGLAS_HUB_PASSWORD=
NAKAI_HUB_PASSWORD=
DOUGLAS_ADMIN_PASSWORD=
NAKAI_ADMIN_PASSWORD=

NODE_ENV=production
PORT=3000

# Hermes Google Chat bot — set both, then paste HERMES_WEBHOOK_SECRET into
# Apps Script property DCHAT_SECRET. Generate with: openssl rand -hex 32
HERMES_WEBHOOK_SECRET=
# Google Chat incoming webhook URL for the space Hermes posts into
GOOGLE_CHAT_WEBHOOK_DOUGLAS=
# Direct Google Chat HTTP endpoint verification. Leave audience as the endpoint
# URL unless you choose Project Number in Google Chat auth settings.
GOOGLE_CHAT_AUTH_AUDIENCE=https://dchat.mclellan.scot/api/google-chat/hermes
GOOGLE_CHAT_PROJECT_NUMBER=
GOOGLE_CHAT_USER=douglas

# Restrict scheduled briefings to these users (comma-separated)
BRIEFING_USERS=douglas

# Absolute path to the Obsidian vault root on this machine
VAULT_PATH=
VAULT_SYNC_KEY=
HUB_URL=
